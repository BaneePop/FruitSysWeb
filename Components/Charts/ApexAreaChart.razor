@using ApexCharts
@using FruitSysWeb.Models.Common

<div class="card" style="background: #1a2332; border: 1px solid #374151;">
    <div class="card-header d-flex justify-content-between align-items-center" style="background: #232d3f; border-bottom: 1px solid #374151;">
        <h5 class="mb-0 text-white">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <i class="@Icon me-2"></i>
            }
            @Title
        </h5>
        <div class="d-flex gap-2 align-items-center">
            @if (!IsLoading && !HasError)
            {
                <!-- Interval selector -->
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn @(Interval == "dnevno" ? "btn-success" : "btn-outline-secondary")"
                            @onclick='() => OnIntervalChanged.InvokeAsync("dnevno")'>
                        D
                    </button>
                    <button type="button" class="btn @(Interval == "nedeljno" ? "btn-success" : "btn-outline-secondary")"
                            @onclick='() => OnIntervalChanged.InvokeAsync("nedeljno")'>
                        N
                    </button>
                    <button type="button" class="btn @(Interval == "mesecno" ? "btn-success" : "btn-outline-secondary")"
                            @onclick='() => OnIntervalChanged.InvokeAsync("mesecno")'>
                        M
                    </button>
                </div>
            }
            @if (!IsLoading && !HasError && OnRefresh.HasDelegate)
            {
                <button class="btn btn-sm btn-outline-light" @onclick="OnRefresh">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        @if (IsLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-success" role="status">
                    <span class="visually-hidden">Učitavanje...</span>
                </div>
                <p class="mt-3 text-white-50">Učitavanje podataka...</p>
            </div>
        }
        else if (HasError)
        {
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Greška pri učitavanju podataka
            </div>
        }
        else if (SeriesData == null || !SeriesData.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox display-1 text-muted"></i>
                <p class="mt-3 text-muted">Nema podataka za prikaz</p>
            </div>
        }
        else
        {
            <ApexChart TItem="ChartDataPoint"
                       Options="@ChartOptions"
                       Height="@Height">
                @foreach (var series in SeriesData)
                {
                    <ApexPointSeries TItem="ChartDataPoint"
                                     Items="@series.Data"
                                     Name="@series.Name"
                                     SeriesType="SeriesType.Area"
                                     XValue="@(e => e.Label)"
                                     YAggregate="@(e => e.Sum(x => x.Value))" />
                }
            </ApexChart>

            @if (ShowSummary && SeriesData.Any())
            {
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="p-3 rounded" style="background: linear-gradient(135deg, #232d3f, #2a3441); border: 1px solid #374151;">
                            <div class="text-white d-flex flex-wrap gap-2 align-items-center">
                                @foreach (var series in SeriesData.OrderByDescending(s => s.TotalKolicina))
                                {
                                    <div class="px-3 py-1 rounded d-flex align-items-center gap-2"
                                         style="background: rgba(255,255,255,0.05); border: 1px solid #374151;">
                                        <span class="rounded-circle d-inline-block" style="width:12px;height:12px;background:@(series.Color ?? "#28a745");"></span>
                                        <strong>@series.Name:</strong>
                                        <span>@series.TotalKolicina.ToString("N0") kg</span>
                                    </div>
                                }
                                <div class="px-3 py-1 rounded d-flex align-items-center gap-2"
                                     style="background: rgba(255,255,255,0.12); border: 1px solid #6b7280;">
                                    <strong>Ukupno:</strong>
                                    <span>@SeriesData.Sum(s => s.TotalKolicina).ToString("N0") kg</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Chart";
    [Parameter] public string Icon { get; set; } = "bi bi-graph-up-arrow";
    [Parameter] public List<ChartSeriesData> SeriesData { get; set; } = new();
    [Parameter] public string Unit { get; set; } = "kg";
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool HasError { get; set; }
    [Parameter] public bool ShowSummary { get; set; } = true;
    [Parameter] public int Height { get; set; } = 450;
    [Parameter] public string Interval { get; set; } = "dnevno";
    [Parameter] public EventCallback<string> OnIntervalChanged { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }

    private ApexChartOptions<ChartDataPoint> ChartOptions => new()
    {
        Theme = new Theme
        {
            Mode = Mode.Dark,
            Palette = PaletteType.Palette2
        },
        Chart = new Chart
        {
            Type = ChartType.Area,
            Height = Height,
            Background = "transparent",
            ForeColor = "#e5e7eb",
            Toolbar = new Toolbar { Show = true },
            Zoom = new Zoom { Enabled = true },
            Stacked = false
        },
        Colors = GetSeriesColors(),
        Fill = new Fill
        {
            Opacity = 0.15
        },
        Stroke = new Stroke
        {
            Curve = Curve.Smooth,
            Width = 3
        },
        Markers = new Markers
        {
            Size = 0
        },
        Xaxis = new XAxis
        {
            TickAmount = 12,
            Labels = new XAxisLabels
            {
                Style = new AxisLabelStyle
                {
                    Colors = "#9ca3af"
                },
                Rotate = -45,
                RotateAlways = false
            }
        },
        Yaxis = new List<YAxis>
        {
            new YAxis
            {
                Title = new AxisTitle
                {
                    Text = Unit,
                    Style = new AxisTitleStyle { Color = "#9ca3af" }
                },
                Labels = new YAxisLabels
                {
                    Style = new AxisLabelStyle { Colors = "#9ca3af" },
                    Formatter = @"function(value) {
                        if (value == null) return '0';
                        return value.toLocaleString('sr-RS', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
                    }"
                }
            }
        },
        Grid = new Grid
        {
            BorderColor = "#374151",
            StrokeDashArray = 4
        },
        Tooltip = new ApexCharts.Tooltip
        {
            Enabled = true,
            Shared = true,
            Intersect = false,
            Y = new TooltipY
            {
                Formatter = @"function(value) {
                    if (value == null || value === 0) return undefined;
                    return value.toLocaleString('sr-RS', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' kg';
                }"
            }
        },
        Legend = new Legend
        {
            Position = LegendPosition.Top,
            HorizontalAlign = Align.Center,
            FontSize = "14px",
            Labels = new LegendLabels
            {
                Colors = "#e5e7eb"
            }
        },
        DataLabels = new DataLabels { Enabled = false }
    };

    private List<string> GetSeriesColors()
    {
        if (SeriesData != null && SeriesData.Any())
        {
            return SeriesData
                .Select(s => !string.IsNullOrEmpty(s.Color) ? s.Color : "#28a745")
                .ToList();
        }
        return new List<string> { "#28a745" };
    }
}
