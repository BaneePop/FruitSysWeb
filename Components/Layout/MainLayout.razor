@using FruitSysWeb.Models
@using FruitSysWeb.Services.Interfaces
@inherits LayoutComponentBase
@using FruitSysWeb.Shared
@inject IAuthService AuthService
@inject NavigationManager Navigation

<NavMenu />

@if (currentUser != null)
{
    <div class="user-info-bar bg-dark text-light py-2 px-3 mb-3">
        <div class="container-fluid d-flex justify-content-end align-items-center gap-3">
            <span>
                <i class="bi bi-person-circle me-2"></i>@currentUser.Ime
                @if (currentUser.Administrator)
                {
                    <span class="badge bg-warning text-dark ms-2">Admin</span>
                }
            </span>
            <button class="btn btn-outline-light btn-sm" type="button" @onclick="HandleLogout">
                <i class="bi bi-box-arrow-right me-1"></i>Odjava
            </button>
        </div>
    </div>
}

@Body

@code {
    private KorisnikModel? currentUser;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = await AuthService.GetCurrentUser();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška: {ex.Message}");
        }
    }

    private async Task HandleLogout()
    {
        try
        {
            await AuthService.Logout();
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška: {ex.Message}");
        }
    }
}