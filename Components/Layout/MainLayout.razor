@inherits LayoutComponentBase
@using FruitSysWeb.Shared
@using FruitSysWeb.Components.Shared
@using Microsoft.AspNetCore.Components.Sections

<!-- Skip to main content link for keyboard accessibility -->
<a href="#main-content" class="skip-link">Preskoči na glavni sadržaj</a>

<InactivityHandler />

<div class="app-shell" id="appShell">
    <NavMenu />

    <div class="app-content">
        <header class="app-topbar">
            <button type="button" class="app-hamb" onclick="odettaSidebar.toggle()" aria-label="Meni">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>
            <span class="app-topbar-title">Odetta Solar</span>
            <SectionOutlet SectionName="topbar-actions" />
        </header>

        <main class="app-main" id="main-content">
            @Body
        </main>

        <Footer />
    </div>
</div>

<style>
    .skip-link {
        position: absolute;
        top: -40px;
        left: 0;
        background: #000;
        color: #fff;
        padding: 8px 16px;
        text-decoration: none;
        z-index: 9999;
        border-radius: 0 0 4px 0;
    }

    .skip-link:focus {
        top: 0;
    }
</style>
