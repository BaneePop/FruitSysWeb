@page "/ambalaza"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using FruitSysWeb.Models
@using FruitSysWeb.Services
@using FruitSysWeb.Services.Models.Requests
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Core
@using FruitSysWeb.Constants
@inject IMagacinLagerService LagerService
@inject IExportService ExportService
@inject ITypeMappingService TypeMapping
@inject IJSRuntime JSRuntime

<style>
    .low-stock { background-color: #fff5f5; border-left: 4px solid #dc3545; }
    .medium-stock { background-color: #fff8e1; border-left: 4px solid #ffc107; }
    .high-stock { background-color: #f0f9ff; border-left: 4px solid #198754; }
    
    .stock-alert {
        padding: 0.25rem 0.5rem;
        border-radius: 0.375rem;
        font-size: 0.75rem;
        font-weight: 600;
    }
    
    .artikal-tip-badge {
        font-size: 0.7rem;
        padding: 0.25rem 0.5rem;
    }
</style>

<div class="container-fluid">
    <!-- Header -->
    <div class="bg-warning text-dark py-3 mb-4">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h1 class="h3 mb-0">
                        <i class="bi bi-box-seam me-2"></i>
                        Lager Ambalaže
                    </h1>
                    <small class="text-dark opacity-75">Trenutno stanje ambalaže — kutije, kese i ostali ambalažni materijal</small>
                </div>
                <div class="col-md-6 text-end">
                    <span class="badge bg-light text-dark fs-6">
                        <i class="bi bi-box me-1"></i>@(lagerStanje?.Count ?? 0) artikala
                    </span>
                    <span class="badge bg-success text-white ms-2 fs-6">
                        Dostupno: @(lagerStanje?.Sum(x => decimal.Parse(x.Lot ?? "0")).ToString("N0") ?? "0") kom
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- TABS za Kutije i Kese -->
    <div class="row mb-4">
        <div class="col-12">
            <ul class="nav nav-tabs" id="ambalazaTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="kutije-tab" data-bs-toggle="tab" data-bs-target="#kutije" type="button" role="tab" @onclick="UcitajKutije">
                        <i class="bi bi-box me-2"></i>Kutije
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="kese-tab" data-bs-toggle="tab" data-bs-target="#kese" type="button" role="tab" @onclick="UcitajKese">
                        <i class="bi bi-bag me-2"></i>Kese
                    </button>
                </li>
            </ul>
        </div>
    </div>

    <div class="tab-content" id="ambalazeTabContent">
        <!-- KUTIJE TAB -->
        <div class="tab-pane fade show active" id="kutije" role="tabpanel">
            <!-- Export Buttons -->
            <div class="row mb-3">
                <div class="col-12 text-end">
                    <div class="btn-group">
                        <button class="btn btn-success btn-sm" @onclick="ExportToExcel" disabled="@(lagerStanje?.Count == 0)">
                            <i class="bi bi-file-earmark-excel me-1"></i>Excel
                        </button>
                        <button class="btn btn-danger btn-sm" @onclick="ExportToPdf" disabled="@(lagerStanje?.Count == 0)">
                            <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                        </button>
                    </div>
                </div>
            </div>

            <!-- Statistics Cards -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card bg-warning text-dark">
                        <div class="card-body text-center">
                            <h5>Ukupno artikala</h5>
                            <h3>@(lagerStanje?.Count ?? 0)</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body text-center">
                            <h5>Na lageru</h5>
                            <h3>@TypeMapping.FormatDecimal(lagerStanje?.Sum(x => x.Kolicina) ?? 0)</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-info text-white">
                        <div class="card-body text-center">
                            <h5>U proizvodnji</h5>
                            <h3>@lagerStanje?.Sum(x => decimal.Parse(x.Pakovanje ?? "0")).ToString("N0")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body text-center">
                            <h5>Dostupno</h5>
                            <h3>@lagerStanje?.Sum(x => decimal.Parse(x.Lot ?? "0")).ToString("N0")</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Results Table -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-box me-2"></i>
                                Kutije 
                                <span class="badge bg-warning ms-2">@(lagerStanje?.Count ?? 0) artikala</span>
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            @if (lagerStanje == null)
                            {
                                <div class="alert alert-info m-3">
                                    <i class="bi bi-info-circle me-2"></i>
                                    Učitavanje podataka...
                                </div>
                            }
                            else if (!lagerStanje.Any())
                            {
                                <div class="alert alert-warning m-3">
                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                    Nema podataka za prikaz sa trenutnim filterima.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover mb-0">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Artikal</th>
                                                <th class="text-end">Količina</th>
                                                <th class="text-end">U Proizvodnji</th>
                                                <th class="text-end">Za najavljene Utovare</th>
                                                <th class="text-end">Dostupno</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in lagerStanje)
                                            {
                                                // Parse Ukupno iz Lot property
                                                decimal ukupno = 0;
                                                decimal.TryParse(item.Lot ?? "0", out ukupno);
                                                
                                                var stockClass = GetStockClass(ukupno, 100); // Min 100 komada na ukupno
                                                var (stockStatus, stockBadgeClass, stockIcon) = TypeMapping.GetQuantityStatus(ukupno);
                                                
                                                <tr class="@stockClass">
                                                    <td>
                                                        <strong>@item.Artikal</strong>
                                                    </td>
                                                    <td class="text-end">
                                                        <span class="fw-bold">@TypeMapping.FormatDecimal(item.Kolicina)</span>
                                                    </td>
                                                    <td class="text-end">
                                                        <span class="badge bg-primary">@item.Pakovanje</span>
                                                    </td>
                                                    <td class="text-end">
                                                        <span class="badge bg-info">@(item.ZaNajavljeneUtovare ?? "0")</span>
                                                    </td>
                                                    <td class="text-end">
                                                        <strong class="text-success">@item.Lot</strong>
                                                    </td>
                                                    <td>
                                                        <span class="badge @stockBadgeClass">
                                                            <i class="@stockIcon"></i> @stockStatus
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot class="table-secondary">
                                            <tr>
                                                <th class="text-end">UKUPNO:</th>
                                                <th class="text-end text-primary">@TypeMapping.FormatDecimal(lagerStanje.Sum(x => x.Kolicina))</th>
                                                <th class="text-end text-warning">@lagerStanje.Sum(x => decimal.Parse(x.Pakovanje ?? "0")).ToString("N0")</th>
                                                <th class="text-end text-danger">@lagerStanje.Sum(x => decimal.Parse(x.ZaNajavljeneUtovare ?? "0")).ToString("N0")</th>
                                                <th class="text-end text-success">@lagerStanje.Sum(x => decimal.Parse(x.Lot ?? "0")).ToString("N0")</th>
                                                <th></th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- KESE TAB -->
        <div class="tab-pane fade" id="kese" role="tabpanel">
            <!-- Export Buttons -->
            <div class="row mb-3">
                <div class="col-12 text-end">
                    <div class="btn-group">
                        <button class="btn btn-success btn-sm" @onclick="ExportToExcelKese" disabled="@(keseStanje?.Count == 0)">
                            <i class="bi bi-file-earmark-excel me-1"></i>Excel
                        </button>
                        <button class="btn btn-danger btn-sm" @onclick="ExportToPdfKese" disabled="@(keseStanje?.Count == 0)">
                            <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                        </button>
                    </div>
                </div>
            </div>

            <!-- Statistics Cards -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card bg-info text-white">
                        <div class="card-body text-center">
                            <h5>Ukupno artikala</h5>
                            <h3>@(keseStanje?.Count ?? 0)</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body text-center">
                            <h5>Na lageru</h5>
                            <h3>@TypeMapping.FormatDecimal(keseStanje?.Sum(x => x.Kolicina) ?? 0)</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning text-dark">
                        <div class="card-body text-center">
                            <h5>U proizvodnji</h5>
                            <h3>@keseStanje?.Sum(x => decimal.Parse(x.Pakovanje ?? "0")).ToString("N0")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body text-center">
                            <h5>Dostupno</h5>
                            <h3>@keseStanje?.Sum(x => decimal.Parse(x.Lot ?? "0")).ToString("N0")</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Results Table -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-bag me-2"></i>
                                Kese
                                <span class="badge bg-info ms-2">@(keseStanje?.Count ?? 0) artikala</span>
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            @if (keseStanje == null)
                            {
                                <div class="alert alert-info m-3">
                                    <i class="bi bi-info-circle me-2"></i>
                                    Učitavanje podataka...
                                </div>
                            }
                            else if (!keseStanje.Any())
                            {
                                <div class="alert alert-warning m-3">
                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                    Nema podataka za prikaz sa trenutnim filterima.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover mb-0">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Artikal</th>
                                                <th class="text-end">Količina</th>
                                                <th class="text-end">U Proizvodnji</th>
                                                <th class="text-end">Za najavljene Utovare</th>
                                                <th class="text-end">Dostupno</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in keseStanje)
                                            {
                                                // Parse Ukupno iz Lot property
                                                decimal ukupno = 0;
                                                decimal.TryParse(item.Lot ?? "0", out ukupno);
                                                
                                                var stockClass = GetStockClass(ukupno, 100); // Min 100 komada na ukupno
                                                var (stockStatus, stockBadgeClass, stockIcon) = TypeMapping.GetQuantityStatus(ukupno);
                                                
                                                <tr class="@stockClass">
                                                    <td>
                                                        <strong>@item.Artikal</strong>
                                                    </td>
                                                    <td class="text-end">
                                                        <span class="fw-bold">@TypeMapping.FormatDecimal(item.Kolicina)</span>
                                                    </td>
                                                    <td class="text-end">
                                                        <span class="badge bg-primary">@item.Pakovanje</span>
                                                    </td>
                                                    <td class="text-end">
                                                        <span class="badge bg-info">@(item.ZaNajavljeneUtovare ?? "0")</span>
                                                    </td>
                                                    <td class="text-end">
                                                        <strong class="text-success">@item.Lot</strong>
                                                    </td>
                                                    <td>
                                                        <span class="badge @stockBadgeClass">
                                                            <i class="@stockIcon"></i> @stockStatus
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot class="table-secondary">
                                            <tr>
                                                <th class="text-end">UKUPNO:</th>
                                                <th class="text-end text-primary">@TypeMapping.FormatDecimal(keseStanje.Sum(x => x.Kolicina))</th>
                                                <th class="text-end text-warning">@keseStanje.Sum(x => decimal.Parse(x.Pakovanje ?? "0")).ToString("N0")</th>
                                                <th class="text-end text-danger">@keseStanje.Sum(x => decimal.Parse(x.ZaNajavljeneUtovare ?? "0")).ToString("N0")</th>
                                                <th class="text-end text-success">@keseStanje.Sum(x => decimal.Parse(x.Lot ?? "0")).ToString("N0")</th>
                                                <th></th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<MagacinLagerModel>? lagerStanje; // Kutije
    private List<MagacinLagerModel>? keseStanje; // Kese
    private FilterRequest filterRequest = new FilterRequest();
    private FilterRequest filterRequestKese = new FilterRequest();

    protected override async Task OnInitializedAsync()
    {
        await UcitajKutije();
    }

    private async Task UcitajKutije()
    {
        try
        {
            lagerStanje = await LagerService.UcitajKutije(filterRequest);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška pri učitavanju kutija: {ex.Message}");
            lagerStanje = new List<MagacinLagerModel>();
        }
    }

    private async Task UcitajKese()
    {
        try
        {
            keseStanje = await LagerService.UcitajKese(filterRequestKese);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška pri učitavanju kesa: {ex.Message}");
            keseStanje = new List<MagacinLagerModel>();
        }
    }

    private async Task ResetujFiltere()
    {
        filterRequest = new FilterRequest();
        filterRequestKese = new FilterRequest();
        await UcitajKutije();
        await UcitajKese();
    }

    private string GetStockClass(decimal kolicina, decimal minimum)
    {
        if (kolicina < minimum) return "low-stock";
        if (kolicina < minimum * 2) return "medium-stock";
        return "high-stock";
    }

    // Export metode
    private async Task ExportToExcel()
    {
        try
        {
            if (lagerStanje != null && lagerStanje.Any())
            {
                // Definiši samo kolone koje se prikazuju u tabeli
                var columns = new Dictionary<string, string>
                {
                    { "Artikal", "Artikal" },
                    { "Kolicina", "Količina" },
                    { "Pakovanje", "U Proizvodnji" },
                    { "ZaNajavljeneUtovare", "Za najavljene Utovare" },
                    { "Lot", "Dostupno" }
                };

                // Dodaj totale na dnu
                var totals = new Dictionary<string, object>
                {
                    { "Artikal", "UKUPNO:" },
                    { "Kolicina", lagerStanje.Sum(x => x.Kolicina) },
                    { "Pakovanje", lagerStanje.Where(x => !string.IsNullOrEmpty(x.Pakovanje)).Sum(x => decimal.TryParse(x.Pakovanje, out var val) ? val : 0) },
                    { "ZaNajavljeneUtovare", lagerStanje.Where(x => !string.IsNullOrEmpty(x.ZaNajavljeneUtovare)).Sum(x => decimal.TryParse(x.ZaNajavljeneUtovare, out var val) ? val : 0) },
                    { "Lot", lagerStanje.Where(x => !string.IsNullOrEmpty(x.Lot)).Sum(x => decimal.TryParse(x.Lot, out var val) ? val : 0) }
                };

                var excelData = ExportService.ExportToExcelWithColumns(lagerStanje, columns, totals);
                var fileName = TypeMapping.GenerateExportFileName("ambalaza_kutije", SystemConstants.Export.EXCEL_EXTENSION);
                await DownloadFile(excelData, fileName, SystemConstants.Export.EXCEL_MIME_TYPE);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Greška pri exportu u Excel: {ex.Message}");
        }
    }

    private async Task ExportToPdf()
    {
        try
        {
            if (lagerStanje != null && lagerStanje.Any())
            {
                // Definiši samo kolone koje se prikazuju u tabeli
                var columns = new Dictionary<string, string>
                {
                    { "Artikal", "Artikal" },
                    { "Kolicina", "Količina" },
                    { "Pakovanje", "U Proizvodnji" },
                    { "ZaNajavljeneUtovare", "Za najavljene Utovare" },
                    { "Lot", "Dostupno" }
                };

                // Dodaj totale na dnu
                var totals = new Dictionary<string, object>
                {
                    { "Artikal", "UKUPNO:" },
                    { "Kolicina", lagerStanje.Sum(x => x.Kolicina) },
                    { "Pakovanje", lagerStanje.Where(x => !string.IsNullOrEmpty(x.Pakovanje)).Sum(x => decimal.TryParse(x.Pakovanje, out var val) ? val : 0) },
                    { "ZaNajavljeneUtovare", lagerStanje.Where(x => !string.IsNullOrEmpty(x.ZaNajavljeneUtovare)).Sum(x => decimal.TryParse(x.ZaNajavljeneUtovare, out var val) ? val : 0) },
                    { "Lot", lagerStanje.Where(x => !string.IsNullOrEmpty(x.Lot)).Sum(x => decimal.TryParse(x.Lot, out var val) ? val : 0) }
                };

                var pdfData = ExportService.ExportToPdfWithColumns(lagerStanje, columns, totals);
                var fileName = TypeMapping.GenerateExportFileName("ambalaza_kutije", SystemConstants.Export.PDF_EXTENSION);
                await DownloadFile(pdfData, fileName, SystemConstants.Export.PDF_MIME_TYPE);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Greška pri exportu u PDF: {ex.Message}");
        }
    }

    private async Task ExportToExcelKese()
    {
        try
        {
            if (keseStanje != null && keseStanje.Any())
            {
                // Definiši samo kolone koje se prikazuju u tabeli
                var columns = new Dictionary<string, string>
                {
                    { "Artikal", "Artikal" },
                    { "Kolicina", "Količina" },
                    { "Pakovanje", "U Proizvodnji" },
                    { "ZaNajavljeneUtovare", "Za najavljene Utovare" },
                    { "Lot", "Dostupno" }
                };

                // Dodaj totale na dnu
                var totals = new Dictionary<string, object>
                {
                    { "Artikal", "UKUPNO:" },
                    { "Kolicina", keseStanje.Sum(x => x.Kolicina) },
                    { "Pakovanje", keseStanje.Where(x => !string.IsNullOrEmpty(x.Pakovanje)).Sum(x => decimal.TryParse(x.Pakovanje, out var val) ? val : 0) },
                    { "ZaNajavljeneUtovare", keseStanje.Where(x => !string.IsNullOrEmpty(x.ZaNajavljeneUtovare)).Sum(x => decimal.TryParse(x.ZaNajavljeneUtovare, out var val) ? val : 0) },
                    { "Lot", keseStanje.Where(x => !string.IsNullOrEmpty(x.Lot)).Sum(x => decimal.TryParse(x.Lot, out var val) ? val : 0) }
                };

                var excelData = ExportService.ExportToExcelWithColumns(keseStanje, columns, totals);
                var fileName = TypeMapping.GenerateExportFileName("ambalaza_kese", SystemConstants.Export.EXCEL_EXTENSION);
                await DownloadFile(excelData, fileName, SystemConstants.Export.EXCEL_MIME_TYPE);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Greška pri exportu u Excel: {ex.Message}");
        }
    }

    private async Task ExportToPdfKese()
    {
        try
        {
            if (keseStanje != null && keseStanje.Any())
            {
                // Definiši samo kolone koje se prikazuju u tabeli
                var columns = new Dictionary<string, string>
                {
                    { "Artikal", "Artikal" },
                    { "Kolicina", "Količina" },
                    { "Pakovanje", "U Proizvodnji" },
                    { "ZaNajavljeneUtovare", "Za najavljene Utovare" },
                    { "Lot", "Dostupno" }
                };

                // Dodaj totale na dnu
                var totals = new Dictionary<string, object>
                {
                    { "Artikal", "UKUPNO:" },
                    { "Kolicina", keseStanje.Sum(x => x.Kolicina) },
                    { "Pakovanje", keseStanje.Where(x => !string.IsNullOrEmpty(x.Pakovanje)).Sum(x => decimal.TryParse(x.Pakovanje, out var val) ? val : 0) },
                    { "ZaNajavljeneUtovare", keseStanje.Where(x => !string.IsNullOrEmpty(x.ZaNajavljeneUtovare)).Sum(x => decimal.TryParse(x.ZaNajavljeneUtovare, out var val) ? val : 0) },
                    { "Lot", keseStanje.Where(x => !string.IsNullOrEmpty(x.Lot)).Sum(x => decimal.TryParse(x.Lot, out var val) ? val : 0) }
                };

                var pdfData = ExportService.ExportToPdfWithColumns(keseStanje, columns, totals);
                var fileName = TypeMapping.GenerateExportFileName("ambalaza_kese", SystemConstants.Export.PDF_EXTENSION);
                await DownloadFile(pdfData, fileName, SystemConstants.Export.PDF_MIME_TYPE);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Greška pri exportu u PDF: {ex.Message}");
        }
    }

    private async Task DownloadFile(byte[] data, string fileName, string mimeType)
    {
        await JSRuntime.InvokeVoidAsync("downloadFile", Convert.ToBase64String(data), fileName, mimeType);
    }
}
