@page "/efikasnost-poslovodja"
@using FruitSysWeb.Models
@using FruitSysWeb.Services.Interfaces
@inject IEfikasnostService EfikasnostService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Efikasnost Poslovođa</PageTitle>

@if (!straniceUcitana)
{
    <div class="d-flex justify-content-center align-items-center" style="height:200px;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Učitavanje...</span>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-3">
        <div class="d-flex align-items-center mb-3">
            <i class="bi bi-person-check text-primary me-2" style="font-size:1.4rem;"></i>
            <h4 class="mb-0 fw-bold">Efikasnost Poslovođa po Smeni</h4>
        </div>

        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <button class="nav-link @(aktivniTab == 1 ? "active" : "")" @onclick="() => aktivniTab = 1">
                    <i class="bi bi-table me-1"></i>Pregled po poslovođi
                </button>
            </li>
            @if (detaljiPoslovodja != null)
            {
                <li class="nav-item">
                    <button class="nav-link @(aktivniTab == 2 ? "active" : "")">
                        <i class="bi bi-list-ul me-1"></i>Detalji — @detaljiPoslovodjaIme
                    </button>
                </li>
            }
        </ul>

        <!-- ═══════════════════════════════════ TAB 1 ═══ -->
        @if (aktivniTab == 1)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-2">
                            <label class="form-label fw-semibold small">Od datuma</label>
                            <input type="date" class="form-control form-control-sm" @bind="filter.OdDatum" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold small">Do datuma</label>
                            <input type="date" class="form-control form-control-sm" @bind="filter.DoDatum" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">Poslovođa</label>
                            <select class="form-select form-select-sm" @bind="filterPoslovodjaId">
                                <option value="">— Svi —</option>
                                @foreach (var p in poslovodje)
                                {
                                    <option value="@p.ID">@p.ImePrezime</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold small">Smena</label>
                            <select class="form-select form-select-sm" @bind="filterSmena">
                                <option value="">— Sve —</option>
                                <option value="1">I (dan)</option>
                                <option value="2">II (noć)</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-primary btn-sm" @onclick="PrikaziPregled" disabled="@ucitavanje">
                                @if (ucitavanje)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                <i class="bi bi-filter me-1"></i>Prikaži
                            </button>
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="OcistiFiltere">
                                <i class="bi bi-x-circle me-1"></i>Resetuj
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(greska))
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle me-1"></i>@greska
                </div>
            }

            @if (rezultati != null)
            {
                <!-- Sažetak -->
                <div class="row g-2 mb-3">
                    <div class="col-auto">
                        <div class="card shadow-sm border-0 bg-light px-3 py-2">
                            <small class="text-muted">Poslovođa</small>
                            <div class="fw-bold fs-5">@rezultati.Count</div>
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="card shadow-sm border-0 bg-primary bg-opacity-10 px-3 py-2">
                            <small class="text-muted">Ukupno smena</small>
                            <div class="fw-bold fs-5">@rezultati.Sum(x => x.BrojSmena)</div>
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="card shadow-sm border-0 bg-info bg-opacity-10 px-3 py-2">
                            <small class="text-muted">Ukupno radnika·sati</small>
                            <div class="fw-bold fs-5">@rezultati.Sum(x => x.UkupnoRadnikaSati).ToString("N0", srLatn)</div>
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="card shadow-sm border-0 bg-success bg-opacity-10 px-3 py-2">
                            <small class="text-muted">Ukupno evidencija</small>
                            <div class="fw-bold fs-5">@rezultati.Sum(x => x.BrojEvidencija)</div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Poslovođa</th>
                                        <th class="text-center">Br. smena</th>
                                        <th class="text-end">Ukupno rad.·sati</th>
                                        <th class="text-end">Prosek rad.·sati/smeni</th>
                                        <th class="text-end">Prosek radnika/smeni</th>
                                        <th class="text-center">Br. evid.</th>
                                        <th class="text-center">Br. RN</th>
                                        <th class="text-end">Gotov proizvod</th>
                                        <th class="text-end">GP/rad.satu</th>
                                        <th class="text-end">GP/radniku</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var maxSati = rezultati.Any() ? rezultati.Max(x => x.UkupnoRadnikaSati) : 1m; }
                                    @foreach (var r in rezultati)
                                    {
                                        var procenat = maxSati > 0 ? (double)(r.UkupnoRadnikaSati / maxSati * 100) : 0;
                                        <tr>
                                            <td class="fw-semibold">@r.Poslovodja</td>
                                            <td class="text-center">@r.BrojSmena</td>
                                            <td class="text-end">
                                                <div class="d-flex align-items-center justify-content-end gap-2">
                                                    <div style="width:60px;">
                                                        <div class="progress" style="height:6px;">
                                                            <div class="progress-bar bg-primary" style="width:@procenat.ToString("F0")%"></div>
                                                        </div>
                                                    </div>
                                                    <span class="small fw-semibold">@((int)Math.Round(r.UkupnoRadnikaSati))</span>
                                                </div>
                                            </td>
                                            <td class="text-end small">@r.ProsecnoRadnikaSatiPoSmeni</td>
                                            <td class="text-end small">@r.ProsecnoBrojRadnikaPoSmeni</td>
                                            <td class="text-center small">@r.BrojEvidencija</td>
                                            <td class="text-center small">@r.BrojRadnihNaloga</td>
                                            <td class="text-end small fw-semibold">@r.GotovProizvod.ToString("N0", srLatn)</td>
                                            <td class="text-end small">@r.GotovProizvodPoRadnomSatu</td>
                                            <td class="text-end small">@r.GotovProizvodPoRadniku</td>
                                            <td>
                                                <button class="btn btn-outline-primary btn-sm py-0"
                                                        title="Pogledaj detalje smena"
                                                        @onclick="() => OtvoriDetalje(r)">
                                                    <i class="bi bi-zoom-in"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light fw-semibold">
                                    <tr>
                                        <td>Ukupno</td>
                                        <td class="text-center">@rezultati.Sum(x => x.BrojSmena)</td>
                                        <td class="text-end">@((int)Math.Round(rezultati.Sum(x => x.UkupnoRadnikaSati)))</td>
                                        <td></td>
                                        <td></td>
                                        <td class="text-center">@rezultati.Sum(x => x.BrojEvidencija)</td>
                                        <td class="text-center">@rezultati.Sum(x => x.BrojRadnihNaloga)</td>
                                        <td class="text-end">@rezultati.Sum(x => x.GotovProizvod).ToString("N0", srLatn)</td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            }
        }

        <!-- ═══════════════════════════════════ TAB 2 ═══ -->
        @if (aktivniTab == 2 && detaljiPoslovodja != null)
        {
            <div class="card shadow-sm mb-3 border-primary">
                <div class="card-body py-2">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <span class="fw-bold text-primary">
                            <i class="bi bi-person me-1"></i>@detaljiPoslovodjaIme
                        </span>
                        <span class="text-muted small">
                            @(filter.OdDatum.HasValue ? filter.OdDatum.Value.ToString("dd.MM.yyyy") : "—")
                            –
                            @(filter.DoDatum.HasValue ? filter.DoDatum.Value.ToString("dd.MM.yyyy") : "—")
                        </span>
                        <span class="badge bg-primary">@detaljiPoslovodja.Count smena</span>
                        <span class="badge bg-info text-dark">
                            @detaljiPoslovodja.Sum(x => x.UkupnoRadnikaSati).ToString("N1", srLatn) rad.·sati ukupno
                        </span>
                        <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => aktivniTab = 1">
                            <i class="bi bi-arrow-left me-1"></i>Nazad
                        </button>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Smenski izv.</th>
                                    <th>Datum</th>
                                    <th class="text-center">Smena</th>
                                    <th class="text-center">Br. evid.</th>
                                    <th class="text-center">Br. RN</th>
                                    <th class="text-end">Radnika·sati</th>
                                    <th class="text-end">Br. radnika</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in detaljiPoslovodja)
                                {
                                    <tr>
                                        <td class="small fw-semibold">@s.SmenskiBroj</td>
                                        <td class="small text-muted">@s.Datum.ToString("dd.MM.yyyy")</td>
                                        <td class="text-center">
                                            <span class="badge @(s.Smena == 1 ? "bg-warning text-dark" : "bg-secondary")">
                                                @(s.Smena == 1 ? "I dan" : "II noć")
                                            </span>
                                        </td>
                                        <td class="text-center small">@s.BrojEvidencija</td>
                                        <td class="text-center small">@s.BrojRadnihNaloga</td>
                                        <td class="text-end small fw-semibold">@s.UkupnoRadnikaSati.ToString("N1", srLatn)</td>
                                        <td class="text-end small">@s.UkupnoBrojRadnika.ToString("N0", srLatn)</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light fw-semibold">
                                <tr>
                                    <td colspan="3">Ukupno</td>
                                    <td class="text-center">@detaljiPoslovodja.Sum(x => x.BrojEvidencija)</td>
                                    <td class="text-center">@detaljiPoslovodja.Sum(x => x.BrojRadnihNaloga)</td>
                                    <td class="text-end">@detaljiPoslovodja.Sum(x => x.UkupnoRadnikaSati).ToString("N1", srLatn)</td>
                                    <td class="text-end">@detaljiPoslovodja.Sum(x => x.UkupnoBrojRadnika).ToString("N0", srLatn)</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                @if (detaljiPoslovodja.Count >= 500)
                {
                    <div class="card-footer text-muted small text-center py-1">
                        <i class="bi bi-info-circle me-1"></i>Prikazano je maksimalno 500 smena.
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo srLatn =
        System.Globalization.CultureInfo.GetCultureInfo("sr-Latn-RS");

    private bool straniceUcitana = false;
    private int aktivniTab = 1;

    private EfikasnostFilter filter = new() { OdDatum = DateTime.Today.AddDays(-30), DoDatum = DateTime.Today };
    private string filterPoslovodjaId = "";
    private string filterSmena = "";
    private List<EfikasnostPoslovodjeModel>? rezultati;
    private bool ucitavanje = false;
    private string? greska;

    // Detalji — tab 2
    private List<EfikasnostSmenaDetaljiModel>? detaljiPoslovodja;
    private string detaljiPoslovodjaIme = "";

    private List<(long ID, string ImePrezime)> poslovodje = new();

    protected override async Task OnInitializedAsync()
    {
        var korisnik = await AuthService.GetCurrentUser();
        if (korisnik == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try { poslovodje = await EfikasnostService.UcitajPoslovodje(); }
        catch { }

        straniceUcitana = true;
    }

    private async Task PrikaziPregled()
    {
        greska = null;
        filter.PoslovodjaID = string.IsNullOrEmpty(filterPoslovodjaId) ? null : long.Parse(filterPoslovodjaId);
        filter.Smena = string.IsNullOrEmpty(filterSmena) ? null : int.Parse(filterSmena);

        ucitavanje = true;
        try
        {
            rezultati = await EfikasnostService.UcitajEfikasnostPoslovodja(filter);
        }
        catch (Exception ex)
        {
            greska = $"Greška pri učitavanju: {ex.Message}";
        }
        finally
        {
            ucitavanje = false;
        }
    }

    private async Task OtvoriDetalje(EfikasnostPoslovodjeModel red)
    {
        detaljiPoslovodjaIme = red.Poslovodja;
        try
        {
            detaljiPoslovodja = await EfikasnostService.UcitajDetaljeSmena(red.PoslovodjaID, filter);
            aktivniTab = 2;
        }
        catch (Exception ex)
        {
            greska = $"Greška pri učitavanju detalja: {ex.Message}";
        }
    }

    private void OcistiFiltere()
    {
        filter = new() { OdDatum = DateTime.Today.AddDays(-30), DoDatum = DateTime.Today };
        filterPoslovodjaId = "";
        filterSmena = "";
        rezultati = null;
        detaljiPoslovodja = null;
        greska = null;
        aktivniTab = 1;
    }
}
