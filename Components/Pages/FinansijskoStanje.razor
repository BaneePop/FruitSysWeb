@page "/finansijsko-stanje"
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Models.Requests
@using FruitSysWeb.Models
@using FruitSysWeb.Services.Core
@inject IFinansijeService FinansijeService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject ILogger<FinansijskoStanje> Logger

<!-- Header -->
<div class="bg-dark text-white py-3 mb-4">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="h3 mb-0">
                    <i class="bi bi-graph-up-arrow me-2"></i>Finansijsko Stanje
                </h1>
                <small class="text-muted">Pregled potraživanja i dugovanja po partnerima</small>
            </div>
            <div class="col-md-6 text-end">
                @if (aktivnaLista != null)
                {
                    <span class="badge bg-light text-dark fs-6 me-2">
                        <i class="bi bi-people me-1"></i>@aktivnaLista.Count partnera
                    </span>
                    <span class="badge bg-success fs-6 me-1">
                        Potražuju: @FormatBroj(aktivnaLista.Sum(x => x.Potrazuje)) RSD
                    </span>
                    <span class="badge bg-danger fs-6">
                        Dugujemo: @FormatBroj(aktivnaLista.Sum(x => x.Duguje)) RSD
                    </span>
                }
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">

    <!-- Filter -->
    <div class="card border-primary mb-4">
        <div class="card-header bg-primary text-white">
            <h6 class="mb-0"><i class="bi bi-funnel me-2"></i>Period i filteri</h6>
        </div>
        <div class="card-body">
            <div class="row align-items-end">
                <div class="col-md-3 mb-2">
                    <label class="form-label fw-bold">Od datuma:</label>
                    <input type="date" class="form-control" value="@OdDatumValue" @onchange="OnOdDatumChanged" />
                </div>
                <div class="col-md-3 mb-2">
                    <label class="form-label fw-bold">Do datuma:</label>
                    <input type="date" class="form-control" value="@DoDatumValue" @onchange="OnDoDatumChanged" />
                </div>
                <div class="col-md-3 mb-2">
                    <label class="form-label fw-bold">Minimalni saldo (RSD):</label>
                    <input type="number" class="form-control" @bind="minimumStanje" min="0" step="1000" />
                </div>
                <div class="col-md-3 mb-2">
                    <button class="btn btn-primary w-100" @onclick="Ucitaj" disabled="@ucitava">
                        @if (ucitava)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        else
                        {
                            <i class="bi bi-search me-1"></i>
                        }
                        Pretraži
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabovi -->
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item">
            <button class="nav-link @(aktivniTab == "dobavljac" ? "active" : "")"
                    @onclick='() => PromenTab("dobavljac")'>
                <i class="bi bi-truck me-1"></i>Dobavljači
                @if (dobavljaci != null)
                {
                    <span class="badge bg-secondary ms-1">@dobavljaci.Count</span>
                }
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(aktivniTab == "kupac" ? "active" : "")"
                    @onclick='() => PromenTab("kupac")'>
                <i class="bi bi-cart-check me-1"></i>Kupci
                @if (kupci != null)
                {
                    <span class="badge bg-secondary ms-1">@kupci.Count</span>
                }
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(aktivniTab == "proizvodjac" ? "active" : "")"
                    @onclick='() => PromenTab("proizvodjac")'>
                <i class="bi bi-factory me-1"></i>Proizvođači
                @if (proizvodjaci != null)
                {
                    <span class="badge bg-secondary ms-1">@proizvodjaci.Count</span>
                }
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(aktivniTab == "otkupljivac" ? "active" : "")"
                    @onclick='() => PromenTab("otkupljivac")'>
                <i class="bi bi-box-arrow-in-down me-1"></i>Otkupljivači
                @if (otkupljivaci != null)
                {
                    <span class="badge bg-secondary ms-1">@otkupljivaci.Count</span>
                }
            </button>
        </li>
    </ul>

    <!-- Sadržaj -->
    @if (ucitava)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Učitavanje podataka...</p>
        </div>
    }
    else if (aktivnaLista == null)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>Kliknite <strong>Pretraži</strong> da učitate podatke.
        </div>
    }
    else if (!aktivnaLista.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Nema partnera sa saldom većim od @FormatBroj(minimumStanje) RSD u izabranom periodu.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width:40px">#</th>
                        <th>Naziv</th>
                        <th class="text-end">Potražuje (RSD)</th>
                        <th class="text-end">Duguje (RSD)</th>
                        <th class="text-end fw-bold">Saldo (RSD)</th>
                        <th class="text-center">Zadnja promena</th>
                        <th class="text-center">Čekanje</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rbr = 0; }
                    @foreach (var red in aktivnaLista)
                    {
                        rbr++;
                        <tr>
                            <td class="text-muted small">@rbr</td>
                            <td>
                                <a href="/kartica-komitenta?komitentId=@red.KomitentID" class="text-decoration-none fw-semibold">
                                    @red.Naziv
                                </a>
                            </td>
                            <td class="text-end text-success">@red.PotrazujeFormatted</td>
                            <td class="text-end text-danger">@red.DugujeFormatted</td>
                            <td class="text-end">
                                <span class="@red.SaldoTextClass">@red.SaldoFormatted</span>
                            </td>
                            <td class="text-center small">@red.DatumFormatted</td>
                            <td class="text-center">
                                @if (red.DatumZadnjePromene.HasValue)
                                {
                                    <span class="badge @red.KasnjenjeBadgeClass">
                                        @red.DanaCekanja d
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-secondary fw-bold">
                    <tr>
                        <td colspan="2">Ukupno (@aktivnaLista.Count partnera)</td>
                        <td class="text-end text-success">@FormatBroj(aktivnaLista.Sum(x => x.Potrazuje))</td>
                        <td class="text-end text-danger">@FormatBroj(aktivnaLista.Sum(x => x.Duguje))</td>
                        <td class="text-end @(aktivnaLista.Sum(x => x.Saldo) >= 0 ? "text-success" : "text-danger")">
                            @FormatBroj(aktivnaLista.Sum(x => x.Saldo))
                        </td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }

</div>

@code {
    private string aktivniTab = "dobavljac";
    private decimal minimumStanje = 10000;
    private bool ucitava = false;

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUser();
        if (user == null || !user.ImaPristupStranici("/finansijsko-stanje"))
            NavigationManager.NavigateTo("/", true);
    }

    private List<FinansijskoStanjeModel>? dobavljaci;
    private List<FinansijskoStanjeModel>? kupci;
    private List<FinansijskoStanjeModel>? proizvodjaci;
    private List<FinansijskoStanjeModel>? otkupljivaci;

    private List<FinansijskoStanjeModel>? aktivnaLista => aktivniTab switch
    {
        "dobavljac"   => dobavljaci,
        "kupac"       => kupci,
        "proizvodjac" => proizvodjaci,
        "otkupljivac" => otkupljivaci,
        _ => null
    };

    private FilterRequest filterRequest = new FilterRequest
    {
        OdDatum = new DateTime(2022, 1, 1),
        DoDatum = DateTime.Now.Date
    };

    private string OdDatumValue => filterRequest.OdDatum?.ToString("yyyy-MM-dd") ?? "2022-01-01";
    private string DoDatumValue => filterRequest.DoDatum?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd");

    private void OnOdDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
            filterRequest.OdDatum = d;
    }

    private void OnDoDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
            filterRequest.DoDatum = d;
    }

    private async Task Ucitaj()
    {
        ucitava = true;
        try
        {
            var tasks = new[]
            {
                FinansijeService.UcitajFinansijskoStanje(filterRequest, "dobavljac", minimumStanje)
                    .ContinueWith(t => dobavljaci = t.Result),
                FinansijeService.UcitajFinansijskoStanje(filterRequest, "kupac", minimumStanje)
                    .ContinueWith(t => kupci = t.Result),
                FinansijeService.UcitajFinansijskoStanje(filterRequest, "proizvodjac", minimumStanje)
                    .ContinueWith(t => proizvodjaci = t.Result),
                FinansijeService.UcitajFinansijskoStanje(filterRequest, "otkupljivac", minimumStanje)
                    .ContinueWith(t => otkupljivaci = t.Result),
            };
            await Task.WhenAll(tasks);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška u Ucitaj FinansijskoStanje");
        }
        finally
        {
            ucitava = false;
        }
    }

    private void PromenTab(string tab)
    {
        aktivniTab = tab;
    }

    private static string FormatBroj(decimal v) =>
        v.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("sr-Latn-RS"));
}
