@page "/"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Models.Requests
@using FruitSysWeb.Components.Charts
@using FruitSysWeb.Components.Shared.Layout
@using FruitSysWeb.Services.Core

@inject IFinansijeService FinansijeService
@inject IProizvodnjaService ProizvodnjaService
@inject IMagacinLagerService LagerService
@inject IExportService exportService
@inject NavigationManager NavigationManager
@inject ITypeMappingService TypeMapping

<style>
    .main-header {
        background: linear-gradient(135deg, #0f5132, #198754, #20c997);
        border-radius: 15px;
        margin-bottom: 2.5rem;
        box-shadow: 0 6px 20px rgba(0,0,0,0.15);
    }
    
    .section-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 2rem;
        margin-bottom: 2.5rem;
    }
    
    .main-section {
        background: white;
        border-radius: 15px;
        padding: 2.5rem;
        text-align: center;
        box-shadow: 0 8px 30px rgba(0,0,0,0.1);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: none;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .main-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, #198754, #20c997);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.4s ease;
    }

    .main-section:hover::before {
        transform: scaleX(1);
    }
    
    .main-section:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 15px 40px rgba(0,0,0,0.2);
    }
    
    .section-icon-main {
        font-size: 4rem;
        margin-bottom: 2rem;
        background: linear-gradient(135deg, #198754, #20c997);
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        transition: all 0.3s ease;
    }

    .main-section:hover .section-icon-main {
        transform: scale(1.1);
    }
    
    .section-title-main {
        font-weight: 800;
        color: #0f5132;
        margin-bottom: 1rem;
        font-size: 1.5rem;
    }
    
    .section-description-main {
        color: #6c757d;
        margin-bottom: 2rem;
        line-height: 1.7;
        font-size: 1.05rem;
    }
    
    .section-features-main {
        list-style: none;
        padding: 0;
        text-align: left;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
    }
    
    .section-features-main li {
        padding: 0.4rem 0;
        color: #495057;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
    }
    
    .section-features-main li i {
        color: #198754;
        margin-right: 0.7rem;
        font-size: 1rem;
    }

    .stats-overview {
        background: white;
        border-radius: 15px;
        padding: 2rem;
        box-shadow: 0 6px 20px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }

    .stats-grid-main {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
    }

    .stat-card-main {
        background: linear-gradient(135deg, #f8f9fa, #ffffff);
        border-radius: 12px;
        padding: 1.5rem;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        border-left: 4px solid #198754;
    }

    .stat-card-main:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }

    .stat-value-main {
        font-size: 1.6rem;
        font-weight: 800;
        color: #0f5132;
        display: block;
        margin-bottom: 0.5rem;
    }

    .stat-label-main {
        font-size: 0.9rem;
        color: #6c757d;
        font-weight: 500;
    }

    .welcome-text {
        text-align: center;
        margin-bottom: 2rem;
        padding: 1.5rem;
        background: linear-gradient(135deg, rgba(25, 135, 84, 0.05), rgba(32, 201, 151, 0.05));
        border-radius: 12px;
        border: 1px solid rgba(25, 135, 84, 0.1);
    }

    .welcome-title {
        font-size: 1.3rem;
        font-weight: 600;
        color: #0f5132;
        margin-bottom: 0.5rem;
    }

    .welcome-subtitle {
        color: #6c757d;
        font-size: 1rem;
    }

    media (max-width: 768px) {
        .section-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .section-features-main {
            grid-template-columns: 1fr;
        }

        .main-section {
            padding: 1.5rem;
        }

        .section-icon-main {
            font-size: 3rem;
        }
    }
</style>

<!-- Header -->
<div class="main-header text-white py-5 mb-4">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 mb-2 fw-bold">
                    <i class="bi bi-speedometer2 me-3"></i>FruitSysWeb Dashboard
                </h1>
                <p class="lead mb-0">Integrisani sistem za upravljanje voćnom proizvodnjom</p>
            </div>
            <div class="col-md-4 text-end">
                <div class="text-white-50">
                    <i class="bi bi-calendar-event me-2"></i>@DateTime.Now.ToString("dd.MM.yyyy")
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <!-- Welcome Section -->
    <div class="welcome-text">
        <div class="welcome-title">Dobrodošli u FruitSysWeb</div>
        <div class="welcome-subtitle">Izaberite sekciju za nastavak rada sa sistemom</div>
    </div>

    <!-- Quick Stats Overview -->
    <div class="stats-overview">
        <h5 class="mb-3">
            <i class="bi bi-graph-up me-2"></i>Ključni pokazatelje (zadnjih 30 dana)
        </h5>
        <div class="stats-grid-main">
            <div class="stat-card-main" style="border-left-color: #198754;">
                <span class="stat-value-main">@TypeMapping.FormatCurrency(ukupnoSaldo)</span>
                <div class="stat-label-main">Ukupno Saldo</div>
            </div>
            <div class="stat-card-main" style="border-left-color: #6f42c1;">
                <span class="stat-value-main">@TypeMapping.FormatCurrency(ukupnaVrednostLager)</span>
                <div class="stat-label-main">Vrednost Lagera</div>
            </div>
            <div class="stat-card-main" style="border-left-color: #fd7e14;">
                <span class="stat-value-main">@TypeMapping.FormatWeight(ukupnaProizvodnja)</span>
                <div class="stat-label-main">Proizvodnja (7 dana)</div>
            </div>
            <div class="stat-card-main" style="border-left-color: #dc3545;">
                <span class="stat-value-main">@brojAktivnihNaloga</span>
                <div class="stat-label-main">Aktivni Nalozi</div>
            </div>
        </div>
    </div>

    <!-- Main Sections -->
    <div class="section-grid">
        <!-- 1. Prerada Home -->
        <div class="main-section" onclick="() => NavigateTo('/preradahome')">
            <div class="section-icon-main">
                <i class="bi bi-gear-wide-connected"></i>
            </div>
            <h3 class="section-title-main">Prerada</h3>
            <p class="section-description-main">
                Upravljanje proizvodnim procesima, radnim nalozima i smenskim izveštajima
            </p>
            <ul class="section-features-main">
                <li><i class="bi bi-check-circle"></i>Proizvodnja</li>
                <li><i class="bi bi-check-circle"></i>Lager proizvodnje</li>
                <li><i class="bi bi-check-circle"></i>Radni nalozi</li>
                <li><i class="bi bi-check-circle"></i>Smenski izveštaji</li>
                <li><i class="bi bi-check-circle"></i>Evidencija rada</li>
                <li><i class="bi bi-check-circle"></i>Efikasnost procesa</li>
            </ul>
        </div>

        <!-- 2. Finansije Home -->
        <div class="main-section" onclick="() => NavigateTo('/finansijehome')">
            <div class="section-icon-main">
                <i class="bi bi-cash-stack"></i>
            </div>
            <h3 class="section-title-main">Promet i Finansije</h3>
            <p class="section-description-main">
                Centralizirano upravljanje finansijskim tokovima i prometom
            </p>
            <ul class="section-features-main">
                <li><i class="bi bi-check-circle"></i>Finansijski pregledi</li>
                <li><i class="bi bi-check-circle"></i>Ulaz-Izlaz dokumenti</li>
                <li><i class="bi bi-check-circle"></i>Saldo analiza</li>
                <li><i class="bi bi-check-circle"></i>Top kupci/dobavljači</li>
                <li><i class="bi bi-check-circle"></i>Mesečne analize</li>
                <li><i class="bi bi-check-circle"></i>Export izveštaja</li>
            </ul>
        </div>

        <!-- 3. Lager Home -->
        <div class="main-section" onclick="() => NavigateTo('/lagerhome')">
            <div class="section-icon-main">
                <i class="bi bi-boxes"></i>
            </div>
            <h3 class="section-title-main">Lager</h3>
            <p class="section-description-main">
                Upravljanje magacinskim operacijama i zalihama sirovina i gotovih proizvoda
            </p>
            <ul class="section-features-main">
                <li><i class="bi bi-check-circle"></i>Magacin lager</li>
                <li><i class="bi bi-check-circle"></i>Lager proizvodnje</li>
                <li><i class="bi bi-check-circle"></i>Stanje sirovina</li>
                <li><i class="bi bi-check-circle"></i>Gotovi proizvodi</li>
                <li><i class="bi bi-check-circle"></i>Ambalažni materijal</li>
                <li><i class="bi bi-check-circle"></i>Status indikatori</li>
            </ul>
        </div>
    </div>

    <!-- Charts Section (Existing Dashboard Analytics) -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent">
                    <h5 class="mb-0">
                        <i class="bi bi-bar-chart me-2"></i>Analitika i pregled
                    </h5>
                </div>
                <div class="card-body">
                    <DashboardCharts />
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private decimal ukupnoSaldo = 0;
    private decimal ukupnaVrednostLager = 0;
    private decimal ukupnaProizvodnja = 0;
    private int brojAktivnihNaloga = 0;

    protected override async Task OnInitializedAsync()
    {
        await UcitajStatistike();
    }

    private async Task UcitajStatistike()
    {
        try
        {
            // Filter za ukupno saldo (zadnji mesec)
            var filterMesec = new FilterRequest
            {
                OdDatum = DateTime.Now.AddMonths(-1),
                DoDatum = DateTime.Now
            };

            ukupnoSaldo = await FinansijeService.UcitajUkupnoSaldo(filterMesec);
            ukupnaProizvodnja = await ProizvodnjaService.UcitajGotoveProizvodePoslednjihDana(7);
            brojAktivnihNaloga = await ProizvodnjaService.UcitajBrojAktivnihNaloga(filterMesec);
            ukupnaVrednostLager = await LagerService.UcitajUkupnuVrednostLager();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška pri učitavanju statistika: {ex.Message}");
            
            // Fallback podaci
            ukupnoSaldo = 1250000;
            ukupnaVrednostLager = 2150000;
            ukupnaProizvodnja = 8500;
            brojAktivnihNaloga = 12;
        }
    }

    private void NavigateTo(string url)
    {
        NavigationManager.NavigateTo(url);
    }
}