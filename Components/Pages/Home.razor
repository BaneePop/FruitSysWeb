@page "/"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Models.Requests
@using FruitSysWeb.Components.Charts
@using FruitSysWeb.Components.Shared.Layout
@using FruitSysWeb.Services.Core
@using FruitSysWeb.Models

@inject IFinansijeService FinansijeService
@inject IProizvodnjaService ProizvodnjaService
@inject IMagacinLagerService LagerService
@inject IExportService exportService
@inject NavigationManager NavigationManager
@inject ITypeMappingService TypeMapping
@inject IPreradaService PreradaService

<style>
    .main-header {
        background: linear-gradient(135deg, #1a2332, #232d3f, #2a3441);
        border-radius: 15px;
        margin-bottom: 2.5rem;
        box-shadow: 0 6px 20px rgba(0,0,0,0.3);
        border: 1px solid #374151;
    }
    
    .section-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 2rem;
        margin-bottom: 2.5rem;
    }
    
    .main-section {
        background: #1a2332;
        border-radius: 15px;
        padding: 2.5rem;
        text-align: center;
        box-shadow: 0 8px 30px rgba(0,0,0,0.3);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 1px solid #374151;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .main-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, #198754, #20c997);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.4s ease;
    }

    .main-section:hover::before {
        transform: scaleX(1);
    }
    
    .main-section:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 15px 40px rgba(0,0,0,0.2);
    }
    
    .section-icon-main {
        font-size: 4rem;
        margin-bottom: 2rem;
        background: linear-gradient(135deg, #198754, #20c997);
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        transition: all 0.3s ease;
    }

    .main-section:hover .section-icon-main {
        transform: scale(1.1);
    }
    
    .section-title-main {
        font-weight: 800;
        color: #e5e7eb;
        margin-bottom: 1rem;
        font-size: 1.5rem;
    }
    
    .section-description-main {
        color: #9ca3af;
        margin-bottom: 2rem;
        line-height: 1.7;
        font-size: 1.05rem;
    }
    
    .section-features-main {
        list-style: none;
        padding: 0;
        text-align: left;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
    }
    
    .section-features-main li {
        padding: 0.4rem 0;
        color: #9ca3af;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
    }
    
    .section-features-main li i {
        color: #198754;
        margin-right: 0.7rem;
        font-size: 1rem;
    }

    .welcome-text {
        text-align: center;
        margin-bottom: 2rem;
        padding: 1.5rem;
        background: linear-gradient(135deg, rgba(25, 135, 84, 0.05), rgba(32, 201, 151, 0.05));
        border-radius: 12px;
        border: 1px solid rgba(25, 135, 84, 0.1);
    }

    .welcome-title {
        font-size: 1.3rem;
        font-weight: 600;
        color: #e5e7eb;
        margin-bottom: 0.5rem;
    }

    .welcome-subtitle {
        color: #9ca3af;
        font-size: 1rem;
    }

    @@media (max-width: 768px) {
        .section-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .section-features-main {
            grid-template-columns: 1fr;
        }

        .main-section {
            padding: 1.5rem;
        }

        .section-icon-main {
            font-size: 3rem;
        }
    }
</style>

<!-- Header -->
<div class="main-header text-white py-5 mb-4">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 mb-2 fw-bold">
                    <i class="bi bi-speedometer2 me-3"></i>FruitSysWeb Dashboard
                </h1>
                <p class="lead mb-0">Integrisani sistem za upravljanje voćnom proizvodnjom</p>
            </div>
            <div class="col-md-4 text-end">
                <div class="text-white-50">
                    <i class="bi bi-calendar-event me-2"></i>@DateTime.Now.ToString("dd.MM.yyyy")
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <!-- Welcome Section -->
    <div class="welcome-text">
        <div class="welcome-title">Dobrodošli u FruitSysWeb</div>
        <div class="welcome-subtitle">Izaberite sekciju za nastavak rada sa sistemom</div>
    </div>

    <!-- Main Sections -->
    <div class="section-grid">
        <!-- 1. Prerada Home -->
        <div class="main-section" @onclick="@(() => NavigateTo("/preradahome"))">
            <div class="section-icon-main">
                <i class="bi bi-gear-wide-connected"></i>
            </div>
            <h3 class="section-title-main">Prerada</h3>
            <p class="section-description-main">
                Upravljanje proizvodnim procesima, radnim nalozima i smenskim izveštajima
            </p>
            <ul class="section-features-main">
                <li><i class="bi bi-check-circle"></i>Proizvodnja</li>
                <li><i class="bi bi-check-circle"></i>Lager proizvodnje</li>
                <li><i class="bi bi-check-circle"></i>Radni nalozi</li>
                <li><i class="bi bi-check-circle"></i>Smenski izveštaji</li>
                <li><i class="bi bi-check-circle"></i>Evidencija rada</li>
                <li><i class="bi bi-check-circle"></i>Efikasnost procesa</li>
            </ul>
        </div>

        <!-- 2. Finansije Home -->
        <div class="main-section" @onclick="@(() => NavigateTo("/finansijehome"))">
            <div class="section-icon-main">
                <i class="bi bi-cash-stack"></i>
            </div>
            <h3 class="section-title-main">Promet i Finansije</h3>
            <p class="section-description-main">
                Centralizirano upravljanje finansijskim tokovima i prometom
            </p>
            <ul class="section-features-main">
                <li><i class="bi bi-check-circle"></i>Finansijski pregledi</li>
                <li><i class="bi bi-check-circle"></i>Ulaz-Izlaz dokumenti</li>
                <li><i class="bi bi-check-circle"></i>Saldo analiza</li>
                <li><i class="bi bi-check-circle"></i>Top kupci/dobavljači</li>
                <li><i class="bi bi-check-circle"></i>Mesečne analize</li>
                <li><i class="bi bi-check-circle"></i>Export izveštaja</li>
            </ul>
        </div>

        <!-- 3. Lager Home -->
        <div class="main-section" @onclick="@(() => NavigateTo("/lagerhome"))">
            <div class="section-icon-main">
                <i class="bi bi-boxes"></i>
            </div>
            <h3 class="section-title-main">Lager</h3>
            <p class="section-description-main">
                Upravljanje magacinskim operacijama i zalihama sirovina i gotovih proizvoda
            </p>
            <ul class="section-features-main">
                <li><i class="bi bi-check-circle"></i>Magacin lager</li>
                <li><i class="bi bi-check-circle"></i>Lager proizvodnje</li>
                <li><i class="bi bi-check-circle"></i>Stanje sirovina</li>
                <li><i class="bi bi-check-circle"></i>Gotovi proizvodi</li>
                <li><i class="bi bi-check-circle"></i>Ambalažni materijal</li>
                <li><i class="bi bi-check-circle"></i>Status indikatori</li>
            </ul>
        </div>

        <!-- 4. Troškovi Home -->
        <div class="main-section" @onclick="@(() => NavigateTo("/troskovihome"))">
            <div class="section-icon-main">
                <i class="bi bi-receipt-cutoff"></i>
            </div>
            <h3 class="section-title-main">Troškovi i Rashodi</h3>
            <p class="section-description-main">
                Praćenje troškova, rashoda i operativnih pokazatelja po kategorijama
            </p>
            <ul class="section-features-main">
                <li><i class="bi bi-check-circle"></i>Troškovi rada</li>
                <li><i class="bi bi-check-circle"></i>Troškovi materijala</li>
                <li><i class="bi bi-check-circle"></i>Režijski troškovi</li>
                <li><i class="bi bi-check-circle"></i>Troškovi transporta</li>
                <li><i class="bi bi-check-circle"></i>Mesečne analize</li>
                <li><i class="bi bi-check-circle"></i>Export izveštaja</li>
            </ul>
        </div>
    </div>

    <!-- Najavljeni Utovari Section -->
    <div class="row mt-4 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-truck me-2 text-primary"></i>Najavljeni Utovari (narednih 20 dana)
                    </h5>
                    @if (najavljeniUtovari != null)
                    {
                        <span class="badge bg-primary">@najavljeniUtovari.Count stavki</span>
                    }
                </div>
                <div class="card-body p-0">
                    @if (najavljeniUtovari == null)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Učitavanje...</span>
                            </div>
                            <p class="mt-3 text-muted">Učitavanje najavljenih utovara...</p>
                        </div>
                    }
                    else if (!najavljeniUtovari.Any())
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-calendar-check display-3 text-muted"></i>
                            <h5 class="mt-3 text-muted">Nema najavljenih utovara u narednih 20 dana</h5>
                            <p class="text-muted">Svi radni nalozi su isporučeni ili trenutno nema aktivnih naloga</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Radni nalog</th>
                                        <th>Datum utovara</th>
                                        <th>Dana</th>
                                        <th>Kupac</th>
                                        <th>Artikal</th>
                                        <th>Potrebna količina</th>
                                        <th>Lot</th>
                                        <th>Ugovor prodaja</th>
                                        <th>Prioritet</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var utovar in najavljeniUtovari)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge @utovar.StatusBadgeClass">@utovar.RadniNalog</span>
                                            </td>
                                            <td>
                                                <strong>@TypeMapping.FormatDate(utovar.DatumIsporuke ?? DateTime.MinValue)</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@utovar.DanaDoUtovara dana</span>
                                            </td>
                                            <td>@utovar.Kupac</td>
                                            <td>
                                                <span class="text-primary">@utovar.Artikal</span>
                                            </td>
                                            <td>
                                                <strong>@TypeMapping.FormatWeight(utovar.Kolicina)</strong>
                                            </td>
                                            <td>
                                                <code class="text-info">@(utovar.LotNaloga ?? "N/A")</code>
                                            </td>
                                            <td>
                                                <small class="text-muted">@(utovar.BrojUgovora ?? "N/A")</small>
                                            </td>
                                            <td>
                                                <span class="badge @utovar.UrgentnostBadgeClass">@utovar.StatusUrgentnosti</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section (Existing Dashboard Analytics) -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent">
                    <h5 class="mb-0">
                        <i class="bi bi-bar-chart me-2"></i>Analitika i pregled
                    </h5>
                </div>
                <div class="card-body">
                    <DashboardCharts />
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<NajavljeniUtovarModel>? najavljeniUtovari;

    protected override async Task OnInitializedAsync()
    {
        await UcitajNajavljeneUtovare();
    }

    private async Task UcitajNajavljeneUtovare()
    {
        try
        {
            najavljeniUtovari = await PreradaService.UcitajNajavljeneUtovare();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška pri učitavanju najavljenih utovara: {ex.Message}");
            najavljeniUtovari = new List<NajavljeniUtovarModel>();
        }
    }

    private void NavigateTo(string url)
    {
        NavigationManager.NavigateTo(url);
    }
}
