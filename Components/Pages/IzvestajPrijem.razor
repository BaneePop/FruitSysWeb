@page "/izvestaj-prijem"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode())
@using Microsoft.AspNetCore.Components.Web
@using ApexCharts
@using FruitSysWeb.Components.Charts
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Core
@using FruitSysWeb.Models
@using FruitSysWeb.Services.Models.Requests
@using FruitSysWeb.Constants
@implements IDisposable

@inject IPaletniListService PaletniListService
@inject ITypeMappingService TypeMapping
@inject ILogger<IzvestajPrijem> Logger

<PageTitle>Prijem Robe</PageTitle>

<style>
    .stat-card {
        transition: all 0.3s ease;
    }
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }
    .live-indicator {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: #28a745;
        animation: pulse 2s infinite;
        margin-right: 8px;
    }
    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }
    .countdown-timer {
        font-size: 0.9rem;
        color: #6c757d;
    }
</style>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <h2 class="mb-1">
                <i class="bi bi-calculator me-2"></i>Prijem Robe
            </h2>
            <p class="text-muted mb-0 small">Pregled primljenih količina voća po vrsti i dobavljaču</p>
            <hr />
        </div>
    </div>

    <!-- Mod izbor -->
    <div class="row mb-3">
        <div class="col-12">
            <ul class="nav nav-tabs">
                <li class="nav-item">
                    <button class="nav-link @(uzivaMod ? "active" : "")" @onclick="PrebaciiNaUzivo">
                        <span class="live-indicator" style="@(!uzivaMod ? "background-color:#6c757d; animation:none;" : "")"></span>
                        Uživo
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(!uzivaMod ? "active" : "")" @onclick="PrebaciiNaIstoriju">
                        <i class="bi bi-clock-history me-1"></i>Istorija
                    </button>
                </li>
            </ul>
        </div>
    </div>

    <!-- Filter -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-filter me-1"></i>Filteri</h5>
                        @if (uzivaMod)
                        {
                            <div class="d-flex align-items-center gap-3">
                                <div class="countdown-timer">
                                    <i class="bi bi-clock"></i> Osvežavanje za: <strong>@CountdownSeconds</strong>s
                                </div>
                                <button class="btn btn-primary btn-sm" @onclick="ManualRefresh" disabled="@IsRefreshing">
                                    <i class="bi bi-arrow-clockwise @(IsRefreshing ? "spin" : "")"></i>
                                    @(IsRefreshing ? "Osvežavam..." : "Osveži")
                                </button>
                            </div>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Datum od</label>
                            <input type="date" class="form-control" value="@OdDatumValue" @onchange="OnOdDatumChanged" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Datum do</label>
                            <input type="date" class="form-control" value="@DoDatumValue" @onchange="OnDoDatumChanged" />
                        </div>
                        <div class="col-md-6 d-flex align-items-end gap-2">
                            <button class="btn btn-primary" @onclick="UcitajPodatke" disabled="@IsRefreshing">
                                <i class="bi bi-search me-1"></i>@(IsRefreshing ? "Učitavam..." : "Primeni filter")
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="ResetujFiltere">
                                <i class="bi bi-arrow-clockwise me-1"></i>Resetuj
                            </button>
                            @if (!uzivaMod)
                            {
                                <button class="btn btn-success" @onclick="PrethodniDan">
                                    <i class="bi bi-arrow-left"></i> Prethodni dan
                                </button>
                                <button class="btn btn-success" @onclick="SledeciDan">
                                    Sledeći dan <i class="bi bi-arrow-right"></i>
                                </button>
                            }
                        </div>
                    </div>
                    @if (uzivaMod)
                    {
                        <div class="mt-2">
                            <small class="text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                Poslednje osvežavanje: @LastRefreshTime.ToString("HH:mm:ss")
                            </small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Statistike -->
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card stat-card bg-primary text-white">
                <div class="card-body">
                    <h6 class="card-title"><i class="bi bi-list-check me-1"></i>Ukupno Prijema</h6>
                    <h2 class="mb-0">@BrojPrijema</h2>
                    <small>@(uzivaMod ? "Danas" : "U izabranom periodu")</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card stat-card bg-success text-white">
                <div class="card-body">
                    <h6 class="card-title"><i class="bi bi-box-seam me-1"></i>Ukupna Težina</h6>
                    <h2 class="mb-0">@TypeMapping.FormatDecimal(UkupnaTezina)</h2>
                    <small>kg</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card stat-card bg-info text-white">
                <div class="card-body">
                    <h6 class="card-title"><i class="bi bi-apple me-1"></i>Vrste Voća</h6>
                    <h2 class="mb-0">@BrojVrstaVoca</h2>
                    <small>Različite vrste</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card stat-card bg-warning text-white">
                <div class="card-body">
                    <h6 class="card-title"><i class="bi bi-people me-1"></i>Dobavljači</h6>
                    <h2 class="mb-0">@BrojDobavljaca</h2>
                    <small>@(uzivaMod ? "Aktivni danas" : "U izabranom periodu")</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Grafikoni -->
    @if (VoceChartData != null && VoceChartData.Any())
    {
        var voceList = VoceChartData.ToList();
        int i = 0;
        while (i < voceList.Count)
        {
            var currentChart = voceList[i];
            var currentHasMany = currentChart.Value.Count >= 5;

            if (currentHasMany)
            {
                <div class="row mb-4">
                    <div class="col-12">
                        <ApexBarChart Title="@($"{currentChart.Key} - Prijem po Dobavljačima")"
                            Icon="bi bi-bar-chart" SeriesName="Količina" Unit="kg"
                            Data="@currentChart.Value" IsLoading="@IsRefreshing"
                            HasError="false" ShowSummary="true" OnRefresh="@UcitajPodatke" />
                    </div>
                </div>
                i++;
            }
            else
            {
                var nextIndex = i + 1;
                var nextChart = nextIndex < voceList.Count ? (KeyValuePair<string, List<ChartDataPoint>>?)voceList[nextIndex] : null;
                var nextHasMany = nextChart != null && nextChart.Value.Value.Count >= 5;

                if (nextChart == null || nextHasMany)
                {
                    <div class="row mb-4">
                        <div class="col-12">
                            <ApexBarChart Title="@($"{currentChart.Key} - Prijem po Dobavljačima")"
                                Icon="bi bi-bar-chart" SeriesName="Količina" Unit="kg"
                                Data="@currentChart.Value" IsLoading="@IsRefreshing"
                                HasError="false" ShowSummary="true" OnRefresh="@UcitajPodatke" />
                        </div>
                    </div>
                    i++;
                }
                else
                {
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <ApexBarChart Title="@($"{currentChart.Key} - Prijem po Dobavljačima")"
                                Icon="bi bi-bar-chart" SeriesName="Količina" Unit="kg"
                                Data="@currentChart.Value" IsLoading="@IsRefreshing"
                                HasError="false" ShowSummary="true" OnRefresh="@UcitajPodatke" />
                        </div>
                        <div class="col-md-6">
                            <ApexBarChart Title="@($"{nextChart.Value.Key} - Prijem po Dobavljačima")"
                                Icon="bi bi-bar-chart" SeriesName="Količina" Unit="kg"
                                Data="@nextChart.Value.Value" IsLoading="@IsRefreshing"
                                HasError="false" ShowSummary="true" OnRefresh="@UcitajPodatke" />
                        </div>
                    </div>
                    i += 2;
                }
            }
        }
    }
    else if (IsRefreshing)
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body text-center p-5">
                        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
                        <p class="mt-3 text-muted">Učitavam podatke o prijemu...</p>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (podaciUcitani)
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-1"></i>
                    Nema podataka o prijemu za @(uzivaMod ? "danas" : "izabrani period").
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool uzivaMod = true;
    private FilterRequest filterRequest = new FilterRequest();
    private Dictionary<string, List<ChartDataPoint>>? VoceChartData;
    private int BrojPrijema = 0;
    private decimal UkupnaTezina = 0;
    private int BrojVrstaVoca = 0;
    private int BrojDobavljaca = 0;
    private bool IsRefreshing = false;
    private bool podaciUcitani = false;
    private DateTime LastRefreshTime = DateTime.Now;
    private int CountdownSeconds = 60;
    private Timer? refreshTimer;
    private Timer? countdownTimer;

    private string OdDatumValue => filterRequest.OdDatum?.ToString("yyyy-MM-dd") ?? "";
    private string DoDatumValue => filterRequest.DoDatum?.ToString("yyyy-MM-dd") ?? "";

    protected override async Task OnInitializedAsync()
    {
        filterRequest.OdDatum = DateTime.Today;
        filterRequest.DoDatum = DateTime.Today;
        await UcitajPodatke();
        StartTimers();
    }

    private async Task PrebaciiNaUzivo()
    {
        uzivaMod = true;
        filterRequest.OdDatum = DateTime.Today;
        filterRequest.DoDatum = DateTime.Today;
        StartTimers();
        await UcitajPodatke();
    }

    private async Task PrebaciiNaIstoriju()
    {
        uzivaMod = false;
        StopTimers();
        var dateRange = SystemConstants.GetDefaultDateRange();
        filterRequest.OdDatum = dateRange.startDate;
        filterRequest.DoDatum = dateRange.endDate;
        await UcitajPodatke();
    }

    private void StartTimers()
    {
        StopTimers();
        if (!uzivaMod) return;

        refreshTimer = new Timer(async _ =>
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    CountdownSeconds = 60;
                    await UcitajPodatke();
                });
            }
            catch (Exception ex) { Logger.LogError(ex, "Greška u refresh timer"); }
        }, null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));

        countdownTimer = new Timer(async _ =>
        {
            try
            {
                if (CountdownSeconds > 0) { CountdownSeconds--; await InvokeAsync(StateHasChanged); }
            }
            catch { }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopTimers()
    {
        refreshTimer?.Dispose();
        refreshTimer = null;
        countdownTimer?.Dispose();
        countdownTimer = null;
    }

    private async Task ManualRefresh()
    {
        CountdownSeconds = 60;
        await UcitajPodatke();
    }

    private async Task UcitajPodatke()
    {
        if (IsRefreshing) return;
        IsRefreshing = true;
        StateHasChanged();

        try
        {
            if (uzivaMod)
            {
                await Task.WhenAll(LoadStatisticsUzivoAsync(), LoadChartDataUzivoAsync());
            }
            else
            {
                await Task.WhenAll(LoadStatisticsPeriodAsync(), LoadChartDataPeriodAsync());
            }
            LastRefreshTime = DateTime.Now;
            podaciUcitani = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju podataka");
        }
        finally
        {
            IsRefreshing = false;
            StateHasChanged();
        }
    }

    private async Task LoadStatisticsUzivoAsync()
    {
        BrojPrijema = await PaletniListService.UcitajBrojAktivnihPrijema();
        UkupnaTezina = await PaletniListService.UcitajUkupnuTezinoZaDan();
        var statistike = await PaletniListService.UcitajStatistikuPrijemaPoVocu();
        BrojVrstaVoca = statistike?.Count ?? 0;
        BrojDobavljaca = statistike?.SelectMany(s => s.Dobavljaci).Select(d => d.Dobavljac).Distinct().Count() ?? 0;
    }

    private async Task LoadChartDataUzivoAsync()
    {
        var prijemData = await PaletniListService.UcitajPrijemPoVocuIDobavljacima();
        VoceChartData = MapChartData(prijemData);
    }

    private async Task LoadStatisticsPeriodAsync()
    {
        if (!filterRequest.OdDatum.HasValue || !filterRequest.DoDatum.HasValue)
        {
            BrojPrijema = 0; UkupnaTezina = 0; BrojVrstaVoca = 0; BrojDobavljaca = 0;
            return;
        }
        BrojPrijema = await PaletniListService.UcitajBrojAktivnihPrijemaPeriod(filterRequest);
        UkupnaTezina = await PaletniListService.UcitajUkupnuTezinuPeriod(filterRequest);
        var statistike = await PaletniListService.UcitajStatistikuPrijemaPoVocuPeriod(filterRequest);
        BrojVrstaVoca = statistike?.Count ?? 0;
        BrojDobavljaca = statistike?.SelectMany(s => s.Dobavljaci).Select(d => d.Dobavljac).Distinct().Count() ?? 0;
    }

    private async Task LoadChartDataPeriodAsync()
    {
        var prijemData = await PaletniListService.UcitajPrijemPoVocuIDobavljacimaPeriod(filterRequest);
        VoceChartData = MapChartData(prijemData);
    }

    private Dictionary<string, List<ChartDataPoint>>? MapChartData(Dictionary<string, List<PrijemPoDobavljacuModel>>? data)
    {
        if (data == null || !data.Any()) return new Dictionary<string, List<ChartDataPoint>>();
        return data.ToDictionary(
            kvp => kvp.Key,
            kvp => kvp.Value.Select(d => new ChartDataPoint { Label = d.Dobavljac, Value = d.Kolicina, ExtraData = d.Artikli }).ToList()
        );
    }

    private void OnOdDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date)) filterRequest.OdDatum = date;
    }

    private void OnDoDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date)) filterRequest.DoDatum = date;
    }

    private async Task ResetujFiltere()
    {
        if (uzivaMod)
        {
            filterRequest.OdDatum = DateTime.Today;
            filterRequest.DoDatum = DateTime.Today;
        }
        else
        {
            filterRequest.OdDatum = DateTime.Today.AddDays(-7);
            filterRequest.DoDatum = DateTime.Today;
        }
        await UcitajPodatke();
    }

    private async Task PrethodniDan()
    {
        if (filterRequest.OdDatum.HasValue && filterRequest.DoDatum.HasValue)
        {
            filterRequest.OdDatum = filterRequest.OdDatum.Value.AddDays(-1);
            filterRequest.DoDatum = filterRequest.DoDatum.Value.AddDays(-1);
            await UcitajPodatke();
        }
    }

    private async Task SledeciDan()
    {
        if (filterRequest.OdDatum.HasValue && filterRequest.DoDatum.HasValue && filterRequest.DoDatum.Value < DateTime.Today)
        {
            filterRequest.OdDatum = filterRequest.OdDatum.Value.AddDays(1);
            filterRequest.DoDatum = filterRequest.DoDatum.Value.AddDays(1);
            await UcitajPodatke();
        }
    }

    public void Dispose()
    {
        StopTimers();
    }
}
