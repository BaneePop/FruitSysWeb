@page "/izvestaj-prijem"
@using DocumentFormat.OpenXml.Office2013.PowerPoint.Roaming
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode())
@using Microsoft.AspNetCore.Components.Web
@using ApexCharts
@using FruitSysWeb.Components.Charts
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Core
@using FruitSysWeb.Models
@implements IDisposable

@inject IPaletniListService PaletniListService
@inject ITypeMappingService TypeMapping
@inject ILogger<IzvestajPrijem> Logger

<PageTitle>Izveštaj Prijem - Uživo</PageTitle>

@* .spin animation moved to wwwroot/css/shared-components.css *@

<style>
    /* Stat card hover effect specific to this page */
    .stat-card {
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }

    .live-indicator {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: #28a745;
        animation: pulse 2s infinite;
        margin-right: 8px;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }
        50% {
            opacity: 0.5;
        }
    }

    .countdown-timer {
        font-size: 0.9rem;
        color: #6c757d;
    }
</style>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2>
                    <span class="live-indicator"></span>
                    <i class="bi bi-truck"></i>
                    Prijem Uživo
                </h2>
                <div class="d-flex align-items-center gap-3">
                    <div class="countdown-timer">
                        <i class="bi bi-clock"></i>
                        Osvežavanje za: <strong>@CountdownSeconds</strong>s
                    </div>
                    <button class="btn btn-primary" @onclick="ManualRefresh" disabled="@IsRefreshing">
                        <i class="bi bi-arrow-clockwise @(IsRefreshing ? "spin" : "")"></i>
                        @(IsRefreshing ? "Osvežavam..." : "Osveži sada")
                    </button>
                </div>
            </div>
            <p class="text-muted">
                Automatsko osvežavanje svakih 60 sekundi | Poslednje osvežavanje: @LastRefreshTime.ToString("HH:mm:ss")
            </p>
            <hr />
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-filter"></i> Filteri</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <DateFilter Label="Od datuma" 
                                   @bind-SelectedDate="DatumOd" 
                                   Size="12" />
                    </div>
                    <div class="col-md-3">
                        <DateFilter Label="Do datuma" 
                                   @bind-SelectedDate="DatumDo" 
                                   Size="12" />
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <button class="btn btn-primary me-2" onclick="PrimeniFilter" disabled="@IsRefreshing">
                            <i class="bi bi-funnel"></i> Primeni filter
                        </button>
                        <button class="btn btn-outline-secondary" onclick="ResetujFilter" disabled="@IsRefreshing">
                            <i class="bi bi-arrow-counterclockwise"></i> Resetuj
                        </button>
                        @if (DatumOd.HasValue || DatumDo.HasValue)
                            {
                            <span class="ms-3 text-muted">
                                Filter: 
                                @(DatumOd?.ToString("dd.MM.yyyy") ?? "sve")
                                - 
                                @(DatumDo?.ToString("dd.MM.yyyy") ?? "sve")
                            </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card stat-card bg-primary text-white">
                <div class="card-body">
                    <h6 class="card-title">
                        <i class="bi bi-list-check"></i>
                        Ukupno Prijema
                    </h6>
                    <h2 class="mb-0">@BrojAktivnihPrijema</h2>
                    <small>Danas</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card stat-card bg-success text-white">
                <div class="card-body">
                    <h6 class="card-title">
                        <i class="bi bi-box-seam"></i>
                        Ukupna Težina
                    </h6>
                    <h2 class="mb-0">@TypeMapping.FormatDecimal(UkupnaTezina)</h2>
                    <small>kg</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card stat-card bg-info text-white">
                <div class="card-body">
                    <h6 class="card-title">
                        <i class="bi bi-apple"></i>
                        Vrste Voća
                    </h6>
                    <h2 class="mb-0">@BrojVrstaVoca</h2>
                    <small>Različite vrste</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card stat-card bg-warning text-white">
                <div class="card-body">
                    <h6 class="card-title">
                        <i class="bi bi-people"></i>
                        Dobavljači
                    </h6>
                    <h2 class="mb-0">@BrojDobavljaca</h2>
                    <small>Aktivni danas</small>
                </div>
            </div>
        </div>
    </div>

    @if (VoceChartData != null && VoceChartData.Any())
    {
        var voceList = VoceChartData.ToList();
        int i = 0;
        while (i < voceList.Count)
        {
            var currentChart = voceList[i];
            var currentHasMany = currentChart.Value.Count >= 5;

            // Ako trenutni chart ima 5+ dobavljača, sam u redu
            if (currentHasMany)
            {
                <div class="row mb-4">
                    <div class="col-12">
                        <ApexBarChart
                            Title="@($"{currentChart.Key} - Prijem po Dobavljačima")"
                            Icon="bi bi-bar-chart"
                            SeriesName="Količina"
                            Unit="kg"
                            Data="@currentChart.Value"
                            IsLoading="@IsRefreshing"
                            HasError="false"
                            ShowSummary="true"
                            OnRefresh="@ManualRefresh" />
                    </div>
                </div>
                i++;
            }
            else
            {
                // Trenutni chart ima manje od 5 dobavljača
                var nextIndex = i + 1;
                var nextChart = nextIndex < voceList.Count ? (KeyValuePair<string, List<ChartDataPoint>>?)voceList[nextIndex] : null;
                var nextHasMany = nextChart != null && nextChart.Value.Value.Count >= 5;

                // Ako sledeći ne postoji ili ima 5+, trenutni sam u redu
                if (nextChart == null || nextHasMany)
                {
                    <div class="row mb-4">
                        <div class="col-12">
                            <ApexBarChart
                                Title="@($"{currentChart.Key} - Prijem po Dobavljačima")"
                                Icon="bi bi-bar-chart"
                                SeriesName="Količina"
                                Unit="kg"
                                Data="@currentChart.Value"
                                IsLoading="@IsRefreshing"
                                HasError="false"
                                ShowSummary="true"
                                OnRefresh="@ManualRefresh" />
                        </div>
                    </div>
                    i++;
                }
                else
                {
                    // Oba imaju manje od 5, stavi ih u isti red
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <ApexBarChart
                                Title="@($"{currentChart.Key} - Prijem po Dobavljačima")"
                                Icon="bi bi-bar-chart"
                                SeriesName="Količina"
                                Unit="kg"
                                Data="@currentChart.Value"
                                IsLoading="@IsRefreshing"
                                HasError="false"
                                ShowSummary="true"
                                OnRefresh="@ManualRefresh" />
                        </div>
                        <div class="col-md-6">
                            <ApexBarChart
                                Title="@($"{nextChart.Value.Key} - Prijem po Dobavljačima")"
                                Icon="bi bi-bar-chart"
                                SeriesName="Količina"
                                Unit="kg"
                                Data="@nextChart.Value.Value"
                                IsLoading="@IsRefreshing"
                                HasError="false"
                                ShowSummary="true"
                                OnRefresh="@ManualRefresh" />
                        </div>
                    </div>
                    i += 2;
                }
            }
        }
    }
    else if (IsRefreshing)
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body text-center p-5">
                        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Učitavam...</span>
                        </div>
                        <p class="mt-3 text-muted">Učitavam podatke o prijemu...</p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    Nema podataka o prijemu za danas. Podaci će se prikazati kada bude aktivnih prijema.
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Dictionary<string, List<ChartDataPoint>>? VoceChartData;
    private int BrojAktivnihPrijema = 0;
    private decimal UkupnaTezina = 0;
    private int BrojVrstaVoca = 0;
    private int BrojDobavljaca = 0;
    private bool IsRefreshing = false;
    private DateTime LastRefreshTime = DateTime.Now;
    private int CountdownSeconds = 60;
    private Timer? refreshTimer;
    private Timer? countdownTimer;

    private DateTime? DatumOd { get; set; }
    private DateTime? DatumDo { get; set; }
    private bool FilterAktivan => DatumOd.HasValue || DatumDo.HasValue;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            Console.WriteLine("\n========================================");
            Console.WriteLine("POČETAK INICIJALIZACIJE IzvestajPrijem");
            Console.WriteLine("========================================");

            Logger.LogInformation("Inicijalizacija IzvestajPrijem započeta");

            // Postavi podrazumevane datume (npr. poslednjih 7 dana)
            DatumDo = DateTime.Today;
            DatumOd = DateTime.Today.AddDays(-7);

            await LoadData();
            StartTimers();

            Console.WriteLine("========================================");
            Console.WriteLine("INICIJALIZACIJA USPEŠNA");
            Console.WriteLine("========================================\n");

            Logger.LogInformation("Inicijalizacija IzvestajPrijem uspešna");
        }
        catch (Exception)
        {
            // Postojeći error handling...
        }
    }

    private async Task PrimeniFilter()
    {
        Console.WriteLine($"Primenjujem filter: {DatumOd} - {DatumDo}");
        CountdownSeconds = 60;
        await LoadData();
    }

    private async Task ResetujFilter()
    {
        DatumOd = DateTime.Today.AddDays(-7);
        DatumDo = DateTime.Today;
        Console.WriteLine("Resetovan filter");
        CountdownSeconds = 60;
        await LoadData();
    }

    private void StartTimers()
    {
        try
        {
            refreshTimer = new Timer(async _ =>
            {
                try
                {
                    await InvokeAsync(async () =>
                    {
                        CountdownSeconds = 60;
                        await LoadData();
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Greška u refresh timer: {ex.Message}");
                    Logger.LogError(ex, "Greška u refresh timer");
                }
            }, null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));

            countdownTimer = new Timer(async _ =>
            {
                try
                {
                    if (CountdownSeconds > 0)
                    {
                        CountdownSeconds--;
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Greška u countdown timer: {ex.Message}");
                }
            }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
            
            Console.WriteLine("Tajmeri pokrenuti uspešno");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška pri pokretanju tajmera: {ex.Message}");
            Logger.LogError(ex, "Greška pri pokretanju tajmera");
        }
    }

    private async Task ManualRefresh()
    {
        Console.WriteLine("Ručno osvežavanje započeto");
        CountdownSeconds = 60;
        await LoadData();
    }

    private async Task LoadData()
    {
        if (IsRefreshing)
        {
            Console.WriteLine("LoadData već u toku - preskačem");
            return;
        }

        IsRefreshing = true;
        StateHasChanged();

        try
        {
            Console.WriteLine("\n--- Učitavanje podataka START ---");
            
            var tasks = new[]
            {
                LoadStatisticsAsync(),
                LoadChartDataAsync()
            };

            await Task.WhenAll(tasks);

            LastRefreshTime = DateTime.Now;
            
            Console.WriteLine($"--- Učitavanje podataka ZAVRŠENO ---");
            Console.WriteLine($"Prijemi: {BrojAktivnihPrijema}, Težina: {UkupnaTezina}kg");
            Console.WriteLine($"Vrste: {BrojVrstaVoca}, Dobavljači: {BrojDobavljaca}\n");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"\n!!! GREŠKA: {ex.Message}\n");
            Logger.LogError(ex, "Greška pri učitavanju podataka");
        }
        finally
        {
            IsRefreshing = false;
            StateHasChanged();
        }
    }

    private async Task LoadStatisticsAsync()
    {
        try
        {
            Console.WriteLine("  → Učitavam statistike...");
            
            BrojAktivnihPrijema = await PaletniListService.UcitajBrojAktivnihPrijema();
            UkupnaTezina = await PaletniListService.UcitajUkupnuTezinoZaDan();

            List<PrijemStatistikaModel>? statistike = await PaletniListService.UcitajStatistikuPrijemaPoVocu();
            BrojVrstaVoca = statistike?.Count ?? 0;

            if (statistike != null && statistike.Any())
            {
                var sviDobavljaci = statistike
                    .SelectMany(s => s.Dobavljaci)
                    .Select(d => d.Dobavljac)
                    .Distinct()
                    .Count();
                BrojDobavljaca = sviDobavljaci;
            }
            else
            {
                BrojDobavljaca = 0;
            }

            Console.WriteLine("  ✓ Statistike učitane");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"  ✗ Greška u statistikama: {ex.Message}");
            Logger.LogError(ex, "Greška pri učitavanju statistika");
            throw;
        }
    }

    private async Task LoadChartDataAsync()
    {
        try
        {
            Console.WriteLine("  → Učitavam chart podatke...");
            
            Dictionary<string, List<PrijemPoDobavljacuModel>>? prijemData = await PaletniListService.UcitajPrijemPoVocuIDobavljacima();

            if (prijemData != null && prijemData.Any())
            {
                VoceChartData = prijemData.ToDictionary(
                    kvp => kvp.Key,
                    kvp => kvp.Value.Select(d => new ChartDataPoint
                    {
                        Label = d.Dobavljac,
                        Value = d.Kolicina,
                        ExtraData = d.Artikli // Artikli za tooltip
                    }).ToList()
                );
                Console.WriteLine($"  ✓ Chart podaci: {VoceChartData.Count} vrsta voća");
            }
            else
            {
                VoceChartData = new Dictionary<string, List<ChartDataPoint>>();
                Console.WriteLine("  ✓ Nema chart podataka");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"  ✗ Greška u chart podacima: {ex.Message}");
            VoceChartData = new Dictionary<string, List<ChartDataPoint>>();
            Logger.LogError(ex, "Greška pri učitavanju chart podataka");
            throw;
        }
    }

    public void Dispose()
    {
        try
        {
            Console.WriteLine("Dispose: čistim resurse");
            
            refreshTimer?.Dispose();
            refreshTimer = null;
            
            countdownTimer?.Dispose();
            countdownTimer = null;
            
            Console.WriteLine("Dispose: završeno");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška u Dispose: {ex.Message}");
        }
    }
}
