@page "/izvestaj-prijem-istorija"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode())
@using Microsoft.AspNetCore.Components.Web
@using ApexCharts
@using FruitSysWeb.Components.Charts
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Core
@using FruitSysWeb.Models
@using FruitSysWeb.Services.Models.Requests
@using FruitSysWeb.Constants
@inject ITypeMappingService TypeMapping
@inject ILogger<IzvestajPrijemIstorija> Logger
@inject IPaletniListService PaletniListService

<PageTitle>Izveštaj Prijem - Istorija</PageTitle>

<style>
    .stat-card {
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }

    .filter-section {
        background-color: #f8f9fa;
        border-radius: 0.375rem;
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

    .date-range-info {
        font-size: 0.9rem;
        color: #6c757d;
    }
</style>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2>
                <i class="bi bi-clock-history"></i>
                Izveštaj Prijem Voća - Istorija
            </h2>
            <p class="text-muted">
                Pregled prijema voća po vremenskom periodu
            </p>
            <hr />
        </div>
    </div>

    <!-- Filter sekcija -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="filter-section">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label fw-bold">Datum od</label>
                        <input type="date" class="form-control" value="@OdDatumValue" @onchange="OnOdDatumChanged" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label fw-bold">Datum do</label>
                        <input type="date" class="form-control" value="@DoDatumValue" @onchange="OnDoDatumChanged" />
                    </div>
                    <div class="col-md-6 mb-3 d-flex align-items-end">
                        <div class="w-100">
                            <div class="d-flex gap-2">
                                <button class="btn btn-primary" @onclick="UcitajPodatke" disabled="@IsRefreshing">
                                    <i class="bi bi-search"></i>
                                    @(IsRefreshing ? "Učitavam..." : "Primeni filter")
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="ResetujFiltere">
                                    <i class="bi bi-arrow-clockwise"></i>
                                    Resetuj
                                </button>
                                <button class="btn btn-success" @onclick="PrethodniDan">
                                    <i class="bi bi-arrow-left"></i>
                                    Prethodni dan
                                </button>
                                <button class="btn btn-success" @onclick="SledeciDan">
                                    Sledeći dan
                                    <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                            @if (filterRequest.OdDatum.HasValue && filterRequest.DoDatum.HasValue)
                            {
                                <div class="date-range-info mt-2">
                                    <i class="bi bi-calendar-range"></i>
                                    Prikaz podataka za period: 
                                    <strong>@filterRequest.OdDatum.Value.ToString("dd.MM.yyyy") - @filterRequest.DoDatum.Value.ToString("dd.MM.yyyy")</strong>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(InitializationError))
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-danger">
                    <h5><i class="bi bi-exclamation-triangle"></i> Greška pri učitavanju</h5>
                    <p><strong>Poruka:</strong> @InitializationError</p>
                    <p><strong>Vreme:</strong> @ErrorTimestamp</p>
                    <pre class="mt-2">@ErrorDetails</pre>
                </div>
            </div>
        </div>
    }

    <!-- Statistike -->
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card stat-card bg-primary text-white">
                <div class="card-body">
                    <h6 class="card-title">
                        <i class="bi bi-list-check"></i>
                        Ukupno Prijema
                    </h6>
                    <h2 class="mb-0">@BrojAktivnihPrijema</h2>
                    <small>U izabranom periodu</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card stat-card bg-success text-white">
                <div class="card-body">
                    <h6 class="card-title">
                        <i class="bi bi-box-seam"></i>
                        Ukupna Težina
                    </h6>
                    <h2 class="mb-0">@TypeMapping.FormatDecimal(UkupnaTezina)</h2>
                    <small>kg</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card stat-card bg-info text-white">
                <div class="card-body">
                    <h6 class="card-title">
                        <i class="bi bi-apple"></i>
                        Vrste Voća
                    </h6>
                    <h2 class="mb-0">@BrojVrstaVoca</h2>
                    <small>Različite vrste</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card stat-card bg-warning text-white">
                <div class="card-body">
                    <h6 class="card-title">
                        <i class="bi bi-people"></i>
                        Dobavljači
                    </h6>
                    <h2 class="mb-0">@BrojDobavljaca</h2>
                    <small>U izabranom periodu</small>
                </div>
            </div>
        </div>
    </div>

    @if (VoceChartData != null && VoceChartData.Any())
    {
        foreach (var voce in VoceChartData)
        {
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="bi bi-bar-chart"></i>
                                    @voce.Key - Prijem po Dobavljačima
                                </h5>
                                <span class="badge bg-primary">
                                    Ukupno: @TypeMapping.FormatDecimal(voce.Value.Sum(x => x.Value)) kg
                                </span>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (IsRefreshing)
                            {
                                <div class="text-center p-4">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Učitavam...</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <ApexChart TItem="ChartDataPoint"
                                           @key="@($"chart-{voce.Key}-{voce.Value.Count}")"
                                           Title="@($"Dobavljači za {voce.Key}")"
                                           Height="300"
                                           Options="@GetChartOptions(voce.Key)">
                                    <ApexPointSeries TItem="ChartDataPoint"
                                                     Items="@voce.Value"
                                                     Name="Količina"
                                                     SeriesType="SeriesType.Bar"
                                                     XValue="@(e => e.Label)"
                                                     YValue="@(e => e.Value)" />
                                </ApexChart>

                                <div class="mt-3 table-responsive">
                                    <table class="table table-sm table-striped">
                                        <thead>
                                            <tr>
                                                <th>Dobavljač</th>
                                                <th class="text-end">Količina (kg)</th>
                                                <th class="text-end">% od Ukupno</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var dobavljac in voce.Value.OrderByDescending(x => x.Value))
                                            {
                                                var procenat = voce.Value.Sum(x => x.Value) > 0 ? 
                                                    (dobavljac.Value / voce.Value.Sum(x => x.Value)) * 100 : 0;
                                                <tr>
                                                    <td>@dobavljac.Label</td>
                                                    <td class="text-end">@TypeMapping.FormatDecimal(dobavljac.Value)</td>
                                                    <td class="text-end">@procenat.ToString("F1")%</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr class="fw-bold">
                                                <td>UKUPNO</td>
                                                <td class="text-end">@TypeMapping.FormatDecimal(voce.Value.Sum(x => x.Value))</td>
                                                <td class="text-end">100%</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else if (IsRefreshing)
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body text-center p-5">
                        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Učitavam...</span>
                        </div>
                        <p class="mt-3 text-muted">Učitavam podatke o prijemu...</p>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (PodaciUcitani)
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    Nema podataka o prijemu za izabrani period.
                </div>
            </div>
        </div>
    }
</div>

@code {
    private FilterRequest filterRequest = new FilterRequest();
    private Dictionary<string, List<ChartDataPoint>>? VoceChartData;
    private int BrojAktivnihPrijema = 0;
    private decimal UkupnaTezina = 0;
    private int BrojVrstaVoca = 0;
    private int BrojDobavljaca = 0;
    private bool IsRefreshing = false;
    private bool PodaciUcitani = false;
    private string? InitializationError;
    private DateTime? ErrorTimestamp;
    private string? ErrorDetails;
    private string OdDatumValue => filterRequest.OdDatum?.ToString("yyyy-MM-dd") ?? "";
    private string DoDatumValue => filterRequest.DoDatum?.ToString("yyyy-MM-dd") ?? "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var dateRange = SystemConstants.GetDefaultDateRange();
            filterRequest.OdDatum = dateRange.startDate;
            filterRequest.DoDatum = dateRange.endDate;

            await UcitajPodatke();
        }
        catch (Exception ex)
        {
            InitializationError = $"{ex.GetType().Name}: {ex.Message}";
            ErrorTimestamp = DateTime.Now;
            ErrorDetails = ex.StackTrace;
            Logger.LogError(ex, "Greška pri inicijalizaciji IzvestajPrijemIstorija");
        }
    }

    private void OnOdDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            filterRequest.OdDatum = date;
        }
    }

    private void OnDoDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            filterRequest.DoDatum = date;
        }
    }

    private async Task UcitajPodatke()
    {
        IsRefreshing = true;
        try
        {
            Logger.LogInformation($"Učitavanje podataka za period: {filterRequest.OdDatum} - {filterRequest.DoDatum}");

            var tasks = new[]
            {
                LoadStatisticsAsync(),
                LoadChartDataAsync()
            };

            await Task.WhenAll(tasks);
            PodaciUcitani = true;
        }
        catch (Exception ex)
        {
            InitializationError = $"{ex.GetType().Name}: {ex.Message}";
            ErrorTimestamp = DateTime.Now;
            ErrorDetails = ex.StackTrace;
            Logger.LogError(ex, "Greška pri učitavanju podataka");
        }
        finally
        {
            IsRefreshing = false;
            StateHasChanged();
        }
    }

    private async Task LoadStatisticsAsync()
    {
        try
        {
            if (filterRequest.OdDatum.HasValue && filterRequest.DoDatum.HasValue)
            {
                // ✅ ISPRAVKA: Koristi filterRequest umesto 2 DateTime parametra
                BrojAktivnihPrijema = await PaletniListService.UcitajBrojAktivnihPrijemaPeriod(filterRequest);
                UkupnaTezina = await PaletniListService.UcitajUkupnuTezinuPeriod(filterRequest);

                var statistike = await PaletniListService.UcitajStatistikuPrijemaPoVocuPeriod(filterRequest);
                BrojVrstaVoca = statistike?.Count ?? 0;

                if (statistike != null && statistike.Any())
                {
                    var sviDobavljaci = statistike
                        .SelectMany(s => s.Dobavljaci)
                        .Select(d => d.Dobavljac)
                        .Distinct()
                        .Count();
                    BrojDobavljaca = sviDobavljaci;
                }
                else
                {
                    BrojDobavljaca = 0;
                }
            }
            else
            {
                BrojAktivnihPrijema = 0;
                UkupnaTezina = 0;
                BrojVrstaVoca = 0;
                BrojDobavljaca = 0;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju statistika");
            throw;
        }
    }

    private async Task LoadChartDataAsync()
    {
        try
        {
            // ✅ ISPRAVKA: Koristi filterRequest umesto 2 DateTime parametra
            var prijemData = await PaletniListService.UcitajPrijemPoVocuIDobavljacimaPeriod(filterRequest);

            if (prijemData != null && prijemData.Any())
            {
                VoceChartData = prijemData.ToDictionary(
                    kvp => kvp.Key,
                    kvp => kvp.Value.Select(d => new ChartDataPoint(d.Dobavljac, d.Kolicina)).ToList()
                );
            }
            else
            {
                VoceChartData = new Dictionary<string, List<ChartDataPoint>>();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju chart podataka");
            throw;
        }
    }

    private async Task ResetujFiltere()
    {
        filterRequest.OdDatum = DateTime.Today.AddDays(-7);
        filterRequest.DoDatum = DateTime.Today;
        await UcitajPodatke();
    }

    private async Task PrethodniDan()
    {
        if (filterRequest.OdDatum.HasValue && filterRequest.DoDatum.HasValue)
        {
            filterRequest.OdDatum = filterRequest.OdDatum.Value.AddDays(-1);
            filterRequest.DoDatum = filterRequest.DoDatum.Value.AddDays(-1);
            await UcitajPodatke();
        }
    }

    private async Task SledeciDan()
    {
        if (filterRequest.OdDatum.HasValue && filterRequest.DoDatum.HasValue && filterRequest.DoDatum.Value < DateTime.Today)
        {
            filterRequest.OdDatum = filterRequest.OdDatum.Value.AddDays(1);
            filterRequest.DoDatum = filterRequest.DoDatum.Value.AddDays(1);
            await UcitajPodatke();
        }
    }

    private ApexChartOptions<ChartDataPoint> GetChartOptions(string voce)
    {
        return new ApexChartOptions<ChartDataPoint>
        {
            Chart = new Chart
            {
                Type = ChartType.Bar,
                Height = 300,
                Toolbar = new Toolbar { Show = false }
            },
            Colors = new List<string> { GetColorForVoce(voce) },
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    Horizontal = false,
                    ColumnWidth = "65%",
                    DataLabels = new PlotOptionsBarDataLabels
                    {
                        Position = BarDataLabelPosition.Bottom
                    }
                }
            },
            DataLabels = new DataLabels
            {
                Enabled = true,
                OffsetY = -20,
                Style = new DataLabelsStyle
                {
                    FontSize = "12px",
                    Colors = new List<string> { "#304758" }
                },
                Formatter = "function(val) { return val.toFixed(1) + ' kg' }"
            },
            Stroke = new Stroke
            {
                Show = true,
                Width = 2,
                Colors = new List<string> { "transparent" }
            },
            Xaxis = new XAxis
            {
                Categories = VoceChartData?[voce].Select(x => x.Label).ToList() ?? new List<string>(),
                Labels = new XAxisLabels
                {
                    Rotate = -45,
                    RotateAlways = false,
                    MaxHeight = 120
                }
            },
            Yaxis = new List<YAxis>
            {
                new YAxis
                {
                    Title = new AxisTitle { Text = "Količina (kg)" },
                    Labels = new YAxisLabels
                    {
                        Formatter = "function(val) { return val.toFixed(0) + ' kg' }"
                    }
                }
            },
            Fill = new Fill
            {
                Opacity = 1.0
            },
            Tooltip = new Tooltip
            {
                Y = new TooltipY
                {
                    Formatter = "function(val) { return val.toFixed(2) + ' kg' }"
                }
            },
            Grid = new Grid
            {
                BorderColor = "#e7e7e7",
                Row = new GridRow
                {
                    Colors = new List<string> { "#f3f3f3", "transparent" },
                    Opacity = 0.5
                }
            }
        };
    }

    /// <summary>
    /// Returns a color hex code for the given fruit name to be used in charts.
    /// </summary>
    private string GetColorForVoce(string voce)
    {
        var colors = new Dictionary<string, string>
        {
            ["Višnja"] = "#3d0122",
            ["Malina"] = "#ad1032",
            ["Kupina"] = "#17040c",
            ["Borovnica"] = "#4f3347",
            ["Šljiva"] = "#2a2b69",
            ["KUTIJA"] = "#28a745",
            ["KESA"] = "#ffc107",
            ["Paleta"] = "#fd7e14",
            ["Folija"] = "#ff8c69",
            ["Traka"] = "#dc143c"
        };

            foreach (var colorMapping in colors)
                {
                if (voce.Contains(colorMapping.Key, StringComparison.OrdinalIgnoreCase))
                {
                return colorMapping.Value;
            }
        }
    return "#17a2b8";
    }
}
