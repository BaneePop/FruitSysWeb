    private HashSet<long> otvoreneOtpremnice = new();
    private Dictionary<long, List<IzvodPaletniListRow>> paletniListoviOtpremnica = new();
    private long ucitavaPaletniListOtpremnica = 0;

    // ── RADNI NALOZI ────────────────────────────────────────────────────────
    private string FRN_OdDatum = DateTime.Today.AddDays(-7).ToString("yyyy-MM-dd");
    private string FRN_DoDatum = DateTime.Today.ToString("yyyy-MM-dd");
