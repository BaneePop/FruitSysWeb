    protected override async Task OnInitializedAsync()
    {
        var taskKomitenti = KomitentService.UcitajSveKomitente();
        var taskArtikli = ArtikalService.UcitajSveArtikle();
        await Task.WhenAll(taskKomitenti, taskArtikli);
        komitenti = taskKomitenti.Result ?? new();
        artikli = taskArtikli.Result ?? new();

        // Auto-učitaj prvi tab
        await UcitajPrijemnice();
    }

    // ── TAB ─────────────────────────────────────────────────────────────────

    private async Task PrebacíTab(string tab)
    {
        aktivniTab = tab;
        if (tab == "prijemnice" && prijemnice.Count == 0 && !ucitavaPrijemnice)
            await UcitajPrijemnice();
        else if (tab == "otpremnice" && otpremnice.Count == 0 && !ucitavaOtpremnice)
            await UcitajOtpremnice();
        else if (tab == "radni-nalozi" && radniNalozi.Count == 0 && !ucitavaRadneNaloge)
            await UcitajRadneNaloge();
        else if (tab == "otkupni-listovi" && otkupniListovi.Count == 0 && !ucitavaOtkupneListove)
            await UcitajOtkupneListove();
        else if (tab == "paletni-nabavka" && paletniListoviNabavka.Count == 0 && !ucitavaPLNabavka)
            await UcitajPaletneListoveNabavke();
        else if (tab == "paletni-gotova-roba" && paletniListoviGotovaRoba.Count == 0 && !ucitavaPLGotovaRoba)
            await UcitajPaletneListoveGotovaRoba();
    }

    // ── PRIJEMNICE ──────────────────────────────────────────────────────────

    private async Task UcitajPrijemnice()
    {
        ucitavaPrijemnice = true;
        otvorenePrijemnice.Clear();
        paletniListoviPrijemnica.Clear();
        try
        {
            prijemnice = await IzvodService.UcitajPrijemnice(BuildFilterPrijemnice());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju prijemnica");
            prijemnice = new();
        }
        finally { ucitavaPrijemnice = false; }
    }

    private void ResetPrijemnice()
    {
        FP_OdDatum = DateTime.Today.AddDays(-7).ToString("yyyy-MM-dd");
        FP_DoDatum = DateTime.Today.ToString("yyyy-MM-dd");
        FP_KomitentId = 0;
        FP_KomitentTip = string.Empty;
        FP_ArtikalId = 0;
        FP_TipArtikla = string.Empty;
        prijemnice = new();
        otvorenePrijemnice.Clear();
        paletniListoviPrijemnica.Clear();
    }

    private async Task TogglePrijemnica(long id)
    {
        if (!otvorenePrijemnice.Add(id)) { otvorenePrijemnice.Remove(id); return; }
        if (!paletniListoviPrijemnica.ContainsKey(id))
        {
            ucitavaPaletniListPrijemnica = id;
            try { paletniListoviPrijemnica[id] = await IzvodService.UcitajPaletneListovePrijemnice(id); }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Greška PL prijemnice {Id}", id);
                paletniListoviPrijemnica[id] = new();
            }
            finally { ucitavaPaletniListPrijemnica = 0; }
        }
    }

