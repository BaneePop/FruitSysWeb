    // ── Sekcija 3 ─────────────────────────────────────────────────

    private void DodajFormulaStavku(string vrsta)
    {
        if (!formulaEdit.ContainsKey(vrsta))
            formulaEdit[vrsta] = new();
        formulaEdit[vrsta].Add((0, 0m));
    }

    private void ObrisiFormulaStavku(string vrsta, int idx)
    {
        if (formulaEdit.TryGetValue(vrsta, out var stavke) && idx < stavke.Count)
            stavke.RemoveAt(idx);
    }

    private void PostaviFormulaArtikal(string vrsta, int idx, string? val)
    {
        if (!formulaEdit.TryGetValue(vrsta, out var stavke) || idx >= stavke.Count) return;
        if (int.TryParse(val, out int artId))
        {
            var current = stavke[idx];
            stavke[idx] = (artId, current.Procenat);
        }
    }

    private void PostaviFormulaProcenat(string vrsta, int idx, string? val)
    {
        if (!formulaEdit.TryGetValue(vrsta, out var stavke) || idx >= stavke.Count) return;
        if (decimal.TryParse(val?.Replace(',', '.'), System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out decimal pct))
        {
            var current = stavke[idx];
            stavke[idx] = (current.ArtikalID, pct);
        }
    }

    private async Task SacuvajFormule()
    {
        sacuvaFormula = true;
        porukaFormula = null;
        try
        {
            var config = await KonfiguracijaService.UcitajKonfiguraciju();
            config.FormulaIskoriscenja = formulaEdit
                .Where(kv => kv.Value.Any(s => s.ArtikalID > 0 && s.Procenat > 0))
                .ToDictionary(
                    kv => kv.Key,
                    kv => kv.Value
                        .Where(s => s.ArtikalID > 0 && s.Procenat > 0)
                        .Select(s =>
                        {
                            var naziv = artikliZaFormulu.Values
                                .SelectMany(x => x)
                                .FirstOrDefault(a => a.ID == s.ArtikalID).Naziv ?? "";
                            return new FormulaIskoriscenjaStavka
                                { ArtikalID = s.ArtikalID, Naziv = naziv, Procenat = s.Procenat };
                        })
                        .ToList());
            await KonfiguracijaService.SacuvajKonfiguraciju(config);
            porukaFormula = "Sačuvano.";
            porukaFormulaUspeh = true;
        }
        catch
        {
            porukaFormula = "Greška pri čuvanju.";
            porukaFormulaUspeh = false;
        }
        finally
        {
            sacuvaFormula = false;
        }
    }

