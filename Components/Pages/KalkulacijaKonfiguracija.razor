    // ── Sekcija 5 ─────────────────────────────────────────────────

    private void PreselektujAltivaFrikos()
    {
        foreach (var a in artikliZaPrenosKonf)
        {
            if (a.Naziv.Contains("ALTIVA", StringComparison.OrdinalIgnoreCase) ||
                a.Naziv.Contains("FRIKOS", StringComparison.OrdinalIgnoreCase) ||
                (a.NazivKomitenta?.Contains("FRIKOS", StringComparison.OrdinalIgnoreCase) ?? false))
                a.Iskljuci = true;
        }
    }

    private void OdznakiSve()
    {
        foreach (var a in artikliZaPrenosKonf)
            a.Iskljuci = false;
    }

    private async Task SacuvajPrenosKonf()
    {
        sacuvaPrenosKonf = true;
        porukaPrenosKonf = null;
        try
        {
            var config = await KonfiguracijaService.UcitajKonfiguraciju();
            config.IskluceniArtikliPrenosZaliha = artikliZaPrenosKonf
                .Where(a => a.Iskljuci)
                .Select(a => a.ArtikalID)
                .Distinct()
                .ToList();
            await KonfiguracijaService.SacuvajKonfiguraciju(config);
            porukaPrenosKonf = $"Sačuvano. Isključeno artikala: {config.IskluceniArtikliPrenosZaliha.Count}.";
            porukaPrenosKonfUspeh = true;
        }
        catch
        {
            porukaPrenosKonf = "Greška pri čuvanju.";
            porukaPrenosKonfUspeh = false;
        }
        finally
        {
            sacuvaPrenosKonf = false;
        }
    }
