@page "/kvalitethome"
@rendermode @(new InteractiveServerRenderMode())
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Models.Requests
@using FruitSysWeb.Components.Charts
@using FruitSysWeb.Models

@inject NavigationManager NavigationManager
@inject IPreradaService PreradaService
@inject IBrziPregledService BrziPregledService
@inject IReklamacijaService ReklamacijaService
@inject ITypeMappingService TypeMapping
@inject ILogger<KvalitetHome> Logger

<style>
    .metric-card {
        text-align: center;
        border-radius: 8px;
        padding: 1rem;
        transition: all 0.3s ease;
    }
    .metric-card:hover {
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        transform: translateY(-2px);
    }
    .metric-card h3 {
        font-size: 1.8rem;
        font-weight: 700;
        margin: 0.3rem 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .metric-card h6 { font-size: 0.85rem; opacity: 0.9; }
    .metric-card small { font-size: 0.78rem; opacity: 0.8; }
</style>

<!-- Header -->
<div class="prerada-header text-white py-4 mb-4">
    <div class="container-fluid">
        <h1 class="h2 mb-1">
            <i class="bi bi-shield-check me-2"></i>Kvalitet - Kontrola i praćenje kvaliteta
        </h1>
        <p class="mb-0">Sledljivost, kontrole radnih naloga i upravljanje reklamacijama</p>
    </div>
</div>

<div class="container-fluid">
    <!-- Navigacione kartice -->
    <div class="section-grid" style="grid-template-columns: repeat(4, 1fr);">
        <div class="section-card" @onclick="@(() => NavigateTo("/sledljivost"))">
            <div class="section-icon">
                <i class="bi bi-diagram-3"></i>
            </div>
            <h4 class="section-title">Sledljivost</h4>
        </div>

        <div class="section-card" @onclick="@(() => NavigateTo("/kontrola-radni-nalog"))">
            <div class="section-icon">
                <i class="bi bi-clipboard2-check"></i>
            </div>
            <h4 class="section-title">Kontrole RN</h4>
        </div>

        <div class="section-card" @onclick="@(() => NavigateTo("/reklamacije"))">
            <div class="section-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <h4 class="section-title">Reklamacije</h4>
        </div>

        <div class="section-card" @onclick="@(() => NavigateTo("/paletni-list-pregled"))">
            <div class="section-icon">
                <i class="bi bi-layers"></i>
            </div>
            <h4 class="section-title">Paletni List Pregled</h4>
        </div>
    </div>

    <!-- Metric kartice reklamacija -->
    <div class="row mt-4 mb-3 g-3">
        <div class="col-md-3">
            <div class="metric-card bg-primary text-white">
                @if (reklamacijeUcitane)
                {
                    <h6><i class="bi bi-exclamation-triangle me-1"></i>Ukupno reklamacija</h6>
                    <h3>@ukupnoReklamacija</h3>
                    <small>od 01.06.2025.</small>
                }
                else
                {
                    <div class="text-center py-2"><div class="spinner-border spinner-border-sm"></div></div>
                }
            </div>
        </div>
        <div class="col-md-3">
            <div class="metric-card bg-info text-white">
                @if (reklamacijeUcitane)
                {
                    <h6><i class="bi bi-basket me-1"></i>Vrsta voća</h6>
                    <h3>@vrstaVocaNajvise</h3>
                    <small>@vrstaVocaBroj reklamacija</small>
                }
                else
                {
                    <div class="text-center py-2"><div class="spinner-border spinner-border-sm"></div></div>
                }
            </div>
        </div>
        <div class="col-md-3">
            <div class="metric-card bg-warning text-dark">
                @if (reklamacijeUcitane)
                {
                    <h6><i class="bi bi-tags me-1"></i>Najčešći tip</h6>
                    <h3>@tipNajvise</h3>
                    <small>@tipBroj reklamacija</small>
                }
                else
                {
                    <div class="text-center py-2"><div class="spinner-border spinner-border-sm"></div></div>
                }
            </div>
        </div>
        <div class="col-md-3">
            <div class="metric-card bg-danger text-white">
                @if (reklamacijeUcitane)
                {
                    <h6><i class="bi bi-truck me-1"></i>Vraćena vozila</h6>
                    <h3>@vracenoVozila</h3>
                    <small>od 01.06.2025.</small>
                }
                else
                {
                    <div class="text-center py-2"><div class="spinner-border spinner-border-sm"></div></div>
                }
            </div>
        </div>
    </div>

    <!-- Najavljeni Utovari -->
    <div class="row mt-4 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-truck me-2 text-primary"></i>Najavljeni Utovari (narednih 20 dana)
                    </h5>
                    @if (najavljeniUtovari != null)
                    {
                        <span class="badge bg-primary">@najavljeniUtovari.Count stavki</span>
                    }
                </div>
                <div class="card-body p-0">
                    @if (najavljeniUtovari == null)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Učitavanje...</span>
                            </div>
                            <p class="mt-3 text-muted">Učitavanje najavljenih utovara...</p>
                        </div>
                    }
                    else if (!najavljeniUtovari.Any())
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-calendar-check display-3 text-muted"></i>
                            <h5 class="mt-3 text-muted">Nema najavljenih utovara u narednih 20 dana</h5>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Radni nalog</th>
                                        <th>Datum utovara</th>
                                        <th>Dana</th>
                                        <th>Kupac</th>
                                        <th>Artikal</th>
                                        <th>Potrebna količina</th>
                                        <th>Lot</th>
                                        <th>Ugovor prodaja</th>
                                        <th>Prioritet</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var utovar in najavljeniUtovari)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge @utovar.StatusBadgeClass">@utovar.RadniNalog</span>
                                            </td>
                                            <td>
                                                <strong>@TypeMapping.FormatDate(utovar.DatumIsporuke ?? DateTime.MinValue)</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@utovar.DanaDoUtovara dana</span>
                                            </td>
                                            <td>@utovar.Kupac</td>
                                            <td>
                                                <span class="text-primary">@utovar.Artikal</span>
                                            </td>
                                            <td>
                                                <strong>@TypeMapping.FormatWeight(utovar.Kolicina)</strong>
                                            </td>
                                            <td>
                                                <code class="text-info">@(utovar.LotNaloga ?? "N/A")</code>
                                            </td>
                                            <td>
                                                <small class="text-muted">@(utovar.BrojUgovora ?? "N/A")</small>
                                            </td>
                                            <td>
                                                <span class="badge @utovar.UrgentnostBadgeClass">@utovar.StatusUrgentnosti</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Nabavka po Vrsti Voća chart -->
    <div class="row mb-4">
        <div class="col-12">
            <ApexMultiSeriesLineChart
                Title="Nabavka po Vrsti Voća (01.06.2025 – 09.03.2026)"
                Icon="bi bi-graph-up"
                SeriesData="@nabavkaPoVoci"
                Unit="kg"
                IsWeight="true"
                IsLoading="@ucitavaNabavku"
                HasError="@greskaUNabavci"
                ShowSummary="true"
                HorizontalSummary="true"
                ShowVrednost="false"
                Height="450"
                OnRefresh="@UcitajNabavkuPoVoci" />
        </div>
    </div>

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Početna</a></li>
            <li class="breadcrumb-item active">Kvalitet</li>
        </ol>
    </nav>
</div>

@code {
    private List<NajavljeniUtovarModel>? najavljeniUtovari;
    private List<ChartSeriesData>? nabavkaPoVoci;
    private bool ucitavaNabavku = false;
    private bool greskaUNabavci = false;

    // Reklamacije metric kartice
    private bool reklamacijeUcitane = false;
    private int ukupnoReklamacija = 0;
    private string vrstaVocaNajvise = "-";
    private int vrstaVocaBroj = 0;
    private string tipNajvise = "-";
    private int tipBroj = 0;
    private int vracenoVozila = 0;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            UcitajReklamacijeStatistike(),
            UcitajNajavljeneUtovare(),
            UcitajNabavkuPoVoci()
        );
    }

    private async Task UcitajReklamacijeStatistike()
    {
        try
        {
            var filter = new ReklamacijaFilterModel
            {
                OdDatum = new DateTime(2025, 6, 1)
            };
            var sve = await ReklamacijaService.FilterirajReklamacije(filter);

            ukupnoReklamacija = sve.Count;
            vracenoVozila = sve.Count(r => r.Rezultat == "Vraćeno vozilo");

            var poVoci = sve
                .Where(r => !string.IsNullOrEmpty(r.VrstaVoca))
                .GroupBy(r => r.VrstaVoca)
                .OrderByDescending(g => g.Count())
                .FirstOrDefault();
            if (poVoci != null) { vrstaVocaNajvise = poVoci.Key; vrstaVocaBroj = poVoci.Count(); }

            var poTipu = sve
                .Where(r => !string.IsNullOrEmpty(r.TipReklamacije))
                .GroupBy(r => r.TipReklamacije)
                .OrderByDescending(g => g.Count())
                .FirstOrDefault();
            if (poTipu != null) { tipNajvise = poTipu.Key; tipBroj = poTipu.Count(); }

            reklamacijeUcitane = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju statistike reklamacija");
            reklamacijeUcitane = true; // prikazi 0 vrednosti
        }
        StateHasChanged();
    }

    private async Task UcitajNajavljeneUtovare()
    {
        try
        {
            najavljeniUtovari = await PreradaService.UcitajNajavljeneUtovare();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju najavljenih utovara");
            najavljeniUtovari = new List<NajavljeniUtovarModel>();
        }
    }

    private async Task UcitajNabavkuPoVoci()
    {
        if (ucitavaNabavku) return;
        ucitavaNabavku = true;
        greskaUNabavci = false;
        StateHasChanged();

        try
        {
            var odDatum = new DateTime(2025, 6, 1);
            var doDatum = new DateTime(2026, 3, 9);

            var podaci = await BrziPregledService.UcitajNabavkuPoDanimaPoVociAsync(odDatum, doDatum);

            // Sortiraj datume ispravno (format "dd.MM.yy")
            var sviDatumi = podaci
                .SelectMany(v => v.Value.Keys)
                .Distinct()
                .OrderBy(d => DateTime.TryParseExact(d, "dd.MM.yy",
                    System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.None, out var dt) ? dt : DateTime.MinValue)
                .ToList();

            nabavkaPoVoci = podaci
                .Select(voce => new ChartSeriesData
                {
                    Name = voce.Key,
                    Data = sviDatumi
                        .Select(datum => new ChartDataPoint
                        {
                            Label = datum,
                            Value = voce.Value.ContainsKey(datum) ? voce.Value[datum] : 0
                        })
                        .ToList(),
                    Color = ChartDataHelper.GetFruitColor(voce.Key),
                    TotalKolicina = voce.Value.Values.Sum(),
                    TotalVrednost = 0
                })
                .OrderByDescending(s => s.TotalKolicina)
                .Take(8)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju nabavke po voću");
            greskaUNabavci = true;
            nabavkaPoVoci = new();
        }
        finally
        {
            ucitavaNabavku = false;
            StateHasChanged();
        }
    }

    private void NavigateTo(string url)
    {
        NavigationManager.NavigateTo(url);
    }
}
