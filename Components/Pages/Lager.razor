@page "/lager"
@page "/lager-proizvodnje"
@page "/ambalaza"
@page "/roba"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using FruitSysWeb.Models
@using FruitSysWeb.Services
@using FruitSysWeb.Services.Models.Requests
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Core
@using FruitSysWeb.Constants
@inject IMagacinLagerService LagerService
@inject IExportService ExportService
@inject ITypeMappingService TypeMapping
@inject IJSRuntime JSRuntime

<style>
    .low-stock { background-color: #fff5f5; border-left: 4px solid #dc3545; }
    .medium-stock { background-color: #fff8e1; border-left: 4px solid #ffc107; }
    .high-stock { background-color: #f0f9ff; border-left: 4px solid #198754; }
    
    .stock-alert {
        padding: 0.25rem 0.5rem;
        border-radius: 0.375rem;
        font-size: 0.75rem;
        font-weight: 600;
    }
    
    .artikal-tip-badge {
        font-size: 0.7rem;
        padding: 0.25rem 0.5rem;
    }
    
    .nav-tabs-vertical {
        border-right: 1px solid #dee2e6;
        border-bottom: none;
    }
    
    .nav-tabs-vertical .nav-link {
        border: 1px solid transparent;
        border-right: none;
        margin-bottom: 2px;
    }
    
    .nav-tabs-vertical .nav-link.active {
        border-color: #dee2e6 #fff #dee2e6 #dee2e6;
    }
</style>

<div class="container-fluid">
    <!-- Header -->
    <div class="bg-info text-white py-3 mb-4">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h1 class="h3 mb-0">
                        <i class="bi bi-archive me-2"></i>
                        Magacin Lager
                    </h1>
                    <small class="opacity-75">Trenutno stanje zaliha po svim magacinima — količine i vrednosti artikala</small>
                </div>
                <div class="col-md-6 text-end">
                    <span class="badge bg-light text-dark fs-6">
                        <i class="bi bi-box me-1"></i>@(lagerStanje?.Count ?? 0) artikala
                    </span>
                    <span class="badge bg-warning text-dark ms-2 fs-6">
                        Ukupno: @(lagerStanje?.Sum(x => x.Kolicina).ToString("N2") ?? "0.00") kg
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- TABS za različite preglede -->
    <div class="row mb-4">
        <div class="col-12">
            <ul class="nav nav-tabs" id="lagerTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(aktivniTab == "magacin" ? "active" : "")" type="button" role="tab" @onclick='() => PrebaciiNaTab("magacin")'>
                        <i class="bi bi-archive me-2"></i>Magacin Lager
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(aktivniTab == "proizvodnja" ? "active" : "")" type="button" role="tab" @onclick='() => PrebaciiNaTab("proizvodnja")'>
                        <i class="bi bi-gear me-2"></i>Lager Proizvodnje
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(aktivniTab == "ambalaza" ? "active" : "")" type="button" role="tab" @onclick='() => PrebaciiNaTab("ambalaza")'>
                        <i class="bi bi-box-seam me-2"></i>Lager Ambalaže
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(aktivniTab == "sirovine" ? "active" : "")" type="button" role="tab" @onclick='() => PrebaciiNaTab("sirovine")'>
                        <i class="bi bi-droplet me-2"></i>Lager Sirovina
                    </button>
                </li>
            </ul>
        </div>
    </div>

    <div>
        <!-- MAGACIN LAGER TAB -->
        @if (aktivniTab == "magacin")
        {
        <div role="tabpanel">
            <!-- REFAKTORISANI Filter Section - koristi TypeMappingService -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card border-info">
                        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-funnel me-2"></i>Filteri pretrage
                            </h5>
                            <div class="btn-group">
                                <button class="btn btn-success btn-sm" @onclick="ExportToExcel" disabled="@(lagerStanje?.Count == 0)">
                                    <i class="bi bi-file-earmark-excel me-1"></i>Excel
                                </button>
                                <button class="btn btn-danger btn-sm" @onclick="ExportToPdf" disabled="@(lagerStanje?.Count == 0)">
                                    <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-bold">Tip artikla:</label>
                                    <select class="form-select" @bind="filterRequest.Tip">
                                        @foreach(var option in TypeMapping.GetMagacinDropdownOptions())
                                        {
                                            <option value="@option.Value">@option.Text</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-2 mb-3 d-flex align-items-end">
                                    <div class="d-flex gap-2 w-100">
                                        <button class="btn btn-info w-100" @onclick="UcitajPodatke">
                                            <i class="bi bi-search me-2"></i>Filtriraj
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Results Section -->
            @if (lagerStanje == null)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    Učitavanje podataka...
                </div>
            }
            else if (!lagerStanje.Any())
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Nema podataka za prikaz sa trenutnim filterima.
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-light">
                                <h5 class="card-title mb-0">
                                    <i class="bi bi-list-check me-2"></i>
                                    Magacin Lager Stanje
                                    <span class="badge bg-info ms-2">@lagerStanje.Count artikala</span>
                                </h5>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover mb-0">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Tip</th>
                                                <th>Artikal</th>
                                                <th class="text-end">Količina</th>
                                                <th>Pakovanje</th>
                                                <th>JM</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in lagerStanje)
                                            {
                                                var stockClass = GetStockClass(item.Kolicina, SystemConstants.Lager.DEFAULT_MIN_KOLICINA);
                                                var (stockStatus, stockBadgeClass, stockIcon) = TypeMapping.GetQuantityStatus(item.Kolicina);
                                                
                                                <tr class="@stockClass">
                                                    <td>
                                                        <span class="badge bg-secondary artikal-tip-badge">
                                                            @item.TipArtikla
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <strong>@item.Artikal</strong>
                                                    </td>
                                                    <td class="text-end">
                                                        <span class="fw-bold">@TypeMapping.FormatDecimal(item.Kolicina)</span>
                                                    </td>
                                                    <td>@item.Pakovanje</td>
                                                    <td>@item.JM</td>
                                                    <td>
                                                        <span class="badge @stockBadgeClass">
                                                            <i class="@stockIcon"></i> @stockStatus
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot class="table-secondary">
                                            <tr>
                                                <th colspan="2" class="text-end">UKUPNO:</th>
                                                <th class="text-end text-info">@TypeMapping.FormatDecimal(lagerStanje.Sum(x => x.Kolicina))</th>
                                                <th colspan="3"></th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        }
        <!-- LAGER PROIZVODNJE TAB -->
        @if (aktivniTab == "proizvodnja")
        {
        <div role="tabpanel">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-gear me-2"></i>
                                Lager Proizvodnje
                                <span class="badge bg-info ms-2">@(lagerProizvodnje?.Count ?? 0) naloga</span>
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            @if (lagerProizvodnje == null)
                            {
                                <div class="alert alert-info m-3">
                                    <i class="bi bi-info-circle me-2"></i>
                                    Učitavanje podataka...
                                </div>
                            }
                            else if (!lagerProizvodnje.Any())
                            {
                                <div class="alert alert-warning m-3">
                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                    Nema podataka o lageru proizvodnje.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover mb-0">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Radni Nalog</th>
                                                <th>Artikal</th>
                                                <th>Pakovanje</th>
                                                <th class="text-end">Količina</th>
                                                <th class="text-end">Potrebna Količina</th>
                                                <th class="text-end">Fali do završetka</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in lagerProizvodnje)
                                            {
                                                <tr>
                                                    <td>
                                                        <span class="badge bg-primary">@item.BrojNaloga</span>
                                                    </td>
                                                    <td>@item.Artikal</td>
                                                    <td>@item.Pakovanje</td>
                                                    <td class="text-end fw-bold">@TypeMapping.FormatDecimal(item.Kolicina)</td>
                                                    <td class="text-end text-muted">@TypeMapping.FormatDecimal(item.PotrebnaKolicina)</td>
                                                    <td class="text-end">
                                                        @{
                                                            var faliDoZavrsetka = item.PotrebnaKolicina - item.Kolicina;
                                                            var badgeClass = faliDoZavrsetka > 0 ? "bg-warning" : "bg-success";
                                                        }
                                                        <span class="badge @badgeClass">@TypeMapping.FormatDecimal(faliDoZavrsetka)</span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot class="table-secondary">
                                            <tr>
                                                <th colspan="3" class="text-end">UKUPNO:</th>
                                                <th class="text-end text-info">@TypeMapping.FormatDecimal(lagerProizvodnje.Sum(x => x.Kolicina))</th>
                                                <th class="text-end text-muted">@TypeMapping.FormatDecimal(lagerProizvodnje.Sum(x => x.PotrebnaKolicina))</th>
                                                <th class="text-end text-warning">@TypeMapping.FormatDecimal(lagerProizvodnje.Sum(x => x.PotrebnaKolicina - x.Kolicina))</th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        }

        <!-- LAGER AMBALAŽE TAB -->
        @if (aktivniTab == "ambalaza")
        {
        <div role="tabpanel">
            <!-- Podtabovi: Kutije / Kese -->
            <ul class="nav nav-pills mb-3">
                <li class="nav-item">
                    <button class="nav-link @(ambalazaPodtab == "kutije" ? "active" : "")" @onclick='() => UcitajAmbalazuTab("kutije")'>
                        <i class="bi bi-box me-1"></i>Kutije
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ambalazaPodtab == "kese" ? "active" : "")" @onclick='() => UcitajAmbalazuTab("kese")'>
                        <i class="bi bi-bag me-1"></i>Kese
                    </button>
                </li>
            </ul>

            @{
                var ambalazaLista = ambalazaPodtab == "kutije" ? kutijeStanje : keseStanje;
                var ambalazaExportNaziv = ambalazaPodtab == "kutije" ? "ambalaza_kutije" : "ambalaza_kese";
            }

            <div class="row mb-3">
                <div class="col-12 text-end">
                    <div class="btn-group">
                        <button class="btn btn-success btn-sm" @onclick="() => ExportAmbalazaExcel(ambalazaLista, ambalazaExportNaziv)" disabled="@(ambalazaLista?.Count == 0)">
                            <i class="bi bi-file-earmark-excel me-1"></i>Excel
                        </button>
                        <button class="btn btn-danger btn-sm" @onclick="() => ExportAmbalazaPdf(ambalazaLista, ambalazaExportNaziv)" disabled="@(ambalazaLista?.Count == 0)">
                            <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                        </button>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card bg-warning text-dark">
                        <div class="card-body text-center">
                            <h5>Ukupno artikala</h5>
                            <h3>@(ambalazaLista?.Count ?? 0)</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body text-center">
                            <h5>Na lageru</h5>
                            <h3>@TypeMapping.FormatDecimal(ambalazaLista?.Sum(x => x.Kolicina) ?? 0)</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-info text-white">
                        <div class="card-body text-center">
                            <h5>U proizvodnji</h5>
                            <h3>@(ambalazaLista?.Sum(x => decimal.TryParse(x.Pakovanje, out var v) ? v : 0).ToString("N0") ?? "0")</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body text-center">
                            <h5>Dostupno</h5>
                            <h3>@(ambalazaLista?.Sum(x => decimal.TryParse(x.Lot, out var v) ? v : 0).ToString("N0") ?? "0")</h3>
                        </div>
                    </div>
                </div>
            </div>

            @if (ambalazaLista == null)
            {
                <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>Učitavanje podataka...</div>
            }
            else if (!ambalazaLista.Any())
            {
                <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>Nema podataka.</div>
            }
            else
            {
                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Artikal</th>
                                        <th class="text-end">Količina</th>
                                        <th class="text-end">U Proizvodnji</th>
                                        <th class="text-end">Za najavljene Utovare</th>
                                        <th class="text-end">Dostupno</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in ambalazaLista)
                                    {
                                        decimal ukupno = 0; decimal.TryParse(item.Lot ?? "0", out ukupno);
                                        var stockClass = GetStockClass(ukupno, 100);
                                        var (stockStatus, stockBadgeClass, stockIcon) = TypeMapping.GetQuantityStatus(ukupno);
                                        <tr class="@stockClass">
                                            <td><strong>@item.Artikal</strong></td>
                                            <td class="text-end"><span class="fw-bold">@TypeMapping.FormatDecimal(item.Kolicina)</span></td>
                                            <td class="text-end"><span class="badge bg-primary">@item.Pakovanje</span></td>
                                            <td class="text-end"><span class="badge bg-info">@(item.ZaNajavljeneUtovare ?? "0")</span></td>
                                            <td class="text-end"><strong class="text-success">@item.Lot</strong></td>
                                            <td><span class="badge @stockBadgeClass"><i class="@stockIcon"></i> @stockStatus</span></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-secondary">
                                    <tr>
                                        <th class="text-end">UKUPNO:</th>
                                        <th class="text-end text-primary">@TypeMapping.FormatDecimal(ambalazaLista.Sum(x => x.Kolicina))</th>
                                        <th class="text-end text-warning">@ambalazaLista.Sum(x => decimal.TryParse(x.Pakovanje, out var v) ? v : 0).ToString("N0")</th>
                                        <th class="text-end text-danger">@ambalazaLista.Sum(x => decimal.TryParse(x.ZaNajavljeneUtovare, out var v) ? v : 0).ToString("N0")</th>
                                        <th class="text-end text-success">@ambalazaLista.Sum(x => decimal.TryParse(x.Lot, out var v) ? v : 0).ToString("N0")</th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
        }

        <!-- LAGER SIROVINA TAB -->
        @if (aktivniTab == "sirovine")
        {
        <div role="tabpanel">
            <!-- Podtabovi: Sirovine / Poluproizvodi -->
            <ul class="nav nav-pills mb-3">
                <li class="nav-item">
                    <button class="nav-link @(sirovinePodtab == "sirovine" ? "active" : "")" @onclick='() => UcitajSirovineTab("sirovine")'>
                        <i class="bi bi-droplet me-1"></i>Sirovine
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(sirovinePodtab == "poluproizvodi" ? "active" : "")" @onclick='() => UcitajSirovineTab("poluproizvodi")'>
                        <i class="bi bi-layers me-1"></i>Poluproizvodi
                    </button>
                </li>
            </ul>

            @{
                var sirovineLista = sirovinePodtab == "sirovine" ? sirovineStanje : poluproizvodiStanje;
                var sirovineExportNaziv = sirovinePodtab == "sirovine" ? "roba_sirovine" : "roba_poluproizvodi";
            }

            <div class="row mb-3">
                <div class="col-12 text-end">
                    <div class="btn-group">
                        <button class="btn btn-success btn-sm" @onclick="() => ExportSirovineExcel(sirovineLista, sirovineExportNaziv)" disabled="@(sirovineLista?.Count == 0)">
                            <i class="bi bi-file-earmark-excel me-1"></i>Excel
                        </button>
                        <button class="btn btn-danger btn-sm" @onclick="() => ExportSirovinePdf(sirovineLista, sirovineExportNaziv)" disabled="@(sirovineLista?.Count == 0)">
                            <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                        </button>
                    </div>
                </div>
            </div>

            @if (sirovineLista == null)
            {
                <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>Učitavanje podataka...</div>
            }
            else if (!sirovineLista.Any())
            {
                <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>Nema podataka.</div>
            }
            else
            {
                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Artikal</th>
                                        <th class="text-end">Količina</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in sirovineLista)
                                    {
                                        var stockClass = GetStockClass(item.Kolicina, 100);
                                        var (stockStatus, stockBadgeClass, stockIcon) = TypeMapping.GetQuantityStatus(item.Kolicina);
                                        <tr class="@stockClass">
                                            <td><strong>@item.Artikal</strong></td>
                                            <td class="text-end"><span class="fw-bold">@TypeMapping.FormatDecimal(item.Kolicina)</span></td>
                                            <td><span class="badge @stockBadgeClass"><i class="@stockIcon"></i> @stockStatus</span></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-secondary">
                                    <tr>
                                        <th class="text-end">UKUPNO:</th>
                                        <th class="text-end text-primary">@TypeMapping.FormatDecimal(sirovineLista.Sum(x => x.Kolicina))</th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
        }

    </div>
</div>

@code {
    private string aktivniTab = "magacin";

    // Magacin Lager
    private List<MagacinLagerModel>? lagerStanje;
    private List<RadniNalogLagerModel>? lagerProizvodnje;
    private List<string>? pakovanjeLista;
    private FilterRequest filterRequest = new FilterRequest();
    private decimal ukupnaVrednostLager = 0;
    private List<QuickFilter> quickFilters = new();

    // Ambalaža
    private string ambalazaPodtab = "kutije";
    private List<MagacinLagerModel>? kutijeStanje;
    private List<MagacinLagerModel>? keseStanje;

    // Sirovine
    private string sirovinePodtab = "sirovine";
    private List<MagacinLagerModel>? sirovineStanje;
    private List<MagacinLagerModel>? poluproizvodiStanje;

    protected override async Task OnInitializedAsync()
    {
        quickFilters = TypeMapping.GetMagacinQuickFilters();
        await UcitajListeZaFiltriranje();
        await UcitajPodatke();
    }

    private async Task PrebaciiNaTab(string tab)
    {
        aktivniTab = tab;
        switch (tab)
        {
            case "proizvodnja" when lagerProizvodnje == null:
                await UcitajLagerProizvodnje();
                break;
            case "ambalaza" when kutijeStanje == null:
                await UcitajAmbalazuTab("kutije");
                break;
            case "sirovine" when sirovineStanje == null:
                await UcitajSirovineTab("sirovine");
                break;
        }
    }

    private async Task UcitajAmbalazuTab(string podtab)
    {
        ambalazaPodtab = podtab;
        try
        {
            if (podtab == "kutije" && kutijeStanje == null)
                kutijeStanje = await LagerService.UcitajKutije(new FilterRequest());
            else if (podtab == "kese" && keseStanje == null)
                keseStanje = await LagerService.UcitajKese(new FilterRequest());
            StateHasChanged();
        }
        catch (Exception ex) { Console.WriteLine($"Greška ambalaža: {ex.Message}"); }
    }

    private async Task UcitajSirovineTab(string podtab)
    {
        sirovinePodtab = podtab;
        try
        {
            if (podtab == "sirovine" && sirovineStanje == null)
                sirovineStanje = await LagerService.UcitajSirovine(new FilterRequest());
            else if (podtab == "poluproizvodi" && poluproizvodiStanje == null)
                poluproizvodiStanje = await LagerService.UcitajPoluproizvode(new FilterRequest());
            StateHasChanged();
        }
        catch (Exception ex) { Console.WriteLine($"Greška sirovine: {ex.Message}"); }
    }

