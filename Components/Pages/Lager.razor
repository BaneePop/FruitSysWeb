@page "/lager"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using FruitSysWeb.Models
@using FruitSysWeb.Services
@using FruitSysWeb.Services.Models.Requests
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Core
@using FruitSysWeb.Constants
@inject IMagacinLagerService LagerService
@inject IExportService ExportService
@inject ITypeMappingService TypeMapping
@inject IJSRuntime JSRuntime

<style>
    .low-stock { background-color: #fff5f5; border-left: 4px solid #dc3545; }
    .medium-stock { background-color: #fff8e1; border-left: 4px solid #ffc107; }
    .high-stock { background-color: #f0f9ff; border-left: 4px solid #198754; }
    
    .stock-alert {
        padding: 0.25rem 0.5rem;
        border-radius: 0.375rem;
        font-size: 0.75rem;
        font-weight: 600;
    }
    
    .artikal-tip-badge {
        font-size: 0.7rem;
        padding: 0.25rem 0.5rem;
    }
    
    .nav-tabs-vertical {
        border-right: 1px solid #dee2e6;
        border-bottom: none;
    }
    
    .nav-tabs-vertical .nav-link {
        border: 1px solid transparent;
        border-right: none;
        margin-bottom: 2px;
    }
    
    .nav-tabs-vertical .nav-link.active {
        border-color: #dee2e6 #fff #dee2e6 #dee2e6;
    }
</style>

<div class="container-fluid">
    <!-- Header -->
    <div class="bg-info text-white py-3 mb-4">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h1 class="h3 mb-0">
                        <i class="bi bi-archive me-2"></i>
                        Magacin Lager
                    </h1>
                    <small class="opacity-75">Trenutno stanje zaliha po svim magacinima — količine i vrednosti artikala</small>
                </div>
                <div class="col-md-6 text-end">
                    <span class="badge bg-light text-dark fs-6">
                        <i class="bi bi-box me-1"></i>@(lagerStanje?.Count ?? 0) artikala
                    </span>
                    <span class="badge bg-warning text-dark ms-2 fs-6">
                        Ukupno: @(lagerStanje?.Sum(x => x.Kolicina).ToString("N2") ?? "0.00") kg
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- TABS za različite preglede -->
    <div class="row mb-4">
        <div class="col-12">
            <ul class="nav nav-tabs" id="lagerTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="magacin-tab" data-bs-toggle="tab" data-bs-target="#magacin" type="button" role="tab">
                        <i class="bi bi-warehouse me-2"></i>Magacin Lager
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="proizvodnja-tab" data-bs-toggle="tab" data-bs-target="#proizvodnja" type="button" role="tab" @onclick="UcitajLagerProizvodnje">
                        <i class="bi bi-gear me-2"></i>Lager Proizvodnje
                    </button>
                </li>
            </ul>
        </div>
    </div>

    <div class="tab-content" id="lagerTabContent">
        <!-- MAGACIN LAGER TAB -->
        <div class="tab-pane fade show active" id="magacin" role="tabpanel">
            <!-- REFAKTORISANI Filter Section - koristi TypeMappingService -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card border-info">
                        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-funnel me-2"></i>Filteri pretrage
                            </h5>
                            <div class="btn-group">
                                <button class="btn btn-success btn-sm" @onclick="ExportToExcel" disabled="@(lagerStanje?.Count == 0)">
                                    <i class="bi bi-file-earmark-excel me-1"></i>Excel
                                </button>
                                <button class="btn btn-danger btn-sm" @onclick="ExportToPdf" disabled="@(lagerStanje?.Count == 0)">
                                    <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-bold">Tip artikla:</label>
                                    <select class="form-select" @bind="filterRequest.Tip">
                                        @foreach(var option in TypeMapping.GetMagacinDropdownOptions())
                                        {
                                            <option value="@option.Value">@option.Text</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-2 mb-3 d-flex align-items-end">
                                    <div class="d-flex gap-2 w-100">
                                        <button class="btn btn-info w-100" @onclick="UcitajPodatke">
                                            <i class="bi bi-search me-2"></i>Filtriraj
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Results Section -->
            @if (lagerStanje == null)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    Učitavanje podataka...
                </div>
            }
            else if (!lagerStanje.Any())
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Nema podataka za prikaz sa trenutnim filterima.
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-light">
                                <h5 class="card-title mb-0">
                                    <i class="bi bi-list-check me-2"></i>
                                    Magacin Lager Stanje
                                    <span class="badge bg-info ms-2">@lagerStanje.Count artikala</span>
                                </h5>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover mb-0">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Tip</th>
                                                <th>Artikal</th>
                                                <th class="text-end">Količina</th>
                                                <th>Pakovanje</th>
                                                <th>JM</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in lagerStanje)
                                            {
                                                var stockClass = GetStockClass(item.Kolicina, SystemConstants.Lager.DEFAULT_MIN_KOLICINA);
                                                var (stockStatus, stockBadgeClass, stockIcon) = TypeMapping.GetQuantityStatus(item.Kolicina);
                                                
                                                <tr class="@stockClass">
                                                    <td>
                                                        <span class="badge bg-secondary artikal-tip-badge">
                                                            @item.TipArtikla
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <strong>@item.Artikal</strong>
                                                    </td>
                                                    <td class="text-end">
                                                        <span class="fw-bold">@TypeMapping.FormatDecimal(item.Kolicina)</span>
                                                    </td>
                                                    <td>@item.Pakovanje</td>
                                                    <td>@item.JM</td>
                                                    <td>
                                                        <span class="badge @stockBadgeClass">
                                                            <i class="@stockIcon"></i> @stockStatus
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot class="table-secondary">
                                            <tr>
                                                <th colspan="2" class="text-end">UKUPNO:</th>
                                                <th class="text-end text-info">@TypeMapping.FormatDecimal(lagerStanje.Sum(x => x.Kolicina))</th>
                                                <th colspan="3"></th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- LAGER PROIZVODNJE TAB -->
        <div class="tab-pane fade" id="proizvodnja" role="tabpanel">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-gear me-2"></i>
                                Lager Proizvodnje
                                <span class="badge bg-info ms-2">@(lagerProizvodnje?.Count ?? 0) naloga</span>
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            @if (lagerProizvodnje == null)
                            {
                                <div class="alert alert-info m-3">
                                    <i class="bi bi-info-circle me-2"></i>
                                    Učitavanje podataka...
                                </div>
                            }
                            else if (!lagerProizvodnje.Any())
                            {
                                <div class="alert alert-warning m-3">
                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                    Nema podataka o lageru proizvodnje.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover mb-0">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Radni Nalog</th>
                                                <th>Artikal</th>
                                                <th>Pakovanje</th>
                                                <th class="text-end">Količina</th>
                                                <th class="text-end">Potrebna Količina</th>
                                                <th class="text-end">Fali do završetka</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in lagerProizvodnje)
                                            {
                                                <tr>
                                                    <td>
                                                        <span class="badge bg-primary">@item.BrojNaloga</span>
                                                    </td>
                                                    <td>@item.Artikal</td>
                                                    <td>@item.Pakovanje</td>
                                                    <td class="text-end fw-bold">@TypeMapping.FormatDecimal(item.Kolicina)</td>
                                                    <td class="text-end text-muted">@TypeMapping.FormatDecimal(item.PotrebnaKolicina)</td>
                                                    <td class="text-end">
                                                        @{
                                                            var faliDoZavrsetka = item.PotrebnaKolicina - item.Kolicina;
                                                            var badgeClass = faliDoZavrsetka > 0 ? "bg-warning" : "bg-success";
                                                        }
                                                        <span class="badge @badgeClass">@TypeMapping.FormatDecimal(faliDoZavrsetka)</span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot class="table-secondary">
                                            <tr>
                                                <th colspan="3" class="text-end">UKUPNO:</th>
                                                <th class="text-end text-info">@TypeMapping.FormatDecimal(lagerProizvodnje.Sum(x => x.Kolicina))</th>
                                                <th class="text-end text-muted">@TypeMapping.FormatDecimal(lagerProizvodnje.Sum(x => x.PotrebnaKolicina))</th>
                                                <th class="text-end text-warning">@TypeMapping.FormatDecimal(lagerProizvodnje.Sum(x => x.PotrebnaKolicina - x.Kolicina))</th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<MagacinLagerModel>? lagerStanje;
    private List<RadniNalogLagerModel>? lagerProizvodnje;
    private List<string>? pakovanjeLista;
    private FilterRequest filterRequest = new FilterRequest();
    private decimal ukupnaVrednostLager = 0;
    
    // DODATO: Quick filter state tracking
    private List<QuickFilter> quickFilters = new();

    protected override async Task OnInitializedAsync()
    {
        // REFAKTORISANO: Load quick filters from TypeMapping
        quickFilters = TypeMapping.GetMagacinQuickFilters();
        
        await UcitajListeZaFiltriranje();
        await UcitajPodatke();
    }

    private async Task UcitajListeZaFiltriranje()
    {
        try
        {
            pakovanjeLista = await LagerService.UcitajListuPakovanja();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška pri učitavanju lista: {ex.Message}");
            pakovanjeLista = new List<string>();
        }
    }

    private async Task UcitajPodatke()
    {
        try
        {
            lagerStanje = await LagerService.UcitajLagerStanjeSaFilterima(filterRequest);
            ukupnaVrednostLager = await LagerService.UcitajUkupnuVrednostLager();
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška pri učitavanju lager podataka: {ex.Message}");
            lagerStanje = new List<MagacinLagerModel>();
        }
    }

    private async Task UcitajLagerProizvodnje()
    {
        try
        {
            lagerProizvodnje = await LagerService.UcitajLagerProizvodnje();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška pri učitavanju lager proizvodnje: {ex.Message}");
            lagerProizvodnje = new List<RadniNalogLagerModel>();
        }
    }

    // REFAKTORISANO: Quick filter handling sa TypeMapping
    private void ToggleQuickFilter(QuickFilter filter)
    {
        // Reset all quick filters first
        foreach(var qf in quickFilters)
        {
            qf.IsActive = false;
        }
        
        // Reset filter properties
        filterRequest.SamoGotoveRobe = null;
        filterRequest.SamoSirovine = null;
        filterRequest.SamoAmbalaže = null;
        filterRequest.Tip = "";

        // Activate the selected filter
        filter.IsActive = true;
        filterRequest.Tip = filter.MagacinId.ToString();

        // Set appropriate boolean flag
        switch (filter.MagacinId)
        {
            case MagacinTypes.GOTOVA_ROBA:  // 6
                filterRequest.SamoGotoveRobe = true;
                break;
            case MagacinTypes.SIROVINE:     // 3
                filterRequest.SamoSirovine = true;
                break;
            case MagacinTypes.AMBALAZA:     // 4
                filterRequest.SamoAmbalaže = true;
                break;
        }
    }

    // REFAKTORISANO: Quick filter button class using TypeMapping
    private string GetQuickFilterButtonClass(QuickFilter filter)
    {
        if (filter.IsActive)
        {
            return filter.MagacinId switch
            {
                MagacinTypes.GOTOVA_ROBA => "btn-success",
                MagacinTypes.SIROVINE => "btn-primary",
                MagacinTypes.AMBALAZA => "btn-warning",
                _ => "btn-info"
            };
        }
        else
        {
            return filter.MagacinId switch
            {
                MagacinTypes.GOTOVA_ROBA => "btn-outline-success",
                MagacinTypes.SIROVINE => "btn-outline-primary", 
                MagacinTypes.AMBALAZA => "btn-outline-warning",
                _ => "btn-outline-info"
            };
        }
    }

    // STARA METODA - OBRISANA: ToggleFilter

    private async Task ResetujFiltere()
    {
        filterRequest = new FilterRequest();
        
        // Reset quick filters
        foreach(var qf in quickFilters)
        {
            qf.IsActive = false;
        }
        
        await UcitajPodatke();
    }

    private string GetStockClass(decimal kolicina, decimal minimum)
    {
        if (kolicina < minimum) return "low-stock";
        if (kolicina < minimum * 2) return "medium-stock";
        return "high-stock";
    }

    private int GetArtikalTipAsInt(string? tip)
    {
        if (int.TryParse(tip, out int tipInt))
        {
            return tipInt;
        }
        return 0;
    }

    // OBRISANE METODE - ZAMENIO TypeMapping:
    // - GetBadgeClass() 
    // - GetDisplayName()

    // REFAKTORISANE STATISTIKE METODE sa TypeMapping konstante
    private decimal GetRobaUKilogramima()
    {
        if (lagerStanje == null) return 0;
        
        return lagerStanje
            .Where(x => x.JM != null && x.JM.ToLower().Contains("kg") && 
                       GetArtikalTipAsInt(x.ArtikalTip) != 7)  // 7 = Kalo i Rastur
            .Sum(x => x.Kolicina);
    }

    private decimal GetUsluzniLager()
    {
        if (lagerStanje == null) return 0;
        
        return lagerStanje
            .Where(x => {
                var magacinId = GetArtikalTipAsInt(x.ArtikalTip);
                return magacinId == MagacinTypes.USL_MLEKO ||  // 8
                       magacinId == MagacinTypes.USL_VOCE ||            // 11
                       magacinId == MagacinTypes.USL_MESO;                 // 12
            })
            .Sum(x => x.Kolicina);
    }

    private decimal GetPoluproizvodi()
    {
        if (lagerStanje == null) return 0;
        
        return lagerStanje
            .Where(x => GetArtikalTipAsInt(x.ArtikalTip) == MagacinTypes.POLUPROIZVODI)  // 5
            .Sum(x => x.Kolicina);
    }

    // Export metode - REFAKTORISANE sa TypeMapping
    private async Task ExportToExcel()
    {
        try
        {
            if (lagerStanje != null && lagerStanje.Any())
            {
                // Definiši samo kolone koje se prikazuju u tabeli
                var columns = new Dictionary<string, string>
                {
                    { "TipArtikla", "Tip" },
                    { "Artikal", "Artikal" },
                    { "Kolicina", "Količina" },
                    { "Pakovanje", "Pakovanje" },
                    { "JM", "JM" }
                };

                var excelData = ExportService.ExportToExcelWithColumns(lagerStanje, columns);
                var fileName = TypeMapping.GenerateExportFileName("lager_stanje", SystemConstants.Export.EXCEL_EXTENSION);
                await DownloadFile(excelData, fileName, SystemConstants.Export.EXCEL_MIME_TYPE);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Greška pri exportu u Excel: {ex.Message}");
        }
    }

    private async Task ExportToPdf()
    {
        try
        {
            if (lagerStanje != null && lagerStanje.Any())
            {
                // Definiši samo kolone koje se prikazuju u tabeli
                var columns = new Dictionary<string, string>
                {
                    { "TipArtikla", "Tip" },
                    { "Artikal", "Artikal" },
                    { "Kolicina", "Količina" },
                    { "Pakovanje", "Pakovanje" },
                    { "JM", "JM" }
                };

                var pdfData = ExportService.ExportToPdfWithColumns(lagerStanje, columns);
                var fileName = TypeMapping.GenerateExportFileName("lager_stanje", SystemConstants.Export.PDF_EXTENSION);
                await DownloadFile(pdfData, fileName, SystemConstants.Export.PDF_MIME_TYPE);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Greška pri exportu u PDF: {ex.Message}");
        }
    }

    private async Task DownloadFile(byte[] data, string fileName, string mimeType)
    {
        await JSRuntime.InvokeVoidAsync("downloadFile", Convert.ToBase64String(data), fileName, mimeType);
    }
}
