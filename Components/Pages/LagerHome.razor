@page "/lagerhome"
@rendermode @(new InteractiveServerRenderMode())
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Models.Requests
@using FruitSysWeb.Services.Core
@using FruitSysWeb.Components.Shared.Layout
@using FruitSysWeb.Components.Charts
@using FruitSysWeb.Models

@inject NavigationManager NavigationManager
@inject IMagacinLagerService LagerService
@inject ITypeMappingService TypeMapping
@inject IProizvodnjaService ProizvodnjaService
@inject IBrziPregledService BrziPregledService
@inject ILogger<LagerHome> Logger

@* All styles moved to wwwroot/css/shared-components.css *@

<!-- Header -->
<div class="lager-header text-white py-4 mb-4">
    <div class="container-fluid">
        <h1 class="h2 mb-1">
            <i class="bi bi-boxes me-2"></i>Lager - Upravljanje zalihama
        </h1>
        <p class="mb-0">Centralno upravljanje magacinskim poslovima i zalihama</p>
    </div>
</div>

<div class="container-fluid">
    <!-- Main Sections -->
    <div class="section-grid">
        <div class="section-card" @onclick="@(() => NavigateTo("/lager"))">
            <div class="section-icon">
                <i class="bi bi-archive"></i>
            </div>
            <h4 class="section-title">Magacin Lager</h4>
        </div>

        <div class="section-card" @onclick="@(() => NavigateTo("/lager-proizvodnje"))">
            <div class="section-icon">
                <i class="bi bi-gear-wide-connected"></i>
            </div>
            <h4 class="section-title">Lager Proizvodnje</h4>
        </div>
        <div class="section-card" @onclick="@(() => NavigateTo("/ambalaza"))">
            <div class="section-icon">
                <i class="bi bi-box-seam"></i>
            </div>
            <h4 class="section-title">Lager Ambalaže</h4>
        </div>

        <div class="section-card" @onclick="@(() => NavigateTo("/roba"))">
            <div class="section-icon">
                <i class="bi bi-droplet"></i>
            </div>
            <h4 class="section-title">Lager Sirovina</h4>
        </div>
    </div>

    <!-- Dashboard Analitika -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5>
                    <i class="bi bi-graph-up me-2"></i>Dashboard Analitika
                </h5>
                <button class="btn btn-sm btn-primary" @onclick="RefreshCharts" disabled="@IsRefreshing">
                    <i class="bi bi-arrow-clockwise @(IsRefreshing ? "spin" : "")"></i>
                    @(IsRefreshing ? "Osvežavam..." : "Osveži")
                </button>
            </div>
        </div>
    </div>

    <!-- Nabavka i Prodaja po Vrsti Voća -->
    <div class="row mb-4">
        <!-- Nabavka Chart -->
        <div class="col-md-6 mb-3">
            <ApexMultiSeriesLineChart
                Title="Nabavka po Vrsti Voća (Poslednjih 30 Dana)"
                Icon="bi bi-cart-plus"
                SeriesData="@nabavkaSeriesData"
                Unit="kg"
                IsWeight="true"
                IsLoading="@isLoadingNabavka"
                HasError="@hasErrorNabavka"
                ShowSummary="true"
                ShowVrednost="false"
                Height="450"
                OnRefresh="@UcitajNabavkuPodatke" />
        </div>
        <!-- Prodaja Chart -->
        <div class="col-md-6 mb-3">
            <ApexMultiSeriesLineChart
                Title="Prodaja po Vrsti Voća (Poslednjih 30 Dana)"
                Icon="bi bi-cart-check"
                SeriesData="@prodajaSeriesData"
                Unit="kg"
                IsWeight="true"
                IsLoading="@isLoadingProdaja"
                HasError="@hasErrorProdaja"
                ShowSummary="true"
                ShowVrednost="false"
                Height="450"
                OnRefresh="@UcitajProdajuPodatke" />
        </div>
    </div>

    <!-- Struktura Lagera - 4 Charts -->
    <div class="row mb-4">
        <div class="col-lg-3 mb-3">
            <ApexBarChart 
                Title="Struktura Sirovina"
                Icon="bi bi-basket"
                SeriesName="Količina"
                Unit="kg"
                Data="@SirovineData"
                IsLoading="@IsLoadingSirovine"
                HasError="@HasErrorSirovine"
                ShowSummary="false"
                OnRefresh="@RefreshSirovine" />
        </div>
        <div class="col-lg-3 mb-3">
            <ApexBarChart 
                Title="Struktura Gotovih Proizvoda"
                Icon="bi bi-box2"
                SeriesName="Količina"
                Unit="kg"
                Data="@GotoviProizvodiData"
                IsLoading="@IsLoadingGotovi"
                HasError="@HasErrorGotovi"
                ShowSummary="false"
                OnRefresh="@RefreshGotovi" />
        </div>
        <div class="col-lg-3 mb-3">
            <ApexBarChart 
                Title="Struktura Kutija/Džakova"
                Icon="bi bi-box"
                SeriesName="Količina"
                Unit="kom"
                Data="@KutijeData"
                IsLoading="@IsLoadingKutije"
                HasError="@HasErrorKutije"
                ShowSummary="false"
                OnRefresh="@RefreshKutije" />
        </div>
        <div class="col-lg-3 mb-3">
            <ApexBarChart 
                Title="Struktura Kesa"
                Icon="bi bi-bag"
                SeriesName="Količina"
                Unit="kom"
                Data="@KesaData"
                IsLoading="@IsLoadingKesa"
                HasError="@HasErrorKesa"
                ShowSummary="false"
                OnRefresh="@RefreshKesa" />
        </div>
    </div>

    <!-- Navigation Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Početna</a></li>
            <li class="breadcrumb-item active">Lager</li>
        </ol>
    </nav>
</div>

@code {
    // Chart Data - Line Charts
    private List<ChartSeriesData> nabavkaSeriesData = new();
    private List<ChartSeriesData> prodajaSeriesData = new();

    // Chart Data - Bar Charts
    private List<ChartDataPoint>? SirovineData;
    private List<ChartDataPoint>? GotoviProizvodiData;
    private List<ChartDataPoint>? KutijeData;
    private List<ChartDataPoint>? KesaData;

    // Loading States
    private bool isLoadingNabavka = true;
    private bool isLoadingProdaja = true;
    private bool IsLoadingSirovine = false;
    private bool IsLoadingGotovi = false;
    private bool IsLoadingKutije = false;
    private bool IsLoadingKesa = false;
    private bool IsRefreshing = false;

    // Error States
    private bool hasErrorNabavka = false;
    private bool hasErrorProdaja = false;
    private bool HasErrorSirovine = false;
    private bool HasErrorGotovi = false;
    private bool HasErrorKutije = false;
    private bool HasErrorKesa = false;

    // Datumski filter
    private FilterRequest StatistikaFilter => new FilterRequest
    {
        OdDatum = new DateTime(2025, 6, 1),
        DoDatum = DateTime.Now
    };

    protected override async Task OnInitializedAsync()
    {
        await RefreshCharts();
    }

    private async Task RefreshCharts()
    {
        IsRefreshing = true;
        StateHasChanged();

        try
        {
            await Task.WhenAll(
                UcitajNabavkuPodatke(),
                UcitajProdajuPodatke(),
                RefreshSirovine(),
                RefreshGotovi(),
                RefreshKutije(),
                RefreshKesa()
            );
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing charts");
        }
        finally
        {
            IsRefreshing = false;
            StateHasChanged();
        }
    }

    private async Task UcitajNabavkuPodatke()
    {
        try
        {
            isLoadingNabavka = true;
            hasErrorNabavka = false;
            StateHasChanged();

            // Učitaj podatke po danima (za chart) i ukupne vrednosti (za summary)
            var podaciTask = BrziPregledService.UcitajNabavkuPoDanimaPoVociAsync();
            var ukupnoTask = BrziPregledService.UcitajUkupneVrednostiNabavkeAsync();

            await Task.WhenAll(podaciTask, ukupnoTask);

            var podaci = await podaciTask;
            var ukupno = await ukupnoTask;

            // Kreiraj kompletan set svih datuma (unija svih datuma iz svih vrsta voća)
            var sviDatumi = podaci
                .SelectMany(voce => voce.Value.Keys)
                .Distinct()
                .OrderBy(d => {
                    // Sortiraj po datumu parsiranjem "dd.MM" formata
                    var parts = d.Split('.');
                    if (parts.Length == 2 && int.TryParse(parts[0], out var day) && int.TryParse(parts[1], out var month))
                    {
                        return new DateTime(DateTime.Now.Year, month, day);
                    }
                    return DateTime.MinValue;
                })
                .ToList();

            // Konvertuj Dictionary<VrstaVoca, Dictionary<Datum, Kolicina>> u ChartSeriesData
            nabavkaSeriesData = podaci
                .Select(voce => new ChartSeriesData
                {
                    Name = voce.Key,
                    Data = sviDatumi
                        .Select(datum => new ChartDataPoint
                        {
                            Label = datum,
                            Value = voce.Value.ContainsKey(datum) ? voce.Value[datum] : 0
                        })
                        .ToList(),
                    Color = ChartDataHelper.GetFruitColor(voce.Key),
                    TotalKolicina = ukupno.ContainsKey(voce.Key) ? ukupno[voce.Key].Kolicina : 0,
                    TotalVrednost = ukupno.ContainsKey(voce.Key) ? ukupno[voce.Key].Vrednost : 0
                })
                .ToList();

            isLoadingNabavka = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading nabavka data");
            hasErrorNabavka = true;
            isLoadingNabavka = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task UcitajProdajuPodatke()
    {
        try
        {
            isLoadingProdaja = true;
            hasErrorProdaja = false;
            StateHasChanged();

            // Učitaj podatke po danima (za chart) i ukupne vrednosti (za summary)
            var podaciTask = BrziPregledService.UcitajProdajuPoDanimaPoVociAsync();
            var ukupnoTask = BrziPregledService.UcitajUkupneVrednostiProdajeAsync();

            await Task.WhenAll(podaciTask, ukupnoTask);

            var podaci = await podaciTask;
            var ukupno = await ukupnoTask;

            // Kreiraj kompletan set svih datuma (unija svih datuma iz svih vrsta voća)
            var sviDatumi = podaci
                .SelectMany(voce => voce.Value.Keys)
                .Distinct()
                .OrderBy(d => {
                    // Sortiraj po datumu parsiranjem "dd.MM" formata
                    var parts = d.Split('.');
                    if (parts.Length == 2 && int.TryParse(parts[0], out var day) && int.TryParse(parts[1], out var month))
                    {
                        return new DateTime(DateTime.Now.Year, month, day);
                    }
                    return DateTime.MinValue;
                })
                .ToList();

            // Konvertuj Dictionary<VrstaVoca, Dictionary<Datum, Kolicina>> u ChartSeriesData
            prodajaSeriesData = podaci
                .Select(voce => new ChartSeriesData
                {
                    Name = voce.Key,
                    Data = sviDatumi
                        .Select(datum => new ChartDataPoint
                        {
                            Label = datum,
                            Value = voce.Value.ContainsKey(datum) ? voce.Value[datum] : 0
                        })
                        .ToList(),
                    Color = ChartDataHelper.GetFruitColor(voce.Key),
                    TotalKolicina = ukupno.ContainsKey(voce.Key) ? ukupno[voce.Key].Kolicina : 0,
                    TotalVrednost = ukupno.ContainsKey(voce.Key) ? ukupno[voce.Key].Vrednost : 0
                })
                .ToList();

            isLoadingProdaja = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading prodaja data");
            hasErrorProdaja = true;
            isLoadingProdaja = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task RefreshSirovine()
    {
        if (IsLoadingSirovine) return;
        
        IsLoadingSirovine = true;
        HasErrorSirovine = false;
        StateHasChanged();

        try
        {
            await Task.Delay(250);
            var data = await LagerService.UcitajStrukturuSirovina();
            SirovineData = ChartDataHelper.FromDictionary(data, 5);
            SirovineData = ChartDataHelper.TruncateLabels(SirovineData, 15);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading sirovine data");
            HasErrorSirovine = true;
            SirovineData = ChartDataHelper.GetMockData("Sirovina", 5);
        }
        finally
        {
            IsLoadingSirovine = false;
            StateHasChanged();
        }
    }

    private async Task RefreshGotovi()
    {
        if (IsLoadingGotovi) return;
        
        IsLoadingGotovi = true;
        HasErrorGotovi = false;
        StateHasChanged();

        try
        {
            await Task.Delay(300);
            var data = await LagerService.UcitajStrukturuGotovihProizvoda();
            GotoviProizvodiData = ChartDataHelper.FromDictionary(data, 5);
            GotoviProizvodiData = ChartDataHelper.TruncateLabels(GotoviProizvodiData, 15);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading gotovi proizvodi data");
            HasErrorGotovi = true;
            GotoviProizvodiData = ChartDataHelper.GetMockData("Proizvod", 5);
        }
        finally
        {
            IsLoadingGotovi = false;
            StateHasChanged();
        }
    }

    private async Task RefreshKutije()
    {
        if (IsLoadingKutije) return;
        
        IsLoadingKutije = true;
        HasErrorKutije = false;
        StateHasChanged();

        try
        {
            await Task.Delay(350);
            var data = await LagerService.UcitajStrukturuKutija();
            KutijeData = ChartDataHelper.FromDictionary(data, 5);
            KutijeData = ChartDataHelper.TruncateLabels(KutijeData, 15);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading kutije data");
            HasErrorKutije = true;
            KutijeData = ChartDataHelper.GetMockData("Kutija", 5);
        }
        finally
        {
            IsLoadingKutije = false;
            StateHasChanged();
        }
    }

    private async Task RefreshKesa()
    {
        if (IsLoadingKesa) return;
        
        IsLoadingKesa = true;
        HasErrorKesa = false;
        StateHasChanged();

        try
        {
            await Task.Delay(400);
            var data = await LagerService.UcitajStrukturuKesa();
            KesaData = ChartDataHelper.FromDictionary(data, 5);
            KesaData = ChartDataHelper.TruncateLabels(KesaData, 15);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading kesa data");
            HasErrorKesa = true;
            KesaData = ChartDataHelper.GetMockData("Kesa", 5);
        }
        finally
        {
            IsLoadingKesa = false;
            StateHasChanged();
        }
    }

    private void NavigateTo(string url)
    {
        NavigationManager.NavigateTo(url);
    }
}
