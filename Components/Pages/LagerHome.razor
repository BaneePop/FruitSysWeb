@page "/lagerhome"
@rendermode @(new InteractiveServerRenderMode())
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Models.Requests
@using FruitSysWeb.Services.Core
@using FruitSysWeb.Components.Shared.Layout
@using FruitSysWeb.Components.Charts
@using FruitSysWeb.Models

@inject NavigationManager NavigationManager
@inject IMagacinLagerService LagerService
@inject ITypeMappingService TypeMapping
@inject IProizvodnjaService ProizvodnjaService
@inject IBrziPregledService BrziPregledService
@inject ILogger<LagerHome> Logger

@* All styles moved to wwwroot/css/shared-components.css *@

<!-- Header -->
<div class="lager-header text-white py-3 mb-4">
    <div class="container-fluid">
        <h1 class="h2 mb-1">
            <i class="bi bi-boxes me-2"></i>Lager Početna
        </h1>
        <p class="mb-0 opacity-75">Pregled stanja magacinskih zaliha — sirovine, gotovi proizvodi, ambalaža i kretanje lagera po sezoni</p>
    </div>
</div>

<div class="container-fluid">
    <!-- Main Sections -->
    <div class="section-grid" style="grid-template-columns: repeat(5, 1fr);">
        <div class="section-card" @onclick="@(() => NavigateTo("/lager"))">
            <div class="section-icon">
                <i class="bi bi-archive"></i>
            </div>
            <h4 class="section-title">Magacin Lager</h4>
        </div>

        <div class="section-card" @onclick="@(() => NavigateTo("/lager-proizvodnje"))">
            <div class="section-icon">
                <i class="bi bi-gear-wide-connected"></i>
            </div>
            <h4 class="section-title">Lager Proizvodnje</h4>
        </div>
        <div class="section-card" @onclick="@(() => NavigateTo("/ambalaza"))">
            <div class="section-icon">
                <i class="bi bi-box-seam"></i>
            </div>
            <h4 class="section-title">Lager Ambalaže</h4>
        </div>

        <div class="section-card" @onclick="@(() => NavigateTo("/roba"))">
            <div class="section-icon">
                <i class="bi bi-droplet"></i>
            </div>
            <h4 class="section-title">Lager Sirovina</h4>
        </div>

        <div class="section-card" @onclick="@(() => NavigateTo("/stanje-kese-altiva"))">
            <div class="section-icon">
                <i class="bi bi-bag-check"></i>
            </div>
            <h4 class="section-title">Stanje Kesa Altiva</h4>
        </div>
    </div>

    <!-- Area chart: Stanje lagera po vrsti voća kroz vreme -->
    <div class="row mb-4">
        <div class="col-12">
            <ApexAreaChart
                Title="@($"Stanje Lagera po Vrsti Voća ({lagerOdDatum:dd.MM.yyyy} – {lagerDoDatum:dd.MM.yyyy})")"
                Icon="bi bi-layers"
                SeriesData="@lagerSeriesData"
                Unit="kg"
                IsLoading="@isLoadingLager"
                HasError="@hasErrorLager"
                ShowSummary="true"
                Height="480"
                Interval="@lagerInterval"
                OnIntervalChanged="@OnLagerIntervalChanged"
                OnRefresh="@UcitajLager" />
        </div>
    </div>

    <!-- Area chart: Nabavka po vrsti voća kroz vreme -->
    <div class="row mb-4">
        <div class="col-12">
            <ApexAreaChart
                Title="@($"Nabavka po Vrsti Voća ({lagerOdDatum:dd.MM.yyyy} – {lagerDoDatum:dd.MM.yyyy})")"
                Icon="bi bi-cart-plus"
                SeriesData="@nabavkaSezonaSeriesData"
                Unit="kg"
                IsLoading="@isLoadingNabavkaSezona"
                HasError="@hasErrorNabavkaSezona"
                ShowSummary="true"
                Height="480"
                Interval="@nabavkaSezonaInterval"
                OnIntervalChanged="@OnNabavkaSezonaIntervalChanged"
                OnRefresh="@UcitajNabavkuSezona" />
        </div>
    </div>

    <!-- Area chart: Prodaja po vrsti voća kroz vreme -->
    <div class="row mb-4">
        <div class="col-12">
            <ApexAreaChart
                Title="@($"Prodaja po Vrsti Voća ({lagerOdDatum:dd.MM.yyyy} – {lagerDoDatum:dd.MM.yyyy})")"
                Icon="bi bi-cart-check"
                SeriesData="@prodajaSezonaSeriesData"
                Unit="kg"
                IsLoading="@isLoadingProdajaSezona"
                HasError="@hasErrorProdajaSezona"
                ShowSummary="true"
                Height="480"
                Interval="@prodajaSezonaInterval"
                OnIntervalChanged="@OnProdajaSezonaIntervalChanged"
                OnRefresh="@UcitajProdajuSezona" />
        </div>
    </div>

    <!-- Dashboard Analitika -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5>
                    <i class="bi bi-graph-up me-2"></i>Dashboard Analitika
                </h5>
                <button class="btn btn-sm btn-primary" @onclick="RefreshCharts" disabled="@IsRefreshing">
                    <i class="bi bi-arrow-clockwise @(IsRefreshing ? "spin" : "")"></i>
                    @(IsRefreshing ? "Osvežavam..." : "Osveži")
                </button>
            </div>
        </div>
    </div>

    <!-- Struktura Lagera - 4 Charts -->
    <div class="row mb-4">
        <div class="col-lg-3 mb-3">
            <ApexBarChart 
                Title="Struktura Sirovina"
                Icon="bi bi-basket"
                SeriesName="Količina"
                Unit="kg"
                Data="@SirovineData"
                IsLoading="@IsLoadingSirovine"
                HasError="@HasErrorSirovine"
                ShowSummary="false"
                OnRefresh="@RefreshSirovine" />
        </div>
        <div class="col-lg-3 mb-3">
            <ApexBarChart 
                Title="Struktura Gotovih Proizvoda"
                Icon="bi bi-box2"
                SeriesName="Količina"
                Unit="kg"
                Data="@GotoviProizvodiData"
                IsLoading="@IsLoadingGotovi"
                HasError="@HasErrorGotovi"
                ShowSummary="false"
                OnRefresh="@RefreshGotovi" />
        </div>
        <div class="col-lg-3 mb-3">
            <ApexBarChart 
                Title="Struktura Kutija/Džakova"
                Icon="bi bi-box"
                SeriesName="Količina"
                Unit="kom"
                Data="@KutijeData"
                IsLoading="@IsLoadingKutije"
                HasError="@HasErrorKutije"
                ShowSummary="false"
                OnRefresh="@RefreshKutije" />
        </div>
        <div class="col-lg-3 mb-3">
            <ApexBarChart 
                Title="Struktura Kesa"
                Icon="bi bi-bag"
                SeriesName="Količina"
                Unit="kom"
                Data="@KesaData"
                IsLoading="@IsLoadingKesa"
                HasError="@HasErrorKesa"
                ShowSummary="false"
                OnRefresh="@RefreshKesa" />
        </div>
    </div>

    <!-- Navigation Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Početna</a></li>
            <li class="breadcrumb-item active">Lager</li>
        </ol>
    </nav>
</div>

@code {
    // Lager area chart
    private List<ChartSeriesData>? lagerSeriesData;
    private bool isLoadingLager = true;
    private bool hasErrorLager = false;
    private string lagerInterval = "dnevno";
    private DateTime lagerOdDatum = new DateTime(2025, 6, 1);
    private DateTime lagerDoDatum = DateTime.Now.Date;


    // Nabavka + Prodaja od početka sezone - area chartovi
    private List<ChartSeriesData>? nabavkaSezonaSeriesData;
    private bool isLoadingNabavkaSezona = true;
    private bool hasErrorNabavkaSezona = false;
    private string nabavkaSezonaInterval = "dnevno";

    private List<ChartSeriesData>? prodajaSezonaSeriesData;
    private bool isLoadingProdajaSezona = true;
    private bool hasErrorProdajaSezona = false;
    private string prodajaSezonaInterval = "dnevno";

    // Chart Data - Bar Charts
    private List<ChartDataPoint>? SirovineData;
    private List<ChartDataPoint>? GotoviProizvodiData;
    private List<ChartDataPoint>? KutijeData;
    private List<ChartDataPoint>? KesaData;

    // Loading States
    private bool IsLoadingSirovine = false;
    private bool IsLoadingGotovi = false;
    private bool IsLoadingKutije = false;
    private bool IsLoadingKesa = false;
    private bool IsRefreshing = false;

    // Error States
    private bool HasErrorSirovine = false;
    private bool HasErrorGotovi = false;
    private bool HasErrorKutije = false;
    private bool HasErrorKesa = false;

    // Datumski filter
    private FilterRequest StatistikaFilter => new FilterRequest
    {
        OdDatum = new DateTime(2025, 6, 1),
        DoDatum = DateTime.Now
    };

    protected override async Task OnInitializedAsync()
    {
        await RefreshCharts();
    }

    private async Task RefreshCharts()
    {
        IsRefreshing = true;
        StateHasChanged();

        try
        {
            await Task.WhenAll(
                UcitajLager(),
                UcitajNabavkuSezona(),
                UcitajProdajuSezona(),
                RefreshSirovine(),
                RefreshGotovi(),
                RefreshKutije(),
                RefreshKesa()
            );
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing charts");
        }
        finally
        {
            IsRefreshing = false;
            StateHasChanged();
        }
    }

    private async Task UcitajLager()
    {
        isLoadingLager = true;
        hasErrorLager = false;
        StateHasChanged();
        try
        {
            var podaci = await BrziPregledService.UcitajLagerKretanjePoVociAsync(lagerOdDatum, lagerDoDatum, lagerInterval);
            var sviDatumi = podaci.SelectMany(v => v.Value.Keys).Distinct().ToList();
            List<string> sortiraniDatumi;
            if (lagerInterval == "mesecno")
                sortiraniDatumi = sviDatumi.OrderBy(d => DateTime.TryParseExact(d, "MM.yyyy", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var dt) ? dt : DateTime.MinValue).ToList();
            else
                sortiraniDatumi = sviDatumi.OrderBy(d => DateTime.TryParseExact(d, "dd.MM.yy", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var dt) ? dt : DateTime.MinValue).ToList();

            lagerSeriesData = podaci
                .Select(v => new ChartSeriesData
                {
                    Name = v.Key,
                    Data = sortiraniDatumi.Select(d => new ChartDataPoint { Label = d, Value = v.Value.ContainsKey(d) ? v.Value[d] : 0 }).ToList(),
                    Color = ChartDataHelper.GetFruitColor(v.Key),
                    TotalKolicina = v.Value.Values.LastOrDefault()
                })
                .OrderByDescending(s => s.TotalKolicina)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju lager kretanja");
            hasErrorLager = true;
        }
        finally
        {
            isLoadingLager = false;
            StateHasChanged();
        }
    }

    private async Task OnLagerIntervalChanged(string noviInterval)
    {
        lagerInterval = noviInterval;
        await UcitajLager();
    }

    private async Task OnNabavkaSezonaIntervalChanged(string noviInterval)
    {
        nabavkaSezonaInterval = noviInterval;
        await UcitajNabavkuSezona();
    }

    private async Task OnProdajaSezonaIntervalChanged(string noviInterval)
    {
        prodajaSezonaInterval = noviInterval;
        await UcitajProdajuSezona();
    }

    private async Task UcitajNabavkuSezona()
    {
        isLoadingNabavkaSezona = true;
        hasErrorNabavkaSezona = false;
        StateHasChanged();
        try
        {
            var podaci = await BrziPregledService.UcitajNabavkuPoDanimaPoVociAsync(lagerOdDatum, lagerDoDatum);
            nabavkaSezonaSeriesData = PretвориUSeriesData(podaci, nabavkaSezonaInterval);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju nabavke po sezoni");
            hasErrorNabavkaSezona = true;
        }
        finally
        {
            isLoadingNabavkaSezona = false;
            StateHasChanged();
        }
    }

    private async Task UcitajProdajuSezona()
    {
        isLoadingProdajaSezona = true;
        hasErrorProdajaSezona = false;
        StateHasChanged();
        try
        {
            var podaci = await BrziPregledService.UcitajProdajuPoDanimaPoVociAsync(lagerOdDatum, lagerDoDatum);
            prodajaSezonaSeriesData = PretвориUSeriesData(podaci, prodajaSezonaInterval);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju prodaje po sezoni");
            hasErrorProdajaSezona = true;
        }
        finally
        {
            isLoadingProdajaSezona = false;
            StateHasChanged();
        }
    }

    private List<ChartSeriesData> PretвориUSeriesData(Dictionary<string, Dictionary<string, decimal>> podaci, string interval)
    {
        var sviDatumi = podaci.SelectMany(v => v.Value.Keys).Distinct().ToList();
        List<string> sortiraniDatumi;
        if (interval == "mesecno")
        {
            sortiraniDatumi = sviDatumi
                .OrderBy(d => DateTime.TryParseExact(d, "MM.yyyy",
                    System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.None, out var dt) ? dt : DateTime.MinValue)
                .ToList();
        }
        else
        {
            sortiraniDatumi = sviDatumi
                .OrderBy(d => DateTime.TryParseExact(d, "dd.MM.yy",
                    System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.None, out var dt) ? dt : DateTime.MinValue)
                .ToList();
        }
        return podaci
            .Select(v =>
            {
                decimal kumulativ = 0;
                var data = sortiraniDatumi.Select(d =>
                {
                    kumulativ += v.Value.ContainsKey(d) ? v.Value[d] : 0;
                    return new ChartDataPoint { Label = d, Value = kumulativ };
                }).ToList();
                return new ChartSeriesData
                {
                    Name = v.Key,
                    Data = data,
                    Color = ChartDataHelper.GetFruitColor(v.Key),
                    TotalKolicina = kumulativ
                };
            })
            .OrderByDescending(s => s.TotalKolicina)
            .ToList();
    }

    private async Task UcitajNabavkuPodatke() { await Task.CompletedTask; } // privremeno uklonjen chart
    private async Task UcitajProdajuPodatke() { await Task.CompletedTask; } // privremeno uklonjen chart

    private async Task _UcitajNabavkuPodatke_DISABLED()
    {
        // SACUVAN KOD - chart "Nabavka po Vrsti Voća (Poslednjih 30 Dana)" privremeno uklonjen
        // State: private List<ChartSeriesData> nabavkaSeriesData = new(); private bool isLoadingNabavka = true; private bool hasErrorNabavka = false;
        // UI: ApexMultiSeriesLineChart Title="Nabavka po Vrsti Voća (Poslednjih 30 Dana)" Icon="bi bi-cart-plus" SeriesData="@nabavkaSeriesData" Unit="kg" IsWeight="true" IsLoading="@isLoadingNabavka" HasError="@hasErrorNabavka" ShowSummary="true" ShowVrednost="false" Height="450" OnRefresh="@UcitajNabavkuPodatke"
        var podaciTask = BrziPregledService.UcitajNabavkuPoDanimaPoVociAsync();
        var ukupnoTask = BrziPregledService.UcitajUkupneVrednostiNabavkeAsync();
        await Task.WhenAll(podaciTask, ukupnoTask);
        var podaci = await podaciTask;
        var ukupno = await ukupnoTask;
        var sviDatumi = podaci.SelectMany(voce => voce.Value.Keys).Distinct()
            .OrderBy(d => { var p = d.Split('.'); return (p.Length == 2 && int.TryParse(p[0], out var day) && int.TryParse(p[1], out var month)) ? new DateTime(DateTime.Now.Year, month, day) : DateTime.MinValue; }).ToList();
        var nabavkaSeriesData = podaci.Select(voce => new ChartSeriesData
        {
            Name = voce.Key,
            Data = sviDatumi.Select(datum => new ChartDataPoint { Label = datum, Value = voce.Value.ContainsKey(datum) ? voce.Value[datum] : 0 }).ToList(),
            Color = ChartDataHelper.GetFruitColor(voce.Key),
            TotalKolicina = ukupno.ContainsKey(voce.Key) ? ukupno[voce.Key].Kolicina : 0,
            TotalVrednost = ukupno.ContainsKey(voce.Key) ? ukupno[voce.Key].Vrednost : 0
        }).ToList();
        await Task.CompletedTask;
    }

    private async Task _UcitajProdajuPodatke_DISABLED()
    {
        // SACUVAN KOD - chart "Prodaja po Vrsti Voća (Poslednjih 30 Dana)" privremeno uklonjen
        // State: private List<ChartSeriesData> prodajaSeriesData = new(); private bool isLoadingProdaja = true; private bool hasErrorProdaja = false;
        // UI: ApexMultiSeriesLineChart Title="Prodaja po Vrsti Voća (Poslednjih 30 Dana)" Icon="bi bi-cart-check" SeriesData="@prodajaSeriesData" Unit="kg" IsWeight="true" IsLoading="@isLoadingProdaja" HasError="@hasErrorProdaja" ShowSummary="true" ShowVrednost="false" Height="450" OnRefresh="@UcitajProdajuPodatke"
        var podaciTask = BrziPregledService.UcitajProdajuPoDanimaPoVociAsync();
        var ukupnoTask = BrziPregledService.UcitajUkupneVrednostiProdajeAsync();
        await Task.WhenAll(podaciTask, ukupnoTask);
        var podaci = await podaciTask;
        var ukupno = await ukupnoTask;
        var sviDatumi = podaci.SelectMany(voce => voce.Value.Keys).Distinct()
            .OrderBy(d => { var p = d.Split('.'); return (p.Length == 2 && int.TryParse(p[0], out var day) && int.TryParse(p[1], out var month)) ? new DateTime(DateTime.Now.Year, month, day) : DateTime.MinValue; }).ToList();
        var prodajaSeriesData = podaci.Select(voce => new ChartSeriesData
        {
            Name = voce.Key,
            Data = sviDatumi.Select(datum => new ChartDataPoint { Label = datum, Value = voce.Value.ContainsKey(datum) ? voce.Value[datum] : 0 }).ToList(),
            Color = ChartDataHelper.GetFruitColor(voce.Key),
            TotalKolicina = ukupno.ContainsKey(voce.Key) ? ukupno[voce.Key].Kolicina : 0,
            TotalVrednost = ukupno.ContainsKey(voce.Key) ? ukupno[voce.Key].Vrednost : 0
        }).ToList();
        await Task.CompletedTask;
    }

    private async Task RefreshSirovine()
    {
        if (IsLoadingSirovine) return;
        
        IsLoadingSirovine = true;
        HasErrorSirovine = false;
        StateHasChanged();

        try
        {
            await Task.Delay(250);
            var data = await LagerService.UcitajStrukturuSirovina();
            SirovineData = ChartDataHelper.FromDictionary(data, 5);
            SirovineData = ChartDataHelper.TruncateLabels(SirovineData, 15);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading sirovine data");
            HasErrorSirovine = true;
            SirovineData = ChartDataHelper.GetMockData("Sirovina", 5);
        }
        finally
        {
            IsLoadingSirovine = false;
            StateHasChanged();
        }
    }

    private async Task RefreshGotovi()
    {
        if (IsLoadingGotovi) return;
        
        IsLoadingGotovi = true;
        HasErrorGotovi = false;
        StateHasChanged();

        try
        {
            await Task.Delay(300);
            var data = await LagerService.UcitajStrukturuGotovihProizvoda();
            GotoviProizvodiData = ChartDataHelper.FromDictionary(data, 5);
            GotoviProizvodiData = ChartDataHelper.TruncateLabels(GotoviProizvodiData, 15);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading gotovi proizvodi data");
            HasErrorGotovi = true;
            GotoviProizvodiData = ChartDataHelper.GetMockData("Proizvod", 5);
        }
        finally
        {
            IsLoadingGotovi = false;
            StateHasChanged();
        }
    }

    private async Task RefreshKutije()
    {
        if (IsLoadingKutije) return;
        
        IsLoadingKutije = true;
        HasErrorKutije = false;
        StateHasChanged();

        try
        {
            await Task.Delay(350);
            var data = await LagerService.UcitajStrukturuKutija();
            KutijeData = ChartDataHelper.FromDictionary(data, 5);
            KutijeData = ChartDataHelper.TruncateLabels(KutijeData, 15);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading kutije data");
            HasErrorKutije = true;
            KutijeData = ChartDataHelper.GetMockData("Kutija", 5);
        }
        finally
        {
            IsLoadingKutije = false;
            StateHasChanged();
        }
    }

    private async Task RefreshKesa()
    {
        if (IsLoadingKesa) return;
        
        IsLoadingKesa = true;
        HasErrorKesa = false;
        StateHasChanged();

        try
        {
            await Task.Delay(400);
            var data = await LagerService.UcitajStrukturuKesa();
            KesaData = ChartDataHelper.FromDictionary(data, 5);
            KesaData = ChartDataHelper.TruncateLabels(KesaData, 15);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading kesa data");
            HasErrorKesa = true;
            KesaData = ChartDataHelper.GetMockData("Kesa", 5);
        }
        finally
        {
            IsLoadingKesa = false;
            StateHasChanged();
        }
    }

    private void NavigateTo(string url)
    {
        NavigationManager.NavigateTo(url);
    }
}
