                                </div>
                            </div>
                        </div>

                        @if (iskStatistika != null)
                        {
                            <div class="row g-2 mb-3">
                                <div class="col-auto"><div class="card shadow-sm border-0 bg-light px-3 py-2"><small class="text-muted">Ukupno PL</small><div class="fw-bold fs-5">@iskStatistika.Count</div></div></div>
                                <div class="col-auto"><div class="card shadow-sm border-0 bg-warning bg-opacity-10 px-3 py-2"><small class="text-muted">Sirovine</small><div class="fw-bold fs-5 text-warning">@iskStatistika.Count(x => !x.JeAmbalaža)</div></div></div>
                                <div class="col-auto"><div class="card shadow-sm border-0 bg-danger bg-opacity-10 px-3 py-2"><small class="text-muted">Ambalaža</small><div class="fw-bold fs-5 text-danger">@iskStatistika.Count(x => x.JeAmbalaža)</div></div></div>
                            </div>
                            <div class="card shadow-sm">
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover mb-0">
                                            <thead class="table-dark">
                                                <tr><th>Šifra PL</th><th>Vrsta</th><th>Artikal</th><th>Komitent</th><th>Datum</th><th class="text-end">Količina</th><th class="text-center">Br. RN</th><th class="text-center">Br. evid.</th><th></th></tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var pl in iskStatistika)
                                                {
                                                    <tr class="@(pl.JeAmbalaža ? "table-danger" : "table-warning") bg-opacity-25">
                                                        <td class="small fw-semibold">@pl.Sifra</td>
                                                        <td class="small text-muted">@(pl.VrstaArtikla ?? "—")</td>
                                                        <td class="small">@pl.Artikal</td>
                                                        <td class="small">@(pl.Komitent ?? "—")</td>
                                                        <td class="small text-muted">@pl.DatumKreiranja.ToString("dd.MM.yyyy")</td>
                                                        <td class="small text-end">@pl.Tezina.ToString("N2", srLatnIsk)</td>
                                                        <td class="text-center"><span class="badge @(pl.BrojRadnihNaloga > 2 ? "bg-danger" : "bg-secondary")">@pl.BrojRadnihNaloga</span></td>
                                                        <td class="text-center"><span class="badge @(pl.BrojEvidencija > 2 ? "bg-danger" : "bg-secondary")">@pl.BrojEvidencija</span></td>
                                                        <td><button class="btn btn-outline-primary btn-sm py-0" @onclick="() => IskOtvoriSledljivost(pl.Sifra)" title="Otvori sledljivost"><i class="bi bi-search"></i></button></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            }

        </div>

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Početna</a></li>
                <li class="breadcrumb-item"><a href="/promethome">Promet Roba</a></li>
                <li class="breadcrumb-item active">Paletni List Pregled</li>
            </ol>
        </nav>
    </div>
}

@code {
    private bool autorizovan = false;
    private bool ucitava = false;
    private string aktivniTab = "nabavka";

    // Filteri po tabu
    private PaletniListPregledFilter filterNabavka = new() { OdDatum = DateTime.Today.AddDays(-10), DoDatum = DateTime.Today };
    private PaletniListPregledFilter filterProdaja = new() { OdDatum = DateTime.Today.AddDays(-10), DoDatum = DateTime.Today };
    private PaletniListPregledFilter filterProizvodnja = new() { OdDatum = DateTime.Today.AddDays(-10), DoDatum = DateTime.Today };

    // Podaci po tabu
    private List<PaletniListPregledRow>? podaciNabavka;
    private List<PaletniListPregledRow>? podaciProdaja;
    private List<PaletniListPregledRow>? podaciProizvodnja;

    // Povezanost tab
    private string pretragaPovezanosti = "";
    private PaletniListPovezanostResult? rezultatPovezanosti;
    private List<PaletniListPregledRow>? dokumentiResult;
    private string? kliknutiDokument;

    // Kvalitet tab
    private PaletniListKvalitetFilter filterKvalitet = new() { OdDatum = DateTime.Today.AddDays(-10), DoDatum = DateTime.Today };
    private List<PaletniListKvalitetRow>? podaciKvalitet;
    private List<(string ID, string Naziv)> artikliKvalitet = new();
    private List<string> komitentiKvalitet = new();
    private List<string> prijemniceKvalitet = new();

    // Dropdown liste
    private List<string> komitentiNabavka = new();
    private List<string> artikliNabavka = new();
    private List<string> prijemnice = new();
    private List<string> komitentiProdaja = new();
    private List<string> artikliProdaja = new();
    private List<string> otpremnice = new();
    private List<string> komitentiProizvodnja = new();
    private List<string> artikliProizvodnja = new();
    private List<string> radniNalozi = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await AuthService.GetCurrentUser();
            if (user == null)
            {
                NavigationManager.NavigateTo("/unauthorized");
                return;
            }
            autorizovan = true;

            // Učitaj statičke dropdown liste i podatke za aktivan tab paralelno
            var t1 = PaletniListService.UcitajKomitentePaletniListova(1); // Nabavka/Prijem
            var t2 = PaletniListService.UcitajArtiklePaletniListova(1);
            var t3 = PaletniListService.UcitajKomitentePaletniListova(3); // Prodaja/Otprema
            var t4 = PaletniListService.UcitajArtiklePaletniListova(3);
            var t5 = PaletniListService.UcitajKomitentePaletniListova(2); // Proizvodnja
            var t6 = PaletniListService.UcitajArtiklePaletniListova(2);
            var t7 = PaletniListService.UcitajPrijemniceZaPeriod(filterNabavka.OdDatum, filterNabavka.DoDatum);
            var t8 = PaletniListService.UcitajOtpremnicaZaPeriod(filterProdaja.OdDatum, filterProdaja.DoDatum);
            var t9 = PaletniListService.UcitajRadneNalogeZaPeriod(filterProizvodnja.OdDatum, filterProizvodnja.DoDatum);
            var t10 = PaletniListService.UcitajNabavkuPaletniListova(filterNabavka);
            var t11 = PaletniListService.UcitajArtikleZaKvalitet();
            var t12 = PaletniListService.UcitajKomitentePaletniListovaKvalitet();
            var t13 = PaletniListService.UcitajPrijemniceZaPeriodKvalitet(filterKvalitet.OdDatum, filterKvalitet.DoDatum);
            await Task.WhenAll(t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, t12, t13);
            komitentiNabavka = t1.Result;
            artikliNabavka = t2.Result;
            komitentiProdaja = t3.Result;
            artikliProdaja = t4.Result;
            komitentiProizvodnja = t5.Result;
            artikliProizvodnja = t6.Result;
            prijemnice = t7.Result;
            otpremnice = t8.Result;
            radniNalozi = t9.Result;
            podaciNabavka = t10.Result;
            artikliKvalitet = t11.Result;
            komitentiKvalitet = t12.Result;
            prijemniceKvalitet = t13.Result;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri inicijalizaciji PaletniListPregled");
            NavigationManager.NavigateTo("/unauthorized");
        }
    }

    private async void PredjNaTab(string tab)
    {
        aktivniTab = tab;
        dokumentiResult = null;
        kliknutiDokument = null;
        if (tab == "iskoriscenje") await UcitajIskoriscenjeDropdownove();
    }

    private async Task OsvjeziPrijemnice()
    {
        prijemnice = await PaletniListService.UcitajPrijemniceZaPeriod(filterNabavka.OdDatum, filterNabavka.DoDatum);
        filterNabavka.Prijemnica = null;
    }

    private async Task OsvjeziOtpremnice()
    {
        otpremnice = await PaletniListService.UcitajOtpremnicaZaPeriod(filterProdaja.OdDatum, filterProdaja.DoDatum);
        filterProdaja.Otpremnica = null;
    }

    private async Task OsvjeziRadneNaloge()
    {
        radniNalozi = await PaletniListService.UcitajRadneNalogeZaPeriod(filterProizvodnja.OdDatum, filterProizvodnja.DoDatum);
        filterProizvodnja.RadniNalog = null;
    }

    // ── NABAVKA ────────────────────────────────────────────
    private async Task PretrazNabavku()
    {
        ucitava = true;
        try { podaciNabavka = await PaletniListService.UcitajNabavkuPaletniListova(filterNabavka); }
        catch (Exception ex) { Logger.LogError(ex, "Greška Nabavka PL"); podaciNabavka = new(); }
        finally { ucitava = false; }
    }

    private void ResetNabavku()
    {
        filterNabavka = new() { OdDatum = DateTime.Today.AddDays(-10), DoDatum = DateTime.Today };
        podaciNabavka = null;
    }

    // ── PRODAJA ────────────────────────────────────────────
    private async Task PretrazProdaju()
    {
        ucitava = true;
        try { podaciProdaja = await PaletniListService.UcitajProdajuPaletniListova(filterProdaja); }
        catch (Exception ex) { Logger.LogError(ex, "Greška Prodaja PL"); podaciProdaja = new(); }
        finally { ucitava = false; }
    }

    private void ResetProdaju()
    {
        filterProdaja = new() { OdDatum = DateTime.Today.AddDays(-10), DoDatum = DateTime.Today };
        podaciProdaja = null;
    }

    // ── PROIZVODNJA ────────────────────────────────────────
    private async Task PretrazProizvodnju()
    {
        ucitava = true;
        try { podaciProizvodnja = await PaletniListService.UcitajProizvodnjuPaletniListova(filterProizvodnja); }
        catch (Exception ex) { Logger.LogError(ex, "Greška Proizvodnja PL"); podaciProizvodnja = new(); }
        finally { ucitava = false; }
    }

    private void ResetProizvodnju()
    {
        filterProizvodnja = new() { OdDatum = DateTime.Today.AddDays(-10), DoDatum = DateTime.Today };
        podaciProizvodnja = null;
    }

    // ── POVEZANOST ─────────────────────────────────────────
    private async Task PretrazPovezanost()
    {
        if (string.IsNullOrWhiteSpace(pretragaPovezanosti)) return;
        ucitava = true;
        dokumentiResult = null;
        kliknutiDokument = null;
        try { rezultatPovezanosti = await PaletniListService.UcitajPovezanostPaletniListova(pretragaPovezanosti.Trim()); }
        catch (Exception ex) { Logger.LogError(ex, "Greška Povezanost PL"); rezultatPovezanosti = new(); }
        finally { ucitava = false; }
    }

    private void ResetPovezanost()
    {
        pretragaPovezanosti = "";
        rezultatPovezanosti = null;
        dokumentiResult = null;
        kliknutiDokument = null;
    }

    private async Task OnPovezanostKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await PretrazPovezanost();
    }

    private async Task PretraziPojedinacniDokument(string tip, string sifra)
    {
        kliknutiDokument = sifra;
        ucitava = true;
        try { dokumentiResult = await PaletniListService.UcitajPojedinacniDokument(tip, sifra); }
        catch (Exception ex) { Logger.LogError(ex, "Greška učitavanja dokumenta {Tip}={Sifra}", tip, sifra); dokumentiResult = new(); }
        finally { ucitava = false; }
    }

    private async Task PretraziPovezanostIzTabele(string sifra)
    {
        pretragaPovezanosti = sifra;
        await PretrazPovezanost();
    }

    private void ZatvoriDokumenteResult()
    {
        dokumentiResult = null;
        kliknutiDokument = null;
    }

    // Typed helpers da izbegnemo string literal problem u Blazor @onclick
    private Task PretraziPrijemnicu(string sifra) => PretraziPojedinacniDokument("prijemnica", sifra);
    private Task PretraziOtpremnicu(string sifra) => PretraziPojedinacniDokument("otpremnica", sifra);
    private Task PretraziRadniNalog(string sifra) => PretraziPojedinacniDokument("radni_nalog", sifra);
    private Task PretraziEvidenciju(string sifra) => PretraziPojedinacniDokument("evidencija", sifra);

    // ── KVALITET ───────────────────────────────────────────
    private async Task PretrazKvalitet()
    {
        if (string.IsNullOrEmpty(filterKvalitet.ArtikalID)) return;
        ucitava = true;
        try { podaciKvalitet = await PaletniListService.UcitajKvalitetIzvestaj(filterKvalitet); }
        catch (Exception ex) { Logger.LogError(ex, "Greška Kvalitet"); podaciKvalitet = new(); }
        finally { ucitava = false; }
    }

    private void ResetKvalitet()
    {
        filterKvalitet = new() { OdDatum = DateTime.Today.AddDays(-10), DoDatum = DateTime.Today };
        podaciKvalitet = null;
    }

    private async Task OsvjeziPrijemniceKvalitet()
    {
        prijemniceKvalitet = await PaletniListService.UcitajPrijemniceZaPeriodKvalitet(filterKvalitet.OdDatum, filterKvalitet.DoDatum);
        filterKvalitet.Prijemnica = null;
    }

    // ── ISKORIŠĆENJE TAB ───────────────────────────────────
    private static readonly System.Globalization.CultureInfo srLatnIsk =
