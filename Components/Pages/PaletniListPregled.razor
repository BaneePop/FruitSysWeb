    // Deljeni dropdown podaci
    private List<(long ID, string Naziv)> iskSviArtikli = new();
    private List<(long ID, string Naziv)> iskKomitenti = new();

    private async Task UcitajIskoriscenjeDropdownove()
    {
        if (iskSviArtikli.Any()) return;
        try
        {
            iskSviArtikli = await IskoriscenjeService.UcitajArtikle();
            iskKomitenti = await IskoriscenjeService.UcitajKomitente();
        }
        catch { }
        iskUcitan = true;
    }

    private async Task OnIskSifraKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await IskTraziPL();
    }

    private async Task IskTraziPL()
    {
        iskGreska1 = null;
        if (string.IsNullOrWhiteSpace(iskUnosSifre)) { iskGreska1 = "Unesite šifru paletnog lista."; return; }
        iskUcitavanjeSledljivosti = true;
        try
        {
            iskSledljivostModel = await IskoriscenjeService.UcitajSledljivostPL(iskUnosSifre.Trim());
            if (iskSledljivostModel == null) iskGreska1 = $"Paletni list '{iskUnosSifre.Trim()}' nije pronađen.";
        }
        catch (Exception ex) { iskGreska1 = $"Greška: {ex.Message}"; }
        finally { iskUcitavanjeSledljivosti = false; }
    }

    private void IskOcistiSledljivost() { iskSledljivostModel = null; iskUnosSifre = ""; iskGreska1 = null; }

    private async Task IskTraziPovezani(string sifra) { iskUnosSifre = sifra; await IskTraziPL(); }

    private async Task IskOtvoriSledljivost(string sifra) { iskPodtab = 1; iskUnosSifre = sifra; await IskTraziPL(); }

    private async Task IskPrikaziListu()
    {
        iskUcitavanjeListe = true;
        try
        {
            iskFilter.PrvaKlasifikacijaID = null;
            iskFilter.ArtikalID = string.IsNullOrEmpty(iskFilterArtikalId) ? null : long.Parse(iskFilterArtikalId);
            iskFilter.KomitentID = string.IsNullOrEmpty(iskFilterKomitentId) ? null : long.Parse(iskFilterKomitentId);
            iskFilter.SamoNeiskorisceni = iskFilterSamoNeiskorisceni;
            iskListaIskoriscenja = await IskoriscenjeService.UcitajListuIskoriscenja(iskFilter);
        }
        catch (Exception ex) { Logger.LogError(ex, "Greška isk lista"); }
        finally { iskUcitavanjeListe = false; }
    }

    private void IskOcistiFiltere()
    {
        iskFilter = new() { OdDatum = DateTime.Today.AddDays(-30), DoDatum = DateTime.Today };
        iskFilterArtikalId = ""; iskFilterKomitentId = ""; iskFilterSamoNeiskorisceni = false;
        iskListaIskoriscenja = null;
    }

    private async Task IskPrikaziStatistiku()
    {
        iskUcitavanjeStat = true;
        try
        {
            iskFilterStat.ArtikalID = string.IsNullOrEmpty(iskFilterStatArtikalId) ? null : long.Parse(iskFilterStatArtikalId);
            iskFilterStat.KomitentID = string.IsNullOrEmpty(iskFilterStatKomitentId) ? null : long.Parse(iskFilterStatKomitentId);
            iskStatistika = await IskoriscenjeService.UcitajStatistikuPL(iskFilterStat);
        }
        catch (Exception ex) { Logger.LogError(ex, "Greška isk statistika"); }
        finally { iskUcitavanjeStat = false; }
    }

    private void IskOcistiFiltereStat()
    {
        iskFilterStat = new() { OdDatum = DateTime.Today.AddDays(-30), DoDatum = DateTime.Today };
        iskFilterStatArtikalId = ""; iskFilterStatKomitentId = "";
        iskStatistika = null;
    }

    private string IskTipBadgeClass(int tip) => tip switch { 1 => "bg-success", 2 => "bg-primary", 3 => "bg-warning text-dark", _ => "bg-secondary" };
    private string IskTipNaziv(int tip) => tip switch { 1 => "Nabavka", 2 => "Proizvodnja", 3 => "Prodaja", _ => "Nepoznato" };
    private string IskSmenaText(int smena) => smena switch { 1 => "1. smena", 2 => "2. smena", 3 => "3. smena", _ => smena.ToString() };
}
