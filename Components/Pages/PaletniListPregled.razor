@page "/paletni-list-pregled"
@rendermode @(new InteractiveServerRenderMode())
@using FruitSysWeb.Models
@using FruitSysWeb.Services.Interfaces

@inject IPaletniListService PaletniListService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject ILogger<PaletniListPregled> Logger

<!-- Header -->
<div class="prerada-header text-white py-3 mb-4">
    <div class="container-fluid">
        <h1 class="h3 mb-0">
            <i class="bi bi-layers me-2"></i>Paletni List Pregled
        </h1>
        <small class="opacity-75">Nabavka · Prodaja · Proizvodnja · Povezanost</small>
    </div>
</div>

@if (!autorizovan)
{
    <div class="container-fluid">
        <div class="alert alert-warning"><i class="bi bi-lock me-2"></i>Proverava pristup...</div>
    </div>
}
else
{
    <div class="container-fluid">
        <!-- 4 TABA -->
        <ul class="nav nav-tabs mb-0" id="plTabs">
            <li class="nav-item">
                <button class="nav-link @(aktivniTab == "nabavka" ? "active" : "")"
                        @onclick='() => PredjNaTab("nabavka")'>
                    <i class="bi bi-truck me-1"></i>Nabavka
                    @if (aktivniTab == "nabavka" && podaciNabavka != null)
                    {
                        <span class="badge bg-secondary ms-1">@podaciNabavka.Count</span>
                    }
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(aktivniTab == "prodaja" ? "active" : "")"
                        @onclick='() => PredjNaTab("prodaja")'>
                    <i class="bi bi-cart-check me-1"></i>Prodaja
                    @if (aktivniTab == "prodaja" && podaciProdaja != null)
                    {
                        <span class="badge bg-secondary ms-1">@podaciProdaja.Count</span>
                    }
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(aktivniTab == "proizvodnja" ? "active" : "")"
                        @onclick='() => PredjNaTab("proizvodnja")'>
                    <i class="bi bi-gear me-1"></i>Proizvodnja
                    @if (aktivniTab == "proizvodnja" && podaciProizvodnja != null)
                    {
                        <span class="badge bg-secondary ms-1">@podaciProizvodnja.Count</span>
                    }
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(aktivniTab == "povezanost" ? "active" : "")"
                        @onclick='() => PredjNaTab("povezanost")'>
                    <i class="bi bi-diagram-3 me-1"></i>Povezanost
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(aktivniTab == "kvalitet" ? "active" : "")"
                        @onclick='() => PredjNaTab("kvalitet")'>
                    <i class="bi bi-star-half me-1"></i>Kvalitet
                    @if (aktivniTab == "kvalitet" && podaciKvalitet != null)
                    {
                        <span class="badge bg-secondary ms-1">@podaciKvalitet.Count</span>
                    }
                </button>
            </li>
        </ul>

        <div class="tab-content border border-top-0 rounded-bottom p-3 bg-white shadow-sm mb-4">

            <!-- ═══ TAB: NABAVKA ═══ -->
            @if (aktivniTab == "nabavka")
            {
                <!-- Filter -->
                <div class="row g-2 mb-3">
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Od datuma</label>
                        <input type="date" class="form-control form-control-sm"
                               value="@(filterNabavka.OdDatum?.ToString("yyyy-MM-dd"))"
                               @onchange="async e => { if(DateTime.TryParse(e.Value?.ToString(), out var d)) filterNabavka.OdDatum = d; else filterNabavka.OdDatum = null; await OsvjeziPrijemnice(); }" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Do datuma</label>
                        <input type="date" class="form-control form-control-sm"
                               value="@(filterNabavka.DoDatum?.ToString("yyyy-MM-dd"))"
                               @onchange="async e => { if(DateTime.TryParse(e.Value?.ToString(), out var d)) filterNabavka.DoDatum = d; else filterNabavka.DoDatum = null; await OsvjeziPrijemnice(); }" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Šifra PL</label>
                        <input type="text" class="form-control form-control-sm" placeholder="N-250101-..."
                               @bind="filterNabavka.SifraPL" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Komitent</label>
                        <select class="form-select form-select-sm" @bind="filterNabavka.Komitent">
                            <option value="">— svi —</option>
                            @foreach (var k in komitentiNabavka)
                            {
                                <option value="@k">@k</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Tip Artikla</label>
                        <select class="form-select form-select-sm" @bind="filterNabavka.TipArtikla">
                            <option value="">— svi —</option>
                            <option value="2">Sveza Roba</option>
                            <option value="3">Sirovine</option>
                            <option value="4">Ambalaza</option>
                            <option value="5">Polu Proizvod</option>
                            <option value="6">Gotov Proizvod</option>
                            <option value="8">Usl. Mleko</option>
                            <option value="9">Repromaterijal</option>
                            <option value="10">Đubriva</option>
                            <option value="11">Usl. Voće</option>
                            <option value="12">Usl. Meso</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Artikal</label>
                        <select class="form-select form-select-sm" @bind="filterNabavka.Artikal">
                            <option value="">— svi —</option>
                            @foreach (var a in artikliNabavka)
                            {
                                <option value="@a">@a</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Prijemnica</label>
                        <select class="form-select form-select-sm" @bind="filterNabavka.Prijemnica">
                            <option value="">— sve —</option>
                            @foreach (var pr in prijemnice)
                            {
                                <option value="@pr">@pr</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end gap-1">
                        <button class="btn btn-primary btn-sm flex-grow-1" @onclick="PretrazNabavku" disabled="@ucitava">
                            @if (ucitava && aktivniTab == "nabavka") { <span class="spinner-border spinner-border-sm"></span> }
                            else { <i class="bi bi-search"></i> }
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ResetNabavku" title="Reset">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                </div>

                <!-- Tabela Nabavka -->
                @if (ucitava && aktivniTab == "nabavka")
                {
                    <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
                }
                else if (podaciNabavka == null)
                {
                    <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>Unesite filter i kliknite Pretraži.</div>
                }
                else if (!podaciNabavka.Any())
                {
                    <div class="alert alert-warning"><i class="bi bi-search me-2"></i>Nema rezultata.</div>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <small class="text-muted">Prikazano @podaciNabavka.Count redova · Ukupno: @podaciNabavka.Sum(x => x.Kolicina).ToString("N0") kg</small>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Datum</th>
                                    <th>Šifra PL</th>
                                    <th>Prijemnica</th>
                                    <th>Komitent</th>
                                    <th>Artikal</th>
                                    <th class="text-end">Količina (kg)</th>
                                    <th>Ambalaža</th>
                                    <th class="text-end">Kol. amb.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in podaciNabavka)
                                {
                                    <tr>
                                        <td class="text-nowrap">@r.DatumFormatted</td>
                                        <td><span class="badge bg-success">@r.Sifra</span></td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(r.PrijemnicaSifra))
                                            {
                                                <button class="btn btn-link btn-sm p-0 text-primary"
                                                        @onclick="() => PretraziPrijemnicu(r.PrijemnicaSifra!)">
                                                    @r.PrijemnicaSifra
                                                </button>
                                            }
                                            else { <span class="text-muted">-</span> }
                                        </td>
                                        <td>@r.Komitent</td>
                                        <td>@r.Artikal</td>
                                        <td class="text-end fw-bold">@r.Kolicina.ToString("N2")</td>
                                        <td><small>@r.Ambalaza</small></td>
                                        <td class="text-end">@r.BrojAmbalaze.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            <!-- ═══ TAB: PRODAJA ═══ -->
            @if (aktivniTab == "prodaja")
            {
                <!-- Filter -->
                <div class="row g-2 mb-3">
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Od datuma</label>
                        <input type="date" class="form-control form-control-sm"
                               value="@(filterProdaja.OdDatum?.ToString("yyyy-MM-dd"))"
                               @onchange="async e => { if(DateTime.TryParse(e.Value?.ToString(), out var d)) filterProdaja.OdDatum = d; else filterProdaja.OdDatum = null; await OsvjeziOtpremnice(); }" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Do datuma</label>
                        <input type="date" class="form-control form-control-sm"
                               value="@(filterProdaja.DoDatum?.ToString("yyyy-MM-dd"))"
                               @onchange="async e => { if(DateTime.TryParse(e.Value?.ToString(), out var d)) filterProdaja.DoDatum = d; else filterProdaja.DoDatum = null; await OsvjeziOtpremnice(); }" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Šifra PL</label>
                        <input type="text" class="form-control form-control-sm" placeholder="F-250101-..."
                               @bind="filterProdaja.SifraPL" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Komitent</label>
                        <select class="form-select form-select-sm" @bind="filterProdaja.Komitent">
                            <option value="">— svi —</option>
                            @foreach (var k in komitentiProdaja)
                            {
                                <option value="@k">@k</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Artikal</label>
                        <select class="form-select form-select-sm" @bind="filterProdaja.Artikal">
                            <option value="">— svi —</option>
                            @foreach (var a in artikliProdaja)
                            {
                                <option value="@a">@a</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Otpremnica</label>
                        <select class="form-select form-select-sm" @bind="filterProdaja.Otpremnica">
                            <option value="">— sve —</option>
                            @foreach (var otp in otpremnice)
                            {
                                <option value="@otp">@otp</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end gap-1">
                        <button class="btn btn-primary btn-sm flex-grow-1" @onclick="PretrazProdaju" disabled="@ucitava">
                            @if (ucitava && aktivniTab == "prodaja") { <span class="spinner-border spinner-border-sm"></span> }
                            else { <i class="bi bi-search"></i> }
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ResetProdaju" title="Reset">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                </div>

                <!-- Tabela Prodaja -->
                @if (ucitava && aktivniTab == "prodaja")
                {
                    <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
                }
                else if (podaciProdaja == null)
                {
                    <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>Unesite filter i kliknite Pretraži.</div>
                }
                else if (!podaciProdaja.Any())
                {
                    <div class="alert alert-warning"><i class="bi bi-search me-2"></i>Nema rezultata.</div>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <small class="text-muted">Prikazano @podaciProdaja.Count redova · Ukupno: @podaciProdaja.Sum(x => x.Kolicina).ToString("N0") kg</small>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Datum</th>
                                    <th>Šifra PL</th>
                                    <th>Otpremnica</th>
                                    <th>Komitent</th>
                                    <th>Artikal</th>
                                    <th class="text-end">Količina (kg)</th>
                                    <th>Ambalaža</th>
                                    <th class="text-end">Kol. amb.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in podaciProdaja)
                                {
                                    <tr>
                                        <td class="text-nowrap">@r.DatumFormatted</td>
                                        <td><span class="badge bg-primary">@r.Sifra</span></td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(r.OtpremnicaSifra))
                                            {
                                                <button class="btn btn-link btn-sm p-0 text-primary"
                                                        @onclick="() => PretraziOtpremnicu(r.OtpremnicaSifra!)">
                                                    @r.OtpremnicaSifra
                                                </button>
                                            }
                                            else { <span class="text-muted">-</span> }
                                        </td>
                                        <td>@r.Komitent</td>
                                        <td>@r.Artikal</td>
                                        <td class="text-end fw-bold">@r.Kolicina.ToString("N2")</td>
                                        <td><small>@r.Ambalaza</small></td>
                                        <td class="text-end">@r.BrojAmbalaze.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            <!-- ═══ TAB: PROIZVODNJA ═══ -->
            @if (aktivniTab == "proizvodnja")
            {
                <!-- Filter -->
                <div class="row g-2 mb-3">
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Od datuma</label>
                        <input type="date" class="form-control form-control-sm"
                               value="@(filterProizvodnja.OdDatum?.ToString("yyyy-MM-dd"))"
                               @onchange="async e => { if(DateTime.TryParse(e.Value?.ToString(), out var d)) filterProizvodnja.OdDatum = d; else filterProizvodnja.OdDatum = null; await OsvjeziRadneNaloge(); }" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Do datuma</label>
                        <input type="date" class="form-control form-control-sm"
                               value="@(filterProizvodnja.DoDatum?.ToString("yyyy-MM-dd"))"
                               @onchange="async e => { if(DateTime.TryParse(e.Value?.ToString(), out var d)) filterProizvodnja.DoDatum = d; else filterProizvodnja.DoDatum = null; await OsvjeziRadneNaloge(); }" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Šifra PL</label>
                        <input type="text" class="form-control form-control-sm" placeholder="P-250101-..."
                               @bind="filterProizvodnja.SifraPL" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Radni Nalog</label>
                        <select class="form-select form-select-sm" @bind="filterProizvodnja.RadniNalog">
                            <option value="">— svi —</option>
                            @foreach (var rn in radniNalozi)
                            {
                                <option value="@rn">@rn</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Komitent</label>
                        <select class="form-select form-select-sm" @bind="filterProizvodnja.Komitent">
                            <option value="">— svi —</option>
                            @foreach (var k in komitentiProizvodnja)
                            {
                                <option value="@k">@k</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Artikal</label>
                        <select class="form-select form-select-sm" @bind="filterProizvodnja.Artikal">
                            <option value="">— svi —</option>
                            @foreach (var a in artikliProizvodnja)
                            {
                                <option value="@a">@a</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Evidencija Rada</label>
                        <input type="text" class="form-control form-control-sm" placeholder="Šifra..."
                               @bind="filterProizvodnja.EvidencijaRada" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end gap-1">
                        <button class="btn btn-primary btn-sm flex-grow-1" @onclick="PretrazProizvodnju" disabled="@ucitava">
                            @if (ucitava && aktivniTab == "proizvodnja") { <span class="spinner-border spinner-border-sm"></span> }
                            else { <i class="bi bi-search"></i> }
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ResetProizvodnju" title="Reset">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                </div>

                <!-- Tabela Proizvodnja -->
                @if (ucitava && aktivniTab == "proizvodnja")
                {
                    <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
                }
                else if (podaciProizvodnja == null)
                {
                    <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>Unesite filter i kliknite Pretraži.</div>
                }
                else if (!podaciProizvodnja.Any())
                {
                    <div class="alert alert-warning"><i class="bi bi-search me-2"></i>Nema rezultata.</div>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <small class="text-muted">Prikazano @podaciProizvodnja.Count redova · Ukupno: @podaciProizvodnja.Sum(x => x.Kolicina).ToString("N0") kg</small>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Datum</th>
                                    <th>Šifra PL</th>
                                    <th>Radni Nalog</th>
                                    <th>Evidencija Rada</th>
                                    <th>Komitent</th>
                                    <th>Artikal</th>
                                    <th class="text-end">Količina (kg)</th>
                                    <th>Ambalaža</th>
                                    <th class="text-end">Kol. amb.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in podaciProizvodnja)
                                {
                                    <tr>
                                        <td class="text-nowrap">@r.DatumFormatted</td>
                                        <td><span class="badge bg-warning text-dark">@r.Sifra</span></td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(r.RadniNalogSifra))
                                            {
                                                <button class="btn btn-link btn-sm p-0 text-primary"
                                                        @onclick="() => PretraziRadniNalog(r.RadniNalogSifra!)">
                                                    @r.RadniNalogSifra
                                                </button>
                                            }
                                            else { <span class="text-muted">-</span> }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(r.EvidencijaRadaSifra))
                                            {
                                                <button class="btn btn-link btn-sm p-0 text-info"
                                                        @onclick="() => PretraziEvidenciju(r.EvidencijaRadaSifra!)">
                                                    @r.EvidencijaRadaSifra
                                                </button>
                                            }
                                            else { <span class="text-muted">-</span> }
                                        </td>
                                        <td>@r.Komitent</td>
                                        <td>@r.Artikal</td>
                                        <td class="text-end fw-bold">@r.Kolicina.ToString("N2")</td>
                                        <td><small>@r.Ambalaza</small></td>
                                        <td class="text-end">@r.BrojAmbalaze.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            <!-- ═══ TAB: POVEZANOST ═══ -->
            @if (aktivniTab == "povezanost")
            {
                <div class="row g-2 mb-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label form-label-sm fw-semibold">Šifra Paletnog Lista</label>
                        <input type="text" class="form-control" placeholder="Npr. N-250101-001 ili F-250101-001..."
                               @bind="pretragaPovezanosti" @bind:event="oninput"
                               @onkeydown="OnPovezanostKeyDown" />
                        <small class="text-muted">Unesite tačnu šifru paletnog lista i pritisnite Enter ili Pretraži</small>
                    </div>
                    <div class="col-md-2 d-flex gap-1">
                        <button class="btn btn-primary" @onclick="PretrazPovezanost" disabled="@ucitava">
                            @if (ucitava && aktivniTab == "povezanost") { <span class="spinner-border spinner-border-sm me-1"></span> }
                            else { <i class="bi bi-diagram-3 me-1"></i> }
                            Pretraži
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="ResetPovezanost" title="Reset">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                </div>

                @if (ucitava && aktivniTab == "povezanost")
                {
                    <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
                }
                else if (rezultatPovezanosti != null)
                {
                    @if (rezultatPovezanosti.Izvorni == null)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-search me-2"></i>Paletni list <strong>@pretragaPovezanosti</strong> nije pronađen.
                        </div>
                    }
                    else
                    {
                        <!-- Izvorni PL -->
                        <div class="card border-0 bg-light mb-3">
                            <div class="card-header bg-dark text-white py-2">
                                <strong><i class="bi bi-layers me-2"></i>Traženi Paletni List</strong>
                            </div>
                            <div class="card-body py-2">
                                <div class="row g-3">
                                    <div class="col-md-2">
                                        <small class="text-muted d-block">Šifra</small>
                                        <span class="badge @rezultatPovezanosti.Izvorni.TipBadgeClass fs-6">
                                            @rezultatPovezanosti.Izvorni.PaletniListSifra
                                        </span>
                                    </div>
                                    <div class="col-md-1">
                                        <small class="text-muted d-block">Tip</small>
                                        <strong>@rezultatPovezanosti.Izvorni.TipNaziv</strong>
                                    </div>
                                    <div class="col-md-2">
                                        <small class="text-muted d-block">Datum</small>
                                        @rezultatPovezanosti.Izvorni.DatumFormatted
                                    </div>
                                    <div class="col-md-2">
                                        <small class="text-muted d-block">Komitent</small>
                                        @rezultatPovezanosti.Izvorni.Komitent
                                    </div>
                                    <div class="col-md-2">
                                        <small class="text-muted d-block">Artikal</small>
                                        @rezultatPovezanosti.Izvorni.Artikal
                                    </div>
                                    <div class="col-md-1 text-end">
                                        <small class="text-muted d-block">Količina</small>
                                        <strong>@rezultatPovezanosti.Izvorni.Kolicina.ToString("N2") kg</strong>
                                    </div>
                                    <div class="col-md-2">
                                        <small class="text-muted d-block">Dokument</small>
                                        @if (!string.IsNullOrEmpty(rezultatPovezanosti.Izvorni.PrijemnicaSifra))
                                        { <span><i class="bi bi-box-arrow-in-down me-1 text-success"></i>@rezultatPovezanosti.Izvorni.PrijemnicaSifra</span> }
                                        @if (!string.IsNullOrEmpty(rezultatPovezanosti.Izvorni.OtpremnicaSifra))
                                        { <span><i class="bi bi-box-arrow-up me-1 text-primary"></i>@rezultatPovezanosti.Izvorni.OtpremnicaSifra</span> }
                                        @if (!string.IsNullOrEmpty(rezultatPovezanosti.Izvorni.RadniNalogSifra))
                                        { <span><i class="bi bi-clipboard-data me-1 text-warning"></i>@rezultatPovezanosti.Izvorni.RadniNalogSifra</span> }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Rezultat pretrage po kliknutom dokumentu -->
                        @if (dokumentiResult != null)
                        {
                            <div class="card border-0 shadow-sm mb-3">
                                <div class="card-header bg-info text-white py-2 d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-list-ul me-2"></i>Svi paletni listovi za: <strong>@kliknutiDokument</strong></span>
                                    <button class="btn btn-sm btn-light" @onclick="ZatvoriDokumenteResult">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                                <div class="card-body p-0">
                                    @if (!dokumentiResult.Any())
                                    {
                                        <div class="p-3 text-muted">Nema paletnih listova za ovaj dokument.</div>
                                    }
                                    else
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm table-hover mb-0">
                                                <thead class="table-secondary">
                                                    <tr>
                                                        <th>Datum</th><th>Šifra PL</th><th>Tip</th>
                                                        <th>Komitent</th><th>Artikal</th>
                                                        <th class="text-end">Količina</th>
                                                        <th>Prijemnica</th><th>Otpremnica</th><th>Radni Nalog</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var r in dokumentiResult)
                                                    {
                                                        <tr>
                                                            <td>@r.DatumFormatted</td>
                                                            <td>
                                                                <button class="btn btn-link btn-sm p-0"
                                                                        @onclick="() => PretraziPovezanostIzTabele(r.Sifra)">
                                                                    <span class="badge @(r.PaletniListTip == 1 ? "bg-success" : r.PaletniListTip == 2 ? "bg-primary" : "bg-warning text-dark")">
                                                                        @r.Sifra
                                                                    </span>
                                                                </button>
                                                            </td>
                                                            <td>@r.TipNaziv</td>
                                                            <td>@r.Komitent</td>
                                                            <td>@r.Artikal</td>
                                                            <td class="text-end">@r.Kolicina.ToString("N2")</td>
                                                            <td><small>@(r.PrijemnicaSifra ?? "-")</small></td>
                                                            <td><small>@(r.OtpremnicaSifra ?? "-")</small></td>
                                                            <td><small>@(r.RadniNalogSifra ?? "-")</small></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Povezani PL -->
                        @if (!rezultatPovezanosti.Povezani.Any())
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>
                                Ovaj paletni list nema evidentiranih veza u tabeli PaletniListoviPracenje.
                            </div>
                        }
                        else
                        {
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-secondary text-white py-2">
                                    <i class="bi bi-diagram-3 me-2"></i>
                                    Povezani paletni listovi
                                    <span class="badge bg-light text-dark ms-2">@rezultatPovezanosti.Povezani.Count</span>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover table-sm mb-0">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Datum</th>
                                                    <th>Šifra PL</th>
                                                    <th>Tip</th>
                                                    <th>Komitent</th>
                                                    <th>Artikal</th>
                                                    <th class="text-end">Količina</th>
                                                    <th>Prijemnica</th>
                                                    <th>Otpremnica</th>
                                                    <th>Radni Nalog</th>
                                                    <th>Evid. Rada</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var v in rezultatPovezanosti.Povezani)
                                                {
                                                    <tr>
                                                        <td class="text-nowrap">@v.DatumFormatted</td>
                                                        <td>
                                                            <button class="btn btn-link btn-sm p-0"
                                                                    @onclick="() => PretraziPovezanostIzTabele(v.PaletniListSifra)">
                                                                <span class="badge @v.TipBadgeClass">@v.PaletniListSifra</span>
                                                            </button>
                                                        </td>
                                                        <td><small>@v.TipNaziv</small></td>
                                                        <td>@v.Komitent</td>
                                                        <td>@v.Artikal</td>
                                                        <td class="text-end">@v.Kolicina.ToString("N2")</td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(v.PrijemnicaSifra))
                                                            {
                                                                <button class="btn btn-link btn-sm p-0 text-success"
                                                                        @onclick="() => PretraziPrijemnicu(v.PrijemnicaSifra!)">
                                                                    @v.PrijemnicaSifra
                                                                </button>
                                                            }
                                                            else { <span class="text-muted">-</span> }
                                                        </td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(v.OtpremnicaSifra))
                                                            {
                                                                <button class="btn btn-link btn-sm p-0 text-primary"
                                                                        @onclick="() => PretraziOtpremnicu(v.OtpremnicaSifra!)">
                                                                    @v.OtpremnicaSifra
                                                                </button>
                                                            }
                                                            else { <span class="text-muted">-</span> }
                                                        </td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(v.RadniNalogSifra))
                                                            {
                                                                <button class="btn btn-link btn-sm p-0 text-warning"
                                                                        @onclick="() => PretraziRadniNalog(v.RadniNalogSifra!)">
                                                                    @v.RadniNalogSifra
                                                                </button>
                                                            }
                                                            else { <span class="text-muted">-</span> }
                                                        </td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(v.EvidencijaRadaSifra))
                                                            {
                                                                <button class="btn btn-link btn-sm p-0 text-info"
                                                                        @onclick="() => PretraziEvidenciju(v.EvidencijaRadaSifra!)">
                                                                    @v.EvidencijaRadaSifra
                                                                </button>
                                                            }
                                                            else { <span class="text-muted">-</span> }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        Unesite šifru paletnog lista da vidite sve povezane paletne listove (nabavka → proizvodnja → prodaja).
                        <br />
                        <small>Kliknite na šifru prijemnice, otpremnice ili radnog naloga da vidite sve paletne listove tog dokumenta.</small>
                    </div>
                }
            }

            <!-- ═══ TAB: KVALITET ═══ -->
            @if (aktivniTab == "kvalitet")
            {
                <!-- Filter -->
                <div class="row g-2 mb-3">
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Od datuma</label>
                        <input type="date" class="form-control form-control-sm"
                               value="@(filterKvalitet.OdDatum?.ToString("yyyy-MM-dd"))"
                               @onchange="async e => { if(DateTime.TryParse(e.Value?.ToString(), out var d)) filterKvalitet.OdDatum = d; else filterKvalitet.OdDatum = null; await OsvjeziPrijemniceKvalitet(); }" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Do datuma</label>
                        <input type="date" class="form-control form-control-sm"
                               value="@(filterKvalitet.DoDatum?.ToString("yyyy-MM-dd"))"
                               @onchange="async e => { if(DateTime.TryParse(e.Value?.ToString(), out var d)) filterKvalitet.DoDatum = d; else filterKvalitet.DoDatum = null; await OsvjeziPrijemniceKvalitet(); }" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Komitent</label>
                        <select class="form-select form-select-sm" @bind="filterKvalitet.Komitent">
                            <option value="">— svi —</option>
                            @foreach (var k in komitentiKvalitet)
                            {
                                <option value="@k">@k</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm fw-bold">Artikal <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm @(filterKvalitet.ArtikalID == null ? "border-danger" : "")" @bind="filterKvalitet.ArtikalID">
                            <option value="">— izaberi artikal —</option>
                            @foreach (var a in artikliKvalitet)
                            {
                                <option value="@a.ID">@a.Naziv</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label form-label-sm">Prijemnica</label>
                        <select class="form-select form-select-sm" @bind="filterKvalitet.Prijemnica">
                            <option value="">— sve —</option>
                            @foreach (var pr in prijemniceKvalitet)
                            {
                                <option value="@pr">@pr</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end gap-1">
                        <button class="btn btn-primary btn-sm flex-grow-1" @onclick="PretrazKvalitet" disabled="@(ucitava || string.IsNullOrEmpty(filterKvalitet.ArtikalID))">
                            @if (ucitava && aktivniTab == "kvalitet") { <span class="spinner-border spinner-border-sm"></span> }
                            else { <i class="bi bi-search"></i> }
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ResetKvalitet" title="Reset">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                </div>

                @if (string.IsNullOrEmpty(filterKvalitet.ArtikalID))
                {
                    <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>Izaberite artikal — izveštaj kvaliteta je uvek za jednu vrstu artikla.</div>
                }
                else if (ucitava && aktivniTab == "kvalitet")
                {
                    <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
                }
                else if (podaciKvalitet == null)
                {
                    <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>Kliknite Pretraži da učitate izveštaj.</div>
                }
                else if (!podaciKvalitet.Any())
                {
                    <div class="alert alert-warning"><i class="bi bi-search me-2"></i>Nema rezultata.</div>
                }
                else
                {
                    <!-- Summary -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <small class="text-muted">
                            Prikazano @podaciKvalitet.Count redova ·
                            Ukupno: @podaciKvalitet.Sum(x => x.Ukupno).ToString("N2") kg ·
                            I klasa: @podaciKvalitet.Sum(x => x.KlasaI).ToString("N2") kg ·
                            Prosek I klase: @(podaciKvalitet.Sum(x => x.Ukupno) > 0
                                ? (podaciKvalitet.Sum(x => x.KlasaI) / podaciKvalitet.Sum(x => x.Ukupno) * 100).ToString("N1")
                                : "0,0") %
                        </small>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Prijemnica</th>
                                    <th>Komitent</th>
                                    <th>Artikal</th>
                                    <th class="text-end">I Klasa (kg)</th>
                                    <th class="text-end">II Klasa (kg)</th>
                                    <th class="text-end">III Klasa (kg)</th>
                                    <th class="text-end">Ukupno (kg)</th>
                                    <th class="text-end">% I Klase</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in podaciKvalitet)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">@(r.PrijemnicaSifra.Length > 0 ? r.PrijemnicaSifra : "-")</span></td>
                                        <td>@r.Komitent</td>
                                        <td>@r.Artikal</td>
                                        <td class="text-end fw-bold text-success">@r.KlasaIStr</td>
                                        <td class="text-end">@r.KlasaIIStr</td>
                                        <td class="text-end text-muted">@r.KlasaIIIStr</td>
                                        <td class="text-end fw-bold">@r.UkupnoStr</td>
                                        <td class="text-end">
                                            <span class="badge @(r.ProcenatKlaseI >= 80 ? "bg-success" : r.ProcenatKlaseI >= 60 ? "bg-warning text-dark" : "bg-danger")">
                                                @r.ProcenatStr
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-secondary fw-bold">
                                <tr>
                                    <td colspan="3">Ukupno</td>
                                    <td class="text-end text-success">@podaciKvalitet.Sum(x => x.KlasaI).ToString("N2")</td>
                                    <td class="text-end">@podaciKvalitet.Sum(x => x.KlasaII).ToString("N2")</td>
                                    <td class="text-end text-muted">@podaciKvalitet.Sum(x => x.KlasaIII).ToString("N2")</td>
                                    <td class="text-end">@podaciKvalitet.Sum(x => x.Ukupno).ToString("N2")</td>
                                    <td class="text-end">
                                        @{
                                            var ukTotal = podaciKvalitet.Sum(x => x.Ukupno);
                                            var i1Total = podaciKvalitet.Sum(x => x.KlasaI);
                                            var pct = ukTotal > 0 ? (i1Total / ukTotal * 100) : 0;
                                        }
                                        <span class="badge @(pct >= 80 ? "bg-success" : pct >= 60 ? "bg-warning text-dark" : "bg-danger")">
                                            @pct.ToString("N1") %
                                        </span>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            }

        </div>

        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Početna</a></li>
                <li class="breadcrumb-item"><a href="/promethome">Promet Roba</a></li>
                <li class="breadcrumb-item active">Paletni List Pregled</li>
            </ol>
        </nav>
    </div>
}

@code {
    private bool autorizovan = false;
    private bool ucitava = false;
    private string aktivniTab = "nabavka";

    // Filteri po tabu
    private PaletniListPregledFilter filterNabavka = new() { OdDatum = DateTime.Today.AddDays(-10), DoDatum = DateTime.Today };
    private PaletniListPregledFilter filterProdaja = new() { OdDatum = DateTime.Today.AddDays(-10), DoDatum = DateTime.Today };
    private PaletniListPregledFilter filterProizvodnja = new() { OdDatum = DateTime.Today.AddDays(-10), DoDatum = DateTime.Today };

    // Podaci po tabu
    private List<PaletniListPregledRow>? podaciNabavka;
    private List<PaletniListPregledRow>? podaciProdaja;
    private List<PaletniListPregledRow>? podaciProizvodnja;

    // Povezanost tab
    private string pretragaPovezanosti = "";
    private PaletniListPovezanostResult? rezultatPovezanosti;
    private List<PaletniListPregledRow>? dokumentiResult;
    private string? kliknutiDokument;

    // Kvalitet tab
    private PaletniListKvalitetFilter filterKvalitet = new() { OdDatum = DateTime.Today.AddDays(-10), DoDatum = DateTime.Today };
    private List<PaletniListKvalitetRow>? podaciKvalitet;
    private List<(string ID, string Naziv)> artikliKvalitet = new();
    private List<string> komitentiKvalitet = new();
    private List<string> prijemniceKvalitet = new();

    // Dropdown liste
    private List<string> komitentiNabavka = new();
    private List<string> artikliNabavka = new();
    private List<string> prijemnice = new();
    private List<string> komitentiProdaja = new();
    private List<string> artikliProdaja = new();
    private List<string> otpremnice = new();
    private List<string> komitentiProizvodnja = new();
    private List<string> artikliProizvodnja = new();
    private List<string> radniNalozi = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await AuthService.GetCurrentUser();
            if (user == null)
            {
                NavigationManager.NavigateTo("/unauthorized");
                return;
            }
            autorizovan = true;

            // Učitaj statičke dropdown liste i podatke za aktivan tab paralelno
            var t1 = PaletniListService.UcitajKomitentePaletniListova(1); // Nabavka/Prijem
            var t2 = PaletniListService.UcitajArtiklePaletniListova(1);
            var t3 = PaletniListService.UcitajKomitentePaletniListova(3); // Prodaja/Otprema
            var t4 = PaletniListService.UcitajArtiklePaletniListova(3);
            var t5 = PaletniListService.UcitajKomitentePaletniListova(2); // Proizvodnja
            var t6 = PaletniListService.UcitajArtiklePaletniListova(2);
            var t7 = PaletniListService.UcitajPrijemniceZaPeriod(filterNabavka.OdDatum, filterNabavka.DoDatum);
            var t8 = PaletniListService.UcitajOtpremnicaZaPeriod(filterProdaja.OdDatum, filterProdaja.DoDatum);
            var t9 = PaletniListService.UcitajRadneNalogeZaPeriod(filterProizvodnja.OdDatum, filterProizvodnja.DoDatum);
            var t10 = PaletniListService.UcitajNabavkuPaletniListova(filterNabavka);
            var t11 = PaletniListService.UcitajArtikleZaKvalitet();
            var t12 = PaletniListService.UcitajKomitentePaletniListovaKvalitet();
            var t13 = PaletniListService.UcitajPrijemniceZaPeriodKvalitet(filterKvalitet.OdDatum, filterKvalitet.DoDatum);
            await Task.WhenAll(t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, t12, t13);
            komitentiNabavka = t1.Result;
            artikliNabavka = t2.Result;
            komitentiProdaja = t3.Result;
            artikliProdaja = t4.Result;
            komitentiProizvodnja = t5.Result;
            artikliProizvodnja = t6.Result;
            prijemnice = t7.Result;
            otpremnice = t8.Result;
            radniNalozi = t9.Result;
            podaciNabavka = t10.Result;
            artikliKvalitet = t11.Result;
            komitentiKvalitet = t12.Result;
            prijemniceKvalitet = t13.Result;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri inicijalizaciji PaletniListPregled");
            NavigationManager.NavigateTo("/unauthorized");
        }
    }

    private void PredjNaTab(string tab)
    {
        aktivniTab = tab;
        dokumentiResult = null;
        kliknutiDokument = null;
    }

    private async Task OsvjeziPrijemnice()
    {
        prijemnice = await PaletniListService.UcitajPrijemniceZaPeriod(filterNabavka.OdDatum, filterNabavka.DoDatum);
        filterNabavka.Prijemnica = null;
    }

    private async Task OsvjeziOtpremnice()
    {
        otpremnice = await PaletniListService.UcitajOtpremnicaZaPeriod(filterProdaja.OdDatum, filterProdaja.DoDatum);
        filterProdaja.Otpremnica = null;
    }

    private async Task OsvjeziRadneNaloge()
    {
        radniNalozi = await PaletniListService.UcitajRadneNalogeZaPeriod(filterProizvodnja.OdDatum, filterProizvodnja.DoDatum);
        filterProizvodnja.RadniNalog = null;
    }

    // ── NABAVKA ────────────────────────────────────────────
    private async Task PretrazNabavku()
    {
        ucitava = true;
        try { podaciNabavka = await PaletniListService.UcitajNabavkuPaletniListova(filterNabavka); }
        catch (Exception ex) { Logger.LogError(ex, "Greška Nabavka PL"); podaciNabavka = new(); }
        finally { ucitava = false; }
    }

    private void ResetNabavku()
    {
        filterNabavka = new() { OdDatum = DateTime.Today.AddDays(-10), DoDatum = DateTime.Today };
        podaciNabavka = null;
    }

    // ── PRODAJA ────────────────────────────────────────────
    private async Task PretrazProdaju()
    {
        ucitava = true;
        try { podaciProdaja = await PaletniListService.UcitajProdajuPaletniListova(filterProdaja); }
        catch (Exception ex) { Logger.LogError(ex, "Greška Prodaja PL"); podaciProdaja = new(); }
        finally { ucitava = false; }
    }

    private void ResetProdaju()
    {
        filterProdaja = new() { OdDatum = DateTime.Today.AddDays(-10), DoDatum = DateTime.Today };
        podaciProdaja = null;
    }

    // ── PROIZVODNJA ────────────────────────────────────────
    private async Task PretrazProizvodnju()
    {
        ucitava = true;
        try { podaciProizvodnja = await PaletniListService.UcitajProizvodnjuPaletniListova(filterProizvodnja); }
        catch (Exception ex) { Logger.LogError(ex, "Greška Proizvodnja PL"); podaciProizvodnja = new(); }
        finally { ucitava = false; }
    }

    private void ResetProizvodnju()
    {
        filterProizvodnja = new() { OdDatum = DateTime.Today.AddDays(-10), DoDatum = DateTime.Today };
        podaciProizvodnja = null;
    }

    // ── POVEZANOST ─────────────────────────────────────────
    private async Task PretrazPovezanost()
    {
        if (string.IsNullOrWhiteSpace(pretragaPovezanosti)) return;
        ucitava = true;
        dokumentiResult = null;
        kliknutiDokument = null;
        try { rezultatPovezanosti = await PaletniListService.UcitajPovezanostPaletniListova(pretragaPovezanosti.Trim()); }
        catch (Exception ex) { Logger.LogError(ex, "Greška Povezanost PL"); rezultatPovezanosti = new(); }
        finally { ucitava = false; }
    }

    private void ResetPovezanost()
    {
        pretragaPovezanosti = "";
        rezultatPovezanosti = null;
        dokumentiResult = null;
        kliknutiDokument = null;
    }

    private async Task OnPovezanostKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await PretrazPovezanost();
    }

    private async Task PretraziPojedinacniDokument(string tip, string sifra)
    {
        kliknutiDokument = sifra;
        ucitava = true;
        try { dokumentiResult = await PaletniListService.UcitajPojedinacniDokument(tip, sifra); }
        catch (Exception ex) { Logger.LogError(ex, "Greška učitavanja dokumenta {Tip}={Sifra}", tip, sifra); dokumentiResult = new(); }
        finally { ucitava = false; }
    }

    private async Task PretraziPovezanostIzTabele(string sifra)
    {
        pretragaPovezanosti = sifra;
        await PretrazPovezanost();
    }

    private void ZatvoriDokumenteResult()
    {
        dokumentiResult = null;
        kliknutiDokument = null;
    }

    // Typed helpers da izbegnemo string literal problem u Blazor @onclick
    private Task PretraziPrijemnicu(string sifra) => PretraziPojedinacniDokument("prijemnica", sifra);
    private Task PretraziOtpremnicu(string sifra) => PretraziPojedinacniDokument("otpremnica", sifra);
    private Task PretraziRadniNalog(string sifra) => PretraziPojedinacniDokument("radni_nalog", sifra);
    private Task PretraziEvidenciju(string sifra) => PretraziPojedinacniDokument("evidencija", sifra);

    // ── KVALITET ───────────────────────────────────────────
    private async Task PretrazKvalitet()
    {
        if (string.IsNullOrEmpty(filterKvalitet.ArtikalID)) return;
        ucitava = true;
        try { podaciKvalitet = await PaletniListService.UcitajKvalitetIzvestaj(filterKvalitet); }
        catch (Exception ex) { Logger.LogError(ex, "Greška Kvalitet"); podaciKvalitet = new(); }
        finally { ucitava = false; }
    }

    private void ResetKvalitet()
    {
        filterKvalitet = new() { OdDatum = DateTime.Today.AddDays(-10), DoDatum = DateTime.Today };
        podaciKvalitet = null;
    }

    private async Task OsvjeziPrijemniceKvalitet()
    {
        prijemniceKvalitet = await PaletniListService.UcitajPrijemniceZaPeriodKvalitet(filterKvalitet.OdDatum, filterKvalitet.DoDatum);
        filterKvalitet.Prijemnica = null;
    }
}
