@page "/poslovanje"
@using FruitSysWeb.Models
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Implementations.ExportService
@inject NavigationManager NavigationManager
@inject IAuthService AuthService
@inject IPromenService PromenService
@inject IUgovorService UgovorService
@inject IJSRuntime JS

@if (!pristupDozvoljen)
{
    <div class="alert alert-danger m-4"><i class="bi bi-lock me-2"></i>Nemate pristup ovoj stranici.</div>
    return;
}

<!-- Header -->
<div class="bg-dark text-white py-4 mb-4">
    <div class="container-fluid">
        <h1 class="h2 mb-1"><i class="bi bi-briefcase me-2"></i>Poslovanje</h1>
        <p class="mb-0 text-white-50">Pregled poslovnih izveštaja — fakture, ugovori, promene i komitenti</p>
    </div>
</div>

<div class="container-fluid">

    <!-- ── KARTICE ── -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 text-center py-3 px-2" style="cursor:pointer; transition:transform .15s;"
                 @onclick='() => NavigationManager.NavigateTo("/promene")'
                 onmouseenter="this.style.transform='translateY(-3px)'" onmouseleave="this.style.transform=''">
                <div class="mb-2" style="font-size:2rem; color:#0d47a1;"><i class="bi bi-arrow-left-right"></i></div>
                <div class="fw-bold">Promene</div>
                <div class="text-muted small">Ulaz, izlaz i finansije</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 text-center py-3 px-2" style="cursor:pointer; transition:transform .15s;"
                 @onclick='() => NavigationManager.NavigateTo("/fakture")'
                 onmouseenter="this.style.transform='translateY(-3px)'" onmouseleave="this.style.transform=''">
                <div class="mb-2" style="font-size:2rem; color:#1b5e20;"><i class="bi bi-receipt"></i></div>
                <div class="fw-bold">Fakture</div>
                <div class="text-muted small">Pregled faktura</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 text-center py-3 px-2" style="cursor:pointer; transition:transform .15s;"
                 @onclick='() => NavigationManager.NavigateTo("/ugovori")'
                 onmouseenter="this.style.transform='translateY(-3px)'" onmouseleave="this.style.transform=''">
                <div class="mb-2" style="font-size:2rem; color:#4a148c;"><i class="bi bi-file-earmark-text"></i></div>
                <div class="fw-bold">Ugovori</div>
                <div class="text-muted small">Pregled ugovora</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 text-center py-3 px-2" style="cursor:pointer; transition:transform .15s;"
                 @onclick='() => NavigationManager.NavigateTo("/kartica-komitenta")'
                 onmouseenter="this.style.transform='translateY(-3px)'" onmouseleave="this.style.transform=''">
                <div class="mb-2" style="font-size:2rem; color:#e65100;"><i class="bi bi-person-lines-fill"></i></div>
                <div class="fw-bold">Kartice Komitenata</div>
                <div class="text-muted small">Analitika po komitentu</div>
            </div>
        </div>
    </div>

    <!-- ── PREOSTALE KOLICINE PO UGOVORU ── -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header fw-bold text-white d-flex justify-content-between align-items-center" style="background-color:#4a148c;">
            <span><i class="bi bi-file-earmark-text me-2"></i>Preostale Količine po Ugovoru</span>
            <a href="/ugovori" class="btn btn-sm btn-outline-light">
                <i class="bi bi-box-arrow-up-right me-1"></i>Aktivni Ugovori
            </a>
        </div>
        <div class="card-body p-0">
            @if (ucitavanjeUgovori)
            {
                <div class="text-center py-3">
                    <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
                    <span class="ms-2 text-muted small">Učitavanje...</span>
                </div>
            }
            else if (!preostaleKolicine.Any())
            {
                <div class="alert alert-info m-3 mb-0"><i class="bi bi-info-circle me-2"></i>Nema aktivnih ugovora sa preostatkom.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped table-hover mb-0" style="font-size:0.85rem;">
                        <thead style="background-color:#6a1b9a; color:white; font-size:0.8rem;">
                            <tr>
                                <th style="width:40px">Rb.</th>
                                <th>Artikal</th>
                                <th class="text-end">Količina (kg)</th>
                                <th class="text-end">Prosečna Cena (EUR)</th>
                                <th class="text-end">Vrednost (EUR)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rbU = 1; }
                            @foreach (var red in preostaleKolicine)
                            {
                                <tr>
                                    <td class="text-muted">@(rbU++)</td>
                                    <td class="fw-semibold">@red.Artikal</td>
                                    <td class="text-end">@red.PreostalaKolicina.ToString("N2", SrCulture)</td>
                                    <td class="text-end">@red.ProsecnaCenaEur.ToString("N2", SrCulture)</td>
                                    <td class="text-end fw-semibold">@red.VrednostEur.ToString("N2", SrCulture)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="fw-bold" style="background-color:#e1bee7;">
                            <tr>
                                <td colspan="2" class="text-end">Ukupno:</td>
                                <td class="text-end">@preostaleKolicine.Sum(x => x.PreostalaKolicina).ToString("N2", SrCulture)</td>
                                <td></td>
                                <td class="text-end">@preostaleKolicine.Sum(x => x.VrednostEur).ToString("N2", SrCulture)</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- ── DNEVNE PROMENE ── -->
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h5 class="mb-0"><i class="bi bi-calendar-day me-2"></i>Dnevne Promene — @DateTime.Today.ToString("dd.MM.yyyy")</h5>
        @if (dnevniData != null && !ucitavanje)
        {
            <a href="/promene" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-box-arrow-up-right me-1"></i>Otvori Promene
            </a>
        }
    </div>

    @if (ucitavanje)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-dark" role="status"></div>
            <p class="mt-3 text-muted">Učitavanje podataka...</p>
        </div>
    }
    else if (dnevniData == null)
    {
        <div class="alert alert-warning"><i class="bi bi-exclamation-circle me-2"></i>Nije moguće učitati podatke.</div>
    }
    else
    {
        <!-- Sumarni boksovi -->
        var sumUlaz = dnevniData.UlazSirovineProizvodi.Sum(x => x.Vrednost)
                    + dnevniData.UlazAmbalaza.Sum(x => x.Vrednost)
                    + dnevniData.UlazRepromaterijal.Sum(x => x.Vrednost);
        var sumIzlaz = dnevniData.IzlazGotovaRobaSirovine.Sum(x => x.Vrednost)
                     + dnevniData.IzlazAmbalaza.Sum(x => x.Vrednost)
                     + dnevniData.IzlazRepromaterijal.Sum(x => x.Vrednost);
        var sumUplate = dnevniData.Finansije.Sum(x => x.Uplata);
        var sumIsplate = dnevniData.Finansije.Sum(x => x.Isplata);
        <div class="row g-2 mb-3">
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #0d47a1 !important;">
                    <div class="card-body py-2 px-3">
                        <div class="text-muted small fw-bold text-uppercase" style="font-size:0.72rem;">Ukupno Ulaz</div>
                        <div class="fw-bold fs-6" style="color:#0d47a1;">@Fmt(sumUlaz) <span class="small fw-normal text-muted">RSD</span></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #b71c1c !important;">
                    <div class="card-body py-2 px-3">
                        <div class="text-muted small fw-bold text-uppercase" style="font-size:0.72rem;">Ukupno Izlaz</div>
                        <div class="fw-bold fs-6" style="color:#b71c1c;">@Fmt(sumIzlaz) <span class="small fw-normal text-muted">RSD</span></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #1b5e20 !important;">
                    <div class="card-body py-2 px-3">
                        <div class="text-muted small fw-bold text-uppercase" style="font-size:0.72rem;">Ukupne Uplate</div>
                        <div class="fw-bold fs-6" style="color:#1b5e20;">@Fmt(sumUplate) <span class="small fw-normal text-muted">RSD</span></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm h-100" style="border-left:4px solid #e65100 !important;">
                    <div class="card-body py-2 px-3">
                        <div class="text-muted small fw-bold text-uppercase" style="font-size:0.72rem;">Ukupne Isplate</div>
                        <div class="fw-bold fs-6" style="color:#e65100;">@Fmt(sumIsplate) <span class="small fw-normal text-muted">RSD</span></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ULAZ -->
        @if (dnevniData.UlazSirovineProizvodi.Any() || dnevniData.UlazAmbalaza.Any() || dnevniData.UlazRepromaterijal.Any())
        {
            <div class="card mb-3 border-0 shadow-sm">
                <div class="card-header fw-bold text-white" style="background-color:#0d47a1;">
                    <i class="bi bi-arrow-down-circle me-2"></i>ULAZ
                </div>
                <div class="card-body p-2">
                    @if (dnevniData.UlazSirovineProizvodi.Any())
                    {
                        <p class="fw-bold mb-1 px-2" style="color:#1565c0;">Sirovine i Proizvodi</p>
                        @RenderUlazTabela(dnevniData.UlazSirovineProizvodi)
                    }
                    @if (dnevniData.UlazAmbalaza.Any())
                    {
                        @if (dnevniData.UlazSirovineProizvodi.Any()) { <hr class="my-2" /> }
                        <p class="fw-bold mb-1 px-2" style="color:#1565c0;">Ambalaza (nepovratna)</p>
                        @RenderUlazTabela(dnevniData.UlazAmbalaza)
                    }
                    @if (dnevniData.UlazRepromaterijal.Any())
                    {
                        @if (dnevniData.UlazSirovineProizvodi.Any() || dnevniData.UlazAmbalaza.Any()) { <hr class="my-2" /> }
                        <p class="fw-bold mb-1 px-2" style="color:#1565c0;">Repromaterijal</p>
                        @RenderUlazTabela(dnevniData.UlazRepromaterijal)
                    }
                    @{ var ukUlaz = dnevniData.UlazSirovineProizvodi.Sum(x=>x.Vrednost)
                                   + dnevniData.UlazAmbalaza.Sum(x=>x.Vrednost)
                                   + dnevniData.UlazRepromaterijal.Sum(x=>x.Vrednost); }
                    <div class="d-flex justify-content-end mt-2">
                        <div class="px-4 py-2 text-white fw-bold rounded" style="background-color:#0d47a1; font-size:0.95rem;">
                            UKUPNO ULAZ: @Fmt(ukUlaz) RSD
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- IZLAZ -->
        @if (dnevniData.IzlazGotovaRobaSirovine.Any() || dnevniData.IzlazAmbalaza.Any() || dnevniData.IzlazRepromaterijal.Any())
        {
            <div class="card mb-3 border-0 shadow-sm">
                <div class="card-header fw-bold text-white" style="background-color:#b71c1c;">
                    <i class="bi bi-arrow-up-circle me-2"></i>IZLAZ
                </div>
                <div class="card-body p-2">
                    @if (dnevniData.IzlazGotovaRobaSirovine.Any())
                    {
                        <p class="fw-bold mb-1 px-2" style="color:#c62828;">Gotova Roba i Sirovine</p>
                        @RenderIzlazTabela(dnevniData.IzlazGotovaRobaSirovine)
                    }
                    @if (dnevniData.IzlazAmbalaza.Any())
                    {
                        @if (dnevniData.IzlazGotovaRobaSirovine.Any()) { <hr class="my-2" /> }
                        <p class="fw-bold mb-1 px-2" style="color:#c62828;">Ambalaza</p>
                        @RenderIzlazTabela(dnevniData.IzlazAmbalaza)
                    }
                    @if (dnevniData.IzlazRepromaterijal.Any())
                    {
                        @if (dnevniData.IzlazGotovaRobaSirovine.Any() || dnevniData.IzlazAmbalaza.Any()) { <hr class="my-2" /> }
                        <p class="fw-bold mb-1 px-2" style="color:#c62828;">Repromaterijal</p>
                        @RenderIzlazTabela(dnevniData.IzlazRepromaterijal)
                    }
                    @{ var ukIzlaz = dnevniData.IzlazGotovaRobaSirovine.Sum(x=>x.Vrednost)
                                    + dnevniData.IzlazAmbalaza.Sum(x=>x.Vrednost)
                                    + dnevniData.IzlazRepromaterijal.Sum(x=>x.Vrednost); }
                    <div class="d-flex justify-content-end mt-2">
                        <div class="px-4 py-2 text-white fw-bold rounded" style="background-color:#b71c1c; font-size:0.95rem;">
                            UKUPNO IZLAZ: @Fmt(ukIzlaz) RSD
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- FINANSIJE -->
        @if (dnevniData.Finansije.Any())
        {
            <div class="card mb-4 border-0 shadow-sm">
                <div class="card-header fw-bold text-white" style="background-color:#1b5e20;">
                    <i class="bi bi-cash-coin me-2"></i>FINANSIJE
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover table-sm mb-0">
                            <thead style="background-color:#2e7d32; color:white; font-size:0.82rem;">
                                <tr>
                                    <th>Rb.</th>
                                    <th>Dokument</th>
                                    <th>Datum</th>
                                    <th>Tip Prometa</th>
                                    <th>Komitent</th>
                                    <th class="text-end">Uplata (RSD)</th>
                                    <th class="text-end">Isplata (RSD)</th>
                                </tr>
                            </thead>
                            <tbody style="font-size:0.82rem;">
                                @{ int rb = 1; }
                                @foreach (var f in dnevniData.Finansije)
                                {
                                    <tr>
                                        <td class="text-muted">@(rb++)</td>
                                        <td><code class="small">@f.Dokument</code></td>
                                        <td>@f.Datum.ToString("dd.MM.yyyy")</td>
                                        <td>
                                            @if (f.TipPrometa == "Uplata")
                                            {
                                                <span class="badge bg-success">Uplata</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Isplata</span>
                                            }
                                        </td>
                                        <td>@f.Komitent</td>
                                        <td class="text-end text-success fw-semibold">@(f.Uplata > 0 ? Fmt(f.Uplata) : "")</td>
                                        <td class="text-end text-danger fw-semibold">@(f.Isplata > 0 ? Fmt(f.Isplata) : "")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="fw-bold" style="background-color:#c8e6c9;">
                                <tr>
                                    <td colspan="5" class="text-end">Ukupno:</td>
                                    <td class="text-end text-success">@Fmt(dnevniData.Finansije.Sum(x=>x.Uplata))</td>
                                    <td class="text-end text-danger">@Fmt(dnevniData.Finansije.Sum(x=>x.Isplata))</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (!dnevniData.UlazSirovineProizvodi.Any() && !dnevniData.UlazAmbalaza.Any() && !dnevniData.UlazRepromaterijal.Any()
          && !dnevniData.IzlazGotovaRobaSirovine.Any() && !dnevniData.IzlazAmbalaza.Any() && !dnevniData.IzlazRepromaterijal.Any()
          && !dnevniData.Finansije.Any())
        {
            <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>Nema promena za danas (@DateTime.Today.ToString("dd.MM.yyyy")).</div>
        }
    }
</div>

@functions {
    RenderFragment RenderUlazTabela(List<PromenUlazModel> stavke) =>
        @<div class="table-responsive">
            <table class="table table-sm table-striped table-hover mb-0" style="font-size:0.82rem;">
                <thead class="table-primary" style="font-size:0.78rem;">
                    <tr>
                        <th style="width:40px">Rb.</th>
                        <th>Dokument</th>
                        <th>Datum</th>
                        <th>Vrsta Proizvoda</th>
                        <th>Dobavljač</th>
                        <th class="text-end">Količina</th>
                        <th class="text-end">Cena (RSD)</th>
                        <th class="text-end">Vrednost (RSD)</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var s in stavke)
                    {
                        <tr>
                            <td class="text-muted">@(i++)</td>
                            <td><code class="small">@s.Dokument</code></td>
                            <td>@s.Datum.ToString("dd.MM.yyyy")</td>
                            <td>@s.VrstaProizvoda</td>
                            <td>@s.Dobavljac</td>
                            <td class="text-end">@Fmt(s.Kolicina)</td>
                            <td class="text-end">@Fmt(s.Cena)</td>
                            <td class="text-end fw-semibold">@Fmt(s.Vrednost)</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-info fw-bold">
                    <tr>
                        <td colspan="7" class="text-end">Ukupno:</td>
                        <td class="text-end">@Fmt(stavke.Sum(x => x.Vrednost))</td>
                    </tr>
                </tfoot>
            </table>
        </div>;

    RenderFragment RenderIzlazTabela(List<PromenIzlazModel> stavke) =>
        @<div class="table-responsive">
            <table class="table table-sm table-striped table-hover mb-0" style="font-size:0.82rem;">
                <thead class="table-danger" style="font-size:0.78rem;">
                    <tr>
                        <th style="width:40px">Rb.</th>
                        <th>Dokument</th>
                        <th>Datum</th>
                        <th>Vrsta Proizvoda</th>
                        <th>Kupac</th>
                        <th class="text-end">Količina</th>
                        <th class="text-end">Cena (RSD)</th>
                        <th class="text-end">Vrednost (RSD)</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var s in stavke)
                    {
                        <tr>
                            <td class="text-muted">@(i++)</td>
                            <td><code class="small">@s.Dokument</code></td>
                            <td>@s.Datum.ToString("dd.MM.yyyy")</td>
                            <td>@s.VrstaProizvoda</td>
                            <td>@s.Kupac</td>
                            <td class="text-end">@Fmt(s.Kolicina)</td>
                            <td class="text-end">@Fmt(s.Cena)</td>
                            <td class="text-end fw-semibold">@Fmt(s.Vrednost)</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-warning fw-bold">
                    <tr>
                        <td colspan="7" class="text-end">Ukupno:</td>
                        <td class="text-end">@Fmt(stavke.Sum(x => x.Vrednost))</td>
                    </tr>
                </tfoot>
            </table>
        </div>;
}

@code {
    private bool pristupDozvoljen = false;
    private bool ucitavanje = false;
    private bool ucitavanjeUgovori = false;
    private PromenPeriodData? dnevniData;
    private List<(string Artikal, decimal PreostalaKolicina, decimal ProsecnaCenaEur, decimal VrednostEur)> preostaleKolicine = new();

    private static readonly System.Globalization.CultureInfo SrCulture =
        System.Globalization.CultureInfo.GetCultureInfo("sr-Latn-RS");

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthService.IsAdministrator())
        {
            NavigationManager.NavigateTo("/finansijehome");
            return;
        }
        pristupDozvoljen = true;
        await Task.WhenAll(UcitajDnevnePromene(), UcitajPreostaleKolicine());
    }

    private async Task UcitajDnevnePromene()
    {
        ucitavanje = true;
        StateHasChanged();
        try
        {
            dnevniData = await PromenService.UcitajPromene(new PromenFilter
            {
                OdDatum = DateTime.Today,
                DoDatum = DateTime.Today
            });
        }
        finally
        {
            ucitavanje = false;
            StateHasChanged();
        }
    }

    private async Task UcitajPreostaleKolicine()
    {
        ucitavanjeUgovori = true;
        StateHasChanged();
        try
        {
            preostaleKolicine = await UgovorService.UcitajPreostaleKolicinePoArtiklu();
        }
        finally
        {
            ucitavanjeUgovori = false;
            StateHasChanged();
        }
    }

    private string Fmt(decimal v) => v.ToString("N2", SrCulture);
}
