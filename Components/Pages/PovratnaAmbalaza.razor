@page "/povratna-ambalaza"
@rendermode @(new InteractiveServerRenderMode())
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Models.Requests
@using FruitSysWeb.Services.Core
@using FruitSysWeb.Components.Charts
@using FruitSysWeb.Models
@using FruitSysWeb.Constants
@inject IPovratnaAmbalazaService PovratnaAmbalazaService
@inject IKomitentService KomitentService
@inject IArtikalService ArtikalService
@inject IExportService ExportService
@inject ITypeMappingService TypeMapping
@inject IJSRuntime JSRuntime
@inject ILogger<PovratnaAmbalaza> Logger

<!-- Header -->
<div class="bg-warning text-dark py-4 mb-4">
    <div class="container-fluid">
        <h1 class="h2 mb-1">
            <i class="bi bi-arrow-repeat me-2"></i>Povratna Ambalaža - PVC Gajbe
        </h1>
        <p class="mb-0">Praćenje prometa povratne PVC ambalaže</p>
    </div>
</div>

<div class="container-fluid">
    <!-- Tabs Navigation -->
    <ul class="nav nav-tabs mb-4" id="povratnaAmbalazaTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="pvc-tab" data-bs-toggle="tab" data-bs-target="#pvc"
                    type="button" role="tab" @onclick="UcitajChartove">
                <i class="bi bi-bar-chart me-2"></i>PVC Ambalaža - Statistika
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="izvestaj-tab" data-bs-toggle="tab" data-bs-target="#izvestaj"
                    type="button" role="tab" @onclick="UcitajIzvestaj">
                <i class="bi bi-table me-2"></i>Detaljan Izveštaj
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="povratnaAmbalazaTabContent">

        <!-- TAB 1: PVC Ambalaža Statistika -->
        <div class="tab-pane fade show active" id="pvc" role="tabpanel">

            <!-- Datum Filter -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="row align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">Od datuma:</label>
                                    <input type="date" class="form-control" value="@OdDatumValue" @onchange="OnOdDatumChanged" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">Do datuma:</label>
                                    <input type="date" class="form-control" value="@DoDatumValue" @onchange="OnDoDatumChanged" />
                                </div>
                                <div class="col-md-3">
                                    <button class="btn btn-primary" @onclick="UcitajChartove" disabled="@IsLoadingCharts">
                                        <i class="bi bi-search me-2"></i>
                                        @(IsLoadingCharts ? "Učitavam..." : "Primeni filter")
                                    </button>
                                    <button class="btn btn-outline-secondary ms-2" @onclick="ResetujFiltere">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Red 1: TOP DUŽNICI -->
            <div class="row mb-3">
                <div class="col-12">
                    <h5 class="mb-3"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Top 5 Dužnika - Ko nama duguje PVC ambala žu</h5>
                </div>
            </div>
            <div class="row mb-4">
                <div class="col-lg-4 mb-3">
                    <ApexBarChart
                        Title="Dužnici PVC 4/1"
                        Icon="bi bi-box-seam"
                        SeriesName="Duguje"
                        Unit="kom"
                        Data="@DuznikPvc41"
                        IsLoading="@IsLoadingDuznik41"
                        HasError="@HasErrorDuznik41"
                        ShowSummary="false"
                        OnRefresh="@(() => UcitajDuznike("PVC 4/1"))" />
                </div>
                <div class="col-lg-4 mb-3">
                    <ApexBarChart
                        Title="Dužnici PVC 6/1"
                        Icon="bi bi-box-seam"
                        SeriesName="Duguje"
                        Unit="kom"
                        Data="@DuznikPvc61"
                        IsLoading="@IsLoadingDuznik61"
                        HasError="@HasErrorDuznik61"
                        ShowSummary="false"
                        OnRefresh="@(() => UcitajDuznike("PVC 6/1"))" />
                </div>
                <div class="col-lg-4 mb-3">
                    <ApexBarChart
                        Title="Dužnici PVC 12/1 + 10/1"
                        Icon="bi bi-box-seam"
                        SeriesName="Duguje"
                        Unit="kom"
                        Data="@DuznikPvc1210"
                        IsLoading="@IsLoadingDuznik1210"
                        HasError="@HasErrorDuznik1210"
                        ShowSummary="false"
                        OnRefresh="@(() => UcitajDuznikeKombinovano())" />
                </div>
            </div>

            <!-- Red 2: KOME DUGUJEMO -->
            <div class="row mb-3">
                <div class="col-12">
                    <h5 class="mb-3"><i class="bi bi-arrow-left-circle text-info me-2"></i>Top 5 Kome Dugujemo - Ko od nas potražuje PVC ambalažu</h5>
                </div>
            </div>
            <div class="row mb-4">
                <div class="col-lg-4 mb-3">
                    <ApexBarChart
                        Title="Kome dugujemo PVC 4/1"
                        Icon="bi bi-arrow-return-left"
                        SeriesName="Potražuje"
                        Unit="kom"
                        Data="@PotrazujePvc41"
                        IsLoading="@IsLoadingPotrazuje41"
                        HasError="@HasErrorPotrazuje41"
                        ShowSummary="false"
                        OnRefresh="@(() => UcitajPotrazujuce("PVC 4/1"))" />
                </div>
                <div class="col-lg-4 mb-3">
                    <ApexBarChart
                        Title="Kome dugujemo PVC 6/1"
                        Icon="bi bi-arrow-return-left"
                        SeriesName="Potražuje"
                        Unit="kom"
                        Data="@PotrazujePvc61"
                        IsLoading="@IsLoadingPotrazuje61"
                        HasError="@HasErrorPotrazuje61"
                        ShowSummary="false"
                        OnRefresh="@(() => UcitajPotrazujuce("PVC 6/1"))" />
                </div>
                <div class="col-lg-4 mb-3">
                    <ApexBarChart
                        Title="Kome dugujemo PVC 12/1 + 10/1"
                        Icon="bi bi-arrow-return-left"
                        SeriesName="Potražuje"
                        Unit="kom"
                        Data="@PotrazujePvc1210"
                        IsLoading="@IsLoadingPotrazuje1210"
                        HasError="@HasErrorPotrazuje1210"
                        ShowSummary="false"
                        OnRefresh="@(() => UcitajPotrazujuceKombinovano())" />
                </div>
            </div>

            <!-- Red 3: STANJE NA LAGERU -->
            <div class="row mb-3">
                <div class="col-12">
                    <h5 class="mb-3"><i class="bi bi-stack text-success me-2"></i>Stanje na Lageru</h5>
                </div>
            </div>
            <div class="row mb-4">
                <div class="col-lg-3 mb-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h6 class="text-muted">PVC 4/1</h6>
                            @if (IsLoadingStanje41)
                            {
                                <div class="spinner-border text-primary" role="status"></div>
                            }
                            else
                            {
                                <h2 class="@GetStanjeClass(StanjePvc41)">@TypeMapping.FormatDecimal(StanjePvc41)</h2>
                                <p class="text-muted mb-0">kom</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 mb-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h6 class="text-muted">PVC 6/1</h6>
                            @if (IsLoadingStanje61)
                            {
                                <div class="spinner-border text-primary" role="status"></div>
                            }
                            else
                            {
                                <h2 class="@GetStanjeClass(StanjePvc61)">@TypeMapping.FormatDecimal(StanjePvc61)</h2>
                                <p class="text-muted mb-0">kom</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 mb-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h6 class="text-muted">PVC 12/1</h6>
                            @if (IsLoadingStanje121)
                            {
                                <div class="spinner-border text-primary" role="status"></div>
                            }
                            else
                            {
                                <h2 class="@GetStanjeClass(StanjePvc121)">@TypeMapping.FormatDecimal(StanjePvc121)</h2>
                                <p class="text-muted mb-0">kom</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 mb-3">
                    <div class="card">
                        <div class="card-body text-center">
                            <h6 class="text-muted">PVC 10/1</h6>
                            @if (IsLoadingStanje101)
                            {
                                <div class="spinner-border text-primary" role="status"></div>
                            }
                            else
                            {
                                <h2 class="@GetStanjeClass(StanjePvc101)">@TypeMapping.FormatDecimal(StanjePvc101)</h2>
                                <p class="text-muted mb-0">kom</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- TAB 2: Detaljan Izveštaj -->
        <div class="tab-pane fade" id="izvestaj" role="tabpanel">

            <!-- Filteri -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card border-warning">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-funnel me-2"></i>Filteri pretrage
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-2 mb-3">
                                    <label class="form-label fw-bold">Od datuma:</label>
                                    <input type="date" class="form-control" value="@OdDatumIzvestajValue" @onchange="OnOdDatumIzvestajChanged" />
                                </div>
                                <div class="col-md-2 mb-3">
                                    <label class="form-label fw-bold">Do datuma:</label>
                                    <input type="date" class="form-control" value="@DoDatumIzvestajValue" @onchange="OnDoDatumIzvestajChanged" />
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label fw-bold">Komitent:</label>
                                    <select class="form-select" @bind="filterIzvestaj.KomitentId">
                                        <option value="">Svi komitenti</option>
                                        @if (komitentiLista != null)
                                        {
                                            @foreach (var k in komitentiLista)
                                            {
                                                <option value="@k.Id">@k.Naziv</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label fw-bold">Artikal (Gajbe i Kutije):</label>
                                    <select class="form-select" @bind="filterIzvestaj.ArtikalId">
                                        <option value="">Svi artikli</option>
                                        @if (artikliAmbalazaLista != null)
                                        {
                                            @foreach (var a in artikliAmbalazaLista)
                                            {
                                                <option value="@a.Id">@a.Naziv</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2 mb-3 d-flex align-items-end">
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-warning" @onclick="UcitajIzvestaj" disabled="@IsLoadingIzvestaj">
                                            <i class="bi bi-search me-2"></i>
                                            @(IsLoadingIzvestaj ? "Učitavam..." : "Pretraži")
                                        </button>
                                        <button class="btn btn-outline-secondary" @onclick="ResetujFiltereIzvestaj">
                                            <i class="bi bi-arrow-clockwise"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Export dugmad -->
            <div class="row mb-3">
                <div class="col-12 text-end">
                    <div class="btn-group">
                        <button class="btn btn-success btn-sm" @onclick="ExportToExcel" disabled="@(izvestajPodaci?.Count == 0 || IsLoadingIzvestaj)">
                            <i class="bi bi-file-earmark-excel me-1"></i>Excel
                        </button>
                        <button class="btn btn-danger btn-sm" @onclick="ExportToPdf" disabled="@(izvestajPodaci?.Count == 0 || IsLoadingIzvestaj)">
                            <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                        </button>
                    </div>
                </div>
            </div>

            <!-- Tabela -->
            @if (IsLoadingIzvestaj)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>Učitavanje podataka...
                </div>
            }
            else if (izvestajPodaci == null || !izvestajPodaci.Any())
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>Nema podataka za prikaz.
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="bi bi-table me-2"></i>
                            Detaljan izveštaj
                            <span class="badge bg-warning text-dark ms-2">@izvestajPodaci.Count stavki</span>
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Datum</th>
                                        <th>Komitent</th>
                                        <th>Dokument</th>
                                        <th>Artikal</th>
                                        <th class="text-end">Ulaz</th>
                                        <th class="text-end">Izlaz</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in izvestajPodaci)
                                    {
                                        <tr>
                                            <td>@TypeMapping.FormatDate(item.Datum)</td>
                                            <td>@item.Komitent</td>
                                            <td>@item.Dokument</td>
                                            <td>@item.Artikal</td>
                                            <td class="text-end">@TypeMapping.FormatDecimal(item.Ulaz)</td>
                                            <td class="text-end">@TypeMapping.FormatDecimal(item.Izlaz)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-secondary">
                                    <tr>
                                        <th colspan="4" class="text-end">UKUPNO:</th>
                                        <th class="text-end text-success">@TypeMapping.FormatDecimal(izvestajPodaci.Sum(x => x.Ulaz))</th>
                                        <th class="text-end text-danger">@TypeMapping.FormatDecimal(izvestajPodaci.Sum(x => x.Izlaz))</th>
                                    </tr>
                                    <tr>
                                        <th colspan="5" class="text-end">STANJE (Ulaz - Izlaz):</th>
                                        <th class="text-end @GetStanjeClass(izvestajPodaci.Sum(x => x.Stanje))">
                                            @TypeMapping.FormatDecimal(izvestajPodaci.Sum(x => x.Stanje)) kom
                                        </th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@code {
    // Chart Data - Dužnici
    private List<ChartDataPoint>? DuznikPvc41;
    private List<ChartDataPoint>? DuznikPvc61;
    private List<ChartDataPoint>? DuznikPvc1210;

    // Chart Data - Potražujuće
    private List<ChartDataPoint>? PotrazujePvc41;
    private List<ChartDataPoint>? PotrazujePvc61;
    private List<ChartDataPoint>? PotrazujePvc1210;

    // Stanje
    private decimal StanjePvc41;
    private decimal StanjePvc61;
    private decimal StanjePvc121;
    private decimal StanjePvc101;

    // Loading states - Dužnici
    private bool IsLoadingDuznik41 = false;
    private bool IsLoadingDuznik61 = false;
    private bool IsLoadingDuznik1210 = false;

    // Loading states - Potražujuće
    private bool IsLoadingPotrazuje41 = false;
    private bool IsLoadingPotrazuje61 = false;
    private bool IsLoadingPotrazuje1210 = false;

    // Loading states - Stanje
    private bool IsLoadingStanje41 = false;
    private bool IsLoadingStanje61 = false;
    private bool IsLoadingStanje121 = false;
    private bool IsLoadingStanje101 = false;

    // Error states
    private bool HasErrorDuznik41 = false;
    private bool HasErrorDuznik61 = false;
    private bool HasErrorDuznik1210 = false;
    private bool HasErrorPotrazuje41 = false;
    private bool HasErrorPotrazuje61 = false;
    private bool HasErrorPotrazuje1210 = false;

    private bool IsLoadingCharts = false;
    private bool IsLoadingIzvestaj = false;

    // Filter requests
    private FilterRequest filterCharts = new FilterRequest();
    private FilterRequest filterIzvestaj = new FilterRequest();

    // Izveštaj data
    private List<PovratnaAmbalazaModel>? izvestajPodaci;
    private List<Komitent>? komitentiLista;
    private List<Artikal>? artikliAmbalazaLista;

    private string OdDatumValue => filterCharts.OdDatum?.ToString("yyyy-MM-dd") ?? "";
    private string DoDatumValue => filterCharts.DoDatum?.ToString("yyyy-MM-dd") ?? "";
    private string OdDatumIzvestajValue => filterIzvestaj.OdDatum?.ToString("yyyy-MM-dd") ?? "";
    private string DoDatumIzvestajValue => filterIzvestaj.DoDatum?.ToString("yyyy-MM-dd") ?? "";

    protected override async Task OnInitializedAsync()
    {
        // Default filter: od početka sezone (01.06 tekuće godine)
        var pocetakSezone = new DateTime(DateTime.Now.Year, 6, 1);
        filterCharts.OdDatum = pocetakSezone;
        filterCharts.DoDatum = DateTime.Now;

        filterIzvestaj.OdDatum = new DateTime(2023, 1, 1);
        filterIzvestaj.DoDatum = DateTime.Now;

        await UcitajListeZaFiltriranje();
        await UcitajChartove();
    }

    private async Task UcitajListeZaFiltriranje()
    {
        try
        {
            komitentiLista = await KomitentService.UcitajSveKomitente();

            // Učitaj samo artikle koji su Gajbe (1) ili Kutije (3)
            var sviArtikli = await ArtikalService.UcitajSveArtikle();
            artikliAmbalazaLista = sviArtikli
                .Where(a => a.MagacinID == 4 && (a.AmbalazaTip == 1 || a.AmbalazaTip == 3))
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju lista za filtriranje");
        }
    }

    private async Task UcitajChartove()
    {
        IsLoadingCharts = true;
        StateHasChanged();

        try
        {
            await Task.WhenAll(
                UcitajDuznike("PVC 4/1"),
                UcitajDuznike("PVC 6/1"),
                UcitajDuznikeKombinovano(),
                UcitajPotrazujuce("PVC 4/1"),
                UcitajPotrazujuce("PVC 6/1"),
                UcitajPotrazujuceKombinovano(),
                UcitajStanje("PVC 4/1"),
                UcitajStanje("PVC 6/1"),
                UcitajStanje("PVC 12/1"),
                UcitajStanje("PVC 10/1")
            );
        }
        finally
        {
            IsLoadingCharts = false;
            StateHasChanged();
        }
    }

    private async Task UcitajDuznike(string tipFilter)
    {
        if (tipFilter.Contains("4/1"))
        {
            IsLoadingDuznik41 = true;
            HasErrorDuznik41 = false;
        }
        else if (tipFilter.Contains("6/1"))
        {
            IsLoadingDuznik61 = true;
            HasErrorDuznik61 = false;
        }

        StateHasChanged();

        try
        {
            var data = await PovratnaAmbalazaService.UcitajTopDuznikeAsync(tipFilter, filterCharts);
            var chartData = ChartDataHelper.FromDictionary(data, 5);

            if (tipFilter.Contains("4/1"))
                DuznikPvc41 = chartData;
            else if (tipFilter.Contains("6/1"))
                DuznikPvc61 = chartData;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju dužnika za {Tip}", tipFilter);

            if (tipFilter.Contains("4/1"))
            {
                HasErrorDuznik41 = true;
                DuznikPvc41 = ChartDataHelper.GetMockData("Komitent", 5);
            }
            else if (tipFilter.Contains("6/1"))
            {
                HasErrorDuznik61 = true;
                DuznikPvc61 = ChartDataHelper.GetMockData("Komitent", 5);
            }
        }
        finally
        {
            if (tipFilter.Contains("4/1"))
                IsLoadingDuznik41 = false;
            else if (tipFilter.Contains("6/1"))
                IsLoadingDuznik61 = false;

            StateHasChanged();
        }
    }

    private async Task UcitajDuznikeKombinovano()
    {
        IsLoadingDuznik1210 = true;
        HasErrorDuznik1210 = false;
        StateHasChanged();

        try
        {
            var data121 = await PovratnaAmbalazaService.UcitajTopDuznikeAsync("PVC 12/1", filterCharts);
            var data101 = await PovratnaAmbalazaService.UcitajTopDuznikeAsync("PVC 10/1", filterCharts);

            // Kombinuj rezultate
            var combined = new Dictionary<string, decimal>();
            foreach (var item in data121)
            {
                if (combined.ContainsKey(item.Key))
                    combined[item.Key] += item.Value;
                else
                    combined[item.Key] = item.Value;
            }
            foreach (var item in data101)
            {
                if (combined.ContainsKey(item.Key))
                    combined[item.Key] += item.Value;
                else
                    combined[item.Key] = item.Value;
            }

            DuznikPvc1210 = ChartDataHelper.FromDictionary(combined, 5);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju kombinovanih dužnika");
            HasErrorDuznik1210 = true;
            DuznikPvc1210 = ChartDataHelper.GetMockData("Komitent", 5);
        }
        finally
        {
            IsLoadingDuznik1210 = false;
            StateHasChanged();
        }
    }

    private async Task UcitajPotrazujuce(string tipFilter)
    {
        if (tipFilter.Contains("4/1"))
        {
            IsLoadingPotrazuje41 = true;
            HasErrorPotrazuje41 = false;
        }
        else if (tipFilter.Contains("6/1"))
        {
            IsLoadingPotrazuje61 = true;
            HasErrorPotrazuje61 = false;
        }

        StateHasChanged();

        try
        {
            var data = await PovratnaAmbalazaService.UcitajTopPotrazujuceAsync(tipFilter, filterCharts);
            var chartData = ChartDataHelper.FromDictionary(data, 5);

            if (tipFilter.Contains("4/1"))
                PotrazujePvc41 = chartData;
            else if (tipFilter.Contains("6/1"))
                PotrazujePvc61 = chartData;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju potražujućih za {Tip}", tipFilter);

            if (tipFilter.Contains("4/1"))
            {
                HasErrorPotrazuje41 = true;
                PotrazujePvc41 = ChartDataHelper.GetMockData("Komitent", 5);
            }
            else if (tipFilter.Contains("6/1"))
            {
                HasErrorPotrazuje61 = true;
                PotrazujePvc61 = ChartDataHelper.GetMockData("Komitent", 5);
            }
        }
        finally
        {
            if (tipFilter.Contains("4/1"))
                IsLoadingPotrazuje41 = false;
            else if (tipFilter.Contains("6/1"))
                IsLoadingPotrazuje61 = false;

            StateHasChanged();
        }
    }

    private async Task UcitajPotrazujuceKombinovano()
    {
        IsLoadingPotrazuje1210 = true;
        HasErrorPotrazuje1210 = false;
        StateHasChanged();

        try
        {
            var data121 = await PovratnaAmbalazaService.UcitajTopPotrazujuceAsync("PVC 12/1", filterCharts);
            var data101 = await PovratnaAmbalazaService.UcitajTopPotrazujuceAsync("PVC 10/1", filterCharts);

            // Kombinuj rezultate
            var combined = new Dictionary<string, decimal>();
            foreach (var item in data121)
            {
                if (combined.ContainsKey(item.Key))
                    combined[item.Key] += item.Value;
                else
                    combined[item.Key] = item.Value;
            }
            foreach (var item in data101)
            {
                if (combined.ContainsKey(item.Key))
                    combined[item.Key] += item.Value;
                else
                    combined[item.Key] = item.Value;
            }

            PotrazujePvc1210 = ChartDataHelper.FromDictionary(combined, 5);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju kombinovanih potražujućih");
            HasErrorPotrazuje1210 = true;
            PotrazujePvc1210 = ChartDataHelper.GetMockData("Komitent", 5);
        }
        finally
        {
            IsLoadingPotrazuje1210 = false;
            StateHasChanged();
        }
    }

    private async Task UcitajStanje(string tipFilter)
    {
        if (tipFilter.Contains("4/1"))
            IsLoadingStanje41 = true;
        else if (tipFilter.Contains("6/1"))
            IsLoadingStanje61 = true;
        else if (tipFilter.Contains("12/1"))
            IsLoadingStanje121 = true;
        else if (tipFilter.Contains("10/1"))
            IsLoadingStanje101 = true;

        StateHasChanged();

        try
        {
            var stanje = await PovratnaAmbalazaService.UcitajStanjeNaLageruAsync(tipFilter, filterCharts);

            if (tipFilter.Contains("4/1"))
                StanjePvc41 = stanje;
            else if (tipFilter.Contains("6/1"))
                StanjePvc61 = stanje;
            else if (tipFilter.Contains("12/1"))
                StanjePvc121 = stanje;
            else if (tipFilter.Contains("10/1"))
                StanjePvc101 = stanje;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju stanja za {Tip}", tipFilter);
        }
        finally
        {
            if (tipFilter.Contains("4/1"))
                IsLoadingStanje41 = false;
            else if (tipFilter.Contains("6/1"))
                IsLoadingStanje61 = false;
            else if (tipFilter.Contains("12/1"))
                IsLoadingStanje121 = false;
            else if (tipFilter.Contains("10/1"))
                IsLoadingStanje101 = false;

            StateHasChanged();
        }
    }

    private async Task UcitajIzvestaj()
