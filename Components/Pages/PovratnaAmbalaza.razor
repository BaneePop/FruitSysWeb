    private string GetStanjeClass(decimal stanje)
    {
        if (stanje < 0)
            return "text-danger";
        else if (stanje > 0)
            return "text-success";
        return "text-muted";
    }

    private async Task ExportToExcel()
    {
        try
        {
            if (izvestajPodaci != null && izvestajPodaci.Any())
            {
                var columns = new Dictionary<string, string>
                {
                    { "Datum", "Datum" },
                    { "Komitent", "Komitent" },
                    { "Dokument", "Dokument" },
                    { "Artikal", "Artikal" },
                    { "Ulaz", "Ulaz" },
                    { "Izlaz", "Izlaz" }
                };

                var excelData = ExportService.ExportToExcelWithColumns(izvestajPodaci, columns);
                var fileName = TypeMapping.GenerateExportFileName("povratna_ambalaza", SystemConstants.Export.EXCEL_EXTENSION);
                await DownloadFile(excelData, fileName, SystemConstants.Export.EXCEL_MIME_TYPE);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Greška pri exportu u Excel: {ex.Message}");
        }
    }

