    private async Task ResetFilterIsporuceni()
    {
        odDatum = DateTime.Today.AddMonths(-1);
        doDatum = DateTime.Today;
        izabraniKomitentId = 0;
        izabraniRadniNalog = "";
        isporuceniNalozi = new();
        isporuceniDetalji.Clear();
        pretragaObavljena = false;
        await Task.CompletedTask;
    }

    private void OnOdDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d)) odDatum = d;
    }

    private void OnDoDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d)) doDatum = d;
    }

    private static string FormatDate(DateTime d) => d.ToString("yyyy-MM-dd");
}
