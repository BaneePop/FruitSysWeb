@page "/pregled-salda"
@using Microsoft.AspNetCore.Components.Web
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Models.Requests
@using FruitSysWeb.Models
@using FruitSysWeb.Services.Core
@using FruitSysWeb.Constants
@inject IFinansijeService FinansijeService
@inject IExportService ExportService
@inject IKomitentService KomitentService
@inject ITypeMappingService TypeMapping
@inject IJSRuntime JSRuntime
@inject ILogger<PregledSalda> Logger
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<!-- Header sa ukupnim saldom -->
<div class="bg-dark text-white py-3 mb-4">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="h3 mb-0">
                    <i class="bi bi-balance-scale me-2"></i>
                    Pregled Salda po Komitentima
                </h1>
                <small class="text-muted">Period: 01.01.2023 - danas</small>
            </div>
            <div class="col-md-6 text-end">
                <span class="badge bg-light text-dark fs-6">
                    <i class="bi bi-people me-1"></i>@(podaci?.Count ?? 0) komitenata
                </span>
                <span class="badge @TypeMapping.GetSaldoBadgeClass(UkupnoStanje) ms-2 fs-6">
                    Ukupno stanje: @TypeMapping.FormatDecimal(UkupnoStanje) RSD
                </span>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <!-- Filter Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-funnel me-2"></i>Filteri pretrage
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Datum filteri -->
                        <div class="col-md-3 mb-3">
                            <label class="form-label fw-bold">Od datuma:</label>
                            <input type="date" class="form-control" value="@OdDatumValue" @onchange="OnOdDatumChanged" />
                        </div>

                        <div class="col-md-3 mb-3">
                            <label class="form-label fw-bold">Do datuma:</label>
                            <input type="date" class="form-control" value="@DoDatumValue" @onchange="OnDoDatumChanged" />
                        </div>

                        <!-- Komitent filter -->
                        <div class="col-md-3 mb-3">
                            <label class="form-label fw-bold">Komitent:</label>
                            <select class="form-select" @bind="filterRequest.KomitentId">
                                <option value="">Svi komitenti</option>
                                @if (komitentiLista != null)
                                {
                                    @foreach (var komitent in komitentiLista)
                                    {
                                        <option value="@komitent.Id">@komitent.Naziv</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Tip komitenta filter -->
                        <div class="col-md-3 mb-3">
                            <label class="form-label fw-bold">Tip komitenta:</label>
                            <select class="form-select" value="@filterRequest.KomitentTip" @onchange="OnKomitentTipChanged">
                                <option value="">Svi tipovi</option>
                                @foreach (var option in SystemConstants.KomitentTipovi)
                                {
                                    <option value="@option.Key">@option.Value</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Dugmad za akcije -->
                    <div class="row">
                        <div class="col-12">
                            <button class="btn btn-primary me-2" @onclick="PrimeniFiltere">
                                <i class="bi bi-search me-1"></i>Pretraži
                            </button>
                            <button class="btn btn-secondary me-2" @onclick="ResetujFiltere">
                                <i class="bi bi-arrow-clockwise me-1"></i>Resetuj
                            </button>
                            @if (podaci != null && podaci.Any())
                            {
                                <button class="btn btn-success me-2" @onclick="ExportToExcel">
                                    <i class="bi bi-file-earmark-excel me-1"></i>Excel
                                </button>
                                <button class="btn btn-danger" @onclick="ExportToPdf">
                                    <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela sa podacima -->
    @if (ucitavanje)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Učitavanje...</span>
            </div>
            <p class="mt-3 text-muted">Učitavanje salda po komitentima...</p>
        </div>
    }
    else if (podaci != null && podaci.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-table me-2"></i>Saldo po komitentima (stanje > 1.000 RSD)
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0">
                                <thead class="table-dark sticky-top">
                                    <tr>
                                        <th style="width: 5%">#</th>
                                        <th style="width: 40%">
                                            <i class="bi bi-person-badge me-1"></i>Komitent
                                        </th>
                                        <th style="width: 15%" class="text-end">
                                            <i class="bi bi-arrow-up-circle me-1"></i>Potražuje (RSD)
                                        </th>
                                        <th style="width: 15%" class="text-end">
                                            <i class="bi bi-arrow-down-circle me-1"></i>Duguje (RSD)
                                        </th>
                                        <th style="width: 15%" class="text-end">
                                            <i class="bi bi-balance-scale me-1"></i>Stanje (RSD)
                                        </th>
                                        <th style="width: 10%" class="text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int brojac = 1;
                                    }
                                    @foreach (var stavka in podaci)
                                    {
                                        <tr>
                                            <td class="text-muted">@brojac</td>
                                            <td>
                                                <strong>@stavka.Komitent</strong>
                                                <br />
                                                <small class="text-muted">ID: @stavka.KomitentID</small>
                                            </td>
                                            <td class="text-end">
                                                <span class="text-success fw-bold">
                                                    @TypeMapping.FormatDecimal(stavka.Potrazuje)
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <span class="text-danger fw-bold">
                                                    @TypeMapping.FormatDecimal(stavka.Duguje)
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <strong class="@(stavka.Stanje > 0 ? "text-success" : stavka.Stanje < 0 ? "text-danger" : "text-secondary")">
                                                    @TypeMapping.FormatDecimal(stavka.Stanje)
                                                </strong>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge @stavka.StanjeBadgeClass">
                                                    <i class="bi @stavka.StanjeIkonica me-1"></i>
                                                    @(stavka.Stanje > 0 ? "Duguju nam" : stavka.Stanje < 0 ? "Dugujemo" : "Nula")
                                                </span>
                                            </td>
                                        </tr>
                                        brojac++;
                                    }
                                </tbody>
                                <tfoot class="table-light border-top border-dark border-3">
                                    <tr class="fw-bold">
                                        <td colspan="2" class="text-end">
                                            <i class="bi bi-calculator me-2"></i>UKUPNO:
                                        </td>
                                        <td class="text-end text-success">
                                            @TypeMapping.FormatDecimal(UkupnoPotrazuje)
                                        </td>
                                        <td class="text-end text-danger">
                                            @TypeMapping.FormatDecimal(UkupnoDuguje)
                                        </td>
                                        <td class="text-end">
                                            <span class="badge @TypeMapping.GetSaldoBadgeClass(UkupnoStanje) fs-6">
                                                @TypeMapping.FormatDecimal(UkupnoStanje)
                                            </span>
                                        </td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer text-muted">
                        <div class="row">
                            <div class="col-md-6">
                                <small>
                                    <i class="bi bi-info-circle me-1"></i>
                                    Prikazani su komitenti sa apsolutnim stanjem većim od 1.000 RSD
                                </small>
                            </div>
                            <div class="col-md-6 text-end">
                                <small>
                                    <i class="bi bi-calendar me-1"></i>
                                    Period: @OdDatumValue do @DoDatumValue
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle me-2"></i>
            Nema podataka za prikazane filtere. Pokušajte sa drugačijim kriterijumima.
        </div>
    }
</div>

@code {
    private List<SaldoPoKomitentuModel> podaci = new List<SaldoPoKomitentuModel>();
    private FilterRequest filterRequest = new FilterRequest();
    private List<Komitent> komitentiLista = new List<Komitent>();
    private bool ucitavanje = true;

    // Datum input values
    private string OdDatumValue = new DateTime(2023, 1, 1).ToString("yyyy-MM-dd");
    private string DoDatumValue = DateTime.Now.ToString("yyyy-MM-dd");

    // Ukupni zbir
    private decimal UkupnoPotrazuje => podaci?.Sum(x => x.Potrazuje) ?? 0;
    private decimal UkupnoDuguje => podaci?.Sum(x => x.Duguje) ?? 0;
    private decimal UkupnoStanje => podaci?.Sum(x => x.Stanje) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUser();
        if (user == null || !user.ImaPristupStranici("/pregled-salda"))
        {
            NavigationManager.NavigateTo("/unauthorized");
            return;
        }

        await UcitajInitialneVrednosti();
        await UcitajPodatke();
    }

    private async Task UcitajInitialneVrednosti()
    {
        try
        {
            // Default datumi
            filterRequest.OdDatum = new DateTime(2023, 1, 1);
            filterRequest.DoDatum = DateTime.Now.Date;

            // Učitaj listu komitenata
            komitentiLista = await KomitentService.UcitajSveKomitente();

            Logger.LogInformation("✅ Učitane initijalne vrednosti");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju inicijalnih vrednosti");
        }
    }

    private async Task UcitajPodatke()
    {
        ucitavanje = true;
        try
        {
            Logger.LogInformation($"🔍 Učitavanje salda: {filterRequest.OdDatum:yyyy-MM-dd} - {filterRequest.DoDatum:yyyy-MM-dd}");

            podaci = await FinansijeService.UcitajSaldoPoKomitentima(filterRequest, minimumStanje: 1000);

            Logger.LogInformation($"✅ Učitano {podaci.Count} komitenata, Ukupno stanje: {UkupnoStanje:N2} RSD");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju salda po komitentima");
            podaci = new List<SaldoPoKomitentuModel>();
        }
        finally
        {
            ucitavanje = false;
        }
    }

    // Datum change handlers
    private void OnOdDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var datum))
        {
            filterRequest.OdDatum = datum;
            OdDatumValue = datum.ToString("yyyy-MM-dd");
        }
    }

    private void OnDoDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var datum))
        {
            filterRequest.DoDatum = datum;
            DoDatumValue = datum.ToString("yyyy-MM-dd");
        }
    }

    private void OnKomitentTipChanged(ChangeEventArgs e)
    {
        filterRequest.KomitentTip = e.Value?.ToString();
    }

    private async Task PrimeniFiltere()
    {
        await UcitajPodatke();
    }

    private async Task ResetujFiltere()
    {
        filterRequest = new FilterRequest
        {
            OdDatum = new DateTime(2023, 1, 1),
            DoDatum = DateTime.Now.Date
        };

        OdDatumValue = filterRequest.OdDatum.Value.ToString("yyyy-MM-dd");
        DoDatumValue = filterRequest.DoDatum.Value.ToString("yyyy-MM-dd");

        await UcitajPodatke();
    }

    // Export funkcionalnosti
    private async Task ExportToExcel()
    {
        try
        {
            // Definiši kolone koje se prikazuju u izveštaju
            var columns = new Dictionary<string, string>
            {
                { "Komitent", "Komitent" },
                { "Potrazuje", "Potražuje" },
                { "Duguje", "Duguje" },
                { "Stanje", "Stanje" }
            };

            // Dodaj totale na dnu
            var totals = new Dictionary<string, object>
            {
                { "Komitent", "UKUPNO:" },
                { "Potrazuje", podaci.Sum(x => x.Potrazuje) },
                { "Duguje", podaci.Sum(x => x.Duguje) },
                { "Stanje", podaci.Sum(x => x.Stanje) }
            };

            var bytes = ExportService.ExportToExcelWithColumns(podaci, columns, totals);
            var fileName = SystemConstants.GenerateExportFileName("pregled_salda", "xlsx");
            await JSRuntime.InvokeVoidAsync("downloadFile", Convert.ToBase64String(bytes), fileName, SystemConstants.ExcelMimeType);

            Logger.LogInformation("✅ Excel export uspešan");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri Excel exportu");
            await JSRuntime.InvokeVoidAsync("alert", $"Greška pri exportu u Excel: {ex.Message}");
        }
    }

    private async Task ExportToPdf()
    {
        try
        {
            // Definiši kolone koje se prikazuju u izveštaju
            var columns = new Dictionary<string, string>
            {
                { "Komitent", "Komitent" },
                { "Potrazuje", "Potražuje" },
                { "Duguje", "Duguje" },
                { "Stanje", "Stanje" }
            };

            // Dodaj totale na dnu
            var totals = new Dictionary<string, object>
            {
                { "Komitent", "UKUPNO:" },
                { "Potrazuje", podaci.Sum(x => x.Potrazuje) },
                { "Duguje", podaci.Sum(x => x.Duguje) },
                { "Stanje", podaci.Sum(x => x.Stanje) }
            };

            var bytes = ExportService.ExportToPdfWithColumns(podaci, columns, totals);
            var fileName = SystemConstants.GenerateExportFileName("pregled_salda", "pdf");
            await JSRuntime.InvokeVoidAsync("downloadFile", Convert.ToBase64String(bytes), fileName, SystemConstants.PdfMimeType);

            Logger.LogInformation("✅ PDF export uspešan");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri PDF exportu");
            await JSRuntime.InvokeVoidAsync("alert", $"Greška pri exportu u PDF: {ex.Message}");
        }
    }
}
