@page "/preradahome"
@using Microsoft.AspNetCore.Components
@inject NavigationManager NavigationManager

<PageTitle>Prerada - Početna</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-3">
                <i class="bi bi-gear-fill text-success me-2"></i>
                Proizvodnja Prerada
            </h2>
            <p class="text-muted">Izaberite vrstu izveštaja</p>
        </div>
    </div>

    <!-- Izveštaji kartice -->
    <div class="row g-4">
        <!-- Radni Nalozi -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm hover-card" onclick="() => NavigationManager.NavigateTo('/radni-nalozi')" style="cursor: pointer;">
                <div class="card-body text-center p-4">
                    <div class="display-4 text-primary mb-3">
                        <i class="bi bi-clipboard-data"></i>
                    </div>
                    <h4 class="card-title">Radni Nalozi</h4>
                    <p class="card-text text-muted">
                        Izveštaj po radnom nalogu sa evidencijom rada, troškovima i procentom iskorišćenja
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0 text-center pb-3">
                    <button class="btn btn-outline-primary">
                        Otvori <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Smenski Izveštaji (placeholder) -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm" style="opacity: 0.6;">
                <div class="card-body text-center p-4">
                    <div class="display-4 text-secondary mb-3">
                        <i class="bi bi-calendar3"></i>
                    </div>
                    <h4 class="card-title">Smenski Izveštaji</h4>
                    <p class="card-text text-muted">
                        Analiza rada po smenama, danima i nedeljama
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0 text-center pb-3">
                    <button class="btn btn-outline-secondary" disabled>
                        Uskoro <i class="bi bi-clock ms-2"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Stalni Radni Nalozi (placeholder) -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm" style="opacity: 0.6;">
                <div class="card-body text-center p-4">
                    <div class="display-4 text-secondary mb-3">
                        <i class="bi bi-pin-angle"></i>
                    </div>
                    <h4 class="card-title">Stalni Radni Nalozi (ST-)</h4>
                    <p class="card-text text-muted">
                        Pregled stalnih radnih naloga koji počinju sa ST-
                    </p>
                </div>
                <div class="card-footer bg-transparent border-0 text-center pb-3">
                    <button class="btn btn-outline-secondary" disabled>
                        Uskoro <i class="bi bi-clock ms-2"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-card {
        transition: all 0.3s ease;
    }

    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.2) !important;
    }
</style>

