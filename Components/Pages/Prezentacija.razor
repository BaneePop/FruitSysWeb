@page "/prezentacija"
@rendermode @(new InteractiveServerRenderMode())
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Models.Requests
@using FruitSysWeb.Models
@using FruitSysWeb.Components.Charts

@inject IBrziPregledService BrziPregledService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject ILogger<Prezentacija> Logger

<!-- Header -->
<div class="bg-dark text-white py-3 mb-4">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="h3 mb-0">
                    <i class="bi bi-bar-chart-line me-2"></i>Prezentacija
                </h1>
                <small class="text-muted">Pregled nabavke, proizvodnje i prodaje po vrstama</small>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">

    <!-- Filter -->
    <div class="card border-primary mb-4">
        <div class="card-header bg-primary text-white">
            <h6 class="mb-0"><i class="bi bi-funnel me-2"></i>Period</h6>
        </div>
        <div class="card-body py-2">
            <div class="row align-items-end g-2">
                <div class="col-auto">
                    <label class="form-label mb-1 fw-bold small">Od datuma</label>
                    <input type="date" class="form-control form-control-sm" value="@OdDatumValue"
                           @onchange="OnOdDatumChanged" style="width:150px;" />
                </div>
                <div class="col-auto">
                    <label class="form-label mb-1 fw-bold small">Do datuma</label>
                    <input type="date" class="form-control form-control-sm" value="@DoDatumValue"
                           @onchange="OnDoDatumChanged" style="width:150px;" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary btn-sm" @onclick="UcitajSve"
                            disabled="@(isLoadingNabavka || isLoadingProdaja)">
                        <i class="bi bi-search me-1"></i>Prikaži
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Area chart: Stanje lagera po vrsti voća kroz vreme -->
    <div class="row mb-4">
        <div class="col-12">
            <ApexAreaChart
                Title="@($"Stanje Lagera po Vrsti Voća ({odDatum:dd.MM.yyyy} – {doDatum:dd.MM.yyyy})")"
                Icon="bi bi-layers"
                SeriesData="@lagerSeriesData"
                Unit="kg"
                IsLoading="@isLoadingLager"
                HasError="@hasErrorLager"
                ShowSummary="true"
                Height="480"
                Interval="@lagerInterval"
                OnIntervalChanged="@OnLagerIntervalChanged"
                OnRefresh="@UcitajLager" />
        </div>
    </div>

    <!-- Column chartovi: Nabavka + Prodaja jedan pored drugog -->
    <div class="row mb-4">
        <div class="col-lg-6 mb-3">
            <ApexBarChart
                Title="Nabavka po Vrsti Voća"
                Icon="bi bi-cart-plus"
                SeriesName="Količina"
                Unit="kg"
                Data="@nabavkaData"
                IsLoading="@isLoadingNabavka"
                HasError="@hasErrorNabavka"
                ShowSummary="true"
                Height="400"
                OnRefresh="@UcitajNabavku" />
        </div>
        <div class="col-lg-6 mb-3">
            <ApexBarChart
                Title="Prodaja Gotovih Proizvoda"
                Icon="bi bi-cart-check"
                SeriesName="Količina"
                Unit="kg"
                Data="@prodajaData"
                IsLoading="@isLoadingProdaja"
                HasError="@hasErrorProdaja"
                ShowSummary="true"
                Height="400"
                OnRefresh="@UcitajProdaju" />
        </div>
    </div>


</div>

@code {
    private DateTime odDatum = new DateTime(2025, 6, 1);
    private DateTime doDatum = DateTime.Now.Date;

    private string OdDatumValue => odDatum.ToString("yyyy-MM-dd");
    private string DoDatumValue => doDatum.ToString("yyyy-MM-dd");

    // Lager area chart
    private List<ChartSeriesData>? lagerSeriesData;
    private bool isLoadingLager = true;
    private bool hasErrorLager = false;
    private string lagerInterval = "dnevno";

    // Nabavka column
    private List<ChartDataPoint>? nabavkaData;
    private List<string>? nabavkaColors;
    private bool isLoadingNabavka = true;
    private bool hasErrorNabavka = false;

    // Prodaja column (gotovi proizvodi)
    private List<ChartDataPoint>? prodajaData;
    private bool isLoadingProdaja = true;
    private bool hasErrorProdaja = false;


    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUser();
        if (user == null || !user.ImaPristupStranici("/prezentacija"))
        {
            NavigationManager.NavigateTo("/", true);
            return;
        }

        await UcitajSve();
    }

    private void OnOdDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
            odDatum = d;
    }

    private void OnDoDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
            doDatum = d;
    }

    private async Task UcitajSve()
    {
        await Task.WhenAll(UcitajLager(), UcitajNabavku(), UcitajProdaju());
    }

    private async Task UcitajLager()
    {
        isLoadingLager = true;
        hasErrorLager = false;
        StateHasChanged();
        try
        {
            var podaci = await BrziPregledService.UcitajLagerKretanjePoVociAsync(odDatum, doDatum, lagerInterval);
            var sviDatumi = podaci
                .SelectMany(v => v.Value.Keys)
                .Distinct()
                .ToList();
            // Sortiranje datuma zavisno od formata
            List<string> sortiraniDatumi;
            if (lagerInterval == "mesecno")
            {
                sortiraniDatumi = sviDatumi
                    .OrderBy(d => DateTime.TryParseExact(d, "MM.yyyy",
                        System.Globalization.CultureInfo.InvariantCulture,
                        System.Globalization.DateTimeStyles.None, out var dt) ? dt : DateTime.MinValue)
                    .ToList();
            }
            else
            {
                sortiraniDatumi = sviDatumi
                    .OrderBy(d => DateTime.TryParseExact(d, "dd.MM.yy",
                        System.Globalization.CultureInfo.InvariantCulture,
                        System.Globalization.DateTimeStyles.None, out var dt) ? dt : DateTime.MinValue)
                    .ToList();
            }
            lagerSeriesData = podaci
                .Select(v => new ChartSeriesData
                {
                    Name = v.Key,
                    Data = sortiraniDatumi.Select(d => new ChartDataPoint
                    {
                        Label = d,
                        Value = v.Value.ContainsKey(d) ? v.Value[d] : 0
                    }).ToList(),
                    Color = ChartDataHelper.GetFruitColor(v.Key),
                    TotalKolicina = v.Value.Values.LastOrDefault() // poslednja vrednost = trenutni lager
                })
                .OrderByDescending(s => s.TotalKolicina)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju lager kretanja");
            hasErrorLager = true;
        }
        finally
        {
            isLoadingLager = false;
            StateHasChanged();
        }
    }

    private async Task OnLagerIntervalChanged(string noviInterval)
    {
        lagerInterval = noviInterval;
        await UcitajLager();
    }

    private async Task UcitajNabavku()
    {
        isLoadingNabavka = true;
        hasErrorNabavka = false;
        StateHasChanged();
        try
        {
            var podaci = await BrziPregledService.UcitajUkupneVrednostiNabavkeAsync(odDatum, doDatum);
            var sortirano = podaci.OrderByDescending(x => x.Value.Kolicina).ToList();
            nabavkaColors = sortirano.Select(x => ChartDataHelper.GetFruitColor(x.Key)).ToList();
            nabavkaData = sortirano.Select((x, i) => new ChartDataPoint { Label = x.Key, Value = x.Value.Kolicina, Color = nabavkaColors[i] }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju nabavke za prezentaciju");
            hasErrorNabavka = true;
        }
        finally
        {
            isLoadingNabavka = false;
            StateHasChanged();
        }
    }

    private async Task UcitajProdaju()
    {
        isLoadingProdaja = true;
        hasErrorProdaja = false;
        StateHasChanged();
        try
        {
            var podaci = await BrziPregledService.UcitajProdajuGotovihProizvodaAsync(odDatum, doDatum);
            prodajaData = podaci
                .Select(x => new ChartDataPoint
                {
                    Label = x.Key,
                    Value = x.Value,
                    Color = ChartDataHelper.GetFruitColor(x.Key)
                })
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju prodaje gotovih proizvoda za prezentaciju");
            hasErrorProdaja = true;
        }
        finally
        {
            isLoadingProdaja = false;
            StateHasChanged();
        }
    }
}
