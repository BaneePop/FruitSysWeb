@page "/promethome"
@rendermode @(new InteractiveServerRenderMode())
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Models.Requests
@using FruitSysWeb.Services.Core
@using FruitSysWeb.Components.Charts
@using FruitSysWeb.Models
@using System.Text.Json

@inject NavigationManager NavigationManager
@inject IFinansijeService FinansijeService
@inject ITypeMappingService TypeMapping
@inject IProizvodnjaService ProizvodnjaService
@inject IBrziPregledService BrziPregledService
@inject IJSRuntime JSRuntime
@inject ILogger<FinansijeHome> Logger
@inject IAuthService AuthService

<style>
    /* Custom grid za 5 kolona u jednom redu */
    .section-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1rem;
        margin-bottom: 2rem;
    }

    /* Responsive - na manjim ekranima prelazi u manje kolona */
    @@media (max-width: 1200px) {
        .section-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .section-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 576px) {
        .section-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- Header -->
<div class="finansije-header text-white py-3 mb-4">
    <div class="container-fluid">
        <h1 class="h2 mb-1">
            <i class="bi bi-arrow-left-right me-2"></i>Promet Početna
        </h1>
        <p class="mb-0 opacity-75">Pregled prometa roba i materijala — nabavka, prodaja, prijem uživo, statistika i povratna ambalaža</p>
    </div>
</div>

<div class="container-fluid">
    <!-- Main Sections -->
    <div class="section-grid">
        @if (currentUser?.ImaPuniPristup() ?? false)
        {
            <div class="section-card active" @onclick="@(() => NavigateTo("/nabavka-roba"))">
                <div class="section-icon">
                    <i class="bi bi-truck"></i>
                </div>
                <h4 class="section-title">Nabavka Roba</h4>
            </div>

            <div class="section-card active" @onclick="@(() => NavigateTo("/prodaja-roba"))">
                <div class="section-icon">
                    <i class="bi bi-cart-check"></i>
                </div>
                <h4 class="section-title">Prodaja Roba</h4>
            </div>
        }

        <div class="section-card" @onclick="@(() => NavigateTo("/izvestaj-prijem"))">
            <div class="section-icon">
                <i class="bi bi-calculator"></i>
            </div>
            <h4 class="section-title">Prijem Uživo</h4>
        </div>
        <div class="section-card active" @onclick="@(() => NavigateTo("/izvestaj-prijem-istorija"))">
            <div class="section-icon">
                <i class="bi bi-cart-check"></i>
            </div>
            <h4 class="section-title">Prijem Statistika</h4>
        </div>

        <div class="section-card" @onclick="@(() => NavigateTo("/povratna-ambalaza"))">
            <div class="section-icon">
                <i class="bi bi-arrow-repeat"></i>
            </div>
            <h4 class="section-title">Povratna Ambalaža</h4>
        </div>
    </div>

    <!-- Nabavka i Prodaja Charts -->
    <div class="card border-0 shadow-sm mb-3 mt-4">
        <div class="card-body py-2">
            <div class="row align-items-end g-2">
                <div class="col-auto">
                    <label class="form-label mb-1 fw-bold text-muted small">Od datuma</label>
                    <input type="date" class="form-control form-control-sm" value="@ChartOdDatumValue"
                           @onchange="OnChartOdDatumChanged" style="width:150px;" />
                </div>
                <div class="col-auto">
                    <label class="form-label mb-1 fw-bold text-muted small">Do datuma</label>
                    <input type="date" class="form-control form-control-sm" value="@ChartDoDatumValue"
                           @onchange="OnChartDoDatumChanged" style="width:150px;" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary btn-sm" @onclick="UcitajObaCharta"
                            disabled="@(isLoadingNabavka || isLoadingProdaja)">
                        <i class="bi bi-search me-1"></i>Prikaži
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <!-- Nabavka Chart -->
        <div class="col-12 mb-3">
            <ApexMultiSeriesLineChart
                Title="@($"Nabavka po Vrsti Voća ({chartOdDatum:dd.MM.yyyy} – {chartDoDatum:dd.MM.yyyy})")"
                Icon="bi bi-cart-plus"
                SeriesData="@nabavkaSeriesData"
                Unit="kg"
                IsWeight="true"
                IsLoading="@isLoadingNabavka"
                HasError="@hasErrorNabavka"
                ShowSummary="true"
                ShowVrednost="false"
                HorizontalSummary="true"
                Height="450"
                OnRefresh="@UcitajNabavkuPodatke" />
        </div>

        <!-- Prodaja Chart -->
        <div class="col-12 mb-3">
            <ApexMultiSeriesLineChart
                Title="@($"Prodaja po Vrsti Voća ({chartOdDatum:dd.MM.yyyy} – {chartDoDatum:dd.MM.yyyy})")"
                Icon="bi bi-cart-check"
                SeriesData="@prodajaSeriesData"
                Unit="kg"
                IsWeight="true"
                IsLoading="@isLoadingProdaja"
                HasError="@hasErrorProdaja"
                ShowSummary="true"
                ShowVrednost="false"
                HorizontalSummary="true"
                Height="450"
                OnRefresh="@UcitajProdajuPodatke" />
        </div>
    </div>

    <!-- Dashboard Analitika - Top 5 Kupaca i Dobavljača -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5>
                    <i class="bi bi-graph-up me-2"></i>Dashboard Analitika
                </h5>
                <button class="btn btn-sm btn-primary" @onclick="RefreshCharts" disabled="@IsRefreshing">
                    <i class="bi bi-arrow-clockwise @(IsRefreshing ? "spin" : "")"></i>
                    @(IsRefreshing ? "Osvežavam..." : "Osveži")
                </button>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-6 mb-3">
            <ApexBarChart 
                Title="Top 5 Kupaca"
                Icon="bi bi-people"
                SeriesName="Količina"
                Unit="kg"
                Data="@TopKupciData"
                IsLoading="@IsLoadingKupci"
                HasError="@HasErrorKupci"
                ShowSummary="false"
                OnRefresh="@RefreshKupci" />
        </div>
        <div class="col-lg-6 mb-3">
            <ApexBarChart 
                Title="Top 5 Dobavljača Sirovina"
                Icon="bi bi-truck"
                SeriesName="Količina"
                Unit="kg"
                Data="@TopDobavljaciData"
                IsLoading="@IsLoadingDobavljaci"
                HasError="@HasErrorDobavljaci"
                ShowSummary="false"
                OnRefresh="@RefreshDobavljaci" />
        </div>
    </div>

    <!-- Navigation Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Početna</a></li>
            <li class="breadcrumb-item active">Promet</li>
        </ol>
    </nav>
</div>

@code {
    private KorisnikModel? currentUser;

    // Chart Data
    private List<ChartDataPoint>? TopKupciData;
    private List<ChartDataPoint>? TopDobavljaciData;

    // Nabavka i Prodaja chart data
    private List<ChartSeriesData> nabavkaSeriesData = new();
    private bool isLoadingNabavka = true;
    private bool hasErrorNabavka = false;

    private List<ChartSeriesData> prodajaSeriesData = new();
    private bool isLoadingProdaja = true;
    private bool hasErrorProdaja = false;

    // Brzi pregled data
    private List<BrziPregledStavka>? brziPregledDobavljaci;
    private List<BrziPregledStavka>? brziPregledKupci;
    private List<RobaZaliheStavka>? robaZalihe;

    // Loading States
    private bool IsLoadingKupci = false;
    private bool IsLoadingDobavljaci = false;
    private bool IsRefreshing = false;

    // Error States
    private bool HasErrorKupci = false;
    private bool HasErrorDobavljaci = false;

    // Date range za nabavka/prodaja chartove
    private DateTime chartOdDatum = new DateTime(2025, 6, 1);
    private DateTime chartDoDatum = DateTime.Now.Date;

    private string ChartOdDatumValue => chartOdDatum.ToString("yyyy-MM-dd");
    private string ChartDoDatumValue => chartDoDatum.ToString("yyyy-MM-dd");

    // Date range za top kupce/dobavljace
    private DateTime startDatum = new DateTime(2025, 6, 1);
    private DateTime endDatum = DateTime.Now;

    // Datumski filter
    private FilterRequest StatistikaFilter => new FilterRequest
    {
        OdDatum = new DateTime(2025, 6, 1),
        DoDatum = DateTime.Now
    };

    private FilterRequest brziPregledFilter => new FilterRequest
    {
        OdDatum = startDatum,
        DoDatum = endDatum
    };

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetCurrentUser();

        await Task.WhenAll(
            RefreshCharts(),
            UcitajBrziPregled(),
            UcitajNabavkuPodatke(),
            UcitajProdajuPodatke()
        );
    }

    private async Task UcitajBrziPregled()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "brzi_pregled_config");
            
            if (string.IsNullOrEmpty(json))
            {
                return;
            }
            
            var config = JsonSerializer.Deserialize<BrziPregledKonfiguracija>(json);
            
            if (config == null)
            {
                return;
            }
            
            var tasks = new List<Task>();
            
            if (config.IzabraniDobavljaci?.Any() == true)
            {
                tasks.Add(Task.Run(async () =>
                {
                    brziPregledDobavljaci = await BrziPregledService
                        .UcitajBrziPregledDobavljaca(config.IzabraniDobavljaci, brziPregledFilter);
                }));
            }
            
            if (config.IzabraniKupci?.Any() == true)
            {
                tasks.Add(Task.Run(async () =>
                {
                    brziPregledKupci = await BrziPregledService
                        .UcitajBrziPregledKupaca(config.IzabraniKupci, brziPregledFilter);
                }));
            }

            if (config.ArtikliPoVrstama?.Any(x => x.Value.Any()) == true)
            {
                tasks.Add(Task.Run(async () =>
                {
                    robaZalihe = await BrziPregledService
                        .UcitajRobaNaZalihama(config.ArtikliPoVrstama, brziPregledFilter);
                }));
            }
            
            await Task.WhenAll(tasks);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading brzi pregled");
        }
    }

    private async Task RefreshCharts()
    {
        IsRefreshing = true;
        StateHasChanged();

        try
        {
            await Task.WhenAll(RefreshKupci(), RefreshDobavljaci());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing charts");
        }
        finally
        {
            IsRefreshing = false;
            StateHasChanged();
        }
    }

    private async Task RefreshKupci()
    {
        if (IsLoadingKupci) return;
        
        IsLoadingKupci = true;
        HasErrorKupci = false;
        StateHasChanged();

        try
        {
            await Task.Delay(100);
            var data = await ProizvodnjaService.UcitajTopKupcePoKilogramima(StatistikaFilter);
            TopKupciData = ChartDataHelper.FromDictionary(data, 5);
            TopKupciData = ChartDataHelper.TruncateLabels(TopKupciData, 15);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading top kupci data");
            HasErrorKupci = true;
            TopKupciData = ChartDataHelper.GetMockData("Kupac", 5);
        }
        finally
        {
            IsLoadingKupci = false;
            StateHasChanged();
        }
    }

    private async Task RefreshDobavljaci()
    {
        if (IsLoadingDobavljaci) return;
        
        IsLoadingDobavljaci = true;
        HasErrorDobavljaci = false;
        StateHasChanged();

        try
        {
            await Task.Delay(150);
            var data = await ProizvodnjaService.UcitajTopDobavljacePoKilogramima(StatistikaFilter);
            TopDobavljaciData = ChartDataHelper.FromDictionary(data, 5);
            TopDobavljaciData = ChartDataHelper.TruncateLabels(TopDobavljaciData, 15);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading top dobavljaci data");
            HasErrorDobavljaci = true;
            TopDobavljaciData = ChartDataHelper.GetMockData("Dobavljač", 5);
        }
        finally
        {
            IsLoadingDobavljaci = false;
            StateHasChanged();
        }
    }

    private void NavigateTo(string url)
    {
        NavigationManager.NavigateTo(url);
    }

    private void OnChartOdDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
            chartOdDatum = d;
    }

    private void OnChartDoDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
            chartDoDatum = d;
    }

    private async Task UcitajObaCharta()
    {
        await Task.WhenAll(UcitajNabavkuPodatke(), UcitajProdajuPodatke());
    }

    private async Task UcitajNabavkuPodatke()
    {
        try
        {
            isLoadingNabavka = true;
            hasErrorNabavka = false;
            StateHasChanged();

            var podaci = await BrziPregledService.UcitajNabavkuPoDanimaPoVociAsync(chartOdDatum, chartDoDatum);

            // Sortiraj datume — format je "dd.MM.yy" pa parsiramo ispravno
            var sviDatumi = podaci
                .SelectMany(voce => voce.Value.Keys)
                .Distinct()
                .OrderBy(d => DateTime.TryParseExact(d, "dd.MM.yy",
                    System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.None, out var dt) ? dt : DateTime.MinValue)
                .ToList();

            // Konvertuj Dictionary<VrstaVoca, Dictionary<Datum, Kolicina>> u ChartSeriesData
            // Svaka serija mora imati SVE datume, stavlja 0 gde nema podataka
            nabavkaSeriesData = podaci
                .Select(voce => new ChartSeriesData
                {
                    Name = voce.Key,
                    Data = sviDatumi
                        .Select(datum => new ChartDataPoint
                        {
                            Label = datum, // "dd.MM" format
                            Value = voce.Value.ContainsKey(datum) ? voce.Value[datum] : 0 // 0 ako nema podataka
                        })
                        .ToList(),
                    Color = ChartDataHelper.GetFruitColor(voce.Key),
                    TotalKolicina = voce.Value.Sum(x => x.Value), // Saberi sve količine za ovu vrstu
                    TotalVrednost = 0 // Ne prikazujemo vrednosti
                })
                .ToList();

            isLoadingNabavka = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ Greška pri učitavanju nabavke");
            hasErrorNabavka = true;
            isLoadingNabavka = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task UcitajProdajuPodatke()
    {
        try
        {
            isLoadingProdaja = true;
            hasErrorProdaja = false;
            StateHasChanged();

            var podaci = await BrziPregledService.UcitajProdajuPoDanimaPoVociAsync(chartOdDatum, chartDoDatum);

            var sviDatumi = podaci
                .SelectMany(voce => voce.Value.Keys)
                .Distinct()
                .OrderBy(d => DateTime.TryParseExact(d, "dd.MM.yy",
                    System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.None, out var dt) ? dt : DateTime.MinValue)
                .ToList();

            // Konvertuj Dictionary<VrstaVoca, Dictionary<Datum, Kolicina>> u ChartSeriesData
            // Svaka serija mora imati SVE datume, stavlja 0 gde nema podataka
            prodajaSeriesData = podaci
                .Select(voce => new ChartSeriesData
                {
                    Name = voce.Key,
                    Data = sviDatumi
                        .Select(datum => new ChartDataPoint
                        {
                            Label = datum, // "dd.MM" format
                            Value = voce.Value.ContainsKey(datum) ? voce.Value[datum] : 0 // 0 ako nema podataka
                        })
                        .ToList(),
                    Color = ChartDataHelper.GetFruitColor(voce.Key),
                    TotalKolicina = voce.Value.Sum(x => x.Value), // Saberi sve količine za ovu vrstu
                    TotalVrednost = 0 // Ne prikazujemo vrednosti
                })
                .ToList();

            isLoadingProdaja = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ Greška pri učitavanju prodaje");
            hasErrorProdaja = true;
            isLoadingProdaja = false;
        }
        finally
        {
            StateHasChanged();
        }
    }
}
