@page "/radni-nalozi"
@using FruitSysWeb.Models
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Models.Requests
@using FruitSysWeb.Constants
@inject IPreradaService PreradaService
@inject IKomitentService KomitentService
@inject IArtikalKlasifikacijaService ArtikalKlasifikacijaService
@inject IExportService ExportService
@inject ITypeMappingService TypeMapping
@inject IJSRuntime JSRuntime

<PageTitle>Izveštaj po Radnom nalogu</PageTitle>

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-1">
                        <i class="bi bi-clipboard-data text-primary me-2"></i>
                        Utrošak Radne Snage RN
                    </h2>
                    <p class="text-muted mb-0">
                        Detaljni pregled gotovih proizvoda po radnim nalozima
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-success" @onclick='() => ExportToExcel("RadniNalog")'>
                        <i class="bi bi-file-earmark-excel me-1"></i>Excel
                    </button>
                    <button class="btn btn-outline-danger" @onclick='() => ExportToPDF("RadniNalog")'>
                        <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="bi bi-funnel me-2"></i>Filteri
            </h5>
        </div>
        <div class="card-body">
            <!-- Prvi red - svi filteri -->
            <div class="row g-3 mb-3">
                <div class="col-md-2">
                    <label class="form-label"><i class="bi bi-calendar3 me-1"></i>Od datuma</label>
                    <input type="date" class="form-control"
                           value="@(filterRequest.OdDatum?.ToString("yyyy-MM-dd"))"
                           @onchange="OnOdDatumChanged" />
                </div>
                <div class="col-md-2">
                    <label class="form-label"><i class="bi bi-calendar3 me-1"></i>Do datuma</label>
                    <input type="date" class="form-control"
                           value="@(filterRequest.DoDatum?.ToString("yyyy-MM-dd"))"
                           @onchange="OnDoDatumChanged" />
                </div>
                <div class="col-md-3">
                    <label class="form-label"><i class="bi bi-clipboard-data me-1"></i>Radni nalog</label>
                    <select class="form-select" @bind="filterRequest.RadniNalog">
                        <option value="">Svi radni nalozi</option>
                        @if (radniNaloziLista != null)
                        {
                            @foreach (var nalog in radniNaloziLista)
                            {
                                <option value="@nalog">@nalog</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label"><i class="bi bi-tag me-1"></i>Vrsta artikla</label>
                    <select class="form-select" @bind="filterRequest.ArtikalKlasifikacijaId">
                        <option value="">Sve vrste</option>
                        @if (artikalKlasifikacijeLista != null)
                        {
                            @foreach (var klasifikacija in artikalKlasifikacijeLista)
                            {
                                <option value="@klasifikacija.Id">@klasifikacija.Naziv</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label"><i class="bi bi-person me-1"></i>Kupac</label>
                    <select class="form-select" @bind="filterRequest.KomitentId">
                        <option value="">Svi kupci</option>
                        @if (komitentiLista != null)
                        {
                            @foreach (var komitent in komitentiLista)
                            {
                                <option value="@komitent.Id">@komitent.Naziv</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <!-- Drugi red - dugmad -->
            <div class="row">
                <div class="col-12">
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" @onclick="UcitajPodatke">
                            <i class="bi bi-search me-1"></i>Pretraži
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="ResetFilter">
                            <i class="bi bi-arrow-clockwise me-1"></i>Reset
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-table me-2"></i>
                Rezultati (@(radniNalogData?.Count ?? 0) stavki)
            </h5>
            <small class="text-muted">
                Poslednji put ažurirano: @TypeMapping.FormatDateTime(DateTime.Now)
            </small>
        </div>
        <div class="card-body p-0">
            @if (radniNalogData == null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Učitavanje...</span>
                    </div>
                    <p class="mt-3 text-muted">Učitavanje podataka...</p>
                </div>
            }
            else if (!radniNalogData.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <h4 class="mt-3 text-muted">Nema podataka za prikaz</h4>
                    <p class="text-muted">Promenite filtere i pokušajte ponovo</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th><strong>Radni nalog</strong></th>
                                <th><strong>Smenski izveštaj</strong></th>
                                <th><strong>Datum</strong></th>
                                <th><strong>Kupac</strong></th>
                                <th><strong>Vrsta artikla</strong></th>
                                <th><strong>Br. radnika</strong></th>
                                <th><strong>Sati</strong></th>
                                <th><strong>Trošak</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in radniNalogData)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-primary">@item.RadniNalog</span>
                                    </td>
                                    <td>
                                        <code class="text-info">@item.BrojIzvestaja</code>
                                    </td>
                                    <td>@TypeMapping.FormatDate(item.Datum ?? DateTime.MinValue)</td>
                                    <td>@item.Komitent</td>
                                    <td>
                                        <span class="badge bg-secondary">@item.VrstaArtikla</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@item.BrojRadnika</span>
                                    </td>
                                    <td>
                                        <strong>@TypeMapping.FormatDecimal(item.BrojRadnihSati)</strong>
                                        <small class="text-muted d-block">h</small>
                                    </td>
                                    <td>
                                        <strong class="text-success">@TypeMapping.FormatCurrency(item.TrosakPoRadnomNalogu)</strong>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th colspan="5" class="text-end"><strong>UKUPNO:</strong></th>
                                <th>
                                    <span class="badge bg-primary">@radniNalogData.Sum(x => x.BrojRadnika)</span>
                                </th>
                                <th>
                                    <strong>@TypeMapping.FormatDecimal(radniNalogData.Sum(x => x.BrojRadnihSati))</strong>
                                    <small class="text-muted d-block">h</small>
                                </th>
                                <th>
                                    <strong class="text-success">@TypeMapping.FormatCurrency(radniNalogData.Sum(x => x.TrosakPoRadnomNalogu))</strong>
                                </th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // Data properties
    private List<RadniNalogIzvestajModel>? radniNalogData;

    // Dropdown data
    private List<Komitent>? komitentiLista;
    private List<string>? radniNaloziLista;
    private List<ArtikalKlasifikacija>? artikalKlasifikacijeLista;

    // Filter
    private FilterRequest filterRequest = new FilterRequest();

    protected override async Task OnInitializedAsync()
    {
        // OPTIMIZACIJA: Učitaj samo zadnjih 7 dana umesto celog perioda
        filterRequest.OdDatum = DateTime.Now.AddDays(-7);
        filterRequest.DoDatum = DateTime.Now;

        await UcitajListeZaFiltriranje();
        await UcitajPodatke();
    }

    private async Task UcitajListeZaFiltriranje()
    {
        try
        {
            Console.WriteLine("Učitavam liste za filtriranje...");

            // Učitaj komitente (samo kupce)
            try
            {
                var allKomitenti = await KomitentService.UcitajKomitenteKojiImajuRadneNaloge();
                komitentiLista = allKomitenti.Where(k => k.JeKupac).Take(50).ToList();
                Console.WriteLine($"Učitano {komitentiLista?.Count ?? 0} kupaca");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"❌ Greška pri učitavanju komitenata: {ex.Message}");
                komitentiLista = new List<Komitent>();
            }

            // Učitaj radne naloge (SQL već isključuje ST-)
            try
            {
                radniNaloziLista = await PreradaService.UcitajSveRadneNaloge();
                Console.WriteLine($"Učitano {radniNaloziLista?.Count ?? 0} radnih naloga (bez ST-)");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"❌ Greška pri učitavanju radnih naloga: {ex.Message}");
                radniNaloziLista = new List<string>();
            }

            // Učitaj artikal klasifikacije
            try
            {
                var sveKlasifikacije = await ArtikalKlasifikacijaService.UcitajSveKlasifikacije();
                artikalKlasifikacijeLista = sveKlasifikacije
                    ?.Where(k => !k.Naziv.Contains("Malina Org") && !k.Naziv.Contains("Kupina Org"))
                    ?.ToList() ?? new List<ArtikalKlasifikacija>();
                Console.WriteLine($"Učitano {artikalKlasifikacijeLista?.Count ?? 0} klasifikacija");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"❌ Greška pri učitavanju klasifikacija: {ex.Message}");
                artikalKlasifikacijeLista = new List<ArtikalKlasifikacija>();
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Generička greška pri učitavanju lista: {ex.Message}");
        }
    }

    private async Task UcitajPodatke()
    {
        try
        {
            Console.WriteLine("🚀 POČETAK učitavanja podataka...");
            Console.WriteLine($"Filter: Od {filterRequest.OdDatum} do {filterRequest.DoDatum}");
            Console.WriteLine($"Radni nalog: '{filterRequest.RadniNalog}'");
            Console.WriteLine($"Komitent ID: {filterRequest.KomitentId}");
            Console.WriteLine($"ArtikalKlasifikacijaId: {filterRequest.ArtikalKlasifikacijaId}");

            // Učitaj glavne podatke - SQL sada koristi RpArtikalTip = 6 (gotovi proizvodi)
            radniNalogData = await PreradaService.UcitajRadniNalogIzvestaj(filterRequest);

            Console.WriteLine($"✅ Učitano {radniNalogData?.Count ?? 0} stavki");
            if (radniNalogData?.Any() == true)
            {
                Console.WriteLine($"Prvi red: RN={radniNalogData.First().RadniNalog}, Datum={radniNalogData.First().Datum}");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ GREŠKA pri učitavanju podataka: {ex.Message}");
            Console.WriteLine($"❌ Stack trace: {ex.StackTrace}");

            radniNalogData = new List<RadniNalogIzvestajModel>();

            StateHasChanged();
        }
    }

    // Event handlers za datume
    private async Task OnOdDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            filterRequest.OdDatum = date;
            await UcitajPodatke();
        }
    }

    private async Task OnDoDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            filterRequest.DoDatum = date;
            await UcitajPodatke();
        }
    }

    // Reset filter
    private async Task ResetFilter()
    {
        var (startDate, endDate) = SystemConstants.GetDefaultDateRange();
        filterRequest = new FilterRequest
        {
            OdDatum = startDate,
            DoDatum = endDate
        };
        await UcitajPodatke();
        StateHasChanged();
    }

    // Export funkcionalnosti - sa totalima
    private async Task ExportToExcel(string tabName)
    {
        try
        {
            if (radniNalogData?.Any() == true)
            {
                // Definiši samo kolone koje se prikazuju u tabeli
                var columns = new Dictionary<string, string>
                {
                    { "RadniNalog", "Radni nalog" },
                    { "BrojIzvestaja", "Smenski izveštaj" },
                    { "Datum", "Datum" },
                    { "Komitent", "Kupac" },
                    { "VrstaArtikla", "Vrsta artikla" },
                    { "BrojRadnika", "Br. radnika" },
                    { "BrojRadnihSati", "Sati" },
                    { "TrosakPoRadnomNalogu", "Trošak" }
                };

                // Izračunaj totale - isto kao u HTML tabeli
                var totals = new Dictionary<string, object>
                {
                    { "VrstaArtikla", "UKUPNO:" },
                    { "BrojRadnika", radniNalogData.Sum(x => x.BrojRadnika) },
                    { "BrojRadnihSati", radniNalogData.Sum(x => x.BrojRadnihSati) },
                    { "TrosakPoRadnomNalogu", radniNalogData.Sum(x => x.TrosakPoRadnomNalogu) }
                };

                var excelData = ExportService.ExportToExcelWithColumns(radniNalogData, columns, totals);
                var fileName = TypeMapping.GenerateExportFileName("radni_nalog", ".xlsx");
                await DownloadFile(excelData, fileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Greška pri exportu u Excel: {ex.Message}");
        }
    }

    private async Task ExportToPDF(string tabName)
    {
        try
        {
            if (radniNalogData?.Any() == true)
            {
                // Definiši samo kolone koje se prikazuju u tabeli
                var columns = new Dictionary<string, string>
                {
                    { "RadniNalog", "Radni nalog" },
                    { "BrojIzvestaja", "Smenski izveštaj" },
                    { "Datum", "Datum" },
                    { "Komitent", "Kupac" },
                    { "VrstaArtikla", "Vrsta artikla" },
                    { "BrojRadnika", "Br. radnika" },
                    { "BrojRadnihSati", "Sati" },
                    { "TrosakPoRadnomNalogu", "Trošak" }
                };

                // Izračunaj totale - isto kao u HTML tabeli
                var totals = new Dictionary<string, object>
                {
                    { "VrstaArtikla", "UKUPNO:" },
                    { "BrojRadnika", radniNalogData.Sum(x => x.BrojRadnika) },
                    { "BrojRadnihSati", radniNalogData.Sum(x => x.BrojRadnihSati) },
                    { "TrosakPoRadnomNalogu", radniNalogData.Sum(x => x.TrosakPoRadnomNalogu) }
                };

                var pdfData = ExportService.ExportToPdfWithColumns(radniNalogData, columns, totals);
                var fileName = TypeMapping.GenerateExportFileName("radni_nalog", ".pdf");
                await DownloadFile(pdfData, fileName, "application/pdf");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Greška pri exportu u PDF: {ex.Message}");
        }
    }

    private async Task DownloadFile(byte[] data, string fileName, string mimeType)
    {
        await JSRuntime.InvokeVoidAsync("downloadFile", Convert.ToBase64String(data), fileName, mimeType);
    }
}
