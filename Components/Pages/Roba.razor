@page "/roba"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using FruitSysWeb.Models
@using FruitSysWeb.Services
@using FruitSysWeb.Services.Models.Requests
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Core
@using FruitSysWeb.Constants
@inject IMagacinLagerService LagerService
@inject IExportService ExportService
@inject ITypeMappingService TypeMapping
@inject IJSRuntime JSRuntime

<style>
    .low-stock { background-color: #fff5f5; border-left: 4px solid #dc3545; }
    .medium-stock { background-color: #fff8e1; border-left: 4px solid #ffc107; }
    .high-stock { background-color: #f0f9ff; border-left: 4px solid #198754; }
    
    .stock-alert {
        padding: 0.25rem 0.5rem;
        border-radius: 0.375rem;
        font-size: 0.75rem;
        font-weight: 600;
    }
    
    .artikal-tip-badge {
        font-size: 0.7rem;
        padding: 0.25rem 0.5rem;
    }
</style>

<div class="container-fluid">
    <!-- Header -->
    <div class="bg-primary text-white py-3 mb-4">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h1 class="h3 mb-0">
                        <i class="bi bi-droplet me-2"></i>
                        Roba - Sirovine i Poluproizvodi
                    </h1>
                </div>
                <div class="col-md-6 text-end">
                    <span class="badge bg-light text-dark fs-6">
                        <i class="bi bi-box me-1"></i>@((sirovineStanje?.Count ?? 0) + (poluproizvodiStanje?.Count ?? 0)) artikala
                    </span>
                    <span class="badge bg-success text-white ms-2 fs-6">
                        Ukupno: @TypeMapping.FormatDecimal((sirovineStanje?.Sum(x => x.Kolicina) ?? 0) + (poluproizvodiStanje?.Sum(x => x.Kolicina) ?? 0)) kg
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- TABS za Sirovine i Poluproizvode -->
    <div class="row mb-4">
        <div class="col-12">
            <ul class="nav nav-tabs" id="robaTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="sirovine-tab" data-bs-toggle="tab" data-bs-target="#sirovine" type="button" role="tab" @onclick="UcitajSirovine">
                        <i class="bi bi-droplet me-2"></i>Sirovine
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="poluproizvodi-tab" data-bs-toggle="tab" data-bs-target="#poluproizvodi" type="button" role="tab" @onclick="UcitajPoluproizvode">
                        <i class="bi bi-layers me-2"></i>Poluproizvodi
                    </button>
                </li>
            </ul>
        </div>
    </div>

    <div class="tab-content" id="robaTabContent">
        <!-- SIROVINE TAB -->
        <div class="tab-pane fade show active" id="sirovine" role="tabpanel">
            <!-- Export Buttons -->
            <div class="row mb-3">
                <div class="col-12 text-end">
                    <div class="btn-group">
                        <button class="btn btn-success btn-sm" @onclick="ExportToExcel" disabled="@(sirovineStanje?.Count == 0)">
                            <i class="bi bi-file-earmark-excel me-1"></i>Excel
                        </button>
                        <button class="btn btn-danger btn-sm" @onclick="ExportToPdf" disabled="@(sirovineStanje?.Count == 0)">
                            <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                        </button>
                    </div>
                </div>
            </div>

            <!-- Statistics Cards -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card bg-danger text-white">
                        <div class="card-body text-center">
                            <h5>Ukupno artikala</h5>
                            <h3>@(sirovineStanje?.Count ?? 0)</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-primary text-white">
                        <div class="card-body text-center">
                            <h5>Na lageru</h5>
                            <h3>@TypeMapping.FormatDecimal(sirovineStanje?.Sum(x => x.Kolicina) ?? 0)</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Results Table -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-droplet me-2"></i>
                                Sirovine 
                                <span class="badge bg-danger ms-2">@(sirovineStanje?.Count ?? 0) artikala</span>
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            @if (sirovineStanje == null)
                            {
                                <div class="alert alert-info m-3">
                                    <i class="bi bi-info-circle me-2"></i>
                                    Učitavanje podataka...
                                </div>
                            }
                            else if (!sirovineStanje.Any())
                            {
                                <div class="alert alert-warning m-3">
                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                    Nema podataka za prikaz sa trenutnim filterima.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover mb-0">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Artikal</th>
                                                <th class="text-end">Količina</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in sirovineStanje)
                                            {
                                                var stockClass = GetStockClass(item.Kolicina, 100); // Min 100 kg
                                                var (stockStatus, stockBadgeClass, stockIcon) = TypeMapping.GetQuantityStatus(item.Kolicina);
                                                
                                                <tr class="@stockClass">
                                                    <td>
                                                        <strong>@item.Artikal</strong>
                                                    </td>
                                                    <td class="text-end">
                                                        <span class="fw-bold">@TypeMapping.FormatDecimal(item.Kolicina)</span>
                                                    </td>
                                                    <td>
                                                        <span class="badge @stockBadgeClass">
                                                            <i class="@stockIcon"></i> @stockStatus
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot class="table-secondary">
                                            <tr>
                                                <th class="text-end">UKUPNO:</th>
                                                <th class="text-end text-primary">@TypeMapping.FormatDecimal(sirovineStanje.Sum(x => x.Kolicina))</th>
                                                <th></th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- POLUPROIZVODI TAB -->
        <div class="tab-pane fade" id="poluproizvodi" role="tabpanel">
            <!-- Export Buttons -->
            <div class="row mb-3">
                <div class="col-12 text-end">
                    <div class="btn-group">
                        <button class="btn btn-success btn-sm" @onclick="ExportToExcelPoluproizvodi" disabled="@(poluproizvodiStanje?.Count == 0)">
                            <i class="bi bi-file-earmark-excel me-1"></i>Excel
                        </button>
                        <button class="btn btn-danger btn-sm" @onclick="ExportToPdfPoluproizvodi" disabled="@(poluproizvodiStanje?.Count == 0)">
                            <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                        </button>
                    </div>
                </div>
            </div>

            <!-- Statistics Cards -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card bg-secondary text-white">
                        <div class="card-body text-center">
                            <h5>Ukupno artikala</h5>
                            <h3>@(poluproizvodiStanje?.Count ?? 0)</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-primary text-white">
                        <div class="card-body text-center">
                            <h5>Na lageru</h5>
                            <h3>@TypeMapping.FormatDecimal(poluproizvodiStanje?.Sum(x => x.Kolicina) ?? 0)</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Results Table -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-layers me-2"></i>
                                Poluproizvodi
                                <span class="badge bg-secondary ms-2">@(poluproizvodiStanje?.Count ?? 0) artikala</span>
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            @if (poluproizvodiStanje == null)
                            {
                                <div class="alert alert-info m-3">
                                    <i class="bi bi-info-circle me-2"></i>
                                    Učitavanje podataka...
                                </div>
                            }
                            else if (!poluproizvodiStanje.Any())
                            {
                                <div class="alert alert-warning m-3">
                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                    Nema podataka za prikaz sa trenutnim filterima.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover mb-0">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Artikal</th>
                                                <th class="text-end">Količina</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in poluproizvodiStanje)
                                            {
                                                var stockClass = GetStockClass(item.Kolicina, 100); // Min 100 kg
                                                var (stockStatus, stockBadgeClass, stockIcon) = TypeMapping.GetQuantityStatus(item.Kolicina);
                                                
                                                <tr class="@stockClass">
                                                    <td>
                                                        <strong>@item.Artikal</strong>
                                                    </td>
                                                    <td class="text-end">
                                                        <span class="fw-bold">@TypeMapping.FormatDecimal(item.Kolicina)</span>
                                                    </td>
                                                    <td>
                                                        <span class="badge @stockBadgeClass">
                                                            <i class="@stockIcon"></i> @stockStatus
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot class="table-secondary">
                                            <tr>
                                                <th class="text-end">UKUPNO:</th>
                                                <th class="text-end text-primary">@TypeMapping.FormatDecimal(poluproizvodiStanje.Sum(x => x.Kolicina))</th>
                                                <th></th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<MagacinLagerModel>? sirovineStanje; // Sirovine
    private List<MagacinLagerModel>? poluproizvodiStanje; // Poluproizvodi
    private FilterRequest filterRequest = new FilterRequest();
    private FilterRequest filterRequestPoluproizvodi = new FilterRequest();

    protected override async Task OnInitializedAsync()
    {
        await UcitajSirovine();
    }

    private async Task UcitajSirovine()
    {
        try
        {
            sirovineStanje = await LagerService.UcitajSirovine(filterRequest);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška pri učitavanju sirovina: {ex.Message}");
            sirovineStanje = new List<MagacinLagerModel>();
        }
    }

    private async Task UcitajPoluproizvode()
    {
        try
        {
            poluproizvodiStanje = await LagerService.UcitajPoluproizvode(filterRequestPoluproizvodi);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška pri učitavanju poluproizvoda: {ex.Message}");
            poluproizvodiStanje = new List<MagacinLagerModel>();
        }
    }

    private async Task ResetujFiltere()
    {
        filterRequest = new FilterRequest();
        filterRequestPoluproizvodi = new FilterRequest();
        await UcitajSirovine();
        await UcitajPoluproizvode();
    }

    private string GetStockClass(decimal kolicina, decimal minimum)
    {
        if (kolicina < minimum) return "low-stock";
        if (kolicina < minimum * 2) return "medium-stock";
        return "high-stock";
    }

    // Export metode
    private async Task ExportToExcel()
    {
        try
        {
            if (sirovineStanje != null && sirovineStanje.Any())
            {
                // Definiši samo kolone koje se prikazuju u tabeli
                var columns = new Dictionary<string, string>
                {
                    { "Artikal", "Artikal" },
                    { "Kolicina", "Količina" }
                };

                var excelData = ExportService.ExportToExcelWithColumns(sirovineStanje, columns);
                var fileName = TypeMapping.GenerateExportFileName("roba_sirovine", SystemConstants.Export.EXCEL_EXTENSION);
                await DownloadFile(excelData, fileName, SystemConstants.Export.EXCEL_MIME_TYPE);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Greška pri exportu u Excel: {ex.Message}");
        }
    }

    private async Task ExportToPdf()
    {
        try
        {
            if (sirovineStanje != null && sirovineStanje.Any())
            {
                // Definiši samo kolone koje se prikazuju u tabeli
                var columns = new Dictionary<string, string>
                {
                    { "Artikal", "Artikal" },
                    { "Kolicina", "Količina" }
                };

                var pdfData = ExportService.ExportToPdfWithColumns(sirovineStanje, columns);
                var fileName = TypeMapping.GenerateExportFileName("roba_sirovine", SystemConstants.Export.PDF_EXTENSION);
                await DownloadFile(pdfData, fileName, SystemConstants.Export.PDF_MIME_TYPE);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Greška pri exportu u PDF: {ex.Message}");
        }
    }

    private async Task ExportToExcelPoluproizvodi()
    {
        try
        {
            if (poluproizvodiStanje != null && poluproizvodiStanje.Any())
            {
                // Definiši samo kolone koje se prikazuju u tabeli
                var columns = new Dictionary<string, string>
                {
                    { "Artikal", "Artikal" },
                    { "Kolicina", "Količina" }
                };

                var excelData = ExportService.ExportToExcelWithColumns(poluproizvodiStanje, columns);
                var fileName = TypeMapping.GenerateExportFileName("roba_poluproizvodi", SystemConstants.Export.EXCEL_EXTENSION);
                await DownloadFile(excelData, fileName, SystemConstants.Export.EXCEL_MIME_TYPE);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Greška pri exportu u Excel: {ex.Message}");
        }
    }

    private async Task ExportToPdfPoluproizvodi()
    {
        try
        {
            if (poluproizvodiStanje != null && poluproizvodiStanje.Any())
            {
                // Definiši samo kolone koje se prikazuju u tabeli
                var columns = new Dictionary<string, string>
                {
                    { "Artikal", "Artikal" },
                    { "Kolicina", "Količina" }
                };

                var pdfData = ExportService.ExportToPdfWithColumns(poluproizvodiStanje, columns);
                var fileName = TypeMapping.GenerateExportFileName("roba_poluproizvodi", SystemConstants.Export.PDF_EXTENSION);
                await DownloadFile(pdfData, fileName, SystemConstants.Export.PDF_MIME_TYPE);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Greška pri exportu u PDF: {ex.Message}");
        }
    }

    private async Task DownloadFile(byte[] data, string fileName, string mimeType)
    {
        await JSRuntime.InvokeVoidAsync("downloadFile", Convert.ToBase64String(data), fileName, mimeType);
    }
}
