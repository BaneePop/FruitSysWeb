@page "/smenski-izvestaji"
@using FruitSysWeb.Models
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Models.Requests
@using FruitSysWeb.Constants
@inject IPreradaService PreradaService
@inject IExportService ExportService
@inject ITypeMappingService TypeMapping
@inject IJSRuntime JSRuntime

<PageTitle>Smenski Izveštaji</PageTitle>

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-1">
                        <i class="bi bi-calendar3 text-success me-2"></i>
                        Smenski Izveštaji
                    </h2>
                    <p class="text-muted mb-0">
                        Analiza rada po smenama i proizvodnim procesima
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-success" @onclick="ExportToExcel">
                        <i class="bi bi-file-earmark-excel me-1"></i>Excel
                    </button>
                    <button class="btn btn-outline-danger" @onclick="ExportToPDF">
                        <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    @if (statistikeData != null)
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="display-6 text-primary mb-2">
                            <i class="bi bi-journals"></i>
                        </div>
                        <h3 class="text-primary mb-1">@TypeMapping.FormatDecimal(statistikeData["UkupnoIzvestaja"])</h3>
                        <p class="text-muted mb-0">Smenski izveštaji</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="display-6 text-success mb-2">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <h3 class="text-success mb-1">@TypeMapping.FormatDecimal(statistikeData["UkupnoSati"])</h3>
                        <p class="text-muted mb-0">Ukupno sati</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="display-6 text-info mb-2">
                            <i class="bi bi-gear-wide"></i>
                        </div>
                        <h3 class="text-info mb-1">@TypeMapping.FormatDecimal(statistikeData["UkupnoRadnika"])</h3>
                        <p class="text-muted mb-0">Broj radnika</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="display-6 text-warning mb-2">
                            <i class="bi bi-currency-exchange"></i>
                        </div>
                        <h3 class="text-warning mb-1">@TypeMapping.FormatCurrency(statistikeData["ProsecanTrosak"])</h3>
                        <p class="text-muted mb-0">Prosečan trošak</p>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="bi bi-funnel me-2"></i>Filteri
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <!-- Datum filteri -->
                <div class="col-md-3">
                    <label class="form-label">Od datuma</label>
                    <input type="date" class="form-control" 
                           value="@(filterRequest.OdDatum?.ToString("yyyy-MM-dd"))" 
                           @onchange="OnOdDatumChanged" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Do datuma</label>
                    <input type="date" class="form-control" 
                           value="@(filterRequest.DoDatum?.ToString("yyyy-MM-dd"))" 
                           @onchange="OnDoDatumChanged" />
                </div>

                <!-- Smenski izveštaj filter -->
                <div class="col-md-3">
                    <label class="form-label">Smenski izveštaj</label>
                    <select class="form-select" @bind="filterRequest.SmenskiIzvestaj">
                        <option value="">Svi izveštaji</option>
                        @if (smenskiIzvestajiLista != null)
                        {
                            @foreach (var izvestaj in smenskiIzvestajiLista)
                            {
                                <option value="@izvestaj">@izvestaj</option>
                            }
                        }
                    </select>
                </div>

                <!-- Proizvodni proces filter -->
                <div class="col-md-3">
                    <label class="form-label">Proizvodni proces</label>
                    <select class="form-select" @bind="filterRequest.ProizvodniProcesId" @bind:after="OnProizvodniProcesChanged">
                        <option value="">Svi procesi</option>
                        @if (proizvodniProcesiLista != null)
                        {
                            @foreach (var proces in proizvodniProcesiLista)
                            {
                                <option value="@proces.ID">@proces.Naziv</option>
                            }
                        }
                    </select>
                </div>

                <!-- Radni proces filter -->
                <div class="col-md-3">
                    <label class="form-label">Filter radnog procesa</label>
                    <select class="form-select" @bind="filterRequest.RadniProcesId">
                        <option value="">Svi radni procesi</option>
                        @if (radniProcesiLista != null)
                        {
                            @foreach (var proces in radniProcesiLista)
                            {
                                <option value="@proces.ID">@proces.Naziv</option>
                            }
                        }
                    </select>
                    <small class="text-muted">Filtrira evidencije pre agregacije</small>
                </div>

                <!-- Action buttons -->
                <div class="col-md-6"></div>
                <div class="col-md-3">
                    <label class="form-label">&nbsp;</label>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary w-100" @onclick="UcitajPodatke">
                            <i class="bi bi-search me-1"></i>Pretraži
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="ResetFilter">
                            <i class="bi bi-arrow-clockwise me-1"></i>Reset
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-table me-2"></i>
                Rezultati (@(smenskiData?.Count ?? 0) stavki)
            </h5>
            <small class="text-muted">
                Poslednji put ažurirano: @TypeMapping.FormatDateTime(DateTime.Now)
            </small>
        </div>
        <div class="card-body p-0">
            @if (smenskiData == null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Učitavanje...</span>
                    </div>
                    <p class="mt-3 text-muted">Učitavanje podataka...</p>
                </div>
            }
            else if (!smenskiData.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <h4 class="mt-3 text-muted">Nema podataka za prikaz</h4>
                    <p class="text-muted">Promenite filtere i pokušajte ponovo</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th><strong>Smenski izveštaj</strong></th>
                                <th><strong>Datum</strong></th>
                                <th><strong>Proizvodni procesi</strong></th>
                                <th><strong>Br. radnika</strong></th>
                                <th><strong>Sati</strong></th>
                                <th><strong>Trošak</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (SmenskiIzvestajModel item in smenskiData)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-success">@item.BrojIzvestaja</span>
                                    </td>
                                    <td>@TypeMapping.FormatDate(item.Datum ?? DateTime.MinValue)</td>
                                    <td>
                                        <span class="badge bg-info">@item.ProizvodniProces</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">@item.BrojRadnika</span>
                                    </td>
                                    <td>
                                        <strong>@TypeMapping.FormatDecimal(item.BrojRadnihSati)</strong>
                                        <small class="text-muted d-block">h</small>
                                    </td>
                                    <td>
                                        <strong class="text-success">@TypeMapping.FormatCurrency(item.TrosakPoRadnomNalogu)</strong>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th colspan="3" class="text-end"><strong>UKUPNO:</strong></th>
                                <th>
                                    <span class="badge bg-primary">@TypeMapping.FormatDecimal(smenskiData.Sum(x => x.BrojRadnihSati/8))</span>
                                </th>
                                <th>
                                    <strong>@TypeMapping.FormatDecimal(smenskiData.Sum(x => x.BrojRadnihSati))</strong>
                                    <small class="text-muted d-block">h</small>
                                </th>
                                <th>
                                    <strong class="text-success">@TypeMapping.FormatCurrency(smenskiData.Sum(x => x.TrosakPoRadnomNalogu))</strong>
                                </th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<SmenskiIzvestajModel>? smenskiData;
    private Dictionary<string, decimal>? statistikeData;
    private List<string>? smenskiIzvestajiLista;
    private List<ProizvodniProcesModel>? proizvodniProcesiLista;
    private List<RadniProcesModel>? radniProcesiLista;
    private FilterRequest filterRequest = new FilterRequest();

    protected override async Task OnInitializedAsync()
    {
        var (startDate, endDate) = SystemConstants.GetDefaultDateRange();
        filterRequest.OdDatum = DateTime.Now.AddDays(-7);
        filterRequest.DoDatum = endDate;
        
        await UcitajListeZaFiltriranje();
        await UcitajPodatke();
    }

    private async Task UcitajListeZaFiltriranje()
    {
        try
        {
            smenskiIzvestajiLista = await PreradaService.UcitajSveSmenskeIzvestaje();
            proizvodniProcesiLista = await PreradaService.UcitajProizvodneProcese();
            var sviRadniProcesi = await PreradaService.UcitajRadneProcese();
            radniProcesiLista = sviRadniProcesi?.Where(p => !p.Naziv.Contains("#"))?.ToList() ?? new List<RadniProcesModel>();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška pri učitavanju lista: {ex.Message}");
            smenskiIzvestajiLista = new List<string>();
            proizvodniProcesiLista = new List<ProizvodniProcesModel>();
            radniProcesiLista = new List<RadniProcesModel>();
        }
    }

    private async Task OnProizvodniProcesChanged()
    {
        try
        {
            var proizvodniProcesId = filterRequest.ProizvodniProcesId;
            
            if (proizvodniProcesId.HasValue)
            {
                var povezaniRadniProcesi = await PreradaService.UcitajRadneProcesePoPorizvodnomProcesu(proizvodniProcesId.Value);
                radniProcesiLista = povezaniRadniProcesi?.Where(p => !p.Naziv.Contains("#"))?.ToList() ?? new List<RadniProcesModel>();
            }
            else
            {
                var sviRadniProcesi = await PreradaService.UcitajRadneProcese();
                radniProcesiLista = sviRadniProcesi?.Where(p => !p.Naziv.Contains("#"))?.ToList() ?? new List<RadniProcesModel>();
            }
            
            filterRequest.RadniProcesId = null;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška pri učitavanju povezanih radnih procesa: {ex.Message}");
        }
    }

    private async Task UcitajPodatke()
    {
        try
        {
            smenskiData = await PreradaService.UcitajSmenskeIzvestaje(filterRequest);
            statistikeData = await PreradaService.UcitajStatistikePoSmenskimIzvestajima(filterRequest);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška pri učitavanju smenskih podataka: {ex.Message}");
            smenskiData = new List<SmenskiIzvestajModel>();
            statistikeData = new Dictionary<string, decimal>();
            StateHasChanged();
        }
    }

    private async Task OnOdDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            filterRequest.OdDatum = date;
            await UcitajPodatke();
        }
    }

    private async Task OnDoDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            filterRequest.DoDatum = date;
            await UcitajPodatke();
        }
    }

    private async Task ResetFilter()
    {
        var (startDate, endDate) = SystemConstants.GetDefaultDateRange();
        filterRequest = new FilterRequest
        {
            OdDatum = startDate,
            DoDatum = endDate
        };
        await UcitajPodatke();
        StateHasChanged();
    }

    private async Task ExportToExcel()
    {
        try
        {
            if (smenskiData?.Any() == true)
            {
                var excelData = ExportService.ExportToExcel(smenskiData);
                var fileName = TypeMapping.GenerateExportFileName("smenski_izvestaji", ".xlsx");
                await DownloadFile(excelData, fileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Greška pri exportu u Excel: {ex.Message}");
        }
    }

    private async Task ExportToPDF()
    {
        try
        {
            if (smenskiData?.Any() == true)
            {
                var pdfData = ExportService.ExportToPdf(smenskiData);
                var fileName = TypeMapping.GenerateExportFileName("smenski_izvestaji", ".pdf");
                await DownloadFile(pdfData, fileName, "application/pdf");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Greška pri exportu u PDF: {ex.Message}");
        }
    }

    private async Task DownloadFile(byte[] data, string fileName, string mimeType)
    {
        await JSRuntime.InvokeVoidAsync("downloadFile", Convert.ToBase64String(data), fileName, mimeType);
    }
}
