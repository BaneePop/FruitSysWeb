@page "/solar-hala"
@rendermode @(new InteractiveServerRenderMode())
@using ApexCharts
@using FruitSysWeb.Models
@using FruitSysWeb.Models.Solar
@using FruitSysWeb.Services.Solar
@using Microsoft.Extensions.Options
@implements IDisposable
@inject SolarLocalDbService SolarDb
@inject SolarIntradaySyncService SolarIntradaySync
@inject IOptions<FusionSolarOptions> SolarOptionsAccessor
@inject ILogger<SolarHala> Logger

<PageTitle>Solarna elektrana — Odetta</PageTitle>

<div class="solar-dashboard solar-hala-page">
    <header class="solar-header">
        <div class="solar-header-right">
            <nav class="sd-day-nav" aria-label="Navigacija kroz dane">
                <button type="button" class="btn-sd-day" @onclick="PrethodniDan" disabled="@_ucitavanje">
                    ◀ Prethodni dan
                </button>
                <span class="sd-day-display">@_izabraniDatum.ToString("dd.MM.yyyy")</span>
                <button type="button" class="btn-sd-day" @onclick="SledeciDan" disabled="@(_jeDanas || _ucitavanje)">
                    Sledeći dan ▶
                </button>
            </nav>
            <span class="status-pill @(_livePolling && _jeDanas ? "" : "status-pill-offline")">
                ● @(_livePolling && _jeDanas ? "Online" : "Lokalna baza")
            </span>
            @if (_poslednji != null)
            {
                <span class="solar-last-read">
                    Poslednje očitavanje: <strong>@_poslednji.Timestamp.ToLocalTime():HH:mm</strong>
                </span>
            }
            <button type="button" class="btn-solar-refresh" @onclick="OsveziPodatke" disabled="@_ucitavanje">Osveži</button>
            <a class="btn-solar-link" href="/solar-pregled">Detaljni pregled →</a>
        </div>
    </header>

    @if (!_hasDbData && !_livePolling)
    {
        <div class="alert alert-warning py-2 mb-2">Nema podataka. Proveri konfiguraciju FusionSolar.</div>
    }
    else
    {
        var solarKw = (double)(_poslednji?.CurrentPower ?? 0);
        var factoryKw = (double)(_poslednji?.LoadPower ?? 0);
        var gridKw = Math.Max((double)(_poslednji?.GridPower ?? 0), 0);
        var solarCoverage = factoryKw > 0 ? Math.Round(solarKw / factoryKw * 100) : (solarKw > 0 ? 100 : 0);
        var dailyUseVal = (double)(_poslednji?.DailyUseEnergy ?? 0);
        var dailySelfVal = (double)(_poslednji?.DailySelfUseEnergy ?? 0);
        var ukupnoPokriveno = dailyUseVal > 0
            ? Math.Round(dailySelfVal / dailyUseVal * 100)
            : (_istorijaDanas.Count > 0
                ? Math.Round(_istorijaDanas.Average(r =>
                {
                    var s = (double)(r.CurrentPower ?? 0);
                    var l = (double)(r.LoadPower ?? 0);
                    return l > 0 ? s / l * 100 : (s > 0 ? 100 : 0);
                }))
                : 0);
        var hasSpark = _istorijaDanas.Count >= 2;

        string statusKlasa;
        string statusNaslov;
        string statusOpis;
        if (solarCoverage >= 70)
        {
            statusKlasa = "sd-status-good";
            statusNaslov = "DOBAR TRENUTAK ZA PALJENJE MAŠINA";
            statusOpis = $"Solar pokriva {solarCoverage:N0}% potrošnje";
        }
        else if (solarCoverage < 50)
        {
            statusKlasa = "sd-status-wait";
            statusNaslov = "SAČEKATI SA VELIKIM POTROŠAČIMA";
            statusOpis = $"Solar pokriva samo {solarCoverage:N0}% potrošnje";
        }
        else
        {
            statusKlasa = "sd-status-normal";
            statusNaslov = "NORMALAN RAD";
            statusOpis = $"Solar pokriva {solarCoverage:N0}% potrošnje";
        }

        var preporuceniTekst = _preporuceniPeriod.Start.HasValue && _preporuceniPeriod.End.HasValue
            ? $"{_preporuceniPeriod.Start:HH:mm} – {_preporuceniPeriod.End:HH:mm}"
            : "Nema perioda danas";

        <section class="solar-kpi-grid sd-kpi-top">
            <div class="solar-kpi-card kpi-power">
                <div class="solar-kpi-label">Solarna energija trenutno</div>
                <div class="solar-kpi-value">@solarKw.ToString("N0")<span class="kpi-unit"> kW</span></div>
                @if (hasSpark)
                {
                    <div class="sd-kpi-spark-chart">
                        <ApexChart TItem="SolarKpiRecord" Options="@_sparkYellow" Height="53">
                            <ApexPointSeries TItem="SolarKpiRecord" Items="_istorijaDanas" Name="kW"
                                             SeriesType="SeriesType.Area"
                                             XValue="@(e => e.Timestamp.ToLocalTime())"
                                             YValue="@(e => e.CurrentPower ?? 0)" />
                        </ApexChart>
                    </div>
                }
            </div>
            <div class="solar-kpi-card kpi-factory">
                <div class="solar-kpi-label">Trenutna potrošnja fabrike</div>
                <div class="solar-kpi-value">@factoryKw.ToString("N0")<span class="kpi-unit"> kW</span></div>
                @if (hasSpark)
                {
                    <div class="sd-kpi-spark-chart">
                        <ApexChart TItem="SolarKpiRecord" Options="@_sparkBlue" Height="53">
                            <ApexPointSeries TItem="SolarKpiRecord" Items="_istorijaDanas" Name="kW"
                                             SeriesType="SeriesType.Area"
                                             XValue="@(e => e.Timestamp.ToLocalTime())"
                                             YValue="@(e => e.LoadPower ?? 0)" />
                        </ApexChart>
                    </div>
                }
            </div>
            <div class="solar-kpi-card kpi-grid-kw">
                <div class="solar-kpi-label">Trenutno iz mreže</div>
                <div class="solar-kpi-value">@gridKw.ToString("N0")<span class="kpi-unit"> kW</span></div>
                @if (hasSpark)
                {
                    <div class="sd-kpi-spark-chart">
                        <ApexChart TItem="SolarKpiRecord" Options="@_sparkRed" Height="53">
                            <ApexPointSeries TItem="SolarKpiRecord" Items="_istorijaDanas" Name="kW"
                                             SeriesType="SeriesType.Area"
                                             XValue="@(e => e.Timestamp.ToLocalTime())"
                                             YValue="@(e => Math.Max(e.GridPower ?? 0, 0))" />
                        </ApexChart>
                    </div>
                }
            </div>
            <div class="solar-kpi-card kpi-coverage">
                <div class="solar-kpi-label">Trenutno solarno pokriveno</div>
                <div class="solar-kpi-value">@solarCoverage.ToString("N0")<span class="kpi-unit"> %</span></div>
                @if (hasSpark)
                {
                    <div class="sd-kpi-spark-chart">
                        <ApexChart TItem="SolarKpiRecord" Options="@_sparkYellow" Height="53">
                            <ApexPointSeries TItem="SolarKpiRecord" Items="_istorijaDanas" Name="%"
                                             SeriesType="SeriesType.Area"
                                             XValue="@(e => e.Timestamp.ToLocalTime())"
                                             YValue="@(e => (e.LoadPower ?? 0) > 0 ? (e.CurrentPower ?? 0) / (e.LoadPower ?? 1) * 100 : 0)" />
                        </ApexChart>
                    </div>
                }
            </div>
        </section>

        <div class="sd-hala-chart-row">
            <section class="sd-main-chart">
                <div class="sd-chart-head">
                    <h2 class="solar-chart-title">Proizvodnja, potrošnja i mreža tokom dana</h2>
                </div>
                @if (_istorijaDanas.Count == 0)
                {
                    <p class="panel-meta mb-0 py-3">Nema intraday očitavanja za @_izabraniDatum.ToString("dd.MM.yyyy").</p>
                }
                else if (_grafOptions != null)
                {
                    <ApexChart @key="@_chartKey" TItem="SolarKpiRecord" Options="@_grafOptions" Height="308">
                        <ApexPointSeries TItem="SolarKpiRecord"
                                         Items="_istorijaDanas"
                                         Name="Sunce"
                                         SeriesType="SeriesType.Area"
                                         XValue="@(e => e.Timestamp.ToLocalTime())"
                                         YValue="@(e => e.CurrentPower ?? 0)" />
                        <ApexPointSeries TItem="SolarKpiRecord"
                                         Items="_istorijaDanas"
                                         Name="Hala / Fabrika"
                                         SeriesType="SeriesType.Area"
                                         XValue="@(e => e.Timestamp.ToLocalTime())"
                                         YValue="@(e => e.LoadPower ?? 0)" />
                        <ApexPointSeries TItem="SolarKpiRecord"
                                         Items="_istorijaDanas"
                                         Name="Iz mreže"
                                         SeriesType="SeriesType.Area"
                                         XValue="@(e => e.Timestamp.ToLocalTime())"
                                         YValue="@(e => Math.Max(e.GridPower ?? 0, 0))" />
                    </ApexChart>
                }
            </section>

            <aside class="sd-advice-panel @statusKlasa">
                <div class="sd-advice-panel-head">
                    <div class="solar-advice-title">Preporuka za mašine</div>
                    <div class="sd-decision-title">@statusNaslov</div>
                    <div class="sd-decision-sub">@statusOpis</div>
                </div>
                <div class="sd-advice-kpi-stack">
                    <div class="sd-advice-kpi-item">
                        <div class="sd-advice-kpi-num sd-advice-kpi-num-sm">@preporuceniTekst</div>
                        <div class="sd-advice-kpi-label">Period</div>
                    </div>
                    <div class="sd-advice-kpi-item">
                        <div class="sd-advice-kpi-num">@solarCoverage.ToString("N0")<span class="sd-advice-kpi-unit">%</span></div>
                        <div class="sd-advice-kpi-label">Pokrivenost</div>
                    </div>
                    <div class="sd-advice-kpi-item">
                        <div class="sd-advice-kpi-num">@gridKw.ToString("N0")<span class="sd-advice-kpi-unit"> kW</span></div>
                        <div class="sd-advice-kpi-label">Mreža sada</div>
                    </div>
                </div>
            </aside>
        </div>

        <section class="solar-kpi-grid sd-kpi-bottom">
            <div class="solar-kpi-card kpi-today">
                <div class="solar-kpi-label">Ukupna proizvodnja danas</div>
                <div class="solar-kpi-value solar-kpi-value-sm">@FormatKwhZero(_poslednji?.DailyEnergy)</div>
                @if (hasSpark)
                {
                    <div class="sd-kpi-spark-chart">
                        <ApexChart TItem="SolarKpiRecord" Options="@_sparkYellow" Height="48">
                            <ApexPointSeries TItem="SolarKpiRecord" Items="_istorijaDanas" Name="kWh"
                                             SeriesType="SeriesType.Area"
                                             XValue="@(e => e.Timestamp.ToLocalTime())"
                                             YValue="@(e => e.DailyEnergy ?? 0)" />
                        </ApexChart>
                    </div>
                }
            </div>
            <div class="solar-kpi-card kpi-factory">
                <div class="solar-kpi-label">Ukupna potrošnja fabrike</div>
                <div class="solar-kpi-value solar-kpi-value-sm">@FormatKwhZero(_poslednji?.DailyUseEnergy)</div>
                @if (hasSpark)
                {
                    <div class="sd-kpi-spark-chart">
                        <ApexChart TItem="SolarKpiRecord" Options="@_sparkBlue" Height="48">
                            <ApexPointSeries TItem="SolarKpiRecord" Items="_istorijaDanas" Name="kWh"
                                             SeriesType="SeriesType.Area"
                                             XValue="@(e => e.Timestamp.ToLocalTime())"
                                             YValue="@(e => e.DailyUseEnergy ?? 0)" />
                        </ApexChart>
                    </div>
                }
            </div>
            <div class="solar-kpi-card kpi-grid-kw">
                <div class="solar-kpi-label">Ukupno iz mreže</div>
                <div class="solar-kpi-value solar-kpi-value-sm">@FormatKwhZero(_poslednji?.DailyBuyEnergy)</div>
                @if (hasSpark)
                {
                    <div class="sd-kpi-spark-chart">
                        <ApexChart TItem="SolarKpiRecord" Options="@_sparkRed" Height="48">
                            <ApexPointSeries TItem="SolarKpiRecord" Items="_istorijaDanas" Name="kWh"
                                             SeriesType="SeriesType.Area"
                                             XValue="@(e => e.Timestamp.ToLocalTime())"
                                             YValue="@(e => e.DailyBuyEnergy ?? 0)" />
                        </ApexChart>
                    </div>
                }
            </div>
            <div class="solar-kpi-card kpi-coverage">
                <div class="solar-kpi-label">Ukupno solarno pokriveno</div>
                <div class="solar-kpi-value">@ukupnoPokriveno.ToString("N0")<span class="kpi-unit"> %</span></div>
                @if (hasSpark)
                {
                    <div class="sd-kpi-spark-chart">
                        <ApexChart TItem="SolarKpiRecord" Options="@_sparkYellow" Height="48">
                            <ApexPointSeries TItem="SolarKpiRecord" Items="_istorijaDanas" Name="%"
                                             SeriesType="SeriesType.Area"
                                             XValue="@(e => e.Timestamp.ToLocalTime())"
                                             YValue="@(e => (e.DailyUseEnergy ?? 0) > 0 ? (e.DailySelfUseEnergy ?? 0) / (e.DailyUseEnergy ?? 1) * 100 : ((e.LoadPower ?? 0) > 0 ? (e.CurrentPower ?? 0) / (e.LoadPower ?? 1) * 100 : 0))" />
                        </ApexChart>
                    </div>
                }
            </div>
        </section>
    }
</div>

@code {
    private bool _livePolling;
    private bool _hasDbData;
    private bool _ucitavanje;
    private DateTime _izabraniDatum = DateTime.Today;
    private bool _jeDanas => _izabraniDatum.Date == DateTime.Today;
    private int _pollIntervalSeconds;
    private string _stationDn = string.Empty;
    private SolarKpiRecord? _poslednji;
    private List<SolarKpiRecord> _istorijaDanas = new();
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _timerCts;
    private ApexChartOptions<SolarKpiRecord>? _grafOptions;
    private string _chartKey = "0";
    private string? _grafOpsegTekst;
    private (DateTime? Start, DateTime? End) _preporuceniPeriod;

    private readonly ApexChartOptions<SolarKpiRecord> _sparkYellow = BuildSparklineOptions("#e8bf3d");
    private readonly ApexChartOptions<SolarKpiRecord> _sparkBlue = BuildSparklineOptions("#5aabe0");
    private readonly ApexChartOptions<SolarKpiRecord> _sparkRed = BuildSparklineOptions("#e05c5c");
    private readonly ApexChartOptions<SolarKpiRecord> _sparkCyan = BuildSparklineOptions("#4ccadd");

    protected override async Task OnInitializedAsync()
    {
        var options = SolarOptionsAccessor.Value;
        _livePolling = options.IsConfigured;
        _pollIntervalSeconds = options.PollIntervalSeconds;
        _stationDn = string.IsNullOrWhiteSpace(options.StationDn)
            ? SolarPodatakKatalog.StationDn
            : options.StationDn;

        if (_livePolling && _jeDanas)
        {
            try
            {
                await SolarIntradaySync.SyncTodayIfNeededAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Intraday sync iz FusionSolar nije uspeo — prikaz iz lokalne baze");
            }
        }

        await UcitajPodatke();

        _hasDbData = _poslednji != null || _istorijaDanas.Count > 0;

        await PokreniAutoRefreshAkoTreba();
    }

    private async Task PrethodniDan()
    {
        _izabraniDatum = _izabraniDatum.AddDays(-1);
        await PromeniDatum();
    }

    private async Task SledeciDan()
    {
        if (_jeDanas)
        {
            return;
        }

        var sledeci = _izabraniDatum.AddDays(1);
        _izabraniDatum = sledeci.Date > DateTime.Today ? DateTime.Today : sledeci;
        await PromeniDatum();
    }

    private async Task PromeniDatum()
    {
        if (_jeDanas)
        {
            await PokreniAutoRefreshAkoTreba();
        }
        else
        {
            await ZaustaviAutoRefresh();
        }

        await UcitajPodatke(prikaziUcitavanje: true);
        await InvokeAsync(StateHasChanged);
    }

    private async Task OsveziPodatke()
    {
        if (_jeDanas && _livePolling)
        {
            try
            {
                await SolarIntradaySync.SyncTodayIfNeededAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Intraday sync pri ručnom osvežavanju nije uspeo");
            }
        }

        await UcitajPodatke(prikaziUcitavanje: true);
        await InvokeAsync(StateHasChanged);
    }

    private async Task UcitajPodatke(bool prikaziUcitavanje = false)
    {
        if (prikaziUcitavanje)
        {
            _ucitavanje = true;
        }

        try
        {
            if (_jeDanas)
            {
                _poslednji = await SolarDb.GetLatestKpiAsync(_stationDn);
                _istorijaDanas = await SolarDb.GetTodayHistoryAsync(_stationDn);
            }
            else
            {
                _poslednji = await SolarDb.GetDailySummaryAsync(_stationDn, _izabraniDatum);
                _istorijaDanas = await SolarDb.GetIntradayForDateAsync(_stationDn, _izabraniDatum);
            }

            _hasDbData = _poslednji != null || _istorijaDanas.Count > 0;
            _preporuceniPeriod = IzracunajPreporuceniPeriod();
            _grafOptions = BuildGlavniGrafOptions(_preporuceniPeriod, _istorijaDanas.Count);
            _chartKey = $"{_izabraniDatum:yyyyMMdd}:{_istorijaDanas.Count}:{_poslednji?.Timestamp.Ticks ?? 0}";

            if (_istorijaDanas.Count > 0)
            {
                var od = _istorijaDanas.Min(r => r.Timestamp).ToLocalTime();
                var doVreme = _istorijaDanas.Max(r => r.Timestamp).ToLocalTime();
                _grafOpsegTekst = $"{od:HH:mm} – {doVreme:HH:mm} ({_istorijaDanas.Count} tačaka)";
            }
            else
            {
                _grafOpsegTekst = null;
            }
        }
        finally
        {
            if (prikaziUcitavanje)
            {
                _ucitavanje = false;
            }
        }
    }

    private async Task PokreniAutoRefreshAkoTreba()
    {
        if (!_livePolling || !_jeDanas)
        {
            return;
        }

        if (_timerCts != null && !_timerCts.IsCancellationRequested)
        {
            return;
        }

        _timerCts = new CancellationTokenSource();
        _ = PokreniAutoOsvezavanje(_timerCts.Token);
        await Task.CompletedTask;
    }

    private async Task ZaustaviAutoRefresh()
    {
        if (_timerCts == null)
        {
            return;
        }

        _timerCts.Cancel();
        _timer?.Dispose();
        _timerCts.Dispose();
        _timerCts = null;
        _timer = null;
        await Task.CompletedTask;
    }

    private static string FormatKwh(decimal? kwh) =>
        kwh.HasValue ? $"{kwh.Value:N1} kWh" : "—";

    private static string FormatKwhZero(decimal? kwh) =>
        $"{(kwh ?? 0):N1} kWh";

    private async Task PokreniAutoOsvezavanje(CancellationToken ct)
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(Math.Max(_pollIntervalSeconds, 10)));
        try
        {
            while (await _timer.WaitForNextTickAsync(ct))
            {
                if (ct.IsCancellationRequested)
                {
                    break;
                }

                if (!_jeDanas)
                {
                    break;
                }

                try
                {
                    if (_jeDanas && _livePolling)
                    {
                        try
                        {
                            await SolarIntradaySync.SyncTodayIfNeededAsync();
                        }
                        catch (Exception ex)
                        {
                            Logger.LogWarning(ex, "Intraday sync u auto-osvežavanju nije uspeo");
                        }
                    }

                    await UcitajPodatke();
                    if (!ct.IsCancellationRequested)
                    {
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (ObjectDisposedException)
                {
                    break;
                }
                catch (Exception ex) when (!ct.IsCancellationRequested)
                {
                    Logger.LogError(ex, "Greška pri osvežavanju solar dashboard-a");
                }
            }
        }
        catch (OperationCanceledException)
        {
            // stranica zatvorena
        }
    }

    private (DateTime? Start, DateTime? End) IzracunajPreporuceniPeriod()
    {
        DateTime? start = null;
        DateTime? end = null;
        DateTime? bestStart = null;
        DateTime? bestEnd = null;

        foreach (var rec in _istorijaDanas.OrderBy(r => r.Timestamp))
        {
            var solar = (double)(rec.CurrentPower ?? 0);
            var load = (double)(rec.LoadPower ?? 0);
            var pokrivenost = load > 0 ? (solar / load) * 100 : (solar > 0 ? 100 : 0);

            if (pokrivenost >= 70)
            {
                start ??= rec.Timestamp;
                end = rec.Timestamp;
            }
            else
            {
                if (start.HasValue && end.HasValue && (!bestStart.HasValue || (end.Value - start.Value) > (bestEnd!.Value - bestStart!.Value)))
                {
                    bestStart = start;
                    bestEnd = end;
                }

                start = null;
                end = null;
            }
        }

        if (start.HasValue && end.HasValue && (!bestStart.HasValue || (end.Value - start.Value) > (bestEnd!.Value - bestStart!.Value)))
        {
            bestStart = start;
            bestEnd = end;
        }

        return (bestStart?.ToLocalTime(), bestEnd?.ToLocalTime());
    }

    private static ApexChartOptions<SolarKpiRecord> BuildGlavniGrafOptions((DateTime? Start, DateTime? End) period, int pointCount)
    {
        int markerSize = pointCount <= 5 ? 5 : 0;
        var options = SolarChartOptionsFactory.ZaSolarKpi(
            darkTheme: true,
            colors: new[] { "#e8bf3d", "#5aabe0", "#e05c5c" },
            strokeWidth: 3,
            markerSize: markerSize);

        options.Chart!.Type = ChartType.Area;
        options.Fill = new Fill
        {
            Type = FillType.Gradient,
            Gradient = new FillGradient
            {
                ShadeIntensity = 0.5,
                OpacityFrom = 0.55,
                OpacityTo = 0.08,
                Stops = new List<double> { 0, 90, 100 }
            }
        };
        options.Grid!.BorderColor = "rgba(148, 163, 184, 0.12)";
        options.Grid.StrokeDashArray = 4;
        options.Legend!.HorizontalAlign = Align.Right;
        options.Legend.Labels = new LegendLabels { Colors = "#cbd5e1" };
        options.Xaxis!.Labels!.Style = new AxisLabelStyle { Colors = "#8ea3ba" };

        if (period.Start.HasValue && period.End.HasValue)
        {
            options.Annotations = new Annotations
            {
                Xaxis = new List<AnnotationsXAxis>
                {
                    new AnnotationsXAxis
                    {
                        X = period.Start.Value.ToUnixTimeMilliseconds(),
                        X2 = period.End.Value.ToUnixTimeMilliseconds(),
                        FillColor = "#3fb873",
                        Opacity = 0.12,
                        BorderColor = "#3fb873",
                        Label = new Label
                        {
                            Text = "Preporučeno za paljenje mašina",
                            Style = new Style { Background = "#3fb873", Color = "#07111f" }
                        }
                    }
                }
            };
        }

        return options;
    }

    private static ApexChartOptions<SolarKpiRecord> BuildSparklineOptions(string color) =>
        new()
        {
            Chart = new Chart
            {
                Type = ChartType.Area,
                Sparkline = new ChartSparkline { Enabled = true },
                Animations = new Animations { Enabled = false },
                Toolbar = new Toolbar { Show = false },
                Background = "transparent",
                Zoom = new Zoom { Enabled = false }
            },
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 },
            Fill = new Fill
            {
                Type = FillType.Gradient,
                Gradient = new FillGradient { OpacityFrom = 0.32, OpacityTo = 0.02 }
            },
            Colors = new List<string> { color },
            Tooltip = new Tooltip { Enabled = false },
            DataLabels = new DataLabels { Enabled = false }
        };

    public void Dispose()
    {
        _timerCts?.Cancel();
        _timer?.Dispose();
        _timerCts?.Dispose();
    }
}
