@page "/solar-pregled"
@rendermode @(new InteractiveServerRenderMode())
@using ApexCharts
@using FruitSysWeb.Models
@using FruitSysWeb.Models.Solar
@using FruitSysWeb.Services.Solar
@using Microsoft.Extensions.Options
@inject SolarLocalDbService SolarDb
@inject IOptions<FusionSolarOptions> SolarOptionsAccessor

<PageTitle>Solarna energija — detaljni pregled</PageTitle>

<div class="solar-dashboard solar-pregled-page">
    <header class="solar-header sp-header">
        <div>
            <h1 class="solar-title">Solarna energija — detaljni pregled</h1>
            <span class="solar-subtitle">@SolarPodatakKatalog.Postrojenje · Huawei FusionSolar</span>
        </div>
        <div class="solar-header-right">
            <span class="status-pill @(_isConfigured ? "" : "status-pill-offline")">
                ● @(_isConfigured ? "Integracija aktivna" : "Integracija neaktivna")
            </span>
            @if (_poslednjiKpi != null)
            {
                <span class="solar-last-read">
                    Očitavanje: <strong>@_poslednjiKpi.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong>
                </span>
            }
            <a class="btn-solar-link" href="/solar-hala">← Dashboard</a>
        </div>
    </header>

    @if (_isConfigured)
    {
        <div class="alert alert-success py-2 mb-2 sp-alert" role="alert">
            <i class="bi bi-check-circle me-1"></i>
            Podaci se osvežavaju svakih @_pollIntervalSeconds sekundi.
        </div>
    }
    else
    {
        <div class="alert alert-warning py-2 mb-2 sp-alert" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            Integracija nije aktivna — proveri lozinku u podešavanjima (FusionSolar:Password).
        </div>
    }

    <div class="sp-section sp-kpi-wrap">
        <table class="table table-dark table-sm sp-kpi-table mb-0">
            <thead>
                <tr>
                    <th>Trenutna snaga</th>
                    <th>Proizvedeno danas</th>
                    <th>Ukupno od instalacije</th>
                    <th>Poslednje očitavanje</th>
                    <th class="text-end">Uređaji povezani</th>
                    <th class="text-end">Problemi</th>
                    <th class="text-end">Diskonektovani</th>
                    <th class="text-end">Notif. / eventi</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="sp-kpi-value">@(_poslednjiKpi?.CurrentPower?.ToString("N2") ?? "—") <span class="sp-unit">kW</span></td>
                    <td class="sp-kpi-value">@(_poslednjiKpi?.DailyEnergy?.ToString("N1") ?? "—") <span class="sp-unit">kWh</span></td>
                    <td class="sp-kpi-value">@(_poslednjiKpi?.CumulativeEnergy?.ToString("N0") ?? "—") <span class="sp-unit">kWh</span></td>
                    <td>@(_poslednjiKpi != null ? _poslednjiKpi.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") : "—")</td>
                    <td class="text-end">
                        @if (_poslednjiKpi?.TotalDevices != null)
                        {
                            <span class="@(_poslednjiKpi.TroubleDevices > 0 || _poslednjiKpi.DisconnectedDevices > 0 ? "text-warning" : "text-success")">
                                @_poslednjiKpi.ConnectedDevices / @_poslednjiKpi.TotalDevices
                            </span>
                        }
                        else { <span>—</span> }
                    </td>
                    <td class="text-end @((_poslednjiKpi?.TroubleDevices ?? 0) > 0 ? "text-warning" : "")">@(_poslednjiKpi?.TroubleDevices ?? 0)</td>
                    <td class="text-end @((_poslednjiKpi?.DisconnectedDevices ?? 0) > 0 ? "text-warning" : "")">@(_poslednjiKpi?.DisconnectedDevices ?? 0)</td>
                    <td class="text-end">@(_poslednjiKpi?.NoticeCount ?? 0) / @(_poslednjiKpi?.EventCount ?? 0)</td>
                </tr>
            </tbody>
        </table>
    </div>

    @if (_poslednjiKpi != null || _istorijaDanas.Count > 0)
    {
        var solarKw = (double)(_poslednjiKpi?.CurrentPower ?? 0);
        var factoryKw = (double)(_poslednjiKpi?.LoadPower ?? 0);
        var gridKw = Math.Max((double)(_poslednjiKpi?.GridPower ?? 0), 0);
        var solarCoverage = factoryKw > 0 ? Math.Round(solarKw / factoryKw * 100) : (solarKw > 0 ? 100 : 0);
        var alarmCount = (_poslednjiKpi?.TroubleDevices ?? 0) + (_poslednjiKpi?.DisconnectedDevices ?? 0);
        var devicesOnline = _poslednjiKpi?.ConnectedDevices ?? 0;
        var devicesTotal = _poslednjiKpi?.TotalDevices ?? SolarPodatakKatalog.InverterDns.Count;
        var inverterOnline = devicesTotal > 0 && devicesOnline >= devicesTotal;

        string statusKlasa;
        string statusNaslov;
        string statusOpis;
        if (solarCoverage >= 70)
        {
            statusKlasa = "sd-status-good";
            statusNaslov = "DOBAR TRENUTAK ZA PALJENJE MAŠINA";
            statusOpis = $"Solar pokriva {solarCoverage:N0}% potrošnje";
        }
        else if (solarCoverage < 50)
        {
            statusKlasa = "sd-status-wait";
            statusNaslov = "SAČEKATI SA VELIKIM POTROŠAČIMA";
            statusOpis = $"Solar pokriva samo {solarCoverage:N0}% potrošnje";
        }
        else
        {
            statusKlasa = "sd-status-normal";
            statusNaslov = "NORMALAN RAD";
            statusOpis = $"Solar pokriva {solarCoverage:N0}% potrošnje";
        }

        var preporuceniTekst = _preporuceniPeriod.Start.HasValue && _preporuceniPeriod.End.HasValue
            ? $"{_preporuceniPeriod.Start:HH:mm} – {_preporuceniPeriod.End:HH:mm}"
            : "Nema perioda danas";

        <div class="sp-section sp-advice-block @statusKlasa">
            <section class="sd-advice-row @statusKlasa">
                <div class="sd-advice-main">
                    <div class="sd-decision-title">@statusNaslov</div>
                    <div class="sd-decision-sub">@statusOpis</div>
                </div>
                <div class="sd-advice-metric">
                    <span class="sd-advice-metric-label">Period</span>
                    <span class="sd-advice-metric-value">@preporuceniTekst</span>
                </div>
                <div class="sd-advice-metric">
                    <span class="sd-advice-metric-label">Pokrivenost</span>
                    <span class="sd-advice-metric-value">@solarCoverage.ToString("N0")%</span>
                </div>
                <div class="sd-advice-metric">
                    <span class="sd-advice-metric-label">Mreža sada</span>
                    <span class="sd-advice-metric-value">@gridKw.ToString("N0") kW</span>
                </div>
            </section>
        </div>

        @if (_istorijaDanas.Count >= 2 && _grafOptions != null)
        {
            <div class="sp-section sp-chart-intraday sd-main-chart">
                <div class="sd-chart-head">
                    <div>
                        <h2 class="solar-chart-title">Proizvodnja, potrošnja i mreža tokom dana</h2>
                        @if (_grafOpsegTekst != null)
                        {
                            <p class="sd-chart-period">@_grafOpsegTekst</p>
                        }
                    </div>
                    <span class="panel-meta">kW · @_istorijaDanas.Count očitavanja</span>
                </div>
                <ApexChart @key="@_chartKey" TItem="SolarKpiRecord" Options="@_grafOptions" Height="300">
                    <ApexPointSeries TItem="SolarKpiRecord"
                                     Items="_istorijaDanas"
                                     Name="Sunce"
                                     SeriesType="SeriesType.Area"
                                     XValue="@(e => e.Timestamp.ToLocalTime())"
                                     YValue="@(e => e.CurrentPower ?? 0)" />
                    <ApexPointSeries TItem="SolarKpiRecord"
                                     Items="_istorijaDanas"
                                     Name="Hala / Fabrika"
                                     SeriesType="SeriesType.Area"
                                     XValue="@(e => e.Timestamp.ToLocalTime())"
                                     YValue="@(e => e.LoadPower ?? 0)" />
                    <ApexPointSeries TItem="SolarKpiRecord"
                                     Items="_istorijaDanas"
                                     Name="Iz mreže"
                                     SeriesType="SeriesType.Area"
                                     XValue="@(e => e.Timestamp.ToLocalTime())"
                                     YValue="@(e => Math.Max(e.GridPower ?? 0, 0))" />
                </ApexChart>
            </div>
        }

        @if (_isConfigured && (_istorijaProizvodnje.Count >= 2 || _dnevnaProizvodnja.Count >= 2 || _dnevnaUsteda.Count >= 2))
        {
            <div class="sp-chart-row">
                @if (_istorijaProizvodnje.Count >= 2)
                {
                    <div class="sp-chart-panel">
                        <div class="sp-panel-head">Ukupna proizvodnja (od instalacije)</div>
                        <ApexChart TItem="SolarKpiRecord" Options="@CumulativeChartOptions" Height="260">
                            <ApexPointSeries TItem="SolarKpiRecord"
                                             Items="_istorijaProizvodnje"
                                             Name="Ukupna proizvodnja"
                                             SeriesType="SeriesType.Line"
                                             XValue="@(e => e.Timestamp.ToLocalTime())"
                                             YValue="@(e => e.CumulativeEnergy ?? 0)" />
                        </ApexChart>
                        <p class="sp-chart-note">Istorija od 14.05.2026.</p>
                    </div>
                }
                @if (_dnevnaProizvodnja.Count >= 2)
                {
                    <div class="sp-chart-panel">
                        <div class="sp-panel-head">Dnevna proizvodnja</div>
                        <ApexChart TItem="SolarKpiRecord" Options="@DailyChartOptions" Height="260">
                            <ApexPointSeries TItem="SolarKpiRecord"
                                             Items="_dnevnaProizvodnja"
                                             Name="Dnevna proizvodnja"
                                             SeriesType="SeriesType.Line"
                                             XValue="@(e => e.Timestamp.ToLocalTime())"
                                             YValue="@(e => e.DailyEnergy ?? 0)" />
                        </ApexChart>
                        <p class="sp-chart-note">
                            @_dnevnaProizvodnja.Count dana
                            (@(_dnevnaProizvodnja.Min(d => d.Timestamp).ToLocalTime().ToString("dd.MM.yyyy"))
                            — @(_dnevnaProizvodnja.Max(d => d.Timestamp).ToLocalTime().ToString("dd.MM.yyyy"))).
                        </p>
                    </div>
                }
                @if (_dnevnaUsteda.Count >= 2)
                {
                    <div class="sp-chart-panel sp-chart-full">
                        <div class="sp-panel-head">Dnevna ušteda (EUR)</div>
                        <ApexChart TItem="SolarKpiRecord" Options="@SavingsChartOptions" Height="260">
                            <ApexPointSeries TItem="SolarKpiRecord"
                                             Items="_dnevnaUsteda"
                                             Name="Ušteda"
                                             SeriesType="SeriesType.Line"
                                             XValue="@(e => e.Timestamp.ToLocalTime())"
                                             YValue="@(e => e.DailySavingsEur ?? 0)" />
                        </ApexChart>
                        <p class="sp-chart-note">
                            @_dnevnaUsteda.Count dana
                            (@(_dnevnaUsteda.Min(d => d.Timestamp).ToLocalTime().ToString("dd.MM.yyyy"))
                            — @(_dnevnaUsteda.Max(d => d.Timestamp).ToLocalTime().ToString("dd.MM.yyyy"))).
                        </p>
                    </div>
                }
            </div>
        }

        <section class="sp-operational-grid">
            <div class="solar-card">
                <h3 class="panel-title">Inverteri</h3>
                <table class="inverter-table">
                    <thead>
                        <tr>
                            <th>Inverter</th>
                            <th>Status</th>
                            <th>Snaga</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < InverterNazivi.Length; i++)
                        {
                            <tr>
                                <td>@InverterNazivi[i]</td>
                                <td>
                                    <span class="@(inverterOnline ? "status-online" : "status-offline")">
                                        @(inverterOnline ? "Online" : "Provera")
                                    </span>
                                </td>
                                <td class="muted">@(i == 0 ? $"{solarKw:N0} kW (ukupno)" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="solar-card">
                <h3 class="panel-title">Mreža / PowerMeter</h3>
                <ul class="metric-list">
                    <li><span>Load trenutno</span><span class="val-blue">@factoryKw.ToString("N0") kW</span></li>
                    <li><span>Grid trenutno</span><span class="val-red">@gridKw.ToString("N0") kW</span></li>
                    <li><span>Kupljeno danas</span><span class="val-red">@FormatKwh(_poslednjiKpi?.DailyBuyEnergy)</span></li>
                    <li><span>Predato u mrežu</span><span class="val-cyan">@FormatKwh(_poslednjiKpi?.DailyOnGridEnergy)</span></li>
                </ul>
            </div>
            <div class="solar-card">
                <h3 class="panel-title">Alarmi</h3>
                <div class="alarm-count @(alarmCount == 0 ? "alarm-count-ok" : "alarm-count-warn")">@alarmCount</div>
                <ul class="metric-list">
                    <li><span>Povezano</span><span class="val-green">@(_poslednjiKpi?.ConnectedDevices?.ToString() ?? "—")</span></li>
                    <li><span>Diskonektovano</span><span class="val-red">@(_poslednjiKpi?.DisconnectedDevices?.ToString() ?? "—")</span></li>
                    <li><span>Problemi</span><span class="val-red">@(_poslednjiKpi?.TroubleDevices?.ToString() ?? "—")</span></li>
                    <li><span>Događaji</span><span>@(_poslednjiKpi?.EventCount?.ToString() ?? "—")</span></li>
                </ul>
            </div>
            <div class="solar-card">
                <h3 class="panel-title">Dnevni rezime</h3>
                <ul class="metric-list">
                    <li><span>Proizvedeno</span><span class="val-yellow">@FormatKwh(_poslednjiKpi?.DailyEnergy)</span></li>
                    <li><span>Potrošnja</span><span class="val-blue">@FormatKwh(_poslednjiKpi?.DailyUseEnergy)</span></li>
                    <li><span>Sopstvena upotreba</span><span class="val-green">@FormatKwh(_poslednjiKpi?.DailySelfUseEnergy)</span></li>
                    <li><span>Preporučeno</span><span>@preporuceniTekst</span></li>
                </ul>
            </div>
        </section>
    }

    <div class="sp-section">
        <ul class="nav nav-tabs sp-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#sp-pane-kat" type="button" role="tab">Kategorije podataka</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#sp-pane-ured" type="button" role="tab">Uređaji</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#sp-pane-sig" type="button" role="tab">Signali</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#sp-pane-teh" type="button" role="tab">Tehnički podaci</button>
            </li>
        </ul>

        <div class="tab-content sp-tab-content">
            <div class="tab-pane fade show active" id="sp-pane-kat" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-dark table-sm table-striped sp-ref-table mb-0">
                        <thead>
                            <tr>
                                <th>Kategorija</th>
                                <th>Status</th>
                                <th>Učestalost</th>
                                <th>Izvor</th>
                                <th>Podaci</th>
                                <th>Grafikoni</th>
                                <th>Izveštaji</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stavka in SolarPodatakKatalog.Sve)
                            {
                                <tr>
                                    <td>@stavka.Kategorija</td>
                                    <td><span class="badge bg-secondary">@stavka.Status</span></td>
                                    <td>@stavka.Ucestalost</td>
                                    <td class="sp-mono">@stavka.Izvor</td>
                                    <td class="sp-cell-list">@string.Join("; ", stavka.Polja)</td>
                                    <td class="sp-cell-list">@string.Join("; ", stavka.Grafikoni)</td>
                                    <td class="sp-cell-list">@string.Join("; ", stavka.Izvestaji)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="tab-pane fade" id="sp-pane-ured" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-dark table-sm table-striped sp-ref-table mb-0">
                        <thead><tr><th>mocId</th><th>Tip uređaja</th></tr></thead>
                        <tbody>
                            @foreach (var (mocId, tip) in SolarPodatakKatalog.TipoviUredjaja)
                            {
                                <tr><td class="text-end">@mocId</td><td>@tip</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="tab-pane fade" id="sp-pane-sig" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-dark table-sm table-striped sp-ref-table mb-0">
                        <thead><tr><th>Signal ID</th><th>Naziv</th><th>Jedinica</th></tr></thead>
                        <tbody>
                            @foreach (var (id, naziv, jed) in SolarPodatakKatalog.SignaliInvertera)
                            {
                                <tr><td class="text-end">@id</td><td>@naziv</td><td>@jed</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="tab-pane fade" id="sp-pane-teh" role="tabpanel">
                <div class="table-responsive">
                    <table class="table table-dark table-sm table-striped sp-ref-table mb-0">
                        <tbody>
                            <tr><th scope="row">Postrojenje</th><td>@SolarPodatakKatalog.Postrojenje</td></tr>
                            <tr><th scope="row">stationDn</th><td class="sp-mono">@SolarPodatakKatalog.StationDn</td></tr>
                            <tr><th scope="row">Logger SN</th><td class="sp-mono">@SolarPodatakKatalog.LoggerSn</td></tr>
                            <tr><th scope="row">Meter DN</th><td class="sp-mono">@SolarPodatakKatalog.MeterDn</td></tr>
                            <tr><th scope="row">Konfiguracija opreme</th><td>3× inverter + 1× PowerMeter</td></tr>
                            <tr><th scope="row">Inverter DN</th><td class="sp-mono">@string.Join(", ", SolarPodatakKatalog.InverterDns)</td></tr>
                            @if (_isConfigured)
                            {
                                <tr><th scope="row">Interval osvežavanja</th><td>@_pollIntervalSeconds s</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly string[] InverterNazivi =
    {
        "SUN2000-110KTL-M2",
        "SUN2000-110KTL-M2",
        "SUN2000-100KTL-M2"
    };

    private bool _isConfigured;
    private int _pollIntervalSeconds;
    private SolarKpiRecord? _poslednjiKpi;
    private List<SolarKpiRecord> _istorijaDanas = new();
    private List<SolarKpiRecord> _istorijaProizvodnje = new();
    private List<SolarKpiRecord> _dnevnaProizvodnja = new();
    private List<SolarKpiRecord> _dnevnaUsteda = new();
    private ApexChartOptions<SolarKpiRecord>? _grafOptions;
    private string _chartKey = "0";
    private string? _grafOpsegTekst;
    private (DateTime? Start, DateTime? End) _preporuceniPeriod;

    private ApexChartOptions<SolarKpiRecord> CumulativeChartOptions =>
        SolarChartOptionsFactory.ZaSolarKpi(darkTheme: true, yAxisTitle: "kWh", markerSize: 4, kwFormatter: false);

    private ApexChartOptions<SolarKpiRecord> DailyChartOptions =>
        SolarChartOptionsFactory.ZaSolarKpi(darkTheme: true, yAxisTitle: "kWh/dan", strokeWidth: 2, kwFormatter: false);

    private ApexChartOptions<SolarKpiRecord> SavingsChartOptions =>
        SolarChartOptionsFactory.ZaSolarKpi(
            darkTheme: true,
            colors: new[] { "#f59e0b" },
            yAxisTitle: "EUR/dan",
            strokeWidth: 2,
            kwFormatter: false);

    protected override async Task OnInitializedAsync()
    {
        var options = SolarOptionsAccessor.Value;
        _isConfigured = options.IsConfigured;
        _pollIntervalSeconds = options.PollIntervalSeconds;

        var stationDn = string.IsNullOrWhiteSpace(options.StationDn)
            ? SolarPodatakKatalog.StationDn
            : options.StationDn;

        _poslednjiKpi = await SolarDb.GetLatestKpiAsync(stationDn);
        _istorijaDanas = await SolarDb.GetTodayHistoryAsync(stationDn);
        _istorijaProizvodnje = await SolarDb.GetCumulativeHistoryAsync(stationDn);
        _dnevnaProizvodnja = await SolarDb.GetDailyEnergyHistoryAsync(stationDn);
        _dnevnaUsteda = await SolarDb.GetDailySavingsHistoryAsync(stationDn);

        _preporuceniPeriod = IzracunajPreporuceniPeriod();
        _grafOptions = BuildGlavniGrafOptions(_preporuceniPeriod, _istorijaDanas.Count);
        _chartKey = $"{_istorijaDanas.Count}:{_poslednjiKpi?.Timestamp.Ticks ?? 0}";

        if (_istorijaDanas.Count > 0)
        {
            var od = _istorijaDanas.Min(r => r.Timestamp).ToLocalTime();
            var doVreme = _istorijaDanas.Max(r => r.Timestamp).ToLocalTime();
            _grafOpsegTekst = $"{od:HH:mm} – {doVreme:HH:mm} ({_istorijaDanas.Count} tačaka)";
        }
    }

    private static string FormatKwh(decimal? kwh) =>
        kwh.HasValue ? $"{kwh.Value:N1} kWh" : "—";

    private (DateTime? Start, DateTime? End) IzracunajPreporuceniPeriod()
    {
        DateTime? start = null;
        DateTime? end = null;
        DateTime? bestStart = null;
        DateTime? bestEnd = null;

        foreach (var rec in _istorijaDanas.OrderBy(r => r.Timestamp))
        {
            var solar = (double)(rec.CurrentPower ?? 0);
            var load = (double)(rec.LoadPower ?? 0);
            var pokrivenost = load > 0 ? (solar / load) * 100 : (solar > 0 ? 100 : 0);

            if (pokrivenost >= 70)
            {
                start ??= rec.Timestamp;
                end = rec.Timestamp;
            }
            else
            {
                if (start.HasValue && end.HasValue && (!bestStart.HasValue || (end.Value - start.Value) > (bestEnd!.Value - bestStart!.Value)))
                {
                    bestStart = start;
                    bestEnd = end;
                }

                start = null;
                end = null;
            }
        }

        if (start.HasValue && end.HasValue && (!bestStart.HasValue || (end.Value - start.Value) > (bestEnd!.Value - bestStart!.Value)))
        {
            bestStart = start;
            bestEnd = end;
        }

        return (bestStart?.ToLocalTime(), bestEnd?.ToLocalTime());
    }

    private static ApexChartOptions<SolarKpiRecord> BuildGlavniGrafOptions((DateTime? Start, DateTime? End) period, int pointCount)
    {
        int markerSize = pointCount <= 5 ? 5 : 0;
        var options = SolarChartOptionsFactory.ZaSolarKpi(
            darkTheme: true,
            colors: new[] { "#e8bf3d", "#5aabe0", "#e05c5c" },
            strokeWidth: 3,
            markerSize: markerSize);

        options.Chart!.Type = ChartType.Area;
        options.Fill = new Fill
        {
            Type = FillType.Gradient,
            Gradient = new FillGradient
            {
                ShadeIntensity = 0.5,
                OpacityFrom = 0.55,
                OpacityTo = 0.08,
                Stops = new List<double> { 0, 90, 100 }
            }
        };
        options.Grid!.BorderColor = "rgba(148, 163, 184, 0.12)";
        options.Grid.StrokeDashArray = 4;
        options.Legend!.HorizontalAlign = Align.Right;
        options.Legend.Labels = new LegendLabels { Colors = "#cbd5e1" };
        options.Xaxis!.Labels!.Style = new AxisLabelStyle { Colors = "#8ea3ba" };

        if (period.Start.HasValue && period.End.HasValue)
        {
            options.Annotations = new Annotations
            {
                Xaxis = new List<AnnotationsXAxis>
                {
                    new AnnotationsXAxis
                    {
                        X = period.Start.Value.ToUnixTimeMilliseconds(),
                        X2 = period.End.Value.ToUnixTimeMilliseconds(),
                        FillColor = "#3fb873",
                        Opacity = 0.12,
                        BorderColor = "#3fb873",
                        Label = new Label
                        {
                            Text = "Preporučeno za paljenje mašina",
                            Style = new Style { Background = "#3fb873", Color = "#07111f" }
                        }
                    }
                }
            };
        }

        return options;
    }
}
