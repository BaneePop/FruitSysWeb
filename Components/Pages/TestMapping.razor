@* 
PRIMER KORIŠĆENJA NOVOG TypeMappingService 
Ovaj fajl pokazuje kako zameniti staru duplikovanu logiku sa novim servisom 
*@

@page "/test-mapping"
@using FruitSysWeb.Services.Core
@using FruitSysWeb.Constants
@inject ITypeMappingService TypeMapping

<h3>🧪 Test TypeMappingService</h3>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>🏷️ MagacinID Tipovi</h5>
            </div>
            <div class="card-body">
                @for(int i = 1; i <= 12; i++)
                {
                    <div class="mb-2">
                        <strong>@i:</strong> 
                        <span class="badge @TypeMapping.GetMagacinBadgeClass(i)">
                            @TypeMapping.GetMagacinDisplayName(i)
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>📋 Document Statusi</h5>
            </div>
            <div class="card-body">
                @for(int status = 1; status <= 4; status++)
                {
                    <div class="mb-2">
                        <i class="@TypeMapping.GetStatusIcon(status)"></i>
                        <span class="badge @TypeMapping.GetStatusBadgeClass(status) ms-1">
                            @TypeMapping.GetStatusDisplayName(status)
                        </span>
                        @if(TypeMapping.IsActiveStatus(status))
                        {
                            <small class="text-success ms-1">(Aktivan)</small>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6>📝 Dropdown - MagacinID</h6>
            </div>
            <div class="card-body">
                <select class="form-select" @bind="selectedMagacinId">
                    @foreach(var option in TypeMapping.GetMagacinDropdownOptions())
                    {
                        <option value="@option.Value">@option.Text</option>
                    }
                </select>
                
                @if(!string.IsNullOrEmpty(selectedMagacinId))
                {
                    <div class="mt-2">
                        <small>Odabrano:</small><br>
                        <span class="badge @TypeMapping.GetMagacinBadgeClass(int.Parse(selectedMagacinId))">
                            @TypeMapping.GetMagacinDisplayName(int.Parse(selectedMagacinId))
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6>🚀 Brzi Filteri</h6>
            </div>
            <div class="card-body">
                @foreach(var filter in TypeMapping.GetMagacinQuickFilters())
                {
                    <button class="btn btn-sm @(filter.IsActive ? "btn-primary" : "btn-outline-secondary") me-1 mb-1"
                            @onclick="() => ToggleQuickFilter(filter)">
                        <i class="@filter.Icon"></i>
                        @filter.Label
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6>📊 Quantity Status</h6>
            </div>
            <div class="card-body">
                @foreach(var qty in testQuantities)
                {
                    var (status, badgeClass, icon) = TypeMapping.GetQuantityStatus(qty);
                    <div class="mb-1">
                        <span class="badge @badgeClass">
                            <i class="@icon"></i> @qty.ToString("N1") - @status
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h6>🎨 Chart Colors</h6>
            </div>
            <div class="card-body">
                @foreach(var color in TypeMapping.GetChartColors(10).Take(10))
                {
                    <span class="d-inline-block me-2 mb-2" 
                          style="width: 30px; height: 30px; background-color: @color; border-radius: 4px;">
                    </span>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h6>🔧 Formatiranje</h6>
            </div>
            <div class="card-body">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Vrednost</th>
                            <th>Format Decimal</th>
                            <th>Format Currency</th>
                            <th>Format Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>12345.67</td>
                            <td>@TypeMapping.FormatDecimal(12345.67m)</td>
                            <td>@TypeMapping.FormatCurrency(12345.67m)</td>
                            <td>@TypeMapping.FormatDate(DateTime.Now)</td>
                        </tr>
                        <tr>
                            <td>999.99</td>
                            <td>@TypeMapping.FormatDecimal(999.99m)</td>
                            <td>@TypeMapping.FormatCurrency(999.99m)</td>
                            <td>@TypeMapping.FormatDate(DateTime.Today.AddDays(-30))</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="alert alert-info">
            <h6><i class="bi-lightbulb"></i> Kako koristiti u postojećim fajlovima:</h6>
            <code>
                @* STARO: *@<br>
                @* var badgeClass = tip switch { 2 => "bg-success", 3 => "bg-primary", ... }; *@<br><br>
                @* NOVO: *@<br>
                @@TypeMapping.GetMagacinBadgeClass(tip)
            </code>
        </div>
    </div>
</div>

@code {
    private string selectedMagacinId = "";
    private List<decimal> testQuantities = new() { 2.5m, 8.0m, 15.5m, 25.0m, 50.0m };

    private void ToggleQuickFilter(QuickFilter filter)
    {
        filter.IsActive = !filter.IsActive;
        StateHasChanged();
    }
}
