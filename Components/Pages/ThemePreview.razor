@page "/theme-preview"
@inject ITypeMappingService TypeMapping

<PageTitle>Dark Theme Preview</PageTitle>

<div class="container-fluid py-4">
    
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="mb-2">🎨 Dark Theme Preview</h1>
            <p class="text-muted">Kompletni pregled nove tamne teme i svih komponenti</p>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stats-card" style="background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-blue-light) 100%);">
                <i class="bi bi-cash-coin fs-1 mb-3"></i>
                <div class="stats-number">@TypeMapping.FormatCurrency(245850.50m)</div>
                <div class="stats-label">Ukupan Prihod</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card" style="background: linear-gradient(135deg, var(--accent-green) 0%, var(--accent-green-light) 100%);">
                <i class="bi bi-graph-up fs-1 mb-3"></i>
                <div class="stats-number">@TypeMapping.FormatDecimal(12.5m)</div>
                <div class="stats-label">Rast (%)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card" style="background: linear-gradient(135deg, var(--accent-orange) 0%, var(--accent-orange-light) 100%);">
                <i class="bi bi-box-seam fs-1 mb-3"></i>
                <div class="stats-number">@TypeMapping.FormatInteger(1248)</div>
                <div class="stats-label">Broj Artikala</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card" style="background: linear-gradient(135deg, var(--accent-purple) 0%, #c4b5fd 100%);">
                <i class="bi bi-people fs-1 mb-3"></i>
                <div class="stats-number">342</div>
                <div class="stats-label">Aktivni Klijenti</div>
            </div>
        </div>
    </div>

    <!-- Badge Preview -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-tags me-2"></i>Status Badge-ovi</h5>
        </div>
        <div class="card-body">
            <div class="d-flex gap-2 flex-wrap">
                <span class="badge bg-success fs-6">Zaključen</span>
                <span class="badge bg-primary fs-6">Otvoren</span>
                <span class="badge bg-danger fs-6">Storno</span>
                <span class="badge bg-warning fs-6">Na čekanju</span>
                <span class="badge bg-secondary fs-6">Neaktivan</span>
                <span class="badge bg-info fs-6">U obradi</span>
            </div>
            
            <hr class="my-3">
            
            <h6>Brojevi dokumenata sa badge-ovima:</h6>
            <div class="d-flex gap-3 flex-wrap mt-2">
                <div>
                    <span class="badge bg-success me-2">001</span>
                    <span class="text-muted">Zaključen</span>
                </div>
                <div>
                    <span class="badge bg-primary me-2">002</span>
                    <span class="text-muted">Otvoren</span>
                </div>
                <div>
                    <span class="badge bg-danger me-2">003</span>
                    <span class="text-muted">Storno</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Preview -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-table me-2"></i>Tabela sa Dark Theme</h5>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Dokument</th>
                        <th>Datum</th>
                        <th>Komitent</th>
                        <th>Status</th>
                        <th class="text-end">Iznos</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span class="badge bg-success">F-001</span></td>
                        <td>@TypeMapping.FormatDate(DateTime.Now.AddDays(-5))</td>
                        <td>Komitent A</td>
                        <td><span class="badge bg-success">Zaključen</span></td>
                        <td class="text-end positive-saldo">@TypeMapping.FormatCurrency(45200.00m)</td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-primary">F-002</span></td>
                        <td>@TypeMapping.FormatDate(DateTime.Now.AddDays(-3))</td>
                        <td>Komitent B</td>
                        <td><span class="badge bg-primary">Otvoren</span></td>
                        <td class="text-end">@TypeMapping.FormatCurrency(32150.00m)</td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-danger">F-003</span></td>
                        <td>@TypeMapping.FormatDate(DateTime.Now.AddDays(-1))</td>
                        <td>Komitent C</td>
                        <td><span class="badge bg-danger">Storno</span></td>
                        <td class="text-end negative-saldo">@TypeMapping.FormatCurrency(-12500.00m)</td>
                    </tr>
                    <tr class="total-row">
                        <td colspan="4"><strong>UKUPNO:</strong></td>
                        <td class="text-end"><strong>@TypeMapping.FormatCurrency(64850.00m)</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Buttons Preview -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-cursor me-2"></i>Dugmad</h5>
        </div>
        <div class="card-body">
            <div class="d-flex gap-2 flex-wrap mb-3">
                <button class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Primarna
                </button>
                <button class="btn btn-success">
                    <i class="bi bi-check-circle me-1"></i> Uspeh
                </button>
                <button class="btn btn-danger">
                    <i class="bi bi-x-circle me-1"></i> Opasnost
                </button>
                <button class="btn btn-warning">
                    <i class="bi bi-exclamation-triangle me-1"></i> Upozorenje
                </button>
                <button class="btn btn-secondary">
                    <i class="bi bi-gear me-1"></i> Sekundarna
                </button>
            </div>
            
            <h6>Export dugmad:</h6>
            <div class="export-buttons">
                <button class="btn btn-success">
                    <i class="bi bi-file-earmark-excel"></i> Excel
                </button>
                <button class="btn btn-danger">
                    <i class="bi bi-file-earmark-pdf"></i> PDF
                </button>
                <button class="btn btn-primary">
                    <i class="bi bi-printer"></i> Print
                </button>
            </div>
        </div>
    </div>

    <!-- Forms Preview -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-input-cursor me-2"></i>Forme</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Tekst input:</label>
                    <input type="text" class="form-control" placeholder="Unesite tekst...">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Datum input:</label>
                    <input type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Select dropdown:</label>
                    <select class="form-select">
                        <option>Opcija 1</option>
                        <option>Opcija 2</option>
                        <option>Opcija 3</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Number input:</label>
                    <input type="number" class="form-control" value="1234" placeholder="Unesite broj...">
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts Preview -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-bell me-2"></i>Alert-ovi</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-success">
                <i class="bi bi-check-circle me-2"></i>
                <strong>Uspeh!</strong> Operacija je uspešno izvršena.
            </div>
            <div class="alert alert-danger">
                <i class="bi bi-x-circle me-2"></i>
                <strong>Greška!</strong> Došlo je do problema pri obradi zahteva.
            </div>
            <div class="alert alert-warning mb-0">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <strong>Upozorenje!</strong> Ova akcija može imati neočekivane posledice.
            </div>
        </div>
    </div>

    <!-- Chart Colors Preview -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-palette me-2"></i>Chart Boje</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                @{
                    var chartColors = TypeMapping.GetChartColors(10);
                    var colorNames = new[] { "Plava", "Crvena", "Narandžasta", "Tirkiz", "Ljubičasta", "Zelena", "Žuta", "Pink", "Svetlo Plava", "Svetlo Crvena" };
                }
                @for (int i = 0; i < chartColors.Count; i++)
                {
                    <div class="col-md-2 col-6">
                        <div style="background: @chartColors[i]; height: 60px; border-radius: 8px; border: 1px solid var(--border-color)"></div>
                        <small class="text-muted d-block mt-2">@colorNames[i]</small>
                        <small class="text-muted">@chartColors[i]</small>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Progress Bars -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Progress Bar-ovi</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Plavi (75%):</label>
                <div class="progress">
                    <div class="progress-bar" style="width: 75%">75%</div>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Zeleni (85%):</label>
                <div class="progress">
                    <div class="progress-bar progress-bar-success" style="width: 85%">85%</div>
                </div>
            </div>
            <div class="mb-0">
                <label class="form-label">Crveni (45%):</label>
                <div class="progress">
                    <div class="progress-bar progress-bar-danger" style="width: 45%">45%</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stock Indicators -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-box me-2"></i>Stock Indikatori (Lager)</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="high-stock p-3 rounded">
                        <span class="stock-indicator stock-high"></span>
                        <strong>Dovoljno zaliha</strong>
                        <div class="mt-2">@TypeMapping.FormatWeight(1250.50m)</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="medium-stock p-3 rounded">
                        <span class="stock-indicator stock-medium"></span>
                        <strong>Ograničeno</strong>
                        <div class="mt-2">@TypeMapping.FormatWeight(450.75m)</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="low-stock p-3 rounded">
                        <span class="stock-indicator stock-low"></span>
                        <strong>Ispod minimuma</strong>
                        <div class="mt-2">@TypeMapping.FormatWeight(89.20m)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Typography -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-fonts me-2"></i>Tipografija (Inter Font)</h5>
        </div>
        <div class="card-body">
            <h1>Naslov 1 - Inter Bold</h1>
            <h2>Naslov 2 - Inter Semi-Bold</h2>
            <h3>Naslov 3 - Inter Semi-Bold</h3>
            <h4>Naslov 4 - Inter Medium</h4>
            <h5>Naslov 5 - Inter Medium</h5>
            <h6>Naslov 6 - Inter Medium</h6>
            <p>Običan tekst - Inter Regular. Ovo je primer kako izgleda normalan paragraf sa novim fontom.</p>
            <p class="text-muted">Sekundarni tekst - Inter Regular sa muted bojom.</p>
            <small class="text-muted">Mali tekst - Inter Regular</small>
        </div>
    </div>

    <!-- Color Palette -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-palette-fill me-2"></i>Kompletna Paleta Boja</h5>
        </div>
        <div class="card-body">
            <h6 class="mb-3">Pozadinske boje:</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div style="background: var(--bg-primary); height: 80px; border-radius: 8px; border: 1px solid var(--border-color)"></div>
                    <small class="text-muted d-block mt-2">--bg-primary</small>
                    <small class="text-muted">#0f1729</small>
                </div>
                <div class="col-md-3">
                    <div style="background: var(--bg-secondary); height: 80px; border-radius: 8px; border: 1px solid var(--border-color)"></div>
                    <small class="text-muted d-block mt-2">--bg-secondary</small>
                    <small class="text-muted">#1a2332</small>
                </div>
                <div class="col-md-3">
                    <div style="background: var(--bg-tertiary); height: 80px; border-radius: 8px; border: 1px solid var(--border-color)"></div>
                    <small class="text-muted d-block mt-2">--bg-tertiary</small>
                    <small class="text-muted">#232d3f</small>
                </div>
                <div class="col-md-3">
                    <div style="background: var(--bg-hover); height: 80px; border-radius: 8px; border: 1px solid var(--border-color)"></div>
                    <small class="text-muted d-block mt-2">--bg-hover</small>
                    <small class="text-muted">#2a3441</small>
                </div>
            </div>

            <h6 class="mb-3">Akcent boje:</h6>
            <div class="row g-3">
                <div class="col-md-2">
                    <div style="background: var(--accent-blue); height: 60px; border-radius: 8px;"></div>
                    <small class="text-muted d-block mt-2">Plava</small>
                </div>
                <div class="col-md-2">
                    <div style="background: var(--accent-green); height: 60px; border-radius: 8px;"></div>
                    <small class="text-muted d-block mt-2">Zelena</small>
                </div>
                <div class="col-md-2">
                    <div style="background: var(--accent-red); height: 60px; border-radius: 8px;"></div>
                    <small class="text-muted d-block mt-2">Crvena</small>
                </div>
                <div class="col-md-2">
                    <div style="background: var(--accent-orange); height: 60px; border-radius: 8px;"></div>
                    <small class="text-muted d-block mt-2">Narandžasta</small>
                </div>
                <div class="col-md-2">
                    <div style="background: var(--accent-purple); height: 60px; border-radius: 8px;"></div>
                    <small class="text-muted d-block mt-2">Ljubičasta</small>
                </div>
                <div class="col-md-2">
                    <div style="background: var(--accent-teal); height: 60px; border-radius: 8px;"></div>
                    <small class="text-muted d-block mt-2">Tirkiz</small>
                </div>
            </div>
        </div>
    </div>

</div>

@code {
    // Ova stranica je pure prezentacijska - nema posebne logike
}
