@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Models
@inject IAuthService AuthService
@inject NavigationManager Navigation

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Učitavanje...</span>
        </div>
        <p class="text-muted mt-2">Provera pristupa...</p>
    </div>
}
else if (imaPristup)
{
    @ChildContent
}
else
{
    <!-- Redirekcija na Zabranjen Pristup stranicu -->
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? RequiredUrl { get; set; }

    private bool isLoading = true;
    private bool imaPristup = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Proveri da li je korisnik ulogovan
            var isAuthenticated = await AuthService.IsAuthenticated();

            if (!isAuthenticated)
            {
                // Redirect na login
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }

            // Proveri pristup stranici
            var url = RequiredUrl ?? Navigation.ToBaseRelativePath(Navigation.Uri);
            imaPristup = await AuthService.ImaPristupStranici(url);

            if (!imaPristup)
            {
                // Redirect na Zabranjen Pristup
                Navigation.NavigateTo("/home-ograniceni", forceLoad: true);
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"AuthGuard greška: {ex.Message}");
            imaPristup = false;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
