@using FruitSysWeb.Models
@using FruitSysWeb.Services.Core
@inject ITypeMappingService TypeMapping

@if (Stavke?.Any() == true)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header @HeaderBgClass">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi @IkonaClass"></i> @Naslov
                </h5>
                @if (OdDatum.HasValue && DoDatum.HasValue)
                {
                    <span class="badge bg-dark">
                        <i class="bi bi-calendar3"></i>
                        @TypeMapping.FormatDate(OdDatum.Value) - @TypeMapping.FormatDate(DoDatum.Value)
                    </span>
                }
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 40%;">@TipPartnera</th>
                            <th class="text-end" style="width: 20%;">Vrednost Robe (RSD)</th>
                            <th class="text-end" style="width: 20%;">@IsplataLabel (RSD)</th>
                            <th class="text-end" style="width: 20%;">Stanje (RSD)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Stavke)
                        {
                            <tr>
                                <td><strong>@item.Naziv</strong></td>
                                <td class="text-end">
                                    @TypeMapping.FormatDecimal(item.VrednostRobe)
                                </td>
                                <td class="text-end">
                                    @TypeMapping.FormatDecimal(item.Isplata)
                                </td>
                                <td class="text-end">
                                    <span class="badge @item.StanjeBadgeClass">
                                        @TypeMapping.FormatDecimal(item.Stanje)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-secondary fw-bold">
                        <tr>
                            <td>SALDO:</td>
                            <td class="text-end">
                                @TypeMapping.FormatDecimal(Stavke.Sum(x => x.VrednostRobe))
                            </td>
                            <td class="text-end">
                                @TypeMapping.FormatDecimal(Stavke.Sum(x => x.Isplata))
                            </td>
                            <td class="text-end">
                                <span class="badge @GetSaldoBadgeClass()">
                                    @TypeMapping.FormatDecimal(Stavke.Sum(x => x.Stanje))
                                </span>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public List<BrziPregledStavka>? Stavke { get; set; }
    [Parameter] public string Naslov { get; set; } = "Brzi Pregled";
    [Parameter] public string TipPartnera { get; set; } = "Partner";
    [Parameter] public string IsplataLabel { get; set; } = "Isplata";
    [Parameter] public string HeaderBgClass { get; set; } = "bg-primary text-white";
    [Parameter] public string IkonaClass { get; set; } = "bi-speedometer2";
    [Parameter] public DateTime? OdDatum { get; set; }
    [Parameter] public DateTime? DoDatum { get; set; }

    private string GetSaldoBadgeClass()
    {
        var ukupnoStanje = Stavke?.Sum(x => x.Stanje) ?? 0;
        return ukupnoStanje < 0 ? "bg-danger" : 
               ukupnoStanje > 0 ? "bg-success" : 
               "bg-secondary";
    }
}
