@using FruitSysWeb.Services.Interfaces
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IConfiguration Config
@implements IAsyncDisposable

@code {
    // Korisnici koji se NE izloguju automatski — appsettings: Auth:InactivityExemptUsers
    private HashSet<string> Izuzeti => new(
        Config.GetSection("Auth:InactivityExemptUsers").Get<string[]>() ?? Array.Empty<string>(),
        StringComparer.OrdinalIgnoreCase);

    private const int TimeoutMinuta = 30;

    private DotNetObjectReference<InactivityHandler>? _ref;
    private bool _inicijalizovan = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _inicijalizovan)
            return;

        _inicijalizovan = true;

        try
        {
            var korisnik = await AuthService.GetCurrentUser();
            if (korisnik == null)
                return;

            // Izuzeti korisnici — ne postavljamo timer
            if (Izuzeti.Contains(korisnik.Ime))
                return;

            _ref = DotNetObjectReference.Create(this);

            var timeoutMs = TimeoutMinuta * 60 * 1000;
            var js = @"
(function(dotnet, timeoutMs) {
    if (window._inactivityTimerId) {
        clearTimeout(window._inactivityTimerId);
        window._inactivityTimerId = null;
    }
    if (window._inactivityListener) {
        ['mousemove','keydown','click','scroll','touchstart'].forEach(function(e) {
            document.removeEventListener(e, window._inactivityListener, true);
        });
        window._inactivityListener = null;
    }

    function resetTimer() {
        if (window._inactivityTimerId) clearTimeout(window._inactivityTimerId);
        window._inactivityTimerId = setTimeout(function() {
            dotnet.invokeMethodAsync('OnNeaktivnost');
        }, timeoutMs);
    }

    window._inactivityListener = resetTimer;
    ['mousemove','keydown','click','scroll','touchstart'].forEach(function(e) {
        document.addEventListener(e, window._inactivityListener, true);
    });

    resetTimer();
})(arguments[0], arguments[1]);
";
            await JS.InvokeVoidAsync("eval", js, _ref, timeoutMs);
        }
        catch (Exception ex)
        {
            Console.WriteLine("InactivityHandler greška pri inicijalizaciji: " + ex.Message);
        }
    }

    [JSInvokable]
    public async Task OnNeaktivnost()
    {
        try
        {
            var korisnik = await AuthService.GetCurrentUser();
            if (korisnik == null || Izuzeti.Contains(korisnik.Ime))
                return;

            await AuthService.Logout();
            Navigation.NavigateTo("/login?razlog=neaktivnost", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine("InactivityHandler greška pri auto-logout: " + ex.Message);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            var js = @"
(function() {
    if (window._inactivityTimerId) {
        clearTimeout(window._inactivityTimerId);
        window._inactivityTimerId = null;
    }
    if (window._inactivityListener) {
        ['mousemove','keydown','click','scroll','touchstart'].forEach(function(e) {
            document.removeEventListener(e, window._inactivityListener, true);
        });
        window._inactivityListener = null;
    }
})();
";
            await JS.InvokeVoidAsync("eval", js);
        }
        catch { /* ignorisati — browser možda već zatvoren */ }

        _ref?.Dispose();
    }
}
