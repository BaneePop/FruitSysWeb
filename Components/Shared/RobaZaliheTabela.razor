@using FruitSysWeb.Models
@using FruitSysWeb.Services.Core
@inject ITypeMappingService TypeMapping

<div class="card shadow mb-4">
    <div class="card-header @HeaderBgClass">
        <h5 class="mb-0">
            <i class="bi @IkonaClass"></i> @Naslov
            <span class="badge bg-light text-dark ms-2">
                @TypeMapping.FormatDate(OdDatum) - @TypeMapping.FormatDate(DoDatum)
            </span>
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="table-dark">
                    <tr class="text-center">
                        <th class="text-start" style="width: 20%;">Vrsta Proizvoda</th>
                        <th style="width: 12%;">Nabavka (kg)</th>
                        <th style="width: 14%;">Nabavna Vrednost (RSD)</th>
                        <th style="width: 12%;">Prodaja (kg)</th>
                        <th style="width: 14%;">Prodaja Vrednost (RSD)</th>
                        <th style="width: 12%;">Lager (kg)</th>
                        <th style="width: 14%;">Lager Vrednost (RSD)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Stavke?.Any() == true)
                    {
                        @foreach (var stavka in Stavke)
                        {
                            <tr>
                                <td class="fw-bold">@stavka.VrstaProizvoda</td>
                                <td class="text-end">@TypeMapping.FormatDecimal(stavka.NabavkaKg)</td>
                                <td class="text-end">@TypeMapping.FormatDecimal(stavka.NabavnaVrednost)</td>
                                <td class="text-end">@TypeMapping.FormatDecimal(stavka.ProdajaKg)</td>
                                <td class="text-end">@TypeMapping.FormatDecimal(stavka.ProdajaVrednost)</td>
                                <td class="text-end">@TypeMapping.FormatDecimal(stavka.LagerKg)</td>
                                <td class="text-end">@TypeMapping.FormatDecimal(stavka.LagerVrednost)</td>
                            </tr>
                        }
                        
                        <!-- SALDO RED -->
                        <tr class="table-primary fw-bold">
                            <td>SALDO:</td>
                            <td class="text-end">@TypeMapping.FormatDecimal(UkupnoNabavkaKg)</td>
                            <td class="text-end">@TypeMapping.FormatDecimal(UkupnoNabavnaVrednost)</td>
                            <td class="text-end">@TypeMapping.FormatDecimal(UkupnoProdajaKg)</td>
                            <td class="text-end">@TypeMapping.FormatDecimal(UkupnoProdajaVrednost)</td>
                            <td class="text-end">@TypeMapping.FormatDecimal(UkupnoLagerKg)</td>
                            <td class="text-end">@TypeMapping.FormatDecimal(UkupnoLagerVrednost)</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-inbox"></i> Nema podataka za prikaz
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public List<RobaZaliheStavka>? Stavke { get; set; }
    
    [Parameter]
    public string Naslov { get; set; } = "Roba na zalihama";
    
    [Parameter]
    public string HeaderBgClass { get; set; } = "bg-info text-white";
    
    [Parameter]
    public string IkonaClass { get; set; } = "bi-box-seam";
    
    [Parameter]
    public DateTime OdDatum { get; set; } = new DateTime(2025, 6, 1);
    
    [Parameter]
    public DateTime DoDatum { get; set; } = DateTime.Now;
    
    // Ukupni zbir za saldo red
    private decimal UkupnoNabavkaKg => Stavke?.Sum(x => x.NabavkaKg) ?? 0;
    private decimal UkupnoNabavnaVrednost => Stavke?.Sum(x => x.NabavnaVrednost) ?? 0;
    private decimal UkupnoProdajaKg => Stavke?.Sum(x => x.ProdajaKg) ?? 0;
    private decimal UkupnoProdajaVrednost => Stavke?.Sum(x => x.ProdajaVrednost) ?? 0;
    private decimal UkupnoLagerKg => Stavke?.Sum(x => x.LagerKg) ?? 0;
    private decimal UkupnoLagerVrednost => Stavke?.Sum(x => x.LagerVrednost) ?? 0;
}
