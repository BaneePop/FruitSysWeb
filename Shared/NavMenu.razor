@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components
@using FruitSysWeb.Models
@using FruitSysWeb.Services.Interfaces

@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="app-sidebar-overlay" onclick="odettaSidebar.toggle()"></div>

<aside class="app-sidebar">
    <div class="app-sidebar-brand">
        <div class="app-sidebar-logo"><i class="bi bi-sun-fill" aria-hidden="true"></i></div>
        <div class="app-sidebar-brandtxt">
            <strong>Odetta Solar</strong>
            <span>Elektrana</span>
        </div>
    </div>

    <nav class="app-sidebar-nav">
        <NavLink class="app-navlink" href="solar-hala">
            <span class="app-navlink-icon"><i class="bi bi-display" aria-hidden="true"></i></span>
            <span class="app-navlink-label">Proizvodnja uživo</span>
        </NavLink>
        <NavLink class="app-navlink" href="solar-pregled">
            <span class="app-navlink-icon"><i class="bi bi-list-check" aria-hidden="true"></i></span>
            <span class="app-navlink-label">Dostupni podaci</span>
        </NavLink>
    </nav>

    <div class="app-sidebar-foot">
        @if (currentUser != null)
        {
            <div class="app-sidebar-user">
                <span class="app-sidebar-user-name"><i class="bi bi-person-circle me-1" aria-hidden="true"></i>@currentUser.Ime</span>
                <button type="button" class="app-sidebar-logout" @onclick="HandleLogout" title="Odjava" aria-label="Odjava">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
        }
    </div>
</aside>

@code {
    private KorisnikModel? currentUser;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = await AuthService.GetCurrentUser();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška pri učitavanju korisnika: {ex.Message}");
        }
    }

    private async Task HandleLogout()
    {
        try
        {
            await AuthService.Logout();
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška pri odjavi: {ex.Message}");
        }
    }
}
