@code {
    private bool collapseNavMenu = true;
    private KorisnikModel? currentUser;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = await AuthService.GetCurrentUser();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška pri učitavanju korisnika: {ex.Message}");
        }
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task HandleLogout()
    {
        try
        {
            await AuthService.Logout();
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška pri odjavi: {ex.Message}");
        }
    }

    // Helper metoda za proveru pristupa
    private bool ImaPristup(string url)
    {
        if (currentUser == null) return false;
        return currentUser.ImaPristupStranici(url);
    }

    // Provera da li korisnik ima puni pristup
    private bool ImaPuniPristup()
    {
        return currentUser?.ImaPuniPristup() ?? false;
    }

    // Provera da li korisnik ima ograničeni pristup
    private bool ImaOgraniceniPristup()
    {
        return currentUser?.ImaOgraniceniPristup() ?? false;
    }
}
