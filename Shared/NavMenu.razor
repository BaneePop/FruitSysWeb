@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components
@using FruitSysWeb.Models
@using FruitSysWeb.Services.Interfaces

@inject IAuthService AuthService
@inject NavigationManager Navigation

<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-3" aria-label="Glavna navigacija">
    <div class="container-fluid">
        <a class="navbar-brand" href="/solar-hala" aria-label="Odetta Solar početna stranica">
            <i class="bi bi-sun me-2" aria-hidden="true"></i>Odetta Solar
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigacija">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <NavLink class="nav-link" href="solar-hala">
                        <i class="bi bi-display me-1" aria-hidden="true"></i>Proizvodnja uživo
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="solar-pregled">
                        <i class="bi bi-list-check me-1" aria-hidden="true"></i>Dostupni podaci
                    </NavLink>
                </li>
            </ul>

            <ul class="navbar-nav">
                @if (currentUser != null)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-label="Korisnički meni">
                            <i class="bi bi-person-circle me-1" aria-hidden="true"></i>@currentUser.Ime
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <button class="dropdown-item" type="button" @onclick="HandleLogout">
                                    <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Odjava
                                </button>
                            </li>
                        </ul>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

@code {
    private KorisnikModel? currentUser;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = await AuthService.GetCurrentUser();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška pri učitavanju korisnika: {ex.Message}");
        }
    }

    private async Task HandleLogout()
    {
        try
        {
            await AuthService.Logout();
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Greška pri odjavi: {ex.Message}");
        }
    }
}
