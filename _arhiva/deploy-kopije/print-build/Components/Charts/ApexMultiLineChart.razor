@rendermode @(new InteractiveServerRenderMode())
@using Microsoft.AspNetCore.Components.Web
@using ApexCharts
@using FruitSysWeb.Components.Charts

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">
            <i class="@Icon"></i>
            @Title
        </h6>
        @if (ShowRefreshButton)
        {
            <button class="btn btn-sm btn-outline-primary" @onclick="RefreshChart" disabled="@IsLoading">
                <i class="bi bi-arrow-clockwise @(IsLoading ? "spin" : "")"></i>
            </button>
        }
    </div>
    <div class="card-body">
        @if (IsLoading)
        {
            <div class="text-center p-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2 text-muted">Učitavam podatke...</p>
            </div>
        }
        else if (HasError)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle"></i>
                Greška pri učitavanju podataka.
                <button class="btn btn-sm btn-outline-danger ms-2" @onclick="RefreshChart">
                    Pokušaj ponovo
                </button>
            </div>
        }
        else if ((Series1Data == null || !Series1Data.Any()) && (Series2Data == null || !Series2Data.Any()))
        {
            <div class="text-center p-4 text-muted">
                <i class="bi bi-graph-up" style="font-size: 2rem;"></i>
                <p class="mt-2">Nema podataka za prikaz</p>
            </div>
        }
        else
        {
            <ApexChart TItem="ChartDataPoint"
                       @key="@($"multi-line-chart-{Title}-{Series1Data?.Count ?? 0}")"
                       Title="@ChartTitle"
                       Height="@Height"
                       Options="@ChartOptions">
                <ApexPointSeries TItem="ChartDataPoint"
                                 Items="@Series1Data"
                                 Name="@Series1Name"
                                 SeriesType="SeriesType.Line"
                                 XValue="@(e => e.Label)"
                                 YValue="@(e => e.Value)"
                                 OrderBy="e => e.X" />
                <ApexPointSeries TItem="ChartDataPoint"
                                 Items="@Series2Data"
                                 Name="@Series2Name"
                                 SeriesType="SeriesType.Line"
                                 XValue="@(e => e.Label)"
                                 YValue="@(e => e.Value)"
                                 OrderBy="e => e.X" />
            </ApexChart>

            @if (ShowSummary && ((Series1Data != null && Series1Data.Any()) || (Series2Data != null && Series2Data.Any())))
            {
                <div class="mt-3 pt-3 border-top">
                    <div class="row">
                        @if (Series1Data != null && Series1Data.Any())
                        {
                            <div class="col-md-6">
                                <small class="text-muted">
                                    <strong>@Series1Name:</strong>
                                    Ukupno: @Series1Data.Sum(x => x.Value).ToString("N0") @Unit1
                                    | Prosek: @Series1Data.Average(x => x.Value).ToString("N0") @Unit1
                                </small>
                            </div>
                        }
                        @if (Series2Data != null && Series2Data.Any())
                        {
                            <div class="col-md-6">
                                <small class="text-muted">
                                    <strong>@Series2Name:</strong>
                                    Ukupno: @Series2Data.Sum(x => x.Value).ToString("N0") @Unit2
                                    | Prosek: @Series2Data.Average(x => x.Value).ToString("N0") @Unit2
                                </small>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Multi-Line Chart";
    [Parameter] public string ChartTitle { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "bi bi-graph-up";
    [Parameter] public string Series1Name { get; set; } = "Serija 1";
    [Parameter] public string Series2Name { get; set; } = "Serija 2";
    [Parameter] public string Unit1 { get; set; } = "";
    [Parameter] public string Unit2 { get; set; } = "";
    [Parameter] public int Height { get; set; } = 350;
    [Parameter] public bool ShowRefreshButton { get; set; } = true;
    [Parameter] public bool ShowSummary { get; set; } = true;
    [Parameter] public bool IsLoading { get; set; } = false;
    [Parameter] public bool HasError { get; set; } = false;
    [Parameter] public List<ChartDataPoint>? Series1Data { get; set; }
    [Parameter] public List<ChartDataPoint>? Series2Data { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }

    private ApexChartOptions<ChartDataPoint> ChartOptions => new()
    {
        Chart = new Chart
        {
            Type = ChartType.Line,
            Height = Height,
            Toolbar = new Toolbar { Show = false },
            Selection = new Selection { Enabled = false },
            Zoom = new Zoom { Enabled = true }
        },
        Colors = new List<string> { "#28a745", "#dc3545" }, // Zelena za prvu, crvena za drugu
        Stroke = new Stroke
        {
            Curve = Curve.Smooth,
            Width = new List<double> { 3, 3 }
        },
        DataLabels = new DataLabels
        {
            Enabled = false
        },
        Markers = new Markers
        {
            Size = new List<double> { 4, 4 }
        },
        Xaxis = new XAxis
        {
            Categories = Series1Data?.Select(x => x.Label).ToList() ?? new List<string>(),
            Labels = new XAxisLabels
            {
                Rotate = -45,
                RotateAlways = false,
                MaxHeight = 100,
                Trim = true,
                Style = new AxisLabelStyle
                {
                    FontSize = "10px"
                }
            }
        },
        Yaxis = new List<YAxis>
        {
            new YAxis
            {
                Title = new AxisTitle { Text = $"{Series1Name} ({Unit1})" },
                Labels = new YAxisLabels
                {
                    Formatter = $"function(val) {{ return Math.round(val).toLocaleString() + ' {Unit1}' }}"
                }
            },
            new YAxis
            {
                Opposite = true,
                Title = new AxisTitle { Text = $"{Series2Name} ({Unit2})" },
                Labels = new YAxisLabels
                {
                    Formatter = $"function(val) {{ return Math.round(val).toLocaleString() + ' {Unit2}' }}"
                }
            }
        },
        Tooltip = new Tooltip
        {
            Shared = true,
            Intersect = false,
            Y = new TooltipY
            {
                Formatter = "function(val, opts) { return Math.round(val).toLocaleString() }"
            }
        },
        Legend = new Legend
        {
            Show = true,
            Position = LegendPosition.Top,
            HorizontalAlign = Align.Center
        }
    };

    private async Task RefreshChart()
    {
        if (OnRefresh.HasDelegate)
        {
            await OnRefresh.InvokeAsync();
        }
    }
}
