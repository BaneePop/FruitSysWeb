@page "/cena-kostanja"
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Models.Requests
@using FruitSysWeb.Models
@inject IPreradaService PreradaService
@inject IKomitentService KomitentService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject ILogger<CenaKostanjaPoNalogu> Logger

<!-- Header -->
<div class="bg-dark text-white py-3 mb-4">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-md-7">
                <h1 class="h3 mb-0">
                    <i class="bi bi-coin me-2"></i>Cena Koštanja
                </h1>
                <small class="text-muted">Analiza ukupne cene koštanja po radnom nalogu razložena na: direktan rad, režija, materijal i ambalaža</small>
            </div>
            <div class="col-md-5 text-end">
                @if (podaci != null)
                {
                    <span class="badge bg-secondary fs-6 me-1">
                        <i class="bi bi-list-ol me-1"></i>@podaci.Count naloga
                    </span>
                    @if (podaci.Any())
                    {
                        <span class="badge bg-primary fs-6">
                            Prosek: @ProsecnaCenaPoKg RSD/kg
                        </span>
                    }
                }
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">

    <!-- Filter -->
    <div class="card border-primary mb-4">
        <div class="card-header bg-primary text-white">
            <h6 class="mb-0"><i class="bi bi-funnel me-2"></i>Filteri</h6>
        </div>
        <div class="card-body">
            <div class="row align-items-end">
                <div class="col-md-2 mb-2">
                    <label class="form-label fw-bold">Od datuma:</label>
                    <input type="date" class="form-control" value="@OdDatumValue" @onchange="OnOdDatumChanged" />
                </div>
                <div class="col-md-2 mb-2">
                    <label class="form-label fw-bold">Do datuma:</label>
                    <input type="date" class="form-control" value="@DoDatumValue" @onchange="OnDoDatumChanged" />
                </div>
                <div class="col-md-3 mb-2">
                    <label class="form-label fw-bold">Komitent:</label>
                    <select class="form-select" @bind="filterRequest.KomitentId">
                        <option value="">— Svi komitenti —</option>
                        @foreach (var k in komitentiLista)
                        {
                            <option value="@k.Id">@k.Naziv</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 mb-2">
                    <label class="form-label fw-bold">Radni nalog:</label>
                    <select class="form-select" @bind="filterRequest.RadniNalog">
                        <option value="">— Svi radni nalozi —</option>
                        @foreach (var nalog in radniNaloziLista)
                        {
                            <option value="@nalog">@nalog</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 mb-2">
                    <button class="btn btn-primary w-100" @onclick="Ucitaj" disabled="@ucitava">
                        @if (ucitava)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        else
                        {
                            <i class="bi bi-search me-1"></i>
                        }
                        Pretraži
                    </button>
                </div>
            </div>
        </div>
    </div>


    <!-- Sadržaj -->
    @if (ucitava)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Učitavanje podataka...</p>
        </div>
    }
    else if (podaci == null)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>Kliknite <strong>Pretraži</strong> da učitate podatke.
        </div>
    }
    else if (!podaci.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>Nema radnih naloga sa evidentiranom gotovom robom u izabranom periodu.
        </div>
    }
    else
    {
        <!-- Summary kartice -->
        <div class="row mb-4">
            <div class="col-md-2 mb-2">
                <div class="card border-primary text-center">
                    <div class="card-body py-2">
                        <div class="text-primary fw-bold fs-5">@FormatBroj(podaci.Sum(x => x.TrosakDirektanRad))</div>
                        <small class="text-muted">Direktan rad ukupno (RSD)</small>
                        <div class="small text-primary">@FormatBroj(podaci.Where(x => x.KolicinaGotovog > 0).Sum(x => x.TrosakDirektanRad) / Math.Max(podaci.Sum(x => x.KolicinaGotovog), 1)) RSD/kg</div>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-2">
                <div class="card border-warning text-center">
                    <div class="card-body py-2">
                        <div class="text-warning fw-bold fs-5">@FormatBroj(podaci.Sum(x => x.TrosakRezija))</div>
                        <small class="text-muted">Režija ukupno (RSD)</small>
                        <div class="small text-warning">@FormatBroj(podaci.Sum(x => x.TrosakRezija) / Math.Max(podaci.Sum(x => x.KolicinaGotovog), 1)) RSD/kg</div>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-2">
                <div class="card border-success text-center">
                    <div class="card-body py-2">
                        <div class="text-success fw-bold fs-5">@FormatBroj(podaci.Sum(x => x.TrosakMaterijal))</div>
                        <small class="text-muted">Materijal ukupno (RSD)</small>
                        <div class="small text-success">@FormatBroj(podaci.Sum(x => x.TrosakMaterijal) / Math.Max(podaci.Sum(x => x.KolicinaGotovog), 1)) RSD/kg</div>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-2">
                <div class="card border-info text-center">
                    <div class="card-body py-2">
                        <div class="text-info fw-bold fs-5">@FormatBroj(podaci.Sum(x => x.TrosakAmbalazaPrimarna))</div>
                        <small class="text-muted">Amb. primarna ukupno (RSD)</small>
                        <div class="small text-info">@FormatBroj(podaci.Sum(x => x.TrosakAmbalazaPrimarna) / Math.Max(podaci.Sum(x => x.KolicinaGotovog), 1)) RSD/kg</div>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-2">
                <div class="card border-secondary text-center">
                    <div class="card-body py-2">
                        <div class="text-secondary fw-bold fs-5">@FormatBroj(podaci.Sum(x => x.TrosakAmbalazaSekundarna))</div>
                        <small class="text-muted">Amb. sekundarna ukupno (RSD)</small>
                        <div class="small text-secondary">@FormatBroj(podaci.Sum(x => x.TrosakAmbalazaSekundarna) / Math.Max(podaci.Sum(x => x.KolicinaGotovog), 1)) RSD/kg</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabela -->
        <div class="table-responsive">
            <table class="table table-sm align-middle" style="font-size: 0.875rem;">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Radni nalog</th>
                        <th>Artikal / Pakovanje</th>
                        <th>Komitent</th>
                        <th class="text-end">Kolicina<br/><small class="text-muted fw-normal">kg / kom</small></th>
                        <th class="text-end text-primary">Dir. rad<br/><small class="text-muted fw-normal">RSD/kg</small></th>
                        <th class="text-end text-warning">Rezija<br/><small class="text-muted fw-normal">RSD/kg</small></th>
                        <th class="text-end text-success">Materijal<br/><small class="text-muted fw-normal">RSD/kg</small></th>
                        <th class="text-end text-info">Amb. primarna<br/><small class="text-muted fw-normal">RSD/kg</small></th>
                        <th class="text-end text-secondary">Amb. sekundarna<br/><small class="text-muted fw-normal">RSD/kg</small></th>
                        <th class="text-end fw-bold">Bez sirovine<br/><small class="text-muted fw-normal">RSD/kg</small></th>
                        <th class="text-end fw-bold">Sa sirovinom<br/><small class="text-muted fw-normal">RSD/kg</small></th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rbr = 0; }
                    @foreach (var red in podaci)
                    {
                        rbr++;
                        var redId = $"red-{red.RadniNalogID}";
                        <tr @onclick="() => ToggleDetalji(red.RadniNalogID)" style="cursor:pointer;"
                            class="@(aktivniDetalj == red.RadniNalogID ? "table-active" : "")">
                            <td class="text-muted">@rbr</td>
                            <td>
                                <span class="fw-semibold text-primary">@red.RadniNalog</span>
                                @if (!string.IsNullOrEmpty(red.LotNaloga))
                                {
                                    <br /><small class="text-muted">LOT: @red.LotNaloga</small>
                                }
                            </td>
                            <td>
                                <span class="fw-semibold">@red.Artikal</span>
                                @if (!string.IsNullOrEmpty(red.Pakovanje))
                                {
                                    <br /><small class="text-muted">@red.Pakovanje</small>
                                }
                            </td>
                            <td><small>@red.Komitent</small></td>
                            <td class="text-end">
                                <span class="fw-semibold">@red.KolicinaFormatted</span>
                                <br /><small class="text-muted">@red.BrojPakovanjaFormatted</small>
                            </td>
                            <td class="text-end text-primary small">@red.CenaDirektanRadPoKgFormatted</td>
                            <td class="text-end text-warning small">@red.CenaRezijaPoKgFormatted</td>
                            <td class="text-end text-success small">@red.CenaMaterijalPoKgFormatted</td>
                            <td class="text-end text-info small">@red.CenaAmbalazaPrimarnaPoKgFormatted</td>
                            <td class="text-end text-secondary small">@red.CenaAmbalazaSekundarnaPoKgFormatted</td>
                            <td class="text-end fw-bold">
                                @red.CenaBezSirovinePoKgFormatted
                            </td>
                            <td class="text-end fw-bold text-primary">
                                @red.UkupnaCenaPoKgFormatted
                            </td>
                        </tr>
                        @if (aktivniDetalj == red.RadniNalogID)
                        {
                            <tr class="table-light">
                                <td colspan="12" class="px-4 py-3">
                                    <div class="row">
                                        <!-- Udelna struktura -->
                                        <div class="col-md-5">
                                            <h6 class="mb-2 fw-bold">Struktura troška</h6>
                                            <div class="mb-1">
                                                <div class="d-flex justify-content-between small">
                                                    <span class="text-primary">Direktan rad</span>
                                                    <span>@red.TrosakDirektanRadFormatted RSD (@red.UdelDirektanRad.ToString("N1") %)</span>
                                                </div>
                                                <div class="progress" style="height:8px;">
                                                    <div class="progress-bar bg-primary" style="width:@(red.UdelDirektanRad)%"></div>
                                                </div>
                                            </div>
                                            <div class="mb-1">
                                                <div class="d-flex justify-content-between small">
                                                    <span class="text-warning">Režija</span>
                                                    <span>@red.TrosakRezijaFormatted RSD (@red.UdelRezija.ToString("N1") %)</span>
                                                </div>
                                                <div class="progress" style="height:8px;">
                                                    <div class="progress-bar bg-warning" style="width:@(red.UdelRezija)%"></div>
                                                </div>
                                            </div>
                                            <div class="mb-1">
                                                <div class="d-flex justify-content-between small">
                                                    <span class="text-success">Materijal (sirovina)</span>
                                                    <span>@red.TrosakMaterijalFormatted RSD (@red.UdelMaterijal.ToString("N1") %)</span>
                                                </div>
                                                <div class="progress" style="height:8px;">
                                                    <div class="progress-bar bg-success" style="width:@(red.UdelMaterijal)%"></div>
                                                </div>
                                            </div>
                                            <div class="mb-1">
                                                <div class="d-flex justify-content-between small">
                                                    <span class="text-info">Amb. primarna</span>
                                                    <span>@red.TrosakAmbalazaPrimarnaFormatted RSD (@red.UdelAmbalazaPrimarna.ToString("N1") %)</span>
                                                </div>
                                                <div class="progress" style="height:8px;">
                                                    <div class="progress-bar bg-info" style="width:@(red.UdelAmbalazaPrimarna)%"></div>
                                                </div>
                                            </div>
                                            <div class="mb-2">
                                                <div class="d-flex justify-content-between small">
                                                    <span class="text-secondary">Amb. sekundarna</span>
                                                    <span>@red.TrosakAmbalazaSekundarnaFormatted RSD (@red.UdelAmbalazaSekundarna.ToString("N1") %)</span>
                                                </div>
                                                <div class="progress" style="height:8px;">
                                                    <div class="progress-bar bg-secondary" style="width:@(red.UdelAmbalazaSekundarna)%"></div>
                                                </div>
                                            </div>
                                            <div class="border-top pt-1">
                                                <div class="d-flex justify-content-between fw-bold">
                                                    <span>Ukupno</span>
                                                    <span>@red.UkupanTrosakFormatted RSD</span>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Cena po kg -->
                                        <div class="col-md-4 border-start">
                                            <h6 class="mb-2 fw-bold ms-3">Cena po kg</h6>
                                            <table class="table table-sm small ms-2" style="width:auto;">
                                                <tbody>
                                                    <tr>
                                                        <td class="text-primary">Direktan rad</td>
                                                        <td class="text-end fw-semibold">@red.CenaDirektanRadPoKgFormatted RSD/kg</td>
                                                    </tr>
                                                    <tr>
                                                        <td class="text-warning">Režija</td>
                                                        <td class="text-end fw-semibold">@red.CenaRezijaPoKgFormatted RSD/kg</td>
                                                    </tr>
                                                    <tr>
                                                        <td class="text-success">Materijal</td>
                                                        <td class="text-end fw-semibold">@red.CenaMaterijalPoKgFormatted RSD/kg</td>
                                                    </tr>
                                                    <tr>
                                                        <td class="text-info">Amb. primarna</td>
                                                        <td class="text-end fw-semibold">@red.CenaAmbalazaPrimarnaPoKgFormatted RSD/kg</td>
                                                    </tr>
                                                    <tr>
                                                        <td class="text-secondary">Amb. sekundarna</td>
                                                        <td class="text-end fw-semibold">@red.CenaAmbalazaSekundarnaPoKgFormatted RSD/kg</td>
                                                    </tr>
                                                                    <tr class="table-warning">
                                                        <td class="fw-bold">Bez sirovine</td>
                                                        <td class="text-end fw-bold">@red.CenaBezSirovinePoKgFormatted RSD/kg</td>
                                                    </tr>
                                                    <tr class="table-dark">
                                                        <td class="fw-bold">Sa sirovinom</td>
                                                        <td class="text-end fw-bold">@red.UkupnaCenaPoKgFormatted RSD/kg</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                        <!-- Info -->
                                        <div class="col-md-3 border-start">
                                            <h6 class="mb-2 fw-bold ms-3">Info</h6>
                                            <div class="ms-3 small">
                                                <div class="mb-1"><i class="bi bi-people me-1 text-muted"></i>Radnici: <strong>@((int)Math.Round(red.BrojRadnihSati / 8))</strong></div>
                                                <div class="mb-1"><i class="bi bi-clock me-1 text-muted"></i>Radnih sati: <strong>@red.BrojRadnihSati.ToString("N1")</strong></div>
                                                <div class="mb-1"><i class="bi bi-box me-1 text-muted"></i>Gotova roba: <strong>@red.KolicinaFormatted</strong></div>
                                                <div class="mb-1"><i class="bi bi-boxes me-1 text-muted"></i>Pakovanja: <strong>@red.BrojPakovanjaFormatted</strong></div>
                                                @if (red.BrojRadnihSati > 0)
                                                {
                                                    <div class="mb-1"><i class="bi bi-speedometer2 me-1 text-muted"></i>
                                                        Produktivnost: <strong>@((red.KolicinaGotovog / red.BrojRadnihSati).ToString("N2")) kg/h</strong>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot class="table-secondary fw-bold">
                    <tr>
                        <td colspan="4" class="fw-bold">Ukupno (@podaci.Count naloga)</td>
                        <td class="text-end">@FormatBroj(podaci.Sum(x => x.KolicinaGotovog)) kg</td>
                        <td class="text-end text-primary small">@FormatBroj(podaci.Sum(x => x.TrosakDirektanRad) / Math.Max(podaci.Sum(x => x.KolicinaGotovog), 1))</td>
                        <td class="text-end text-warning small">@FormatBroj(podaci.Sum(x => x.TrosakRezija) / Math.Max(podaci.Sum(x => x.KolicinaGotovog), 1))</td>
                        <td class="text-end text-success small">@FormatBroj(podaci.Sum(x => x.TrosakMaterijal) / Math.Max(podaci.Sum(x => x.KolicinaGotovog), 1))</td>
                        <td class="text-end text-info small">@FormatBroj(podaci.Sum(x => x.TrosakAmbalazaPrimarna) / Math.Max(podaci.Sum(x => x.KolicinaGotovog), 1))</td>
                        <td class="text-end text-secondary small">@FormatBroj(podaci.Sum(x => x.TrosakAmbalazaSekundarna) / Math.Max(podaci.Sum(x => x.KolicinaGotovog), 1))</td>
                        <td class="text-end">@FormatBroj(podaci.Sum(x => x.TrosakBezSirovine) / Math.Max(podaci.Sum(x => x.KolicinaGotovog), 1))</td>
                        <td class="text-end">@FormatBroj(podaci.Sum(x => x.UkupanTrosak) / Math.Max(podaci.Sum(x => x.KolicinaGotovog), 1))</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }

</div>

@code {
    private List<CenaKostanjaModel>? podaci;
    private List<Komitent> komitentiLista = new();
    private List<string> radniNaloziLista = new();
    private bool ucitava = false;
    private long? aktivniDetalj = null;

    private FilterRequest filterRequest = new FilterRequest
    {
        OdDatum = DateTime.Now.Date.AddDays(-7),
        DoDatum = DateTime.Now.Date
    };

    private string OdDatumValue => filterRequest.OdDatum?.ToString("yyyy-MM-dd") ?? "";
    private string DoDatumValue => filterRequest.DoDatum?.ToString("yyyy-MM-dd") ?? "";

    private string ProsecnaCenaPoKg
    {
        get
        {
            if (podaci == null || !podaci.Any()) return "0,00";
            var ukupnaKg = podaci.Sum(x => x.KolicinaGotovog);
            var ukupanTrosak = podaci.Sum(x => x.UkupanTrosak);
            return ukupnaKg > 0
                ? FormatBroj(ukupanTrosak / ukupnaKg)
                : "0,00";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUser();
        if (user == null || !user.ImaPristupStranici("/cena-kostanja"))
        {
            NavigationManager.NavigateTo("/", true);
            return;
        }

        komitentiLista = await KomitentService.UcitajKomitenteKojiImajuRadneNaloge();
        radniNaloziLista = await PreradaService.UcitajSveRadneNaloge();
    }

    private void OnOdDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
            filterRequest.OdDatum = d;
    }

    private void OnDoDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
            filterRequest.DoDatum = d;
    }

    private async Task Ucitaj()
    {
        ucitava = true;
        aktivniDetalj = null;
        try
        {
            podaci = await PreradaService.UcitajCenuKostanjaPoRadnimNalozima(filterRequest);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška u CenaKostanjaPoNalogu.Ucitaj");
            podaci = new List<CenaKostanjaModel>();
        }
        finally
        {
            ucitava = false;
        }
    }

    private void ToggleDetalji(long radniNalogId)
    {
        aktivniDetalj = aktivniDetalj == radniNalogId ? null : radniNalogId;
    }

    private static string FormatBroj(decimal v) =>
        v.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("sr-Latn-RS"));
}
