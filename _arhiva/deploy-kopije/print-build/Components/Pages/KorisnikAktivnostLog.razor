@page "/korisnik-aktivnost-log"
@using FruitSysWeb.Models
@using FruitSysWeb.Services.Interfaces
@inject IKorisnikAktivnostService AktivnostService
@inject IAuthService AuthService
@inject NavigationManager Navigation

@code {
    private List<KorisnikAktivnostModel>? aktivnosti;
    private List<string> sviKorisnici = new();
    private KorisnikAktivnostFilter filter = new();
    private bool ucitavanje = false;
    private bool pristupDozvoljen = false;

    protected override async Task OnInitializedAsync()
    {
        // Samo administratori mogu videti ovaj izveštaj
        if (!await AuthService.IsAdministrator())
        {
            Navigation.NavigateTo("/");
            return;
        }
        pristupDozvoljen = true;

        filter.DatumOd = DateTime.Today.AddDays(-7);
        filter.DatumDo = DateTime.Today;

        await Task.WhenAll(UcitajKorisnike(), UcitajPodatke());
    }

    private async Task UcitajKorisnike()
    {
        sviKorisnici = await AktivnostService.UcitajSveKorisnike();
    }

    private async Task UcitajPodatke()
    {
        ucitavanje = true;
        StateHasChanged();
        try
        {
            aktivnosti = await AktivnostService.UcitajAktivnosti(filter);
        }
        finally
        {
            ucitavanje = false;
            StateHasChanged();
        }
    }

    private async Task ResetuiFilter()
    {
        filter = new KorisnikAktivnostFilter
        {
            DatumOd = DateTime.Today.AddDays(-7),
            DatumDo = DateTime.Today
        };
        await UcitajPodatke();
    }
}

@if (!pristupDozvoljen)
{
    <div class="alert alert-danger m-4">Nemate pristup ovoj stranici.</div>
    return;
}

<div class="container-fluid">
    <div class="bg-dark text-white py-3 mb-4">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h1 class="h3 mb-0">
                        <i class="bi bi-person-lines-fill me-2"></i>
                        Log Aktivnosti Korisnika
                    </h1>
                    <small class="text-white-50">Pregled prijava, IP adresa i trajanja sesija</small>
                </div>
                <div class="col-md-6 text-end">
                    <span class="badge bg-light text-dark fs-6">
                        <i class="bi bi-list-check me-1"></i>@(aktivnosti?.Count ?? 0) zapisa
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter -->
    <div class="card border-dark mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="bi bi-funnel me-2"></i>Filter</h5>
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-bold">Datum od:</label>
                    <input type="date" class="form-control"
                           value="@filter.DatumOd?.ToString("yyyy-MM-dd")"
                           @onchange="@(e => filter.DatumOd = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateTime.Parse(e.Value.ToString()!))" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Datum do:</label>
                    <input type="date" class="form-control"
                           value="@filter.DatumDo?.ToString("yyyy-MM-dd")"
                           @onchange="@(e => filter.DatumDo = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateTime.Parse(e.Value.ToString()!))" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Korisnik:</label>
                    <select class="form-select" @bind="filter.KorisnikIme">
                        <option value="">-- Svi korisnici --</option>
                        @foreach (var k in sviKorisnici)
                        {
                            <option value="@k">@k</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="d-flex gap-2">
                        <button class="btn btn-dark flex-fill" @onclick="UcitajPodatke" disabled="@ucitavanje">
                            <i class="bi bi-search me-1"></i>Pretraži
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="ResetuiFilter" disabled="@ucitavanje">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela -->
    <div class="card">
        <div class="card-body p-0">
            @if (ucitavanje)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-dark" role="status"></div>
                    <p class="mt-3 text-muted">Učitavanje...</p>
                </div>
            }
            else if (aktivnosti == null || !aktivnosti.Any())
            {
                <div class="alert alert-info m-3">
                    <i class="bi bi-info-circle me-2"></i>Nema podataka za izabrani filter.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Korisnik</th>
                                <th>IP Adresa</th>
                                <th>Vreme logina</th>
                                <th>Vreme logouta</th>
                                <th class="text-end">Trajanje sesije</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int redBroj = 1;}
                            @foreach (var a in aktivnosti)
                            {
                                var aktivan = !a.VremeLogauta.HasValue;
                                <tr>
                                    <td class="text-muted">@(redBroj++)</td>
                                    <td><strong>@a.KorisnikIme</strong></td>
                                    <td><code>@(a.IpAdresa ?? "-")</code></td>
                                    <td>@a.VremeLogina.ToString("dd.MM.yyyy HH:mm:ss")</td>
                                    <td>@(a.VremeLogauta?.ToString("dd.MM.yyyy HH:mm:ss") ?? "-")</td>
                                    <td class="text-end">
                                        <span class="badge @(aktivan ? "bg-success" : "bg-secondary")">
                                            @a.TrajanjePrikaz
                                        </span>
                                    </td>
                                    <td>
                                        @if (aktivan)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i>Aktivan</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark">Odjavljen</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-secondary">
                            <tr>
                                <th colspan="5" class="text-end">Ukupno sesija:</th>
                                <th class="text-end">@aktivnosti.Count</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
