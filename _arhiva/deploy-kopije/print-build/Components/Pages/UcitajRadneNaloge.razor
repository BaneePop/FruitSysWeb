@page "/ucitaj-radne-naloge"
@using FruitSysWeb.Models
@using FruitSysWeb.Services.Interfaces
@using FruitSysWeb.Services.Models.Requests

@inject IKontrolaService KontrolaService
@inject IKomitentService KomitentService
@inject IPreradaService PreradaService
@inject NavigationManager NavigationManager
@inject ILogger<UcitajRadneNaloge> Logger

<PageTitle>Pregled Isporučenih RN</PageTitle>

<div class="container-fluid">

    <!-- HEADER -->
    <div class="row mb-3">
        <div class="col-12">
            <h4 class="mb-0">
                <i class="bi bi-truck me-2"></i>Pregled Isporučenih RN
            </h4>
            <small class="text-muted">Lista zaključenih radnih naloga sa brzim pristupom sledljivosti, kontrolama i troškovima</small>
        </div>
    </div>

    <!-- FILTER BAR -->
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="bi bi-funnel me-2"></i>Filteri</h5>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-2">
                    <label class="form-label"><i class="bi bi-calendar3 me-1"></i>Od datuma</label>
                    <input type="date" class="form-control"
                           value="@(odDatum?.ToString("yyyy-MM-dd"))"
                           @onchange="OnOdDatumChanged" />
                </div>
                <div class="col-md-2">
                    <label class="form-label"><i class="bi bi-calendar3 me-1"></i>Do datuma</label>
                    <input type="date" class="form-control"
                           value="@(doDatum?.ToString("yyyy-MM-dd"))"
                           @onchange="OnDoDatumChanged" />
                </div>
                <div class="col-md-3">
                    <label class="form-label"><i class="bi bi-person me-1"></i>Komitent</label>
                    <select class="form-select" @bind="izabraniKomitentId">
                        <option value="0">Svi komitenti</option>
                        @foreach (var k in komitentiLista)
                        {
                            <option value="@k.Id">@k.Naziv</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label"><i class="bi bi-clipboard-data me-1"></i>Radni nalog</label>
                    <select class="form-select" @bind="izabraniRadniNalog">
                        <option value="">Svi radni nalozi</option>
                        @foreach (var rn in radniNaloziLista)
                        {
                            <option value="@rn">@rn</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button class="btn btn-primary flex-grow-1" @onclick="Pretrazi" disabled="@ucitavaListe">
                        @if (ucitava)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        else
                        {
                            <i class="bi bi-search me-1"></i>
                        }
                        Pretraži
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="ResetFilter" title="Reset">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- TABELA -->
    @if (ucitava)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="mt-2 text-muted">Učitavanje podataka...</div>
        </div>
    }
    else if (pretragaObavljena && nalozi.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>Nema isporučenih radnih naloga za zadati filter.
        </div>
    }
    else if (nalozi.Count > 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-list-ul me-2"></i>Isporučeni radni nalozi
                    <span class="badge bg-secondary ms-2">@nalozi.Count</span>
                </h5>
                <small class="text-muted">Kliknite na red za detalje i akcije</small>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th style="width:30px;"></th>
                                <th>Radni nalog</th>
                                <th>Komitent</th>
                                <th>Artikal</th>
                                <th>Datum Početka</th>
                                <th>Datum Isporuke</th>
                                <th>Broj dana</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var nalog in nalozi)
                            {
                                var jeOtvoren = otvoreniNalozi.Contains(nalog.ID);
                                <tr style="cursor:pointer; background-color:@(jeOtvoren ? "#e8f0fe" : ""); border-bottom: 1px solid #dee2e6;" @onclick="() => ToggleNalog(nalog.ID)">
                                    <td class="text-center">
                                        <i class="bi @(jeOtvoren ? "bi-chevron-down text-primary" : "bi-chevron-right text-muted")"></i>
                                    </td>
                                    <td><span class="badge bg-primary">@nalog.Sifra</span></td>
                                    <td>@nalog.Komitent</td>
                                    <td>@nalog.Artikal</td>
                                    <td>@nalog.DatumPocetkaFormatted</td>
                                    <td>@nalog.DatumIsporukeFormatted</td>
                                    <td>
                                        @if (nalog.BrojDana.HasValue)
                                        {
                                            <span class="badge bg-secondary">@nalog.BrojDana dana</span>
                                        }
                                        else { <span class="text-muted">-</span> }
                                    </td>
                                </tr>
                                @if (jeOtvoren)
                                {
                                    <tr style="background-color:#f8f9fa;">
                                        <td colspan="7" class="px-4 py-3" style="border-bottom: 2px solid #0d6efd;">
                                            <div class="row g-3 align-items-start">
                                                <!-- Detalji -->
                                                <div class="col-md-6">
                                                    <div class="row g-2">
                                                        <div class="col-6 col-md-4">
                                                            <small class="text-muted d-block">Količina</small>
                                                            <strong>@nalog.KolicinaFormatted kg</strong>
                                                        </div>
                                                        <div class="col-6 col-md-4">
                                                            <small class="text-muted d-block">LOT</small>
                                                            @if (!string.IsNullOrEmpty(nalog.LotNaloga))
                                                            {
                                                                <span class="badge bg-info text-dark">@nalog.LotNaloga</span>
                                                            }
                                                            else { <span class="text-muted">-</span> }
                                                        </div>
                                                        <div class="col-6 col-md-4">
                                                            <small class="text-muted d-block">Pakovanje</small>
                                                            <span>@(string.IsNullOrEmpty(nalog.Pakovanje) ? "-" : nalog.Pakovanje)</span>
                                                        </div>
                                                        <div class="col-6 col-md-4">
                                                            <small class="text-muted d-block">Br. pakovanja</small>
                                                            <strong>@nalog.BrojPakovanja</strong>
                                                        </div>
                                                        <div class="col-6 col-md-4">
                                                            <small class="text-muted d-block">Br. evidencija</small>
                                                            <span class="badge bg-secondary">@nalog.BrojEvidencija</span>
                                                        </div>
                                                        <div class="col-6 col-md-4">
                                                            <small class="text-muted d-block">Otpremnica</small>
                                                            @if (!string.IsNullOrEmpty(nalog.OtpremnicaSifra))
                                                            {
                                                                <code class="text-info">@nalog.OtpremnicaSifra</code>
                                                            }
                                                            else { <span class="text-muted">-</span> }
                                                        </div>
                                                    </div>
                                                </div>
                                                <!-- Dugmad 2x2 -->
                                                <div class="col-md-6">
                                                    <div class="row g-2">
                                                        <div class="col-6">
                                                            <button class="btn btn-primary w-100"
                                                                    @onclick:stopPropagation="true"
                                                                    @onclick="() => OtvoriSledljivost(nalog)">
                                                                <i class="bi bi-diagram-3 me-1"></i>Sledljivost RN
                                                            </button>
                                                        </div>
                                                        <div class="col-6">
                                                            <button class="btn btn-warning w-100"
                                                                    @onclick:stopPropagation="true"
                                                                    @onclick="() => OtvoriKontrole(nalog)">
                                                                <i class="bi bi-clipboard2-check me-1"></i>Kontrole RN
                                                            </button>
                                                        </div>
                                                        <div class="col-6">
                                                            <button class="btn btn-success w-100"
                                                                    @onclick:stopPropagation="true"
                                                                    @onclick="() => OtvoriUtrosakSirovine(nalog)">
                                                                <i class="bi bi-box-arrow-in-down me-1"></i>Utrošena Sirovina
                                                            </button>
                                                        </div>
                                                        <div class="col-6">
                                                            <button class="btn btn-info w-100"
                                                                    @onclick:stopPropagation="true"
                                                                    @onclick="() => OtvoriUtrosakRadneSnage(nalog)">
                                                                <i class="bi bi-people me-1"></i>Utrošak Radne Snage RN
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private bool ucitava = false;
    private bool ucitavaListe = true;
    private bool pretragaObavljena = false;

    private DateTime? odDatum = DateTime.Today.AddMonths(-1);
    private DateTime? doDatum = DateTime.Today;
    private long izabraniKomitentId = 0;
    private string izabraniRadniNalog = "";

    private List<Komitent> komitentiLista = new();
    private List<string> radniNaloziLista = new();
    private List<UcitajRadneNalogeModel> nalozi = new();
    private HashSet<long> otvoreniNalozi = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var komitentiTask = KomitentService.UcitajKomitenteKojiImajuRadneNaloge();
            var naloziTask = PreradaService.UcitajSveRadneNaloge();
            await Task.WhenAll(komitentiTask, naloziTask);

            komitentiLista = komitentiTask.Result ?? new();
            radniNaloziLista = naloziTask.Result ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška pri učitavanju lista za filtriranje");
        }
        finally
        {
            ucitavaListe = false;
        }

        await Pretrazi();
    }

    private async Task Pretrazi()
    {
        ucitava = true;
        otvoreniNalozi.Clear();
        pretragaObavljena = false;

        try
        {
            var filter = new FilterRequest { OdDatum = odDatum, DoDatum = doDatum };
            int? komitentId = izabraniKomitentId > 0 ? (int?)izabraniKomitentId : null;
            string? rn = string.IsNullOrEmpty(izabraniRadniNalog) ? null : izabraniRadniNalog;

            nalozi = await KontrolaService.UcitajIsporuceneNaloge(filter, komitentId, rn);
            pretragaObavljena = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Greška u pretrazi isporučenih naloga");
            nalozi = new();
        }
        finally
        {
            ucitava = false;
        }
    }

    private void ToggleNalog(long id)
    {
        if (!otvoreniNalozi.Add(id))
            otvoreniNalozi.Remove(id);
    }

    private void OtvoriSledljivost(UcitajRadneNalogeModel nalog)
    {
        var url = $"/sledljivost?radniNalog={Uri.EscapeDataString(nalog.Sifra)}";
        NavigationManager.NavigateTo(url);
    }

    private void OtvoriKontrole(UcitajRadneNalogeModel nalog)
    {
        var od = FormatDateParam(nalog.DatumPocetka ?? nalog.DatumIsporuke ?? DateTime.Today.AddMonths(-1));
        var do_ = FormatDateParam(nalog.DatumIsporuke ?? DateTime.Today);
        var url = $"/kontrola-radni-nalog?radniNalog={Uri.EscapeDataString(nalog.Sifra)}&odDatum={od}&doDatum={do_}";
        NavigationManager.NavigateTo(url);
    }

    private void OtvoriUtrosakSirovine(UcitajRadneNalogeModel nalog)
    {
        var od = FormatDateParam(nalog.DatumPocetka ?? nalog.DatumIsporuke ?? DateTime.Today.AddMonths(-1));
        var do_ = FormatDateParam(nalog.DatumIsporuke ?? DateTime.Today);
        var url = $"/proizvodnja?radniNalog={Uri.EscapeDataString(nalog.Sifra)}&odDatum={od}&doDatum={do_}";
        NavigationManager.NavigateTo(url);
    }

    private void OtvoriUtrosakRadneSnage(UcitajRadneNalogeModel nalog)
    {
        var od = FormatDateParam(nalog.DatumPocetka ?? nalog.DatumIsporuke ?? DateTime.Today.AddMonths(-1));
        var do_ = FormatDateParam(nalog.DatumIsporuke ?? DateTime.Today);
        var url = $"/radni-nalozi?radniNalog={Uri.EscapeDataString(nalog.Sifra)}&odDatum={od}&doDatum={do_}";
        NavigationManager.NavigateTo(url);
    }

    private static string FormatDateParam(DateTime d) => d.ToString("yyyy-MM-dd");

    private async Task ResetFilter()
    {
        odDatum = DateTime.Today.AddMonths(-1);
        doDatum = DateTime.Today;
        izabraniKomitentId = 0;
        izabraniRadniNalog = "";
        nalozi = new();
        otvoreniNalozi.Clear();
        pretragaObavljena = false;
        await Task.CompletedTask;
    }

    private void OnOdDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
            odDatum = d;
    }

    private void OnDoDatumChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
            doDatum = d;
    }
}
